%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FeedbackForms_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 5ec38919bd39245b98c3ec338c7f7f5e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: t nul
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "0 \xE9toile, m'a envoy\xE9 dans le mauvais train"
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: Tu devrais te raser
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "T'\xE9tais plut\xF4t mignon aujourd'hui\u2026 appelle-moi si t'as
      besoin d'une pause loin des trains (800) 8135"
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: xoxo
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "Tu portes la m\xEAme tenue tous les jours ?"
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "0 \xE9toile, m'a fait payer s\xE9par\xE9ment pour chacun de mes
      20 krillions d'enfants"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: J'aimerais que tu fasses un peu plus que tamponner mon billet
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "A regard\xE9 ma photo beaaaaaucoup trop longtemps"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "T'as des enfants\u2026 tu veux adopter les miens\u2026 ?"
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "Publicit\xE9 mensong\xE8re, t'es pas aussi baroudeur qu'on le raconte"
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "J'aime les plus \xE2g\xE9s ;)"
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: Tu veux investir dans mon petit business ? On pourrait se faire
      un paquet d'argent ensemble ;)
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "Achetez ShellCoin maintenant et r\xE9cup\xE9rez 110 % de votre
      mise dans les 5 prochaines ann\xE9es !"
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "Achetez ClawCoin maintenant et r\xE9cup\xE9rez 68 % de votre mise
      dans les 2 prochaines ann\xE9es !"
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "Vous avez une dette impay\xE9e de 75 600 $. Veuillez appeler le
      (800) 5201 afin de r\xE9gler la situation."
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "Pourquoi tu m'as quitt\xE9 ?! Tu peux pas me faire \xE7a !!!"
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "0 \xE9toile pour le service, 5 \xE9toiles pour la belle gueule
      quand m\xEAme"
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "0 \xE9toile pour le physique, 5 \xE9toiles pour le service quand
      m\xEAme"
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: Je suis venu voir le fameux responsable canon dont tout le monde
      parle, mais franchement t'es pas si impressionnant
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: "Je suis venu voir le fameux responsable canon dont tout le monde
      parle. T'es\u2026 pas mal. On sort ensemble ?"
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: "AAAAAAH J'ARRIVE PAS \xC0 CROIRE QUE J'AI RENCONTR\xC9 MON IDOLE
      AUJOURD'HUI IL A M\xCAME POIN\xC7ONN\xC9 MON BILLET LUI-M\xCAME AAAAAAA"
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: "ne rencontrez jamais vos idoles s\xE9rieux quelle d\xE9ception."
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "Ce serait bizarre si je te disais que j'ai r\xEAv\xE9 de toi cette
      nuit ?"
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: "oh\u2026 mon salut, la vraie lumi\xE8re de ma vie\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: "Le train que j'ai pris aujourd'hui avait des si\xE8ges vraiment
      sales, vous pourriez peut-\xEAtre embaucher davantage de personnel de nettoyage
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: La navette que j'ai prise aujourd'hui avait des vitres vraiment
      sales, faudrait les nettoyer plus souvent non ?
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "Super service, je reprendrais le train sans h\xE9siter ! :D"
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: Excellent service de restauration, le billet deluxe valait vraiment
      son prix !
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: "Le personnel du train \xE9tait adorable et super serviable, ils
      ont m\xEAme offert une sucette \xE0 mon fils quand il a perdu la sienne ! Merci
      infiniment !"
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: "Super sympa et serviable ! M'a aid\xE9 \xE0 trouver le bon train
      quand j'\xE9tais perdu !"
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: "\xE0 l'aide"
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: ils arrivent
    m_Metadata:
      m_Items: []
  - m_Id: 34
    m_Localized: "Un jour, je te ferai payer pour ce que tu as fait \xE0 ma famille."
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: "b\xE2tonnets de poisson et lobster rolls"
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: "Je prends souvent ce train et c'est vraiment d\xE9cevant de vous
      voir laisser monter des oiseaux. Si vous ne faites rien pour rendre le trajet
      plus s\xFBr, je d\xE9poserai une plainte aupr\xE8s de la direction."
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: "Je prends souvent ce train et c'est vraiment d\xE9cevant de vous
      voir laisser monter des otaries. Si vous ne faites rien pour rendre le trajet
      plus s\xFBr, je d\xE9poserai une plainte aupr\xE8s de la direction."
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: "Je ne me sens plus en s\xE9curit\xE9 dans le train ; j'ai l'impression
      d'\xEAtre entour\xE9 de passagers qui veulent me manger\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: "Il devrait y avoir un train r\xE9serv\xE9 aux crustac\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 40
    m_Localized: Service catastrophique.
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: Pars tant que tu le peux !
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: Reste loin de Crustacean Corporation
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: On te surveille toujours
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: "Stop \xE0 la crustac\xE9ification, arr\xEAtez de les envoyer en
      navette"
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: Si tu vois quelque chose, dis-le.
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: "Trop de non-crustac\xE9s dans mon train"
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: T'avais l'air triste aujourd'hui
    m_Metadata:
      m_Items: []
  - m_Id: 48
    m_Localized: "Ta famille n'est pas en s\xE9curit\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: Je sais pour ton isopode.
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: Tu devrais quitter la ville
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: "j'ai mang\xE9 ma sucete dans le train et elle a disparue\u2026
      elle \xE9 o\xF9 :("
    m_Metadata:
      m_Items: []
  - m_Id: 52
    m_Localized: maman dit que samuel c'est un tardigratte, et le tien c'est un zizopode
      !
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: "maman a dit qu'elle devait amener sameul chez le v\xE9to et plus
      lui donner de sucetes. m'sieur, c'est moi qui ai fait mal \xE0 sameul ? mais
      j'adore les sucetes\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 54
    m_Localized: "maman est rentr\xE9e tard encor\u2026 mais elle a achet\xE9 plein
      plein de sucetes ! j'aime tro ma maman"
    m_Metadata:
      m_Items: []
  - m_Id: 55
    m_Localized: "maman dit que l\xE9cole c'est tr\xE9 importan, mais moi j'aime
      pas ! m'sieur, pourkoi je dois aller \xE0 l\xE9cole ?"
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: "5 \xE9toiles ! Non, 6 \xE9toiles ! 100 \xE9toiles ! 1 milliard
      d'\xE9toiles ! Une infinit\xE9 d'\xE9toiles !"
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: "m'sieur, quand tu parles de toi et de ton zizopode, \xE7a me rend
      tro content. tu veux me parler encore ?"
    m_Metadata:
      m_Items: []
  - m_Id: 58
    m_Localized: "M'a pas laiss\xE9 monter avec toutes mes plantes. 0 \xE9toile."
    m_Metadata:
      m_Items: []
  - m_Id: 59
    m_Localized: Ils devraient rendre les trains plus accueillants pour les poissons.
    m_Metadata:
      m_Items: []
  - m_Id: 60
    m_Localized: "Pas assez mouill\xE9, m\xEAme apr\xE8s la pluie."
    m_Metadata:
      m_Items: []
  - m_Id: 61
    m_Localized: "Voil\xE0 l'adresse de ma prochaine manif\u2026 sois discret. \\n1823
      Sandy Shore Drive\u2026 Apporte du ruban adh\xE9sif."
    m_Metadata:
      m_Items: []
  - m_Id: 62
    m_Localized: "Mon gar\xE7on, je dois te remercier d'avoir \xE9cout\xE9 les divagations
      de ce vieil \xEAtre."
    m_Metadata:
      m_Items: []
  - m_Id: 63
    m_Localized: "Souhaites-tu entendre des r\xE9cits d'autrefois ? Il est rare que
      quelqu'un comme toi accepte d'\xE9couter\u2026 un vieux fou."
    m_Metadata:
      m_Items: []
  - m_Id: 64
    m_Localized: "M\xEAme si mes compagnons ne marchent plus \xE0 mes c\xF4t\xE9s,
      les courants et le sable murmurent encore leurs voix, comme s'ils m'appelaient
      vers l'autre rive."
    m_Metadata:
      m_Items: []
  - m_Id: 65
    m_Localized: "Autrefois, nous fuyions des pinces surgies de l'ab\xEEme et des
      gueules capables de nous avaler tout entiers. Mais je dois me corriger. Ces
      pinces et ces gueules ont disparu du monde tangible ; elles vivent pourtant
      encore dans nos c\u0153urs."
    m_Metadata:
      m_Items: []
  - m_Id: 66
    m_Localized: "Est-ce que je sais encore faire un \xAB wheelie de malade \xBB
      ? \u2026Bien s\xFBr que j'en faisais autrefois ! Je suis juste un vieux schnock
      arthritique maintenant, d'accord ?!?!"
    m_Metadata:
      m_Items: []
  - m_Id: 67
    m_Localized: "Les scorpions de mer ont disparu, mais mes plus proches compagnons
      aussi\u2026 Coral, Pearl, Finn, o\xF9 \xEAtes-vous d\xE9sormais ?"
    m_Metadata:
      m_Items: []
  - m_Id: 68
    m_Localized: "Quand j'ai enfin trouv\xE9 la grotte des scorpions, il ne restait
      que leurs exosquelettes. Si je ne les avais pas abandonn\xE9s ce jour-l\xE0\u2026
      peut-\xEAtre ne serais-je pas si seul aujourd'hui."
    m_Metadata:
      m_Items: []
  - m_Id: 69
    m_Localized: "\xC0 mes yeux, ces r\xE9cifs glac\xE9s des grandes entreprises
      ne sont pas si diff\xE9rents des grottes de scorpions. Seul le pr\xE9dateur
      qui r\xF4de dans l'ombre a chang\xE9\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 70
    m_Localized: "J'aurais d\xFB s\xE9cher l'entra\xEEnement plus souvent pour aller
      voir leurs spectacles. Mon gar\xE7on, ne gaspille pas ta vie derri\xE8re ce
      kiosque, surtout au service d'un pouvoir ingrat."
    m_Metadata:
      m_Items: []
  - m_Id: 71
    m_Localized: "Mes souvenirs\u2026 Pearl dansait comme second m\xE9tier sur l'atoll
      voisin, et Coral jouait des tubes dans la symphonie marine. Finn \xE9tait imbattable
      au combat pince contre pince\u2026 mais lui et ses peintures de sable \xE9taient
      plus beaux encore. Ch\xE9ris ceux que tu aimes."
    m_Metadata:
      m_Items: []
  - m_Id: 72
    m_Localized: "Mon gar\xE7on, ne pleure pas pour moi. C'\xE9tait un destin \xE9crit
      depuis longtemps, que j'ai fui bien trop longtemps. Puisque tu as entendu les
      confessions de ce p\xE9cheur, tu sais que je dois expier mes fautes."
    m_Metadata:
      m_Items: []
  - m_Id: 73
    m_Localized: "Ce matin, je me suis r\xE9veill\xE9 d'un r\xEAve merveilleux. Plus
      de coraux blanchis, seulement les r\xE9cifs d'autrefois et des visages familiers
      qui m'appelaient. Il est donc temps pour moi de gagner l'autre rive."
    m_Metadata:
      m_Items: []
  - m_Id: 74
    m_Localized: "Sympa, mais refuse d'acheter des n\u0153uds assortis avec moi"
    m_Metadata:
      m_Items: []
  - m_Id: 75
    m_Localized: "Le train \xE9tait trop bruyant, impossible de lire."
    m_Metadata:
      m_Items: []
  - m_Id: 76
    m_Localized: "Ne m'a pas dit que je parlais trop doucement, c'\xE9tait parfait"
    m_Metadata:
      m_Items: []
  - m_Id: 77
    m_Localized: "Super gamin, me rappelle \xE9norm\xE9ment mes propres enfants !"
    m_Metadata:
      m_Items: []
  - m_Id: 78
    m_Localized: "Bien habill\xE9, poli, travailleur\u2026 j'esp\xE8re que mes enfants
      deviendront comme toi en grandissant"
    m_Metadata:
      m_Items: []
  - m_Id: 79
    m_Localized: "Super service, c'est juste que\u2026 les billets sont un peu chers.
      Tu pourrais pas glisser un mot \xE0 la direction pour faire baisser un peu
      les prix ?"
    m_Metadata:
      m_Items: []
  - m_Id: 80
    m_Localized: "Franchement, mon mari n'arr\xEAte pas de parler de toi en disant
      que t'es un bon petit chaque fois qu'il rentre. Tu pourrais lui faire comprendre
      de ramener un peu moins de fleurs ? J'adore son grand c\u0153ur d'idiot, mais
      on n'a litt\xE9ralement plus de place \xE0 la maison !!!"
    m_Metadata:
      m_Items: []
  - m_Id: 81
    m_Localized: "Et celle-l\xE0\u2026 comment une algue r\xE9pond au t\xE9l\xE9phone
      ? \xAB Alg\xF4 ? Je vous \xE9coute ! \xBB Haha ! Pas mal, hein ? (mets 5 \xE9toiles
      \xE0 ma blague et je t'en mets 5 sur la plateforme du service client"
    m_Metadata:
      m_Items: []
  - m_Id: 82
    m_Localized: La prochaine fois que tu vois Papi, tu peux lui donner une bonne
      place ?
    m_Metadata:
      m_Items: []
  - m_Id: 83
    m_Localized: "\xC9coute, mais ne r\xE9pond jamais \xE0 mes questions. Pourrait
      \xEAtre plus poli."
    m_Metadata:
      m_Items: []
  - m_Id: 84
    m_Localized: "Tr\xE8s beau, mais refuse de sortir avec ma petite-fille."
    m_Metadata:
      m_Items: []
  - m_Id: 85
    m_Localized: "Porte la m\xEAme tenue tous les jours, devrait s'acheter de nouveaux
      v\xEAtements."
    m_Metadata:
      m_Items: []
  - m_Id: 86
    m_Localized: "Un nouveau mouchoir de poche ne ferait pas de mal, celui-l\xE0
      a l'air un peu poussi\xE9reux."
    m_Metadata:
      m_Items: []
  - m_Id: 87
    m_Localized: "Bonne poign\xE9e de main, bien ferme. Beau jeune gars."
    m_Metadata:
      m_Items: []
  - m_Id: 88
    m_Localized: "M'\xE9coute toujours. J'adore ce petit."
    m_Metadata:
      m_Items: []
  - m_Id: 89
    m_Localized: "Si jamais tu as besoin d'un peu de sagesse bien pr\xE9cise, voil\xE0
      mon num\xE9ro. J'en ai \xE0 revendre. 921-8564"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
