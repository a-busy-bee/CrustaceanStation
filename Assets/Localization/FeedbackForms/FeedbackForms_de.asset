%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FeedbackForms_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 5ec38919bd39245b98c3ec338c7f7f5e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: du bis doof
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: 0 Sterne, hat mich zum falschen Zug geschickt
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: Du solltest dich mal rasieren.
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "Du sahst heute echt s\xFC\xDF aus \u2026 Ruf mich an, wenn du mal
      eine Pause von Z\xFCgen brauchst: (800) 8135"
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: xoxo
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "Tr\xE4gst du eigentlich jeden Tag dasselbe?"
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "0 Sterne, ich musste f\xFCr jedes meiner 20 Krillionen Kinder einzeln
      bezahlen"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "W\xE4r sch\xF6n, wenn du ein bisschen mehr machen w\xFCrdest, als
      nur mein Ticket abzustempeln."
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: Hat mein Foto vieeeel zu lange angestarrt.
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "Hast du Kinder \u2026 willst du meine adoptieren \u2026?"
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "Irref\xFChrende Werbung. So verwegen, wie alle sagen, bist du gar
      nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "Ich steh auf \xE4ltere Kerle ;)"
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "Willst du in mein Nebengesch\xE4ft investieren? Wir k\xF6nnten
      zusammen richtig Kohle machen ;)"
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "Kauf jetzt ShellCoin und mach in den n\xE4chsten 5 Jahren 110 %
      Gewinn!"
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "Kauf jetzt ClawCoin und mach in den n\xE4chsten 2 Jahren 68 % Gewinn!"
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "Sie haben ausstehende Schulden in H\xF6he von 75.600 $. Bitte rufen
      Sie zur Kl\xE4rung unter (800) 5201 an."
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: Warum hast du Schluss mit mir gemacht? Das kannst du mir nicht antun!!!
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "0 Sterne f\xFCr den Service, aber das Gesicht kriegt 5"
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "0 Sterne f\xFCrs Aussehen, aber der Service kriegt 5"
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "Bin hergekommen, um diesen legend\xE4r hei\xDFen Manager zu sehen,
      von dem alle reden. Ehrlich gesagt nicht besonders beeindruckend."
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: "Bin hergekommen, um diesen legend\xE4r hei\xDFen Manager zu sehen,
      von dem alle reden. Du bist \u2026 ganz okay. Lust auf ein Date?"
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: "AAAAAA ICH FASS ES NICHT ICH HAB HEUTE MEIN IDOL GETROFFEN UND
      ER HAT SOGAR PERS\xD6NLICH MEIN TICKET ENTWERTET AAAAAAA"
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: "triff niemals deine idole brudi du warst so entt\xE4uschend"
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "W\xE4re es komisch, wenn ich sage, dass ich letzte Nacht von dir
      getr\xE4umt habe?"
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: "Oh \u2026 mein Retter, das wahre Licht meines Lebens \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: "Der Zug heute hatte echt dreckige Sitze. Vielleicht solltet ihr
      mehr Reinigungskr\xE4fte einstellen?"
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: "Die Fenster im Shuttle heute waren echt dreckig. Ihr solltet die
      \xF6fter putzen."
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "Super Service, w\xFCrde wieder mitfahren! :D"
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: Tolles Essen! Das Deluxe-Ticket war den Preis wirklich wert!
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: Das Zugpersonal war so hilfsbereit und nett. Als mein Sohn seinen
      Lolli verloren hat, haben sie ihm sogar einen neuen geschenkt! Vielen Dank!
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: Supernett und hilfsbereit! Hat mir den richtigen Zug gezeigt, als
      ich mich verlaufen hatte!
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: hilfe
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: sie kommen
    m_Metadata:
      m_Items: []
  - m_Id: 34
    m_Localized: "Eines Tages wirst du f\xFCr das bezahlen, was du meiner Familie
      angetan hast."
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: "Fischst\xE4bchen und Hummerbr\xF6tchen"
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: "Als Vielfahrer finde ich es echt entt\xE4uschend, dass ihr st\xE4ndig
      V\xF6gel in den Zug lasst. Wenn ihr den Zug f\xFCr uns nicht sicherer macht,
      beschwere ich mich bei der Zentrale."
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: "Als Vielfahrer finde ich es echt entt\xE4uschend, dass ihr st\xE4ndig
      Seel\xF6wen in den Zug lasst. Wenn ihr den Zug f\xFCr uns nicht sicherer macht,
      beschwere ich mich bei der Zentrale."
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: "Ich f\xFChle mich im Zug \xFCberhaupt nicht mehr sicher. Es kommt
      mir vor, als w\xE4re ich nur von Fahrg\xE4sten umgeben, die mich fressen wollen
      \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: "Es sollte einen Zug nur f\xFCr Krebstiere geben."
    m_Metadata:
      m_Items: []
  - m_Id: 40
    m_Localized: Schrecklicher Service.
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: Verschwinde, solange du noch kannst!
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: Halt dich von der Crustacean Corporation fern.
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: Wir beobachten dich immer.
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: Stoppt die Verkrabbung. Schluss mit den Shuttles.
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: "Wenn dir etwas auff\xE4llt, sag etwas."
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: Zu viele Nicht-Krebstiere in meinem Zug.
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: Du sahst heute traurig aus.
    m_Metadata:
      m_Items: []
  - m_Id: 48
    m_Localized: Deine Familie ist nicht sicher.
    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: "Ich wei\xDF von deiner Assel."
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: Du solltest die Stadt verlassen.
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: "ich hab mein loli im zug gegesn und dann war er weg \u2026 wo is
      er hin :("
    m_Metadata:
      m_Items: []
  - m_Id: 52
    m_Localized: "mama sagt samuel is ein b\xE4rtirchn und deiner is ne assl!"
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: "mama muste samuel zum tierartz bringn und ich darf ihm keine lolis
      mer gebn. mister hab ich samuel weh getan? aber ich libe lolis \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 54
    m_Localized: "mama kam wider sp\xE4t nach hause \u2026 aber sie hat gaaaaanz
      viele lolis mitgebracht! ich libe meine mama so sehr"
    m_Metadata:
      m_Items: []
  - m_Id: 55
    m_Localized: mama sagt schule is voll wichtig aber ich mags nich! mister warum
      muss ich in die schule?
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: 5 Sterne! Nein, 6 Sterne! 100 Sterne! 1 Milliarde Sterne! Unendlich
      Sterne!
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: "mister wenn du von dir und deiner assl erz\xE4hlst macht mich das
      so froh. redest du noch mehr mit mir?"
    m_Metadata:
      m_Items: []
  - m_Id: 58
    m_Localized: Hat mich nicht alle meine Pflanzen mitnehmen lassen. 0 Sterne.
    m_Metadata:
      m_Items: []
  - m_Id: 59
    m_Localized: "Die Z\xFCge sollten fischfreundlicher sein."
    m_Metadata:
      m_Items: []
  - m_Id: 60
    m_Localized: Nicht nass genug, obwohl es geregnet hat.
    m_Metadata:
      m_Items: []
  - m_Id: 61
    m_Localized: "Hier ist die Adresse f\xFCr meinen n\xE4chsten Protest \u2026 Sei
      unauff\xE4llig. \\n1823 Sandy Shore Drive \u2026 Bring Panzertape mit."
    m_Metadata:
      m_Items: []
  - m_Id: 62
    m_Localized: "Junger Freund, ich muss dir danken, dass du den Abschweifungen
      dieser alten Seele zugeh\xF6rt hast."
    m_Metadata:
      m_Items: []
  - m_Id: 63
    m_Localized: "M\xF6chtest du Geschichten aus alter Zeit h\xF6ren? Selten ist
      jemand wie du bereit, einem alten Narren zuzuh\xF6ren \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 64
    m_Localized: "Auch wenn meine Gef\xE4hrten l\xE4ngst nicht mehr denselben Pfad
      gehen, fl\xFCstern Str\xF6mung und Boden noch immer mit ihren Stimmen und rufen
      mich ans andere Ufer."
    m_Metadata:
      m_Items: []
  - m_Id: 65
    m_Localized: "In l\xE4ngst vergangenen Zeiten flohen wir vor Scheren, die aus
      dem Abgrund griffen, und M\xE4ulern, die uns ganz verschlingen konnten. Doch
      ich muss mich berichtigen: Diese Scheren und M\xE4uler sind aus der greifbaren
      Welt verschwunden, aber in unseren Herzen leben sie weiter."
    m_Metadata:
      m_Items: []
  - m_Id: 66
    m_Localized: "Wei\xDF ich etwa noch, wie man einen \u201Ekranken Wheelie\u201C
      macht? \u2026 Nat\xFCrlich konnte ich das mal! Ich bin jetzt eben ein alter
      Knacker mit Arthritis, ja?!?!"
    m_Metadata:
      m_Items: []
  - m_Id: 67
    m_Localized: "Die Seeskorpione sind fort, doch meine engsten Gef\xE4hrten ebenso
      \u2026 Coral, Pearl, Finn \u2014 wo seid ihr jetzt?"
    m_Metadata:
      m_Items: []
  - m_Id: 68
    m_Localized: "Als ich die Skorpionh\xF6hle endlich fand, waren nur noch ihre
      Exoskelette \xFCbrig. H\xE4tte ich sie an jenem Tag nicht verlassen \u2026
      vielleicht w\xE4re ich heute nicht so allein."
    m_Metadata:
      m_Items: []
  - m_Id: 69
    m_Localized: "Ich glaube, diese kalten Firmenriffe unterscheiden sich gar nicht
      so sehr von jenen Skorpionh\xF6hlen. Nur lauert dort ein anderes Raubtier im
      Schatten \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 70
    m_Localized: "Ich h\xE4tte \xF6fter das Training schw\xE4nzen und mir ihre Auftritte
      ansehen sollen. Junger Freund, verschwende dein Leben nicht an diesem Kiosk
      \u2014 schon gar nicht f\xFCr eine Macht, die es dir nicht dankt."
    m_Metadata:
      m_Items: []
  - m_Id: 71
    m_Localized: "Meine Erinnerungen \u2026 Pearl tanzte nebenbei am nahen Atoll,
      und Coral spielte R\xF6hren in der Meersinfonie. Finn war im Schere-gegen-Schere-Kampf
      ungeschlagen \u2026 doch noch sch\xF6ner waren er und seine Sandbilder. H\xFCte
      die, die du liebst."
    m_Metadata:
      m_Items: []
  - m_Id: 72
    m_Localized: "Junger Freund, weine nicht um mich. Diesem Schicksal war ich l\xE4ngst
      bestimmt, doch ich bin ihm viel zu lange davongelaufen. Du hast die Beichte
      dieses S\xFCnders geh\xF6rt und wei\xDFt, dass ich f\xFCr meine Schuld b\xFC\xDFen
      muss."
    m_Metadata:
      m_Items: []
  - m_Id: 73
    m_Localized: "Heute Morgen erwachte ich aus einem wundersch\xF6nen Traum. Keine
      gebleichten Korallen, sondern alte Riffe und vertraute Gesichter, die nach
      mir riefen. Darum werde ich nun zum anderen Ufer aufbrechen."
    m_Metadata:
      m_Items: []
  - m_Id: 74
    m_Localized: Netter Kerl, aber weigert sich, mit mir passende Schleifen zu kaufen.
    m_Metadata:
      m_Items: []
  - m_Id: 75
    m_Localized: Der Zug war so laut, dass ich nicht lesen konnte.
    m_Metadata:
      m_Items: []
  - m_Id: 76
    m_Localized: "Hat mich nicht darauf hingewiesen, dass ich zu leise rede. Gro\xDFartig."
    m_Metadata:
      m_Items: []
  - m_Id: 77
    m_Localized: Super Kleiner, erinnert mich total an meine eigenen Kinder!
    m_Metadata:
      m_Items: []
  - m_Id: 78
    m_Localized: "Gut angezogen, h\xF6flich, flei\xDFig \u2026 Ich hoffe, meine Kinder
      werden sp\xE4ter mal so wie du."
    m_Metadata:
      m_Items: []
  - m_Id: 79
    m_Localized: "Super Service, nur \u2026 die Ticketpreise sind ziemlich hoch.
      K\xF6nntest du nicht mal bei der Leitung ein gutes Wort einlegen, damit die
      ein bisschen runtergehen?"
    m_Metadata:
      m_Items: []
  - m_Id: 80
    m_Localized: "Ehrlich, mein Mann erz\xE4hlt jedes Mal von dir, wenn er nach Hause
      kommt. Kannst du ihm vielleicht ganz dezent sagen, dass er weniger Blumen mitbringen
      soll? Ich liebe sein gro\xDFes, dummes Herz, aber wir haben zu Hause wirklich
      keinen Platz mehr!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 81
    m_Localized: "Wie w\xE4r\u2019s mit dem hier \u2026 Wie meldet sich Seetang am
      Telefon? \u201EAlge guten Tag!\u201C Haha! Lustig, oder? (Gib mir 5 Sterne
      f\xFCr den Witz, dann geb ich dir 5 Sterne auf der Serviceplattform.)"
    m_Metadata:
      m_Items: []
  - m_Id: 82
    m_Localized: "Wenn du Opa das n\xE4chste Mal siehst, kannst du ihm bitte einen
      guten Sitzplatz geben?"
    m_Metadata:
      m_Items: []
  - m_Id: 83
    m_Localized: "H\xF6rt zu, beantwortet aber nie meine Fragen. K\xF6nnte h\xF6flicher
      sein."
    m_Metadata:
      m_Items: []
  - m_Id: 84
    m_Localized: Sehr gut aussehend, will aber meine Enkelin nicht daten.
    m_Metadata:
      m_Items: []
  - m_Id: 85
    m_Localized: "Tr\xE4gt jeden Tag dasselbe. Sollte sich mal neue Klamotten kaufen."
    m_Metadata:
      m_Items: []
  - m_Id: 86
    m_Localized: "Ein neues Einstecktuch w\xE4re nicht schlecht. Das alte sieht etwas
      staubig aus."
    m_Metadata:
      m_Items: []
  - m_Id: 87
    m_Localized: "Kr\xE4ftiger H\xE4ndedruck, gut aussehender junger Kerl."
    m_Metadata:
      m_Items: []
  - m_Id: 88
    m_Localized: "H\xF6rt mir immer zu. Ich mag den Kerl."
    m_Metadata:
      m_Items: []
  - m_Id: 89
    m_Localized: 'Falls du mal ganz besondere Weisheit brauchst: Hier ist meine Nummer.
      Davon hab ich reichlich. 921-8564'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
