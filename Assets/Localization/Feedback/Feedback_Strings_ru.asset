  m_TableData:
  - m_Id: 1
    m_Localized: "\u0442\u0438\u0441 \u0441\u0443\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "0 \u0437\u0432\u0435\u0437\u0434, \u043C\u0435\u043D\u044F \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0438
      \u043D\u0435 \u0432 \u0442\u043E\u0442 \u043F\u043E\u0435\u0437\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "\u0412\u0430\u043C \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u043F\u043E\u0431\u0440\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "\u0422\u044B \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u0430
      \u043E\u0447\u0430\u0440\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E...
      \u043F\u043E\u0437\u0432\u043E\u043D\u0438 \u043C\u043D\u0435, \u0435\u0441\u043B\u0438
      \u0437\u0430\u0445\u043E\u0447\u0435\u0448\u044C \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C
      \u043E\u0442 \u043F\u043E\u0435\u0437\u0434\u043E\u0432 (800) 8135"
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "\u0446\u0435\u043B\u0443\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "\u0412\u044B \u043D\u043E\u0441\u0438\u0442\u0435 \u043E\u0434\u043D\u0443
      \u0438 \u0442\u0443 \u0436\u0435 \u043E\u0434\u0435\u0436\u0434\u0443 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0434\u0435\u043D\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "0 \u0437\u0432\u0435\u0437\u0434, \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u043C\u0435\u043D\u044F \u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u043E
      \u0437\u0430 \u043C\u043E\u0438\u0445 20 \u043C\u0438\u043B\u043B\u0438\u0430\u0440\u0434\u043E\u0432
      \u0434\u0435\u0442\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "\u0425\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u0431\u044B,
      \u0447\u0442\u043E\u0431\u044B \u0432\u044B \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0447\u0442\u043E-\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0435\u0435,
      \u0447\u0435\u043C \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u0448\u0442\u0430\u043C\u043F \u043D\u0430 \u043C\u043E\u0439 \u0431\u0438\u043B\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u043E\u043B\u0433\u043E
      \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u043B\u0430
      \u0441\u0432\u043E\u044E \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "\u0423 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C \u0434\u0435\u0442\u0438...
      \u0432\u044B \u0443\u0441\u044B\u043D\u043E\u0432\u0438\u0442\u0435 \u043C\u043E\u0438\u0445...?"
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "\u041B\u043E\u0436\u043D\u0430\u044F \u0440\u0435\u043A\u043B\u0430\u043C\u0430,
      \u0432\u044B \u043D\u0435 \u0442\u0430\u043A\u0438\u0435 \u043A\u0440\u0443\u0442\u044B\u0435,
      \u043A\u0430\u043A \u043E \u0432\u0430\u0441 \u0433\u043E\u0432\u043E\u0440\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "\u041C\u043D\u0435 \u043D\u0440\u0430\u0432\u044F\u0442\u0441\u044F
      \u043C\u0443\u0436\u0447\u0438\u043D\u044B \u043F\u043E\u0441\u0442\u0430\u0440\u0448\u0435
      ;)"
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "\u0425\u043E\u0447\u0435\u0448\u044C \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0432 \u043C\u043E\u0439 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0431\u0438\u0437\u043D\u0435\u0441? \u041C\u044B \u043C\u043E\u0433\u043B\u0438
      \u0431\u044B \u0432\u043C\u0435\u0441\u0442\u0435 \u043D\u0435\u043F\u043B\u043E\u0445\u043E
      \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C ;)"
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u0435 ShellCoin \u043F\u0440\u044F\u043C\u043E
      \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435
      110% \u043F\u0440\u0438\u0431\u044B\u043B\u0438 \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445 5 \u043B\u0435\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u0435 ClawCoin \u043F\u0440\u044F\u043C\u043E
      \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435
      68% \u043F\u0440\u0438\u0431\u044B\u043B\u0438 \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445 2 \u043B\u0435\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "\u0423 \u0432\u0430\u0441 \u0438\u043C\u0435\u0435\u0442\u0441\u044F
      \u0437\u0430\u0434\u043E\u043B\u0436\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u0432 \u0440\u0430\u0437\u043C\u0435\u0440\u0435 75 600 \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432.
      \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u043E\u0437\u0432\u043E\u043D\u0438\u0442\u0435
      \u043F\u043E \u043D\u043E\u043C\u0435\u0440\u0443 (800) 5201 \u0434\u043B\u044F
      \u0440\u0435\u0448\u0435\u043D\u0438\u044F \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u0441\u043E
      \u043C\u043D\u043E\u0439 \u0440\u0430\u0441\u0441\u0442\u0430\u043B\u0430\u0441\u044C?
      \u0422\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C \u0442\u0430\u043A
      \u0441\u043E \u043C\u043D\u043E\u0439 \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u0442\u044C!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "\u041E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435
      \u043D\u0430 0 \u0437\u0432\u0435\u0437\u0434, \u043D\u043E \u043A\u0430\u0440\u0442\u0430
      \u043B\u043E\u044F\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u043D\u0430 5
      \u0437\u0432\u0435\u0437\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "\u0412\u043D\u0435\u0448\u043D\u0438\u0439 \u0432\u0438\u0434 \u043D\u0430
      0 \u0437\u0432\u0435\u0437\u0434, \u043D\u043E \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435
      \u043D\u0430 5 \u0437\u0432\u0435\u0437\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "\u041F\u0440\u0438\u0448\u043B\u0430 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043D\u0430 \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u043E\u0433\u043E
      \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u043C\u0435\u043D\u0435\u0434\u0436\u0435\u0440\u0430, \u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u0432\u0441\u0435 \u0433\u043E\u0432\u043E\u0440\u044F\u0442, \u043D\u043E,
      \u0447\u0435\u0441\u0442\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u044F,
      \u0442\u044B \u043D\u0435 \u0442\u0430\u043A \u0443\u0436 \u0438 \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u044F\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: "\u041F\u0440\u0438\u0448\u043B\u0430 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043D\u0430 \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u043E\u0433\u043E
      \u043A\u0440\u0430\u0441\u0430\u0432\u0447\u0438\u043A\u0430-\u043C\u0435\u043D\u0435\u0434\u0436\u0435\u0440\u0430,
      \u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0432\u0441\u0435 \u0433\u043E\u0432\u043E\u0440\u044F\u0442.
      \u0422\u044B\u2026 \u0432\u043F\u043E\u043B\u043D\u0435 \u043D\u0435\u043F\u043B\u043E\u0445.
      \u0425\u043E\u0447\u0435\u0448\u044C \u043F\u043E\u0439\u0442\u0438 \u043A\u0443\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: "\u041D\u0435 \u043C\u043E\u0433\u0443 \u043F\u043E\u0432\u0435\u0440\u0438\u0442\u044C,
      \u0447\u0442\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0430
      \u0441\u0432\u043E\u0435\u0433\u043E \u043A\u0443\u043C\u0438\u0440\u0430!
      \u041E\u043D \u0434\u0430\u0436\u0435 \u0441\u0430\u043C \u043F\u0440\u043E\u0431\u0438\u043B
      \u043C\u043E\u0439 \u0431\u0438\u043B\u0435\u0442! \u0410\u0410\u0410\u0410\u0410\u0410\u0410!"
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: "\u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0439\u0441\u044F
      \u0441\u043E \u0441\u0432\u043E\u0438\u043C\u0438 \u043A\u0443\u043C\u0438\u0440\u0430\u043C\u0438,
      \u0447\u0443\u0432\u0430\u043A, \u0442\u044B \u043C\u0435\u043D\u044F \u0442\u0430\u043A
      \u0440\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "\u0411\u0443\u0434\u0435\u0442 \u043B\u0438 \u0441\u0442\u0440\u0430\u043D\u043D\u043E,
      \u0435\u0441\u043B\u0438 \u044F \u0441\u043A\u0430\u0436\u0443, \u0447\u0442\u043E
      \u043C\u043D\u0435 \u043F\u0440\u0438\u0441\u043D\u0438\u043B\u0441\u044F \u0442\u044B
      \u043F\u0440\u043E\u0448\u043B\u043E\u0439 \u043D\u043E\u0447\u044C\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: "\u041E, \u043C\u043E\u0439 \u0421\u043F\u0430\u0441\u0438\u0442\u0435\u043B\u044C,
      \u0438\u0441\u0442\u0438\u043D\u043D\u044B\u0439 \u0441\u0432\u0435\u0442 \u043C\u043E\u0435\u0439
      \u0436\u0438\u0437\u043D\u0438\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: "\u0412 \u043F\u043E\u0435\u0437\u0434\u0435, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0435\u0445\u0430\u043B\u0430,
      \u0431\u044B\u043B\u0438 \u043E\u0447\u0435\u043D\u044C \u0433\u0440\u044F\u0437\u043D\u044B\u0435
      \u0441\u0438\u0434\u0435\u043D\u044C\u044F, \u043C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C, \u0432\u044B \u043C\u043E\u0433\u043B\u0438 \u0431\u044B
      \u043D\u0430\u043D\u044F\u0442\u044C \u0435\u0449\u0451 \u0443\u0431\u043E\u0440\u0449\u0438\u043A\u043E\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: "\u0412 \u0430\u0432\u0442\u043E\u0431\u0443\u0441\u0435, \u043D\u0430
      \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0435\u0445\u0430\u043B\u0430, \u0431\u044B\u043B\u0438 \u043E\u0447\u0435\u043D\u044C
      \u0433\u0440\u044F\u0437\u043D\u044B\u0435 \u043E\u043A\u043D\u0430, \u0432\u0430\u043C
      \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u043C\u044B\u0442\u044C \u0438\u0445
      \u0447\u0430\u0449\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E\u0435 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435,
      \u0441 \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435\u043C
      \u043F\u0440\u043E\u043A\u0430\u0442\u043B\u044E\u0441\u044C \u0435\u0449\u0435
      \u0440\u0430\u0437! :D"
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E\u0435 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435
      \u0438 \u0435\u0434\u0430, \u0431\u0438\u043B\u0435\u0442 \u0432 \u043B\u044E\u043A\u0441
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0441\u0442\u043E\u0438\u043B \u0441\u0432\u043E\u0438\u0445 \u0434\u0435\u043D\u0435\u0433!"
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: "\u0421\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0438 \u043F\u043E\u0435\u0437\u0434\u0430
      \u0431\u044B\u043B\u0438 \u0442\u0430\u043A\u0438\u043C\u0438 \u043E\u0442\u0437\u044B\u0432\u0447\u0438\u0432\u044B\u043C\u0438
      \u0438 \u0434\u043E\u0431\u0440\u044B\u043C\u0438, \u043E\u043D\u0438 \u0434\u0430\u0436\u0435
      \u043F\u043E\u0434\u0430\u0440\u0438\u043B\u0438 \u043C\u043E\u0435\u043C\u0443
      \u0441\u044B\u043D\u0443 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0439
      \u043B\u0435\u0434\u0435\u043D\u0435\u0446, \u043A\u043E\u0433\u0434\u0430
      \u043E\u043D \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0441\u0432\u043E\u0439!
      \u042F \u0438\u043C \u043E\u0447\u0435\u043D\u044C \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: "\u041E\u0447\u0435\u043D\u044C \u0434\u043E\u0431\u0440\u044B\u0439
      \u0438 \u043E\u0442\u0437\u044B\u0432\u0447\u0438\u0432\u044B\u0439! \u041F\u043E\u043C\u043E\u0433
      \u043C\u043D\u0435 \u043D\u0430\u0439\u0442\u0438 \u043D\u0443\u0436\u043D\u044B\u0439
      \u043F\u043E\u0435\u0437\u0434, \u043A\u043E\u0433\u0434\u0430 \u044F \u0437\u0430\u0431\u043B\u0443\u0434\u0438\u043B\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: "\u043F\u043E\u043C\u043E\u0449\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: "\u043E\u043D\u0438 \u0438\u0434\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 34
    m_Localized: "\u041E\u0434\u043D\u0430\u0436\u0434\u044B \u044F \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044E
      \u0442\u0435\u0431\u044F \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E \u0442\u044B \u0441\u0434\u0435\u043B\u0430\u043B
      \u0441 \u043C\u043E\u0435\u0439 \u0441\u0435\u043C\u044C\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: "\u0440\u044B\u0431\u043D\u044B\u0435 \u043F\u0430\u043B\u043E\u0447\u043A\u0438
      \u0438 \u0441\u044D\u043D\u0434\u0432\u0438\u0447\u0438 \u0441 \u043B\u043E\u0431\u0441\u0442\u0435\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: "\u041A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u0447\u0430\u0441\u0442\u043E \u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0449\u0438\u0439\u0441\u044F
      \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u043E\u043C,
      \u044F \u043E\u0447\u0435\u043D\u044C \u0440\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043D
      \u0442\u0435\u043C, \u0447\u0442\u043E \u0432\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0435
      \u043F\u0443\u0441\u043A\u0430\u0442\u044C \u043F\u0442\u0438\u0446 \u0432
      \u043F\u043E\u0435\u0437\u0434. \u042F \u043F\u043E\u0434\u0430\u043C \u0436\u0430\u043B\u043E\u0431\u0443
      \u0432 \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044E, \u0435\u0441\u043B\u0438
      \u0432\u044B \u043D\u0435 \u043F\u0440\u0438\u043C\u0435\u0442\u0435 \u043C\u0435\u0440\u044B
      \u0434\u043B\u044F \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u044F \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
      \u043F\u043E\u0435\u0437\u0434\u0430 \u0434\u043B\u044F \u043D\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: "\u041A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u0447\u0430\u0441\u0442\u043E \u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0449\u0438\u0439\u0441\u044F
      \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u043E\u043C,
      \u044F \u043A\u0440\u0430\u0439\u043D\u0435 \u0440\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043D
      \u0442\u0435\u043C, \u0447\u0442\u043E \u0432\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0435
      \u043F\u0443\u0441\u043A\u0430\u0442\u044C \u043C\u043E\u0440\u0441\u043A\u0438\u0445
      \u043B\u044C\u0432\u043E\u0432 \u0432 \u043F\u043E\u0435\u0437\u0434. \u042F
      \u043F\u043E\u0434\u0430\u043C \u0436\u0430\u043B\u043E\u0431\u0443 \u0432
      \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044E, \u0435\u0441\u043B\u0438
      \u0432\u044B \u043D\u0435 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043C\u0435\u0442\u0435
      \u0443\u0441\u0438\u043B\u0438\u0439 \u0434\u043B\u044F \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u044F
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u043F\u043E\u0435\u0437\u0434\u043E\u0432
      \u0434\u043B\u044F \u043D\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: "\u042F \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E
      \u0441\u0435\u0431\u044F \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
      \u0432 \u043F\u043E\u0435\u0437\u0434\u0435; \u0442\u0430\u043A\u043E\u0435
      \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435, \u0447\u0442\u043E \u043C\u0435\u043D\u044F
      \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0442 \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u044B,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0445\u043E\u0442\u044F\u0442 \u043C\u0435\u043D\u044F
      \u0441\u044A\u0435\u0441\u0442\u044C\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: "\u0414\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C \u043F\u043E\u0435\u0437\u0434,
      \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u044F\u0449\u0438\u0439 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 40
    m_Localized: "\u0423\u0436\u0430\u0441\u043D\u043E\u0435 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: "\u0423\u0435\u0437\u0436\u0430\u0439\u0442\u0435, \u043F\u043E\u043A\u0430
      \u0435\u0441\u0442\u044C \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: "\u0414\u0435\u0440\u0436\u0438\u0442\u0435\u0441\u044C \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435
      \u043E\u0442 \u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: "\u041C\u044B \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: "\u041F\u043E\u043A\u043E\u043D\u0447\u0438\u043C \u0441 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435\u043C
      \u0432 \u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445,
      \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u043C \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u0443
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u043D\u0430 \u0448\u0430\u0442\u0442\u043B\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: "\u0415\u0441\u043B\u0438 \u0432\u044B \u0447\u0442\u043E-\u0442\u043E
      \u0432\u0438\u0434\u0438\u0442\u0435, \u0441\u043A\u0430\u0436\u0438\u0442\u0435
      \u043E\u0431 \u044D\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: "\u0412 \u043C\u043E\u0451\u043C \u043F\u043E\u0435\u0437\u0434\u0435
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E \u043D\u0435-\u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u044B \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u0430
      \u0433\u0440\u0443\u0441\u0442\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 48
    m_Localized: "\u0412\u0430\u0448\u0430 \u0441\u0435\u043C\u044C\u044F \u0432
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: "\u042F \u0437\u043D\u0430\u044E \u043E \u0432\u0430\u0448\u0435\u043C
      \u0438\u0437\u043E\u043F\u043E\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: "\u0412\u0430\u043C \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0443\u0435\u0445\u0430\u0442\u044C
      \u0438\u0437 \u0433\u043E\u0440\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: "\u042F \u0441\u044A\u0435\u043B\u0430 \u0441\u0432\u043E\u0439
      \u043B\u0435\u0434\u0435\u043D\u0435\u0446 \u0432 \u043F\u043E\u0435\u0437\u0434\u0435,
      \u0438 \u043E\u043D \u043F\u0440\u043E\u043F\u0430\u043B\u2026 \u041A\u0443\u0434\u0430
      \u043E\u043D \u0434\u0435\u043B\u0441\u044F :("
    m_Metadata:
      m_Items: []
  - m_Id: 52
    m_Localized: "\u041C\u0430\u043C\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u0447\u0442\u043E \u0421\u044D\u043C\u044E\u044D\u043B \u2014 \u044D\u0442\u043E
      \u0442\u0430\u0440\u0434\u0438\u0433\u0440\u0430\u0434, \u0430 \u0432\u0430\u0448
      \u2014 \u0433\u043B\u0430\u0437\u043E\u043F\u043E\u0434!"
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: "\u041C\u0430\u043C\u0430 \u0441\u043A\u0430\u0437\u0430\u043B\u0430,
      \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u043E\u0442\u0432\u0435\u0437\u0442\u0438
      \u0421\u0430\u043C\u0435\u0443\u043B\u0430 \u043A \u0432\u0435\u0442\u0435\u0440\u0438\u043D\u0430\u0440\u0443
      \u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0434\u0430\u0432\u0430\u0442\u044C
      \u0435\u043C\u0443 \u043B\u0435\u0434\u0435\u043D\u0446\u044B. \u041C\u0438\u0441\u0442\u0435\u0440,
      \u044F \u043D\u0435 \u043E\u0431\u0438\u0434\u0435\u043B \u0421\u0430\u043C\u0435\u0443\u043B\u0430?
      \u041D\u043E \u044F \u0436\u0435 \u043B\u044E\u0431\u043B\u044E \u043B\u0435\u0434\u0435\u043D\u0446\u044B\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 54
    m_Localized: "\u041C\u0430\u043C\u0430 \u0441\u043D\u043E\u0432\u0430 \u043F\u043E\u0437\u0434\u043D\u043E
      \u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C \u0434\u043E\u043C\u043E\u0439\u2026
      \u043D\u043E \u0437\u0430\u0442\u043E \u043A\u0443\u043F\u0438\u043B\u0430
      \u043A\u0443\u0447\u0443 \u043B\u0435\u0434\u0435\u043D\u0446\u043E\u0432!
      \u042F \u0442\u0430\u043A \u043B\u044E\u0431\u043B\u044E \u0441\u0432\u043E\u044E
      \u043C\u0430\u043C\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 55
    m_Localized: "\u041C\u0430\u043C\u0430 \u0441\u043A\u0430\u0437\u0430\u043B\u0430,
      \u0447\u0442\u043E \u0448\u043A\u043E\u043B\u0430 \u043E\u0447\u0435\u043D\u044C
      \u0432\u0430\u0436\u043D\u0430, \u043D\u043E \u043C\u043D\u0435 \u043E\u043D\u0430
      \u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F! \u041C\u0438\u0441\u0442\u0435\u0440,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u044F \u0434\u043E\u043B\u0436\u0435\u043D
      \u0445\u043E\u0434\u0438\u0442\u044C \u0432 \u0448\u043A\u043E\u043B\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: "5 \u0437\u0432\u0451\u0437\u0434! \u041D\u0435\u0442, 6 \u0437\u0432\u0451\u0437\u0434!
      100 \u0437\u0432\u0451\u0437\u0434! 1 \u043C\u0438\u043B\u043B\u0438\u0430\u0440\u0434
      \u0437\u0432\u0451\u0437\u0434! \u0411\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u044C
      \u0437\u0432\u0451\u0437\u0434!"
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: "\u041C\u0438\u0441\u0442\u0435\u0440, \u043A\u043E\u0433\u0434\u0430
      \u0432\u044B \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435
      \u043E \u0441\u0435\u0431\u0435 \u0438 \u0441\u0432\u043E\u0435\u043C Eyesopod,
      \u043C\u0435\u043D\u044F \u044D\u0442\u043E \u0442\u0430\u043A \u0440\u0430\u0434\u0443\u0435\u0442.
      \u041D\u0435 \u043C\u043E\u0433\u043B\u0438 \u0431\u044B \u0432\u044B \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u0441\u043E \u043C\u043D\u043E\u0439 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 58
    m_Localized: "\u041C\u043D\u0435 \u043D\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043B\u0438
      \u0432\u0437\u044F\u0442\u044C \u043D\u0430 \u0431\u043E\u0440\u0442 \u0432\u0441\u0435
      \u043C\u043E\u0438 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F. 0 \u0437\u0432\u0435\u0437\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 59
    m_Localized: "\u0418\u043C \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u043F\u043E\u0435\u0437\u0434\u0430 \u0431\u043E\u043B\u0435\u0435 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u043C\u0438
      \u0434\u043B\u044F \u0440\u044B\u0431."
    m_Metadata:
      m_Items: []
  - m_Id: 60
    m_Localized: "\u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0434\u043E\u0436\u0434\u044C,
      \u0432\u043B\u0430\u0433\u0438 \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
      \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 61
    m_Localized: "\u0412\u043E\u0442 \u0430\u0434\u0440\u0435\u0441 \u043C\u043E\u0435\u0439
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u0430\u043A\u0446\u0438\u0438
      \u043F\u0440\u043E\u0442\u0435\u0441\u0442\u0430\u2026 \u0431\u0443\u0434\u044C\u0442\u0435
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B. \\n1823 \u0421\u044D\u043D\u0434\u0438
      \u0428\u043E\u0440 \u0414\u0440\u0430\u0439\u0432\u2026 \u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435
      \u0441 \u0441\u043E\u0431\u043E\u0439 \u0441\u043A\u043E\u0442\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 62
    m_Localized: "\u041F\u0430\u0440\u0435\u043D\u044C, \u044F \u0434\u043E\u043B\u0436\u0435\u043D
      \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u0442\u0435\u0431\u044F \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E \u0442\u044B
      \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B \u0431\u043E\u043B\u0442\u043E\u0432\u043D\u044E
      \u044D\u0442\u043E\u0433\u043E \u0441\u0442\u0430\u0440\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 63
    m_Localized: "\u0425\u043E\u0442\u0438\u0442\u0435 \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u0442\u044C
      \u0441\u0442\u0430\u0440\u0438\u043D\u043D\u044B\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B?
      \u0420\u0435\u0434\u043A\u043E \u043A\u0442\u043E, \u043A\u0430\u043A \u0432\u044B,
      \u0433\u043E\u0442\u043E\u0432 \u0441\u043B\u0443\u0448\u0430\u0442\u044C\u2026
      \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u0434\u0443\u0440\u0430\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 64
    m_Localized: "\u0425\u043E\u0442\u044F \u0441\u043E\u043E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u0438
      \u0443\u0436\u0435 \u043D\u0435 \u0438\u0434\u0443\u0442 \u043F\u043E \u0442\u043E\u043C\u0443
      \u0436\u0435 \u043F\u0443\u0442\u0438, \u0442\u0435\u0447\u0435\u043D\u0438\u044F
      \u0438 \u0437\u0435\u043C\u043B\u044F \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443
      \u0448\u0435\u043F\u0447\u0443\u0442 \u0441\u0432\u043E\u0438 \u0433\u043E\u043B\u043E\u0441\u0430,
      \u0437\u043E\u0432\u044F \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430
      \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439 \u0431\u0435\u0440\u0435\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 65
    m_Localized: "\u0412 \u0431\u044B\u043B\u044B\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0430
      \u043C\u044B \u0432\u044B\u043F\u043B\u044B\u0432\u0430\u043B\u0438 \u0438\u0437
      \u043A\u043E\u0433\u0442\u0435\u0439, \u0442\u044F\u043D\u0443\u0432\u0448\u0438\u0445\u0441\u044F
      \u0438\u0437 \u0431\u0435\u0437\u0434\u043D\u044B, \u0438 \u043F\u0430\u0441\u0442\u0435\u0439,
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B\u0445 \u043F\u043E\u0433\u043B\u043E\u0442\u0438\u0442\u044C
      \u043D\u0430\u0441 \u0446\u0435\u043B\u0438\u043A\u043E\u043C. \u0418 \u0432\u0441\u0451
      \u0436\u0435, \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u0441\u0432\u043E\u0438 \u0441\u043B\u043E\u0432\u0430. \u042D\u0442\u0438
      \u043A\u043E\u0433\u0442\u0438 \u0438 \u043F\u0430\u0441\u0442\u0438 \u0438\u0441\u0447\u0435\u0437\u043B\u0438
      \u0438\u0437 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u043C\u0438\u0440\u0430, \u043D\u043E \u043E\u043D\u0438 \u0432\u0441\u0451
      \u0435\u0449\u0451 \u0436\u0438\u0432\u0443\u0442 \u0432 \u043D\u0430\u0448\u0438\u0445
      \u0441\u0435\u0440\u0434\u0446\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 66
    m_Localized: "\u041A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0443\u043C\u0435\u0435\u0442
      \u0434\u0435\u043B\u0430\u0442\u044C \"\u043A\u0440\u0443\u0442\u043E\u0435
      \u0432\u0438\u043B\u043B\u0438\"? ...\u041A\u043E\u043D\u0435\u0447\u043D\u043E,
      \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u0443\u043C\u0435\u043B, \u043F\u0440\u043E\u0441\u0442\u043E
      \u0442\u0435\u043F\u0435\u0440\u044C \u044D\u0442\u043E \u0441\u0442\u0430\u0440\u044B\u0439
      \u0445\u0440\u044B\u0447 \u0441 \u0430\u0440\u0442\u0440\u0438\u0442\u043E\u043C,
      \u043F\u043E\u043D\u044F\u0442\u043D\u043E?!"
    m_Metadata:
      m_Items: []
  - m_Id: 67
    m_Localized: "\u041C\u043E\u0440\u0441\u043A\u0438\u0435 \u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D\u044B
      \u0438\u0441\u0447\u0435\u0437\u043B\u0438, \u043D\u043E \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u043D\u0438\u043C\u0438 \u043F\u0440\u043E\u043F\u0430\u043B\u0438
      \u0438 \u0441\u0430\u043C\u044B\u0435 \u0431\u043B\u0438\u0437\u043A\u0438\u0435
      \u0434\u0440\u0443\u0437\u044C\u044F\u2026 \u041A\u043E\u0440\u0430\u043B\u043B,
      \u041F\u0435\u0440\u043B, \u0424\u0438\u043D\u043D, \u0433\u0434\u0435 \u0432\u044B
      \u0432\u0441\u0435 \u0441\u0435\u0439\u0447\u0430\u0441?"
    m_Metadata:
      m_Items: []
  - m_Id: 68
    m_Localized: "\u041A \u0442\u043E\u043C\u0443 \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
      \u043A\u0430\u043A \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438 \u043F\u0435\u0449\u0435\u0440\u0443
      \u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D\u043E\u0432, \u043E\u0442
      \u043D\u0438\u0445 \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0438\u0441\u044C
      \u043B\u0438\u0448\u044C \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u044B.
      \u0415\u0441\u043B\u0438 \u0431\u044B \u0438\u0445 \u043D\u0435 \u0431\u0440\u043E\u0441\u0438\u043B\u0438
      \u0432 \u0442\u043E\u0442 \u0434\u0435\u043D\u044C\u2026 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
      \u0441\u0435\u0439\u0447\u0430\u0441 \u043E\u043D\u0438 \u043D\u0435 \u0431\u044B\u043B\u0438
      \u0431\u044B \u0442\u0430\u043A \u043E\u0434\u0438\u043D\u043E\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 69
    m_Localized: "\u041B\u0438\u0447\u043D\u043E \u044F \u0441\u0447\u0438\u0442\u0430\u044E,
      \u0447\u0442\u043E \u044D\u0442\u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0435
      \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0435
      \u0440\u0438\u0444\u044B \u043D\u0435 \u0442\u0430\u043A \u0443\u0436 \u0441\u0438\u043B\u044C\u043D\u043E
      \u043E\u0442\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F \u043E\u0442 \u043F\u0435\u0449\u0435\u0440
      \u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D\u043E\u0432. \u041F\u0440\u043E\u0441\u0442\u043E
      \u0432 \u0442\u0435\u043D\u0438 \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0445\u0438\u0449\u043D\u0438\u043A\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 70
    m_Localized: "\u041D\u0430\u0434\u043E \u0431\u044B\u043B\u043E \u0447\u0430\u0449\u0435
      \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0442\u044C \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0438
      \u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0438\u0445 \u0432\u044B\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F.
      \u041F\u0430\u0440\u0435\u043D\u044C, \u043D\u0435 \u0442\u0440\u0430\u0442\u044C
      \u0441\u0432\u043E\u044E \u0436\u0438\u0437\u043D\u044C \u0432\u043F\u0443\u0441\u0442\u0443\u044E
      \u0432 \u044D\u0442\u043E\u043C \u043A\u0438\u043E\u0441\u043A\u0435, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
      \u0440\u0430\u0434\u0438 \u043D\u0435\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0439
      \u0432\u043B\u0430\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 71
    m_Localized: "\u041C\u043E\u0438 \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F\u2026
      \u041F\u0435\u0440\u043B \u043F\u043E\u0434\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u043B\u0430
      \u0442\u0430\u043D\u0446\u043E\u0432\u0449\u0438\u0446\u0435\u0439 \u043D\u0430
      \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u043C \u0430\u0442\u043E\u043B\u043B\u0435,
      \u0430 \u041A\u043E\u0440\u0430\u043B \u0438\u0433\u0440\u0430\u043B\u0430
      \u043D\u0430 \u0442\u0440\u0443\u0431\u0430\u0445 \u0432 \u043C\u043E\u0440\u0441\u043A\u043E\u0439
      \u0441\u0438\u043C\u0444\u043E\u043D\u0438\u0438. \u0424\u0438\u043D\u043D
      \u0432 \u0441\u0432\u043E\u0438\u0445 \u0441\u0445\u0432\u0430\u0442\u043A\u0430\u0445
      \u043A\u043E\u0433\u0442\u044F\u043C\u0438 \u0431\u044B\u043B \u0432\u043D\u0435
      \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0446\u0438\u0438\u2026 \u043D\u043E
      \u043E\u043D \u0438 \u0435\u0433\u043E \u043F\u0435\u0441\u043E\u0447\u043D\u044B\u0435
      \u043A\u0430\u0440\u0442\u0438\u043D\u044B \u0431\u044B\u043B\u0438 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u0435\u0435.
      \u0411\u0435\u0440\u0435\u0433\u0438\u0442\u0435 \u0442\u0435\u0445, \u043A\u043E\u0433\u043E
      \u043B\u044E\u0431\u0438\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 72
    m_Localized: "\u042E\u043D\u043E\u0448\u0430, \u043D\u0435 \u043F\u043B\u0430\u0447\u044C
      \u043E\u0431\u043E \u043C\u043D\u0435. \u042D\u0442\u0430 \u0441\u0443\u0434\u044C\u0431\u0430
      \u0431\u044B\u043B\u0430 \u043C\u043D\u0435 \u0434\u0430\u0432\u043D\u043E
      \u043F\u0440\u0435\u0434\u043D\u0430\u0447\u0435\u0440\u0442\u0430\u043D\u0430,
      \u0438 \u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u043E\u043B\u0433\u043E
      \u043E\u0442 \u043D\u0435\u0451 \u0443\u0431\u0435\u0433\u0430\u043B. \u0412\u044B\u0441\u043B\u0443\u0448\u0430\u0432
      \u0438\u0441\u043F\u043E\u0432\u0435\u0434\u044C \u044D\u0442\u043E\u0433\u043E
      \u0433\u0440\u0435\u0448\u043D\u0438\u043A\u0430, \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C,
      \u0447\u0442\u043E \u044F \u0434\u043E\u043B\u0436\u0435\u043D \u0438\u0441\u043A\u0443\u043F\u0438\u0442\u044C
      \u0441\u0432\u043E\u0438 \u0433\u0440\u0435\u0445\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 73
    m_Localized: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0443\u0442\u0440\u043E\u043C
      \u044F \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F \u043E\u0442
      \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E\u0433\u043E \u0441\u043D\u0430.
      \u041D\u0435 \u0431\u044B\u043B\u043E \u0432\u044B\u0431\u0435\u043B\u0435\u043D\u043D\u044B\u0445
      \u043A\u043E\u0440\u0430\u043B\u043B\u043E\u0432, \u043D\u043E \u0431\u044B\u043B\u0438
      \u0441\u0442\u0430\u0440\u044B\u0435 \u0440\u0438\u0444\u044B \u0438 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0435
      \u043B\u0438\u0446\u0430, \u0437\u043E\u0432\u0443\u0449\u0438\u0435 \u043C\u0435\u043D\u044F.
      \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u044F \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044E\u0441\u044C
      \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439 \u0431\u0435\u0440\u0435\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 74
    m_Localized: "\u041F\u0440\u0438\u044F\u0442\u043D\u044B\u0439 \u043F\u0430\u0440\u0435\u043D\u044C,
      \u043D\u043E \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A\u0443\u043F\u0438\u0442\u044C \u043C\u043D\u0435 \u0431\u0430\u043D\u0442\u0438\u043A\u0438
      \u0432 \u0442\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 75
    m_Localized: "\u0412 \u043F\u043E\u0435\u0437\u0434\u0435 \u0431\u044B\u043B\u043E
      \u0442\u0430\u043A \u0448\u0443\u043C\u043D\u043E, \u0447\u0442\u043E \u044F
      \u043D\u0435 \u043C\u043E\u0433 \u0447\u0438\u0442\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 76
    m_Localized: "\u041C\u043D\u0435 \u0434\u0430\u0436\u0435 \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B\u0438,
      \u0447\u0442\u043E \u0443 \u043C\u0435\u043D\u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0442\u0438\u0445\u0438\u0439 \u0433\u043E\u043B\u043E\u0441, \u0438 \u044D\u0442\u043E
      \u0431\u044B\u043B\u043E \u0437\u0434\u043E\u0440\u043E\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 77
    m_Localized: "\u0417\u0430\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043C\u0430\u043B\u044B\u0448, \u043E\u0447\u0435\u043D\u044C \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
      \u043C\u043D\u0435 \u043C\u043E\u0438\u0445 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
      \u0434\u0435\u0442\u0435\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 78
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E \u043E\u0434\u0435\u0442\u044B,
      \u0432\u0435\u0436\u043B\u0438\u0432\u044B, \u0442\u0440\u0443\u0434\u043E\u043B\u044E\u0431\u0438\u0432\u044B\u2026
      \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043C\u043E\u0438 \u0434\u0435\u0442\u0438,
      \u043A\u043E\u0433\u0434\u0430 \u0432\u044B\u0440\u0430\u0441\u0442\u0443\u0442,
      \u0441\u0442\u0430\u043D\u0443\u0442 \u0442\u0430\u043A\u0438\u043C\u0438 \u0436\u0435,
      \u043A\u0430\u043A \u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 79
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E\u0435 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435,
      \u0442\u043E\u043B\u044C\u043A\u043E\u2026 \u0446\u0435\u043D\u044B \u043D\u0430
      \u0431\u0438\u043B\u0435\u0442\u044B \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0437\u0430\u0432\u044B\u0448\u0435\u043D\u044B. \u041D\u0435 \u043C\u043E\u0433\u043B\u0438
      \u0431\u044B \u0432\u044B \u043E\u0431\u0440\u0430\u0442\u0438\u0442\u044C\u0441\u044F
      \u043A \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u0443 \u0441
      \u043F\u0440\u043E\u0441\u044C\u0431\u043E\u0439 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0441\u043D\u0438\u0437\u0438\u0442\u044C \u0446\u0435\u043D\u044B \u043D\u0430
      \u0431\u0438\u043B\u0435\u0442\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 80
    m_Localized: "\u0427\u0435\u0441\u0442\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u044F,
      \u043C\u043E\u0439 \u043C\u0443\u0436 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u0442\u044B
      \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0440\u0435\u0431\u0435\u043D\u043E\u043A,
      \u043A\u043E\u0433\u0434\u0430 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0434\u043E\u043C\u043E\u0439. \u041C\u043E\u0436\u0435\u0448\u044C \u043D\u0430\u043C\u0435\u043A\u043D\u0443\u0442\u044C
      \u0435\u043C\u0443, \u0447\u0442\u043E\u0431\u044B \u043E\u043D \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u043B
      \u043F\u043E\u043C\u0435\u043D\u044C\u0448\u0435 \u0446\u0432\u0435\u0442\u043E\u0432?
      \u042F \u043E\u0447\u0435\u043D\u044C \u043B\u044E\u0431\u043B\u044E \u0435\u0433\u043E
      \u0431\u043E\u043B\u044C\u0448\u043E\u0435, \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0433\u043B\u0443\u043F\u043E\u0432\u0430\u0442\u043E\u0435 \u0441\u0435\u0440\u0434\u0446\u0435,
      \u043D\u043E \u0434\u043E\u043C\u0430 \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435\u0442 \u043C\u0435\u0441\u0442\u0430 \u0434\u043B\u044F \u0446\u0432\u0435\u0442\u043E\u0432!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 81
    m_Localized: "\u0410 \u043A\u0430\u043A \u043D\u0430\u0441\u0447\u0451\u0442
      \u0432\u043E\u0442 \u044D\u0442\u043E\u0433\u043E\u2026 \u043A\u0430\u043A
      \u0432\u043E\u0434\u043E\u0440\u043E\u0441\u043B\u0438 \u043E\u0442\u0432\u0435\u0447\u0430\u044E\u0442
      \u043D\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u043D\u044B\u0435 \u0437\u0432\u043E\u043D\u043A\u0438?
      \xAB\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435,
      \u0447\u0435\u043C \u044F \u043C\u043E\u0433\u0443 \u0432\u0430\u043C \u043F\u043E\u043C\u043E\u0447\u044C?\xBB
      \u0425\u0430-\u0445\u0430! \u0421\u043C\u0435\u0448\u043D\u043E, \u043F\u0440\u0430\u0432\u0434\u0430?
      (\u041F\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u043C\u043D\u0435
      5 \u0437\u0432\u0451\u0437\u0434 \u0437\u0430 \u044D\u0442\u0443 \u0448\u0443\u0442\u043A\u0443,
      \u0438 \u044F \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u044E \u0432\u0430\u043C
      5 \u0437\u0432\u0451\u0437\u0434 \u043D\u0430 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435
      \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432)"
    m_Metadata:
      m_Items: []
  - m_Id: 82
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0440\u0430\u0437 \u0443\u0432\u0438\u0434\u0438\u0442\u0435 \u0434\u0435\u0434\u0443\u0448\u043A\u0443,
      \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0443\u0441\u0430\u0434\u0438\u0442\u0435
      \u0435\u0433\u043E \u043F\u043E\u0443\u0434\u043E\u0431\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 83
    m_Localized: "\u0421\u043B\u0443\u0448\u0430\u0435\u0442, \u043D\u043E \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u043D\u0430
      \u043C\u043E\u0438 \u0432\u043E\u043F\u0440\u043E\u0441\u044B. \u041C\u043E\u0433
      \u0431\u044B \u0431\u044B\u0442\u044C \u0432\u0435\u0436\u043B\u0438\u0432\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 84
    m_Localized: "\u041E\u0447\u0435\u043D\u044C \u0441\u0438\u043C\u043F\u0430\u0442\u0438\u0447\u043D\u044B\u0439,
      \u043D\u043E \u043D\u0435 \u0441\u0442\u0430\u043D\u0435\u0442 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0442\u044C\u0441\u044F
      \u0441 \u043C\u043E\u0435\u0439 \u0432\u043D\u0443\u0447\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 85
    m_Localized: "\u041D\u043E\u0441\u0438\u0442 \u043E\u0434\u043D\u043E \u0438
      \u0442\u043E \u0436\u0435 \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C,
      \u043F\u043E\u0440\u0430 \u043A\u0443\u043F\u0438\u0442\u044C \u043D\u043E\u0432\u0443\u044E
      \u043E\u0434\u0435\u0436\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 86
    m_Localized: "\u041D\u0435 \u043F\u043E\u043C\u0435\u0448\u0430\u043B \u0431\u044B
      \u043D\u043E\u0432\u044B\u0439 \u043D\u0430\u0433\u0440\u0443\u0434\u043D\u044B\u0439
      \u043F\u043B\u0430\u0442\u043E\u043A, \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u044B\u043B\u044C\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 87
    m_Localized: "\u041A\u0440\u0435\u043F\u043A\u043E\u0435 \u0440\u0443\u043A\u043E\u043F\u043E\u0436\u0430\u0442\u0438\u0435,
      \u0441\u0438\u043C\u043F\u0430\u0442\u0438\u0447\u043D\u044B\u0439 \u043C\u043E\u043B\u043E\u0434\u043E\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 88
    m_Localized: "\u0412\u0441\u0435\u0433\u0434\u0430 \u043C\u0435\u043D\u044F \u0441\u043B\u0443\u0448\u0430\u0435\u0442.
