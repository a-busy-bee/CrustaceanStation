%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Feedback_Strings_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 1cc745f6ad70042ac8edf889829c2b48, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: Eiben-Suk
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: 0 Sterne haben mich in den falschen Zug geschickt.
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: Du solltest dich rasieren
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "Du sahst heute s\xFC\xDF aus... Ruf mich an, wenn du eine Pause
      vom Zugfahren brauchst (800) 8135"
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: xoxo
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "Tr\xE4gst du jeden Tag dasselbe?"
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "0 Sterne, ich musste f\xFCr meine 20 Milliarden Kinder einzeln
      bezahlen."
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "Ich w\xFCnschte, Sie w\xFCrden etwas mehr tun, als nur mein Ticket
      abzustempeln."
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: Ich habe mein Foto viel zu lange angeschaut.
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "Haben Sie Kinder... w\xFCrden Sie meine adoptieren...?"
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "Irref\xFChrende Werbung, du bist nicht so robust, wie sie behaupten."
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "Ich mag \xE4ltere M\xE4nner ;)"
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "H\xE4ttest du Lust, in mein Nebengewerbe zu investieren? Wir k\xF6nnten
      zusammen richtig viel Geld verdienen ;)"
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "Kaufen Sie jetzt ShellCoin und erhalten Sie in den n\xE4chsten
      5 Jahren 110 % zur\xFCck!"
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "Kaufen Sie jetzt ClawCoin und erhalten Sie 68 % innerhalb der n\xE4chsten
      2 Jahre zur\xFCck!"
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "Sie haben offene Schulden in H\xF6he von 75.600 US-Dollar. Bitte
      rufen Sie unter (800) 5201 an, um eine L\xF6sung zu finden."
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: Warum hast du mit mir Schluss gemacht? Das kannst du mir nicht antun!!!
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "0 Sterne f\xFCr den Service, aber 5 Sterne f\xFCr die Visitenkarte."
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: Optisch 0 Sterne, aber der Service 5 Sterne.
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "Ich bin gekommen, um mir den legend\xE4ren, attraktiven Manager
      anzusehen, von dem alle reden, aber ehrlich gesagt bist du nicht wirklich beeindruckend."
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: "Ich bin gekommen, um mir den legend\xE4ren, hei\xDFen Manager anzusehen,
      von dem alle reden. Du bist\u2026ganz okay. Lust, mit mir auszugehen?"
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: AHHHHHH ICH KANN ES NICHT GLAUBEN, ICH HABE HEUTE MEIN IDOL GETROFFEN!
      ER HAT SOGAR SELBST MEIN TICKET AUSGEDRUCKT! AAAAAAA
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: "Triff niemals deine Idole, Mann, du warst so entt\xE4uschend."
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "W\xE4re es komisch, wenn ich sagen w\xFCrde, dass ich letzte Nacht
      von dir getr\xE4umt habe?"
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: "Oh\u2026 mein Erl\xF6ser, das wahre Licht meines Lebens\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: "Die Sitze in dem Zug, mit dem ich heute gefahren bin, waren wirklich
      schmutzig. Vielleicht k\xF6nntet ihr mehr Reinigungskr\xE4fte einstellen?"
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: "Der Shuttlebus, mit dem ich heute gefahren bin, hatte wirklich
      schmutzige Fenster. Ihr solltet regelm\xE4\xDFiger putzen?"
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "Super Service, ich w\xFCrde wieder mitfahren! :D"
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: Der Verpflegungsservice war hervorragend, das Deluxe-Ticket war
      den Preis absolut wert!
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: Die Zugbegleiter waren so hilfsbereit und freundlich, sie haben
      meinem Sohn sogar einen kostenlosen Lutscher gegeben, als er seinen verloren
      hatte! Ich bin ihnen unendlich dankbar!
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: Super nett und hilfsbereit! Hat mir geholfen, den richtigen Zug
      zu finden, als ich mich verfahren hatte!
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: helfen
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: Sie kommen
    m_Metadata:
      m_Items: []
  - m_Id: 34
    m_Localized: "Eines Tages wirst du den Preis f\xFCr das bezahlen, was du meiner
      Familie angetan hast."
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: "Fischst\xE4bchen und Hummerbr\xF6tchen"
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: "Als regelm\xE4\xDFiger Pendler bin ich wirklich entt\xE4uscht,
      dass Sie immer wieder V\xF6gel in den Zug lassen. Ich werde mich bei der Konzernzentrale
      beschweren, wenn Sie keine Ma\xDFnahmen ergreifen, um die Z\xFCge f\xFCr uns
      alle sicherer zu machen."
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: "Als regelm\xE4\xDFiger Pendler bin ich wirklich entt\xE4uscht,
      dass Sie immer wieder Seel\xF6wen in den Zug lassen. Ich werde mich bei der
      Konzernzentrale beschweren, wenn Sie nichts unternehmen, um die Z\xFCge f\xFCr
      uns sicherer zu machen."
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: "Ich f\xFChle mich im Zug nicht mehr sicher; es kommt mir vor, als
      w\xE4re ich von Fahrg\xE4sten umgeben, die mich fressen wollen\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: "Es sollte einen Zug geben, der nur Krustentiere bef\xF6rdert."
    m_Metadata:
      m_Items: []
  - m_Id: 40
    m_Localized: Schrecklicher Service.
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: "Raus hier, solange ihr noch k\xF6nnt!"
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: Halten Sie sich von Krustentierkonzernen fern.
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: Wir beobachten immer.
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: "Stoppt die Krustentierifizierung, h\xF6rt auf, Leute hin und her
      zu transportieren"
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: Wenn Sie etwas sehen, sagen Sie etwas.
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: Zu viele Nicht-Krebstiere in meinem Zug
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: Du sahst heute traurig aus.
    m_Metadata:
      m_Items: []
  - m_Id: 48
    m_Localized: Deine Familie ist nicht sicher
    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: Ich kenne deine Assel.
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: Du solltest die Stadt verlassen.
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: "Ich habe meinen Lutscher im Zug gegessen und er ist verschwunden\u2026
      wo ist er nur hin? :("
    m_Metadata:
      m_Items: []
  - m_Id: 52
    m_Localized: "Mama sagt, Samuel sei ein Sp\xE4tz\xFCnder, und du seist ein Langweiler!"
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: "Mama sagte, sie m\xFCsse Samuel zum Tierarzt bringen und ich solle
      ihm keine Lollis mehr geben. Herr, habe ich Samuel wehgetan? Aber ich liebe
      Lollis\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 54
    m_Localized: "Mama kam wieder sp\xE4t nach Hause\u2026 aber sie hat tonnenweise
      Lollis gekauft! Ich liebe meine Mama so sehr"
    m_Metadata:
      m_Items: []
  - m_Id: 55
    m_Localized: Mama sagt, Schule sei total wichtig, aber ich mag sie nicht! Herr,
      warum muss ich zur Schule gehen?
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: 5 Sterne! Nein, 6 Sterne! 100 Sterne! Eine Milliarde Sterne! Unendlich
      viele Sterne!
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: "Mein Herr, wenn Sie von sich und Ihrem Eyesopod erz\xE4hlen, freut
      mich das sehr. Wollen Sie sich noch \xF6fter mit mir unterhalten?"
    m_Metadata:
      m_Items: []
  - m_Id: 58
    m_Localized: Ich durfte nicht alle meine Pflanzen mit an Bord nehmen. 0 Sterne.
    m_Metadata:
      m_Items: []
  - m_Id: 59
    m_Localized: "Die Z\xFCge sollten fischfreundlicher gestaltet werden."
    m_Metadata:
      m_Items: []
  - m_Id: 60
    m_Localized: Nicht nass genug, obwohl es geregnet hat.
    m_Metadata:
      m_Items: []
  - m_Id: 61
    m_Localized: "Hier ist die Adresse f\xFCr meine n\xE4chste Demonstration\u2026
      seid diskret. 1823 Sandy Shore Drive\u2026 Bringt Klebeband mit."
    m_Metadata:
      m_Items: []
  - m_Id: 62
    m_Localized: "Mein Lieber, ich muss dir danken, dass du dir die Ausf\xFChrungen
      dieser alten Seele angeh\xF6rt hast."
    m_Metadata:
      m_Items: []
  - m_Id: 63
    m_Localized: "M\xF6chtest du alte Geschichten h\xF6ren? Es ist selten, dass jemand
      wie du bereit ist, einem alten Narren zuzuh\xF6ren."
    m_Metadata:
      m_Items: []
  - m_Id: 64
    m_Localized: "Auch wenn die Landsleute nicht mehr denselben Weg gehen, fl\xFCstern
      die Str\xF6mungen und der Boden noch immer ihre Stimmen, w\xE4hrend sie einen
      ans andere Ufer rufen."
    m_Metadata:
      m_Items: []
  - m_Id: 65
    m_Localized: "In l\xE4ngst vergangenen Zeiten schwammen wir vor Klauen, die sich
      aus dem Abgrund streckten, und vor M\xE4ulern, die uns verschlingen konnten.
      Doch man muss seine Worte korrigieren. Diese Klauen und M\xE4uler sind aus
      der greifbaren Welt verschwunden, aber sie leben noch immer in unseren Herzen."
    m_Metadata:
      m_Items: []
  - m_Id: 66
    m_Localized: "Wei\xDF einer von euch, wie man einen \u201Ekrassen Wheelie\u201C
      macht? \u2026Nat\xFCrlich konnte man das mal, aber jetzt ist man halt ein alter
      Knacker mit Arthritis, okay?!?!"
    m_Metadata:
      m_Items: []
  - m_Id: 67
    m_Localized: "Die Seeskorpione sind verschwunden, aber auch die engsten Gef\xE4hrten\u2026
      Coral, Pearl, Finn, wo seid ihr alle jetzt?"
    m_Metadata:
      m_Items: []
  - m_Id: 68
    m_Localized: "Als man die Skorpionh\xF6hle fand, waren nur noch ihre Exoskelette
      \xFCbrig. H\xE4tte man sie an jenem Tag nicht zur\xFCckgelassen \u2026 w\xE4re
      man jetzt vielleicht nicht so allein."
    m_Metadata:
      m_Items: []
  - m_Id: 69
    m_Localized: "Ich pers\xF6nlich glaube, dass diese kalten, gesch\xE4ftigen Konzernriffe
      gar nicht so anders sind als jene Skorpionh\xF6hlen. Nur dass dort ein anderer
      R\xE4uber im Verborgenen lauert\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 70
    m_Localized: "Er h\xE4tte \xF6fter das Training schw\xE4nzen und sich stattdessen
      seine Leistungen ansehen sollen. Junger Bursche, verschwende dein Leben nicht
      an diesem Kiosk, schon gar nicht f\xFCr eine so undankbare Macht."
    m_Metadata:
      m_Items: []
  - m_Id: 71
    m_Localized: "Meine Erinnerungen\u2026 Pearl tanzte nebenbei auf dem nahegelegenen
      Atoll, und Coral spielte R\xF6hren in der Meeressinfonie. Finns Klauenk\xE4mpfe
      waren un\xFCbertroffen\u2026 aber er und seine Sandmalereien waren noch sch\xF6ner.
      Bewahrt die Menschen, die ihr liebt, in Ehren."
    m_Metadata:
      m_Items: []
  - m_Id: 72
    m_Localized: "Junger Mann, weine nicht um mich. Dies war ein Schicksal, das mir
      l\xE4ngst vorherbestimmt war und vor dem ich viel zu lange geflohen bin. Da
      du die Beichte dieses S\xFCnders geh\xF6rt hast, wei\xDFt du, dass ich f\xFCr
      meine S\xFCnden b\xFC\xDFen muss."
    m_Metadata:
      m_Items: []
  - m_Id: 73
    m_Localized: "Ich bin heute Morgen aus einem wundersch\xF6nen Traum erwacht.
      Keine gebleichten Korallen, sondern alte Riffe und vertraute Gesichter riefen
      mich. Deshalb werde ich zum anderen Ufer aufbrechen."
    m_Metadata:
      m_Items: []
  - m_Id: 74
    m_Localized: Netter Kerl, aber er weigert sich, mit mir passende Schleifen zu
      kaufen.
    m_Metadata:
      m_Items: []
  - m_Id: 75
    m_Localized: Der Zug war zu laut, ich konnte nicht lesen.
    m_Metadata:
      m_Items: []
  - m_Id: 76
    m_Localized: Er hat mir nicht gesagt, dass meine Stimme zu leise sei, was super
      war.
    m_Metadata:
      m_Items: []
  - m_Id: 77
    m_Localized: Ein toller Junge, erinnert mich sehr an meine eigenen Kinder!
    m_Metadata:
      m_Items: []
  - m_Id: 78
    m_Localized: "Gut gekleidet, h\xF6flich, flei\xDFig\u2026 Ich hoffe, meine Kinder
      werden einmal so wie du."
    m_Metadata:
      m_Items: []
  - m_Id: 79
    m_Localized: "Der Service ist super, nur\u2026 die Ticketpreise sind etwas hoch.
      K\xF6nnten Sie vielleicht bei der Gesch\xE4ftsleitung nachfragen, ob man die
      Preise etwas senken k\xF6nnte?"
    m_Metadata:
      m_Items: []
  - m_Id: 80
    m_Localized: "Ehrlich gesagt, mein Mann schw\xE4rmt immer wieder von dir, wenn
      er nach Hause kommt. K\xF6nntest du ihm vielleicht einen kleinen Tipp geben,
      weniger Blumen mitzubringen? Ich mag ihn ja wirklich sehr, aber wir haben einfach
      keinen Platz mehr daf\xFCr!"
    m_Metadata:
      m_Items: []
  - m_Id: 81
    m_Localized: "Wie w\xE4re es damit\u2026 wie geht Seetang ans Telefon? \u201EHallo,
      wie kann ich Ihnen helfen?\u201C Haha! Lustig, oder? (Geben Sie diesem Witz
      5 Sterne und ich gebe Ihnen 5 Sterne f\xFCr die Kundenservice-Plattform.)"
    m_Metadata:
      m_Items: []
  - m_Id: 82
    m_Localized: "Wenn du Opa das n\xE4chste Mal siehst, kannst du ihm bitte einen
      guten Platz zuweisen?"
    m_Metadata:
      m_Items: []
  - m_Id: 83
    m_Localized: "Er h\xF6rt zwar zu, beantwortet aber nie meine Fragen. Er k\xF6nnte
      h\xF6flicher sein."
    m_Metadata:
      m_Items: []
  - m_Id: 84
    m_Localized: "Sehr gutaussehend, aber er w\xFCrde meine Enkelin nicht daten."
    m_Metadata:
      m_Items: []
  - m_Id: 85
    m_Localized: "Tr\xE4gt jeden Tag dasselbe, sollte sich mal neue Kleidung zulegen."
    m_Metadata:
      m_Items: []
  - m_Id: 86
    m_Localized: "K\xF6nnte ein neues Einstecktuch gebrauchen, sieht etwas staubig
      aus."
    m_Metadata:
      m_Items: []
  - m_Id: 87
    m_Localized: "Ein fester H\xE4ndedruck, ein gutaussehender junger Mann."
    m_Metadata:
      m_Items: []
  - m_Id: 88
    m_Localized: "Er h\xF6rt mir immer zu. Ich liebe diesen Kerl."
    m_Metadata:
      m_Items: []
  - m_Id: 89
    m_Localized: "Falls Sie jemals einen besonderen Rat ben\xF6tigen, hier ist meine
      Nummer. Ich habe jede Menge davon. 921-8564"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
