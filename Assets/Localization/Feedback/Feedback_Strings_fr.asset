%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Feedback_Strings_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 1cc745f6ad70042ac8edf889829c2b48, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: l'if suk
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "0 \xE9toile m'a envoy\xE9 dans le mauvais train"
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: Tu devrais te raser
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "Tu \xE9tais mignonne aujourd'hui... appelle-moi si tu veux faire
      une pause dans les trains (800) 8135"
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: Bisous bisous
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "Portez-vous la m\xEAme chose tous les jours ?"
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "0 \xE9toile, on m'a fait payer individuellement pour mes 20 milliards
      d'enfants"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "J'aurais souhait\xE9 que vous fassiez un peu plus que tamponner
      mon billet."
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "J'ai pass\xE9 beaucoup trop de temps \xE0 v\xE9rifier ma photo"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "Avez-vous des enfants\u2026 adopteriez-vous les miens\u2026 ?"
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "Publicit\xE9 mensong\xE8re, vous n'\xEAtes pas aussi robustes qu'ils
      le pr\xE9tendent."
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "Je pr\xE9f\xE8re les hommes plus \xE2g\xE9s ;)"
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "Envie d'investir dans mon activit\xE9 secondaire ? On pourrait
      gagner beaucoup d'argent ensemble ;)"
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "Achetez ShellCoin maintenant et r\xE9cup\xE9rez 110 % de votre
      investissement dans les 5 prochaines ann\xE9es !"
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "Achetez ClawCoin maintenant et r\xE9cup\xE9rez 68 % de votre investissement
      dans les 2 prochaines ann\xE9es !"
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "Vous avez une dette impay\xE9e de 75\_600\_$. Veuillez appeler
      le (800) 5201 pour trouver une solution."
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "Pourquoi m'as-tu quitt\xE9(e) ? Tu ne peux pas me faire \xE7a !!!"
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "Service 0 \xE9toile, mais carte de visite 5 \xE9toiles."
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "Apparence \xE0 0 \xE9toile, service \xE0 5 \xE9toiles par contre"
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "Je suis venu voir le manager canon l\xE9gendaire dont tout le monde
      parle, mais franchement, tu n'es pas si impressionnant que \xE7a."
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: "Je suis venu voir le manager canon dont tout le monde parle. T'es\u2026
      plut\xF4t pas mal. \xC7a te dirait de sortir\_?"
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: "AHHHHHH JE N'ARRIVE PAS \xC0 CROIRE QUE J'AI RENCONTR\xC9 MON IDOLE
      AUJOURD'HUI IL A M\xCAME PERFOR\xC9 MON BILLET LUI-M\xCAME AAAAAAA"
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: "Ne rencontre jamais tes idoles, mec, tu as \xE9t\xE9 tellement
      d\xE9cevant."
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "Serait-ce bizarre si je te disais que j'ai r\xEAv\xE9 de toi la
      nuit derni\xE8re ?"
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: "Oh\u2026 mon sauveur, la v\xE9ritable lumi\xE8re de ma vie\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: "Les si\xE8ges du train que j'ai pris aujourd'hui \xE9taient vraiment
      sales, peut-\xEAtre pourriez-vous embaucher plus de personnel de nettoyage
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: "La navette que j'ai prise aujourd'hui avait les vitres vraiment
      sales, vous devriez les nettoyer plus r\xE9guli\xE8rement ?"
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "Service impeccable, je referai l'exp\xE9rience ! :D"
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: Service de restauration exceptionnel, le billet de luxe valait vraiment
      son prix !
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: "Les agents de bord \xE9taient tellement serviables et gentils\_!
      Ils ont m\xEAme offert une sucette \xE0 mon fils quand il a perdu la sienne\_!
      Je ne les remercierai jamais assez\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: "Super gentil et serviable ! Il m'a aid\xE9 \xE0 trouver le bon
      train quand j'\xE9tais perdu !"
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: aide
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: Ils arrivent
    m_Metadata:
      m_Items: []
  - m_Id: 34
    m_Localized: "Un jour, je te ferai payer pour ce que tu as fait \xE0 ma famille."
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: "b\xE2tonnets de poisson et rouleaux de homard"
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: "En tant qu'usager r\xE9gulier des transports en commun, je suis
      vraiment d\xE9\xE7u de voir que vous laissez monter des oiseaux dans le train.
      Je d\xE9poserai une plainte aupr\xE8s de la direction si vous ne prenez pas
      de mesures pour am\xE9liorer la s\xE9curit\xE9 des passagers."
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: "En tant qu'usager r\xE9gulier des transports en commun, je suis
      vraiment d\xE9\xE7u de voir que vous laissez monter des otaries dans le train.
      Je d\xE9poserai une plainte aupr\xE8s de la direction si vous ne prenez pas
      de mesures pour am\xE9liorer la s\xE9curit\xE9 des passagers."
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: "Je ne me sens plus en s\xE9curit\xE9 dans le train ; j\u2019ai
      l\u2019impression d\u2019\xEAtre entour\xE9e de passagers qui veulent me d\xE9vorer\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: "Il faudrait un train r\xE9serv\xE9 aux crustac\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 40
    m_Localized: "Service d\xE9plorable."
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: Partez tant que vous le pouvez !
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: "\xC9vitez les corps crustac\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: Nous surveillons constamment.
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: "Mettez fin \xE0 la crustac\xE9isation, arr\xEAtez la navette"
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: Si vous voyez quelque chose, signalez-le.
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: "Trop de non-crustac\xE9s dans mon train"
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: Tu avais l'air triste aujourd'hui
    m_Metadata:
      m_Items: []
  - m_Id: 48
    m_Localized: "Votre famille n'est pas en s\xE9curit\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: Je connais votre isopode.
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: Vous devriez quitter la ville
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: "J'ai mang\xE9 ma sucette dans le train et elle a disparu\u2026
      o\xF9 est-elle pass\xE9e\_? :("
    m_Metadata:
      m_Items: []
  - m_Id: 52
    m_Localized: Maman dit que Samuel est un retardataire, et le tien un eyesopod
      !
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: "Maman a dit qu'elle devait emmener Samuel chez le v\xE9t\xE9rinaire
      et qu'il ne fallait plus lui donner de sucettes. Monsieur, ai-je fait du mal
      \xE0 Samuel\_? Mais j'adore les sucettes\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 54
    m_Localized: "Maman est rentr\xE9e tard encore une fois\u2026 mais elle a achet\xE9
      des tonnes de sucettes ! J'aime tellement ma maman"
    m_Metadata:
      m_Items: []
  - m_Id: 55
    m_Localized: "Maman dit que l'\xE9cole est vraiment importante, mais je n'aime
      pas \xE7a ! Monsieur, pourquoi dois-je aller \xE0 l'\xE9cole ?"
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: "5 \xE9toiles ! Non, 6 \xE9toiles ! 100 \xE9toiles ! 1 milliard
      d'\xE9toiles ! Des \xE9toiles \xE0 l'infini !"
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: "Monsieur, quand vous parlez de vous et de votre eye-pod, cela me
      rend tellement heureuse. Voulez-vous me parler davantage\_?"
    m_Metadata:
      m_Items: []
  - m_Id: 58
    m_Localized: "Je n'ai pas pu emporter toutes mes plantes \xE0 bord. 0 \xE9toile."
    m_Metadata:
      m_Items: []
  - m_Id: 59
    m_Localized: Ils devraient rendre les trains plus respectueux des poissons.
    m_Metadata:
      m_Items: []
  - m_Id: 60
    m_Localized: "Pas assez mouill\xE9 malgr\xE9 la pluie."
    m_Metadata:
      m_Items: []
  - m_Id: 61
    m_Localized: "Voici l'adresse de ma prochaine manifestation\u2026 soyez discrets.
      1823 Sandy Shore Drive\u2026 Apportez du ruban adh\xE9sif."
    m_Metadata:
      m_Items: []
  - m_Id: 62
    m_Localized: "Mon gar\xE7on, je dois te remercier d'avoir \xE9cout\xE9 les divagations
      de cette vieille \xE2me."
    m_Metadata:
      m_Items: []
  - m_Id: 63
    m_Localized: "Aimeriez-vous entendre des contes d'antan\_? Il est rare qu'une
      personne comme vous soit dispos\xE9e \xE0 \xE9couter\u2026 un vieux fou."
    m_Metadata:
      m_Items: []
  - m_Id: 64
    m_Localized: "M\xEAme si ses compatriotes ne suivent plus le m\xEAme chemin,
      les courants et la terre murmurent encore leurs voix, appelant celui qui les
      accompagne sur l'autre rive."
    m_Metadata:
      m_Items: []
  - m_Id: 65
    m_Localized: "Jadis, nous \xE9chappions \xE0 des griffes surgies des abysses
      et \xE0 des gueules qui pouvaient nous engloutir tout entiers. Pourtant, il
      convient de nuancer ses propos. Ces griffes et ces gueules ont disparu du monde
      tangible, mais elles demeurent en nous."
    m_Metadata:
      m_Items: []
  - m_Id: 66
    m_Localized: "Est-ce que quelqu'un sait faire un \xAB wheeling de malade \xBB
      ? \u2026Bien s\xFBr que si, avant, je ne suis plus qu'un vieux schnock avec
      de l'arthrite, d'accord ?!"
    m_Metadata:
      m_Items: []
  - m_Id: 67
    m_Localized: "Les scorpions de mer ont disparu, mais nos plus proches compagnons
      aussi\u2026 Coral, Pearl, Finn, o\xF9 \xEAtes-vous maintenant\_?"
    m_Metadata:
      m_Items: []
  - m_Id: 68
    m_Localized: "Quand on a enfin trouv\xE9 la grotte aux scorpions, il ne restait
      plus que leurs exuvies. Si on ne les avait pas abandonn\xE9s ce jour-l\xE0\u2026
      peut-\xEAtre qu\u2019on ne serait pas aussi seul aujourd\u2019hui."
    m_Metadata:
      m_Items: []
  - m_Id: 69
    m_Localized: "Personnellement, je pense que ces r\xE9cifs froids des grandes
      entreprises ne sont pas si diff\xE9rents de ces grottes aux scorpions. C'est
      juste qu'un autre pr\xE9dateur r\xF4de dans l'ombre\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 70
    m_Localized: "Il aurait fallu s\xE9cher les entra\xEEnements plus souvent et
      observer leurs performances. Jeune homme, ne g\xE2che pas ta vie \xE0 ce kiosque,
      surtout pour une autorit\xE9 ingrate."
    m_Metadata:
      m_Items: []
  - m_Id: 71
    m_Localized: "Mes souvenirs\u2026 Pearl dansait pour arrondir ses fins de mois
      sur l\u2019atoll voisin, et Coral jouait de la trompette dans l\u2019orchestre
      marin. Finn \xE9tait imbattable au combat\u2026 mais lui et ses peintures de
      sable \xE9taient bien plus beaux. Ch\xE9rissez ceux que vous aimez."
    m_Metadata:
      m_Items: []
  - m_Id: 72
    m_Localized: "Jeune homme, ne pleure pas pour moi. C'\xE9tait un destin qui m'\xE9tait
      destin\xE9 depuis longtemps et que j'ai longtemps fui. Puisque tu as entendu
      les confessions de ce p\xE9cheur, tu sais que je dois expier mes fautes."
    m_Metadata:
      m_Items: []
  - m_Id: 73
    m_Localized: "Ce matin, je me suis r\xE9veill\xE9 d'un magnifique r\xEAve. Point
      de coraux blanchis, mais de vieux r\xE9cifs et des visages familiers qui m'appelaient.
      Je partirai donc pour l'autre rive."
    m_Metadata:
      m_Items: []
  - m_Id: 74
    m_Localized: "Sympa, mais il refuse d'acheter des n\u0153uds papillon assortis
      avec moi."
    m_Metadata:
      m_Items: []
  - m_Id: 75
    m_Localized: "Le train \xE9tait tellement bruyant que je ne pouvais pas lire."
    m_Metadata:
      m_Items: []
  - m_Id: 76
    m_Localized: "On ne m'a pas dit que ma voix \xE9tait trop faible, ce qui \xE9tait
      super."
    m_Metadata:
      m_Items: []
  - m_Id: 77
    m_Localized: Quel enfant formidable, il me rappelle beaucoup mes propres enfants
      !
    m_Metadata:
      m_Items: []
  - m_Id: 78
    m_Localized: "Bien habill\xE9, poli, travailleur\u2026 J\u2019esp\xE8re que mes
      enfants deviendront comme vous quand ils seront grands."
    m_Metadata:
      m_Items: []
  - m_Id: 79
    m_Localized: "Service impeccable, mais\u2026 les prix des billets sont un peu
      \xE9lev\xE9s. Ne pourriez-vous pas en parler \xE0 la direction pour qu'ils
      baissent l\xE9g\xE8rement le prix\_?"
    m_Metadata:
      m_Items: []
  - m_Id: 80
    m_Localized: "Franchement, mon mari n'arr\xEAte pas de dire que tu es un bon
      gar\xE7on d\xE8s qu'il rentre \xE0 la maison. Tu pourrais lui sugg\xE9rer discr\xE8tement
      de ramener moins de fleurs\_? J'adore son grand c\u0153ur, mais il n'y a plus
      de place \xE0 la maison\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 81
    m_Localized: "Et celle-ci\u2026 comment les algues r\xE9pondent-elles au t\xE9l\xE9phone\_?
      \xAB\_Bonjour, comment puis-je vous aider\_?\_\xBB Haha\_! Dr\xF4le, non\_?
      (Donnez-moi 5 \xE9toiles pour cette blague et je vous donnerai 5 \xE9toiles
      pour le service client.)"
    m_Metadata:
      m_Items: []
  - m_Id: 82
    m_Localized: "La prochaine fois que tu verras grand-p\xE8re, peux-tu t'assurer
      de lui laisser une bonne place assise ?"
    m_Metadata:
      m_Items: []
  - m_Id: 83
    m_Localized: "Il \xE9coute, mais ne r\xE9pond jamais \xE0 mes questions. Il pourrait
      \xEAtre plus poli."
    m_Metadata:
      m_Items: []
  - m_Id: 84
    m_Localized: "Tr\xE8s beau, mais il ne sortira pas avec ma petite-fille."
    m_Metadata:
      m_Items: []
  - m_Id: 85
    m_Localized: "Elle porte toujours les m\xEAmes v\xEAtements, elle devrait s'acheter
      de nouveaux v\xEAtements."
    m_Metadata:
      m_Items: []
  - m_Id: 86
    m_Localized: "Il lui faudrait une nouvelle pochette, elle a l'air un peu poussi\xE9reuse."
    m_Metadata:
      m_Items: []
  - m_Id: 87
    m_Localized: "Bonne poign\xE9e de main ferme, beau jeune homme."
    m_Metadata:
      m_Items: []
  - m_Id: 88
    m_Localized: "Il m'\xE9coute toujours. J'adore ce type."
    m_Metadata:
      m_Items: []
  - m_Id: 89
    m_Localized: "Si jamais vous avez besoin de conseils avis\xE9s, voici mon num\xE9ro.
      J'en ai \xE0 revendre. 921-8564"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
