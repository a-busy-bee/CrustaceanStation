    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "\u5217\u8ECA\u304C\u6E80\u54E1\u306B\u306A\u3063\u305F\u3089\u3001\u3053\u306E\u30B9\u30A4\u30C3\u30C1\u3067\u5217\u8ECA\u3092\u51FA\u767A\u3055\u305B\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002"
