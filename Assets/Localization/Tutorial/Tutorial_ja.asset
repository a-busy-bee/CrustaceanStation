    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "\u307E\u305A\u3001\u5F7C\u3089\u306EID\u3092\u78BA\u8A8D\u3057\u3066\u3001\u5199\u771F\u304C\u6B63\u3057\u3044\u304B\u3069\u3046\u304B\u3092\u30C1\u30A7\u30C3\u30AF\u3057\u3066\u304F\u3060\u3055\u3044\xB7\xB7\xB7"
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "\u305D\u3057\u3066\u3001ID\u306B\u8A18\u8F09\u3055\u308C\u305F\u540D\u524D\u304C\u30C1\u30B1\u30C3\u30C8\u306E\u540D\u524D\u3068\u4E00\u81F4\u3057\u3066\u3044\u308B\u3053\u3068\xB7\xB7\xB7"
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "\u51E6\u7406\u3092\u5B8C\u4E86\u3059\u308B\u306B\u306F\u3001\u7DD1\u306E\u30DC\u30BF\u30F3\u3092\u62BC\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "\u30AB\u30CB\u6700\u9AD8\uFF01 \u3053\u306E\u4E57\u5BA2\u306F\u30A8\u30B3\u30CE\u30DF\u30FC\u30AF\u30E9\u30B9\u306E\u5217\u8ECA\u306E\u5207\u7B26\u3092\u6301\u3063\u3066\u3044\u307E\u3059\u3002
