  m_SharedData: {fileID: 11400000, guid: 44da958ea56854660a88a49c88970c8b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: "Tutorial \xFCberspringen"
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: Sieh mal, ein neuer Fahrgast!
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "Pr\xFCfe zuerst den Ausweis und vergleiche das Foto ..."
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "... und ob der Name auf dem Ausweis mit dem Namen auf dem Ticket
      \xFCbereinstimmt."
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "Dr\xFCcke zum Abschluss den gr\xFCnen Knopf."
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "Krabbastisch! Dieser Fahrgast hat ein Zugticket f\xFCr die Economy-Klasse.
      W\xE4hle den Economy-Wagen aus."
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "Bei uns reisen die unterschiedlichsten Fahrg\xE4ste. Achte bei
      der Sitzplatzzuweisung besonders gut auf ihre Bed\xFCrfnisse."
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: Wenn der Zug voll ist, kannst du ihn mit diesem Schalter abfahren
      lassen.
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "Jetzt bist du dran: Fertige selbst ein paar Fahrg\xE4ste ab!"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "Gl\xFCckwunsch, du kennst jetzt die Grundlagen!"
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: (Zum Fortfahren irgendwo klicken)
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
