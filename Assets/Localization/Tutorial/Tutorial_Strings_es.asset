  m_Name: Tutorial_Strings_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 27411ae6b6a0042869f8105d38ceb782, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: Saltar tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "\xA1Mira, un posible pasajero!"
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: Primero, revise su documento de identidad para comprobar si la foto
      es correcta...
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: y que el nombre en el documento de identidad coincida con el nombre
      en el billete...
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "Para finalizar el procesamiento, pulse el bot\xF3n verde."
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "\xA1Fant\xE1stico! Este pasajero tiene un billete de tren de clase
      econ\xF3mica. Seleccione el vag\xF3n econ\xF3mico."
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: Atendemos a todo tipo de pasajeros. Tenga especial cuidado al asignarles
      sus asientos.
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: Cuando el tren se llene, puedes ponerlo en marcha con este interruptor.
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "\xA1Ahora intenta procesar algunos t\xFA mismo!"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "\xA1Enhorabuena por aprender lo b\xE1sico!"
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: (Haz clic en cualquier parte para continuar)
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
