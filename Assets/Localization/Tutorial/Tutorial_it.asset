  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_it
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: it
  m_SharedData: {fileID: 11400000, guid: 44da958ea56854660a88a49c88970c8b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: Salta Tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: Guarda, un potenziale passeggero!
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "In primo luogo, ispezionare il loro ID per verificare se la loro
      foto \xE8 corretta..."
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: e che il nome sull'ID corrisponda al nome sul biglietto...
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: Per terminare l'elaborazione, premere il pulsante verde.
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: Granchio-tastic! Questo passeggero ha un biglietto del treno di
      classe economica. Seleziona il carrello economy.
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: Serviamo tutti i tipi di passeggeri. Prestare particolare attenzione
      quando si assegnano i passeggeri ai loro posti.
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "Quando il treno si riempie, \xE8 possibile inviare fuori con questo
      interruttore."
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: Ora prova a elaborarne alcuni da solo!
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: Complimenti per l'apprendimento delle basi!
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: (Clicca ovunque per continuare)
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
