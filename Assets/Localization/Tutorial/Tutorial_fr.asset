  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 44da958ea56854660a88a49c88970c8b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: Passer le tutoriel
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: Regardez, un passager potentiel !
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "Commencez par v\xE9rifier sa pi\xE8ce d'identit\xE9 et assurez-vous
      que la photo correspond\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "puis v\xE9rifiez que le nom sur la pi\xE8ce d'identit\xE9 correspond
      \xE0 celui du billet\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "Pour terminer le contr\xF4le, appuyez sur le bouton vert."
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "Crabuleux ! Ce passager a un billet de train en classe \xE9conomique.
      S\xE9lectionnez le wagon \xE9conomique."
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "Nous accueillons toutes sortes de passagers. Faites particuli\xE8rement
      attention au placement de chacun."
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: Quand le train est plein, actionnez cet interrupteur pour le faire
      partir.
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "\xC0 vous maintenant : contr\xF4lez quelques passagers !"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: Bravo, vous connaissez maintenant les bases !
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "(Cliquez n'importe o\xF9 pour continuer)"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
