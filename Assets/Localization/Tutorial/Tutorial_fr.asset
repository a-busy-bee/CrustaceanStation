  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 44da958ea56854660a88a49c88970c8b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: Passer le Tutoriel
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: Regardez, un passager potentiel!
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "Tout d'abord, inspectez leur pi\xE8ce d'identit\xE9 pour v\xE9rifier
      si leur photo est correcte..."
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "et que le nom sur la pi\xE8ce d'identit\xE9 correspond au nom sur
      le ticket..."
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: Pour terminer le traitement, appuyez sur le bouton vert.
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "Crabe-tastic! Ce passager a un billet de train en classe \xE9conomique.
      S\xE9lectionnez le panier \xE9conomique."
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "Nous servons toutes sortes de passagers. Soyez particuli\xE8rement
      prudent lorsque vous assignez des passagers \xE0 leurs si\xE8ges."
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: Lorsque le train se remplit, vous pouvez l'envoyer avec cet interrupteur.
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "Maintenant, essayez d'en traiter quelques-uns vous-m\xEAme!"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "F\xE9licitations pour l'apprentissage des bases!"
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "(Cliquez n'importe o\xF9 pour continuer)"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
