  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 44da958ea56854660a88a49c88970c8b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: 'Skip Tutorial  '
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: 'Look, a prospective passenger! '
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: First, inspect their ID to check if their photo is correct...
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: and that the name on the ID matches the name on the ticket...
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: To finish processing, press the green button.
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: Crab-tastic! This passenger has an economy-class train ticket. Select
      the economy cart.
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: We serve all kinds of passengers. Take special care when assigning
      passengers to their seats.
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: 'When the train fills up, you can send it off with this switch. '
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: Now try processing a few yourself!
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: Congrats on learning the basics!
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: (Click anywhere to continue)
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
