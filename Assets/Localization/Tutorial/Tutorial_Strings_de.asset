  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_Strings_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 27411ae6b6a0042869f8105d38ceb782, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: "Tutorial \xFCberspringen"
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: Schau mal, ein potenzieller Passagier!
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "\xDCberpr\xFCfen Sie zun\xE4chst den Ausweis, um sicherzustellen,
      dass das Foto korrekt ist..."
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "und dass der Name auf dem Ausweis mit dem Namen auf dem Ticket
      \xFCbereinstimmt..."
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "Dr\xFCcken Sie zum Abschluss des Vorgangs den gr\xFCnen Knopf."
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "Krabben-tastisch! Dieser Fahrgast hat ein Ticket f\xFCr die 2.
      Klasse. W\xE4hlen Sie den 2. Klasse-Waggon."
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "Wir bef\xF6rdern alle Arten von Fahrg\xE4sten. Bitte achten Sie
      besonders darauf, die Fahrg\xE4ste ihren Sitzpl\xE4tzen zuzuweisen."
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "Wenn der Zug voll ist, k\xF6nnen Sie ihn mit diesem Schalter abfahren
      lassen."
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: Versuchen Sie nun, ein paar selbst zu verarbeiten!
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "Herzlichen Gl\xFCckwunsch zum Erlernen der Grundlagen!"
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: (Zum Fortfahren klicken)
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
