  - m_Id: 1
    m_Localized: "\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u3092\u30B9\u30AD\u30C3\u30D7"
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "\u307B\u3089\u3001\u4E57\u5BA2\u5019\u88DC\u304C\u3044\u308B\u305E\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "\u307E\u305A\u3001\u8EAB\u5206\u8A3C\u660E\u66F8\u3092\u8ABF\u3079\u3066\u3001\u5199\u771F\u304C\u6B63\u3057\u3044\u304B\u3069\u3046\u304B\u3092\u78BA\u8A8D\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "\u305D\u3057\u3066\u3001\u8EAB\u5206\u8A3C\u660E\u66F8\u306B\u8A18\u8F09\u3055\u308C\u3066\u3044\u308B\u540D\u524D\u3068\u30C1\u30B1\u30C3\u30C8\u306B\u8A18\u8F09\u3055\u308C\u3066\u3044\u308B\u540D\u524D\u304C\u4E00\u81F4\u3057\u3066\u3044\u308B\u3053\u3068\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "\u51E6\u7406\u3092\u5B8C\u4E86\u3059\u308B\u306B\u306F\u3001\u7DD1\u8272\u306E\u30DC\u30BF\u30F3\u3092\u62BC\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "\u30AB\u30CB\u6700\u9AD8\uFF01\u3053\u306E\u4E57\u5BA2\u306F\u30A8\u30B3\u30CE\u30DF\u30FC\u30AF\u30E9\u30B9\u306E\u5217\u8ECA\u306E\u5207\u7B26\u3092\u6301\u3063\u3066\u3044\u307E\u3059\u3002\u30A8\u30B3\u30CE\u30DF\u30FC\u8ECA\u4E21\u3092\u9078\u629E\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "\u5F0A\u793E\u3067\u306F\u3042\u3089\u3086\u308B\u30BF\u30A4\u30D7\u306E\u304A\u5BA2\u69D8\u306B\u5BFE\u5FDC\u3057\u3066\u304A\u308A\u307E\u3059\u3002\u5EA7\u5E2D\u306E\u5272\u308A\u5F53\u3066\u306B\u306F\u7279\u306B\u3054\u6CE8\u610F\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "\u5217\u8ECA\u304C\u6E80\u54E1\u306B\u306A\u3063\u305F\u3089\u3001\u3053\u306E\u30B9\u30A4\u30C3\u30C1\u3067\u767A\u8ECA\u3055\u305B\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "\u3055\u3042\u3001\u4ECA\u5EA6\u306F\u81EA\u5206\u3067\u3044\u304F\u3064\u304B\u51E6\u7406\u3057\u3066\u307F\u307E\u3057\u3087\u3046\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "\u57FA\u672C\u3092\u7FD2\u5F97\u3055\u308C\u305F\u3068\u306E\u3053\u3068\u3001\u304A\u3081\u3067\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "\uFF08\u30AF\u30EA\u30C3\u30AF\u3057\u3066\u7D9A\u884C\uFF09"
