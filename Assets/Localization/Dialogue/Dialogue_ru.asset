  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_ru
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ru
  m_SharedData: {fileID: 11400000, guid: 25e982df099754116b3863808eae6c55, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0443 \u0442\u0435\u0431\u044F
      \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "\u0422\u044B \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0448\u044C
      \u0443\u0441\u0442\u0430\u0432\u0448\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "\u041A\u0430\u043A \u0434\u0435\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0442\u044B \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0448\u044C\u0441\u044F
      \u043D\u0430 \u043F\u0435\u043D\u0441\u0438\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "\u041A\u0430\u043A\u0430\u044F \u0443 \u043D\u0430\u0441 \u0447\u0443\u0434\u0435\u0441\u043D\u0430\u044F
      \u043F\u043E\u0433\u043E\u0434\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "\u0424\u0443, \u0437\u0434\u0435\u0441\u044C \u043D\u0435\u0434\u0430\u0432\u043D\u043E
      \u0431\u044B\u043B\u0430 \u0440\u044B\u0431\u0430? \u041E\u0442 \u043D\u0435\u0451
      \u0432\u043E\u043D\u044F\u0435\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0432 \u044D\u0442\u0438
      \u0432\u044B\u0445\u043E\u0434\u043D\u044B\u0435 \u0431\u0443\u0434\u0435\u0442
      \u0434\u043E\u0436\u0434\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "\u0421\u043B\u044B\u0448\u0430\u043B, \u0447\u0442\u043E \u043D\u0430\u043C
      \u043F\u043E\u0432\u044B\u0441\u044F\u0442 \u043D\u0430\u043B\u043E\u0433\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "\u042F \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C \u043D\u0430\u0432\u0435\u0441\u0442\u0438\u0442\u044C
      \u0441\u0432\u043E\u0435\u0433\u043E \u0434\u0440\u0443\u0433\u0430, \u0441
      \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u0434\u0430\u0432\u043D\u043E \u043D\u0435
      \u0432\u0438\u0434\u0435\u043B\u0441\u044F! \u041C\u044B \u043D\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043B\u0438\u0441\u044C
      \u0443\u0436\u0435 \u043C\u043D\u043E\u0433\u043E \u043B\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "\u042F \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0437\u0430
      \u0434\u0435\u0441\u044F\u0442\u044C \u043B\u0435\u0442 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0441\u044C
      \u0432 \u043E\u0442\u043F\u0443\u0441\u043A!"
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "\u042F \u0431\u0435\u0433\u0443 \u043E\u0442 \u0441\u0432\u043E\u0435\u0433\u043E
      \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "\u0410 \u0442\u044B \u0437\u043D\u0430\u043B, \u0447\u0442\u043E
      \u043F\u043E\u0435\u0437\u0434 \u043C\u043E\u0436\u0435\u0442 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0442\u044C
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0434\u043E 57 \u043B\u0438\u0433
      \u0432 \u0447\u0430\u0441?! \u042D\u0442\u043E \u0442\u0430\u043A \u0431\u044B\u0441\u0442\u0440\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "\u041F\u043E\u0442\u043E\u0440\u043E\u043F\u0438\u0441\u044C \u0438
      \u043F\u0440\u043E\u0431\u0435\u0439 \u043C\u043E\u0439 \u0431\u0438\u043B\u0435\u0442,
      \u0442\u044B \u0447\u0442\u043E, \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0448\u044C \u043C\u043E\u0438
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B??!"
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "\u0422\u044B \u043D\u0435 \u0432\u0438\u0434\u0435\u043B \u043C\u043E\u044E
      \u0448\u043B\u044F\u043F\u0443 \u0441 \u043F\u0440\u043E\u043F\u0435\u043B\u043B\u0435\u0440\u043E\u043C?
      \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u044F \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u0435\u0451 \u0432 \u043F\u043E\u0435\u0437\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "\u0422\u044B \u043D\u0435 \u0432\u0438\u0434\u0435\u043B \u043C\u043E\u044E
      \u0448\u043B\u044F\u043F\u0443-\u0446\u0438\u043B\u0438\u043D\u0434\u0440?
      \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u044F \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u0435\u0451 \u0432 \u043F\u043E\u0435\u0437\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "\u0422\u044B \u043D\u0435 \u0432\u0438\u0434\u0435\u043B \u043C\u043E\u044E
      \u0437\u0435\u043B\u0451\u043D\u0443\u044E \u0448\u043B\u044F\u043F\u0443?
      \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u044F \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u0435\u0451 \u0432 \u043F\u043E\u0435\u0437\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "\u0427\u0442\u043E \u0442\u044B \u0438\u0449\u0435\u0448\u044C
      \u0432 \u043C\u043E\u0438\u0445 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0445?
      \u0422\u0435\u0431\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u043C\u043E\u044F
      \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F, \u043A\u0440\u0430\u0441\u0430\u0432\u0447\u0438\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "\u042D\u0442\u043E \u044F \u043D\u0430 \u0441\u043D\u0438\u043C\u043A\u0435,
      \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u043C\u0435\u043D\u044F
      \u0443\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "\u0422\u0430\u043A \u0441\u043B\u043E\u0436\u043D\u043E \u0441\u043B\u0435\u0434\u0438\u0442\u044C
      \u0437\u0430 \u044D\u0442\u0438\u043C\u0438 \u0431\u0438\u043B\u0435\u0442\u0430\u043C\u0438,
      \u0430 \u0432 \u043D\u0430\u0448\u0435 \u0432\u0440\u0435\u043C\u044F \u043C\u044B
      \u043F\u0440\u043E\u0441\u0442\u043E \u0446\u0435\u043B\u043E\u0432\u0430\u043B\u0438
      \u043A\u043E\u043D\u0434\u0443\u043A\u0442\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: "\u0422\u0430\u043A \u0441\u043B\u043E\u0436\u043D\u043E \u0441\u043B\u0435\u0434\u0438\u0442\u044C
      \u0437\u0430 \u044D\u0442\u0438\u043C\u0438 \u0431\u0438\u043B\u0435\u0442\u0430\u043C\u0438,
      \u0430 \u0432 \u043D\u0430\u0448\u0435 \u0432\u0440\u0435\u043C\u044F \u043C\u044B
      \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043B\u0430\u0442\u0438\u043B\u0438
      \u043D\u0430 \u0432\u0445\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: "\u0422\u0430\u043A \u0441\u043B\u043E\u0436\u043D\u043E \u0441\u043B\u0435\u0434\u0438\u0442\u044C
      \u0437\u0430 \u044D\u0442\u0438\u043C\u0438 \u0431\u0438\u043B\u0435\u0442\u0430\u043C\u0438,
      \u0430 \u0432 \u043D\u0430\u0448\u0435 \u0432\u0440\u0435\u043C\u044F \u043C\u044B
      \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u043E\u0441\u0438\u043B\u0438
      \u043F\u0440\u043E\u0449\u0435\u043D\u0438\u044F, \u0430 \u043D\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: "\u042F \u0443\u0436\u0435 \u0446\u0435\u043B\u0443\u044E \u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C
      \u0441\u0442\u043E\u044E \u0432 \u043E\u0447\u0435\u0440\u0435\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "\u041A\u0430\u043A \u044D\u0442\u043E \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u2014 \u043F\u043E\u0435\u0437\u0434 \u0438\u043B\u0438 \u0442\u0440\u043E\u043B\u043B\u0435\u0439\u0431\u0443\u0441?"
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: "\u041C\u043E\u0439 \u0441\u043E\u0441\u0435\u0434 \u0441\u043A\u0430\u0437\u0430\u043B,
      \u0447\u0442\u043E \u044D\u0442\u0438 \u0448\u0430\u0442\u0442\u043B\u044B
      \u0443\u0432\u043E\u0437\u044F\u0442 \u043B\u044E\u0434\u0435\u0439 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430,
      \u044D\u0442\u043E \u043F\u0440\u0430\u0432\u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: "\u0421 \u044D\u0442\u0438\u043C\u0438 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044F\u043C\u0438
      \u0447\u0442\u043E-\u0442\u043E \u043D\u0435 \u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: "\u041E\u0442 \u043B\u044E\u0434\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F \u0438\u0437
      \u044D\u0442\u043E\u0439 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438,
      \u0441\u0442\u0440\u0430\u043D\u043D\u043E \u043F\u0430\u0445\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "\u0418\u043D\u043E\u0433\u0434\u0430 \u043F\u043E \u043D\u043E\u0447\u0430\u043C
      \u044F \u0441\u043B\u044B\u0448\u0443 \u043A\u0440\u0438\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: "\u042F \u0441\u043B\u044B\u0448\u0430\u043B, \u0447\u0442\u043E
      \xAB\u0420\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u0430\u044F
      \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F\xBB \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442
      \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u044B \u043D\u0430\u0434
      \u044D\u0442\u0438\u043C\u0438 \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u043D\u044B\u043C\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: "\u0413\u043E\u043B\u043E\u0441\u0443\u0439\u0442\u0435 \u0437\u0430
      \u043F\u0440\u0430\u0432\u0430 \u0440\u044B\u0431, \u0434\u0430\u0436\u0435
      \u0435\u0441\u043B\u0438 \u0432\u044B \u043D\u0435 \u0440\u044B\u0431\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: "\u042D\u0439, \u043F\u043E \u043A\u0440\u0430\u0439\u043D\u0435\u0439
      \u043C\u0435\u0440\u0435, \u0432\u0441\u0435 \u0445\u0438\u0449\u043D\u0438\u043A\u0438
      \u0434\u0435\u043B\u0430\u044E\u0442 \u044D\u0442\u043E \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u043E.
      \u0418 \u0438\u043C \u0437\u0430 \u044D\u0442\u043E \u043F\u043B\u0430\u0442\u044F\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: "\u041A\u0430\u043A \u0434\u0443\u043C\u0430\u0435\u0442\u0435,
      \u0435\u0441\u0442\u044C \u043B\u0438 \u0435\u0449\u0451 \u0432\u0430\u043A\u0430\u043D\u0441\u0438\u0438
      \u0434\u043B\u044F \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: "\xAB\u0420\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u0430\u044F
      \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F\xBB \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B\u0430
      \u043C\u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0443, \u043D\u043E \u0441
      \u044D\u0442\u0438\u043C\u0438 \u0440\u0435\u0431\u044F\u0442\u0430\u043C\u0438
      \u0447\u0442\u043E-\u0442\u043E \u043D\u0435 \u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 34
    m_Localized: "\u042F \u0445\u043E\u0447\u0443 \u0441\u0442\u0430\u0442\u044C
      \u0432\u043E\u043B\u043E\u043D\u0442\u0451\u0440\u043E\u043C \u0432 \u043D\u043E\u0432\u043E\u043C
      \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u043C
      \u043F\u0440\u043E\u0435\u043A\u0442\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: "\u041C\u043E\u0439 \u043B\u0435\u0434\u0435\u043D\u0435\u0446\u2026
      \u043A\u0443\u0434\u0430 \u0436\u0435 \u043E\u043D \u043F\u043E\u0434\u0435\u0432\u0430\u043B\u0441\u044F\u2026
      ;("
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: "\u041C\u043E\u0435\u0433\u043E \u043B\u0443\u0447\u0448\u0435\u0433\u043E
      \u0434\u0440\u0443\u0433\u0430 \u0437\u043E\u0432\u0443\u0442 \u0421\u044D\u043C\u044E\u044D\u043B!
      \u0410 \u043A\u0430\u043A \u0437\u043E\u0432\u0443\u0442 \u0442\u0432\u043E\u0435\u0433\u043E
      \u043B\u0443\u0447\u0448\u0435\u0433\u043E \u0434\u0440\u0443\u0433\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: "\u0421\u044D\u043C\u044E\u044D\u043B \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B \u0437\u0430\u0431\u0430\u0432\u043D\u043E\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: "\u041C\u0430\u043C\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u0442\u0430\u043A\u0430\u044F
      \u043A\u0440\u0443\u0442\u0430\u044F \u0432 \u0441\u0432\u043E\u0451\u043C
      \u0431\u0435\u043B\u043E\u043C \u043F\u0438\u0434\u0436\u0430\u043A\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: "\u041C\u0430\u043C\u0430 \u0433\u043E\u0442\u043E\u0432\u0438\u0442
      \u0441\u0430\u043C\u0443\u044E \u0432\u043A\u0443\u0441\u043D\u0443\u044E \u0435\u0434\u0443
      \u043D\u0430 \u0432\u0441\u0451\u043C \u0431\u0435\u043B\u043E\u043C \u0441\u0432\u0435\u0442\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 40
    m_Localized: "\u0412 \u0448\u043A\u043E\u043B\u0435 \u0442\u0430\u043A \u0441\u043A\u0443\u0447\u043D\u043E\u2026
      \u041C\u0438\u0441\u0442\u0435\u0440, \u043F\u043E\u0438\u0433\u0440\u0430\u0435\u0442\u0435
      \u0441\u043E \u043C\u043D\u043E\u0439 \u0438 \u0421\u044D\u043C\u044E\u044D\u043B\u043E\u043C?
      \u2026\u041D\u0443 \u043B\u0430\u0434\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: "\u041A\u0430\u043A\u0438\u0435 \u043A\u043E\u043D\u0444\u0435\u0442\u044B
      \u044F \u043B\u044E\u0431\u043B\u044E? \u041C\u043C, \u044F \u043B\u044E\u0431\u043B\u044E
      \u0434\u0440\u0430\u0436\u0435 \u0438 \u043B\u0435\u0434\u0435\u043D\u0446\u044B,
      \u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0441\u0435\u0433\u043E
      \u043B\u044E\u0431\u043B\u044E \u043B\u0435\u0434\u0435\u043D\u0446\u044B \u043D\u0430
      \u043F\u0430\u043B\u043E\u0447\u043A\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: "\u041C\u0438\u0441\u0442\u0435\u0440! \u0421\u0435\u0433\u043E\u0434\u043D\u044F
      \u044F \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0441\u0432\u043E\u0439
      \u043B\u044E\u0431\u0438\u043C\u044B\u0439 \u043A\u043B\u0443\u0431\u043D\u0438\u0447\u043D\u043E-\u0431\u0430\u043D\u0430\u043D\u043E\u0432\u044B\u0439
      \u043B\u0435\u0434\u0435\u043D\u0435\u0446! \u0425\u043E\u0442\u0438\u0442\u0435
      \u0442\u0430\u043A\u043E\u0439 \u0436\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435
      \u043D\u0435 \u0431\u044B\u043B\u043E \u043A\u043B\u0443\u0431\u043D\u0438\u0447\u043D\u043E-\u0431\u0430\u043D\u0430\u043D\u043E\u0432\u044B\u0445
      \u043B\u0435\u0434\u0435\u043D\u0446\u043E\u0432\u2026 \u0410 \u044D\u0442\u043E
      \u043C\u043E\u0438 \u043B\u044E\u0431\u0438\u043C\u044B\u0435\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: "\u042F \u043B\u044E\u0431\u043B\u044E \u0441\u0432\u043E\u044E
      \u043C\u0430\u043C\u0443, \u043B\u044E\u0431\u043B\u044E \u0421\u044D\u043C\u044E\u044D\u043B\u0430,
      \u043B\u044E\u0431\u043B\u044E \u043A\u043B\u0443\u0431\u043D\u0438\u0447\u043D\u043E-\u0431\u0430\u043D\u0430\u043D\u043E\u0432\u044B\u0435
      \u043B\u0435\u0434\u0435\u043D\u0446\u044B\u2026 \u0438 \u0432\u0430\u0441
      \u044F \u0442\u043E\u0436\u0435 \u043B\u044E\u0431\u043B\u044E!"
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: "\u042F \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0431\u043E\u0436\u0430\u044E
      \u0434\u043E\u0436\u0434\u044C, \u0430 \u0432\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: "\u041C\u043D\u0435 \u043D\u0435 \u043D\u0443\u0436\u043D\u043E
      \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u044C \u0431\u0438\u043B\u0435\u0442
      \u043D\u0430 \u043F\u043E\u0435\u0437\u0434, \u0432\u0435\u0440\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: "\u042F \u043C\u043E\u0433\u0443 \u0432\u0437\u044F\u0442\u044C
      \u0441 \u0441\u043E\u0431\u043E\u0439 \u0432 \u043F\u043E\u0435\u0437\u0434
      \u0441\u0432\u043E\u0439 \u043F\u043B\u0430\u043A\u0430\u0442, \u043F\u0440\u0430\u0432\u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 48
    m_Localized: "\u041C\u043E\u0435 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0435
      \u0428\u0435\u043B\u043B\u0434\u043E\u043D \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0443\u0432\u044F\u0434\u0448\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0432\u044B\u0441\u0442\u0430\u0432\u0438\u043B\u0430
      \u0432\u0441\u0435 \u0441\u0432\u043E\u0438 \u0433\u043E\u0440\u0448\u043A\u0438
      \u043D\u0430 \u0443\u043B\u0438\u0446\u0443, \u0447\u0442\u043E\u0431\u044B
      \u0432\u043E\u0434\u0430 \u0441\u0442\u0435\u043A\u0430\u043B\u0430 \u0441
      \u043D\u0438\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: "\u041C\u043E\u0436\u043D\u043E \u043C\u043D\u0435 \u0432\u0437\u044F\u0442\u044C
      \u0441 \u0441\u043E\u0431\u043E\u0439 \u0432 \u043F\u043E\u0435\u0437\u0434
      \u0431\u0430\u043A\u043B\u0430\u0436\u0430\u043D\u044B \u0441 \u043F\u0430\u0440\u043C\u0435\u0437\u0430\u043D\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: "\u0412\u0430\u043C \u0441\u0442\u043E\u0438\u0442 \u043F\u0440\u0438\u0439\u0442\u0438
      \u043D\u0430 \u043C\u043E\u044E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E
      \u0430\u043A\u0446\u0438\u044E \u043F\u0440\u043E\u0442\u0435\u0441\u0442\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 52
    m_Localized: "\u0412\u0430\u043C \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435
      \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u0447\u0442\u043E \u0442\u0435\u043C\u043D\u044B\u0435
      \u0442\u0443\u0447\u0438 \u043F\u044B\u0442\u0430\u044E\u0442\u0441\u044F \u043D\u0430\u043C
      \u0447\u0442\u043E-\u0442\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: "\u041D\u043E\u0432\u044B\u0435 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438
      \u0442\u043E\u043B\u044C\u043A\u043E \u0435\u0449\u0435 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0438\u0437\u043E\u043B\u0438\u0440\u0443\u044E\u0442 \u043D\u0430\u0441,
      \u0440\u044B\u0431, \u043E\u0442 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 54
    m_Localized: "\u041A\u0430\u043A \u0432\u044B \u0434\u0443\u043C\u0430\u0435\u0442\u0435,
      \u0435\u0441\u043B\u0438 \u044F \u043F\u0440\u0438\u043A\u0443\u044E \u0441\u0435\u0431\u044F
      \u0446\u0435\u043F\u044F\u043C\u0438 \u043A \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u0439
      \u0447\u0430\u0441\u0442\u0438 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438,
      \u043E\u043D\u0438 \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u044F\u0442 \u0441\u0432\u043E\u044E
      \u0440\u0430\u0431\u043E\u0442\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 55
    m_Localized: "\u0410\u0445, \u043A\u0430\u043A \u0436\u0435 \u0441\u043A\u0440\u0438\u043F\u0438\u0442
      \u043C\u043E\u044F \u0441\u0442\u0430\u0440\u0430\u044F \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430.
      \u041F\u0440\u043E\u0432\u043E\u0434\u0438\u0448\u044C \u0441\u0442\u0430\u0440\u0443\u044E
      \u0434\u0443\u0448\u0443 \u0432 \u043F\u0443\u0442\u044C, \u044E\u043D\u043E\u0448\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: "\u0411\u044B\u043B\u043E \u0432\u0440\u0435\u043C\u044F, \u043A\u043E\u0433\u0434\u0430
      \u0432\u0441\u0435 \u0436\u0438\u0432\u044B\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430
      \u0431\u0440\u043E\u0434\u0438\u043B\u0438 \u043F\u043E \u043C\u043E\u0440\u0441\u043A\u043E\u043C\u0443
      \u0434\u043D\u0443, \u044F \u0441\u043A\u0443\u0447\u0430\u044E \u043F\u043E
      \u0442\u0435\u043C \u0434\u0430\u0432\u043D\u043E \u0443\u0448\u0435\u0434\u0448\u0438\u043C
      \u0434\u043D\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: "\u0422\u0435, \u0441 \u043A\u0435\u043C \u043E\u043D \u043A\u043E\u0433\u0434\u0430-\u0442\u043E
      \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B,
      \u0442\u0435\u043F\u0435\u0440\u044C \u0434\u0430\u0432\u043D\u043E \u0443\u0448\u043B\u0438,
      \u0438\u0445 \u0441\u043B\u0435\u0434\u044B \u0438\u0441\u0447\u0435\u0437\u043B\u0438
      \u0438\u0437 \u044D\u0442\u043E\u0433\u043E \u043C\u0438\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 58
    m_Localized: "\u0425\u043C! \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E
      \u0441 \u0431\u044B\u043B\u044B\u043C\u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u0430\u043C\u0438
      \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u0438 \u043D\u0430\u0448\u0435\u0433\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u2014 \u0436\u0430\u043B\u043A\u0438\u0435
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 59
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u0438 \u0437\u0430 \u0432\u044F\u043B\u043E\u0441\u0442\u044C
      \u044D\u0442\u043E\u0433\u043E \u0442\u0435\u043B\u0430; \u044F \u0443\u0436\u0435
      \u0434\u0430\u0432\u043D\u043E \u043F\u0440\u0438\u043A\u043E\u0432\u0430\u043D
      \u043A \u0438\u043D\u0432\u0430\u043B\u0438\u0434\u043D\u043E\u043C\u0443 \u043A\u0440\u0435\u0441\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 60
    m_Localized: "\u041F\u0430\u0440\u0435\u043D\u044C, \u043D\u0435 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0439
      \u043C\u043E\u0438\u0445 \u043E\u0448\u0438\u0431\u043E\u043A. \u0415\u0441\u043B\u0438
      \u043C\u043E\u0436\u0435\u0448\u044C \u043A\u043E\u0433\u043E-\u0442\u043E
      \u0441\u043F\u0430\u0441\u0442\u0438, \u043D\u0435 \u0441\u0442\u043E\u0439
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u0438 \u043D\u0435 \u043E\u0431\u0440\u0435\u043A\u0430\u0439
      \u0435\u0433\u043E \u043D\u0430 \u0441\u043C\u0435\u0440\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 61
    m_Localized: "\u042F \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u0441\u043B\u044B\u0448\u0443
      \u0438\u0445 \u043A\u0440\u0438\u043A\u0438... \u043D\u0435 \u0437\u043D\u0430\u044E,
      \u0438\u0437 \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E \u043E\u043D\u0438
      \u0438\u043B\u0438 \u0438\u0437 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 62
    m_Localized: "\u0422\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438 \u0438
      \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442 \u0432 \u043D\u0430\u0448\u0438
      \u0434\u043D\u0438 \u0434\u043E\u0441\u0442\u0438\u0433\u043B\u0438 \u0442\u0430\u043A\u043E\u0433\u043E
      \u0443\u0440\u043E\u0432\u043D\u044F... \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E
      \u0441\u0435\u0431\u044F \u0447\u0443\u0436\u0430\u043A\u043E\u043C \u0432
      \u044D\u0442\u043E\u043C \u043C\u0438\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 63
    m_Localized: "\u041F\u0430\u0440\u0435\u043D\u044C, \u0442\u0435\u0431\u0435
      \u043D\u0443\u0436\u043D\u043E \u0432\u044B\u0439\u0442\u0438 \u0438\u0437
      \u0434\u043E\u043C\u0430 \u0438 \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u0442\u044C\u0441\u044F
      \u0436\u0438\u0437\u043D\u044C\u044E \u0441\u043E \u0441\u0432\u043E\u0438\u043C\u0438
      \u0431\u043B\u0438\u0437\u043A\u0438\u043C\u0438. \u041D\u0435 \u043F\u043E\u0441\u0432\u044F\u0449\u0430\u0439
      \u0441\u0432\u043E\u044E \u0436\u0438\u0437\u043D\u044C \u0431\u043E\u0440\u044C\u0431\u0435
      \u0437\u0430 \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u0435 \u0438
      \u043D\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0441\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C
      \u043E\u0434\u0438\u043D\u043E\u043A\u0438\u043C \u0432\u044B\u0436\u0438\u0432\u0448\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 64
    m_Localized: "...\u041C\u043E\u0438 \u0434\u0440\u0443\u0437\u044C\u044F? ...
      \u0412 \u0443\u0447\u0435\u0431\u043D\u0438\u043A\u0430\u0445 \u0438\u0441\u0442\u043E\u0440\u0438\u0438
      \u0438\u0445 \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0445\u0440\u0430\u0431\u0440\u044B\u043C\u0438
      \u0432\u043E\u0438\u043D\u0430\u043C\u0438, \u043D\u043E \u043C\u043D\u0435
      \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0442\u044C
      \u043E \u043D\u0438\u0445 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043A\u0430\u043A \u043E \u0433\u0435\u0440\u043E\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 65
    m_Localized: "...\u043D\u0435 \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u0439\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 66
    m_Localized: "\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0435
      \u0434\u0435\u043D\u0435\u0433, \u0447\u0442\u043E\u0431\u044B \u043A\u0443\u043F\u0438\u0442\u044C
      \u0432\u0441\u0435 \u044D\u0442\u0438 \u0431\u0430\u043D\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 67
    m_Localized: "\u0416\u0430\u043B\u044C, \u0447\u0442\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u043D\u0435 \u043F\u043E\u0445\u043E\u043B\u043E\u0434\u0430\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 68
    m_Localized: "\u0421 \u0431\u0430\u043D\u0442\u043E\u043C \u0442\u044B \u0431\u044B
      \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B \u0435\u0449\u0451 \u043C\u0438\u043B\u0435\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 69
    m_Localized: "\u041D\u0435 \u043C\u043E\u0433\u0443 \u0434\u043E\u0436\u0434\u0430\u0442\u044C\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0441\u0432\u0435\u0440\u043D\u0443\u0441\u044C
      \u043A\u0430\u043B\u0430\u0447\u0438\u043A\u043E\u043C \u0432 \u043F\u043E\u0435\u0437\u0434\u0435
      \u0438 \u0431\u0443\u0434\u0443 \u0447\u0438\u0442\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 70
    m_Localized: "\u0422\u044B \u0436\u0435 \u0437\u043D\u0430\u0435\u0448\u044C,
      \u0447\u0442\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u0435\u0431\u0435
      \u043D\u0435 \u0441\u0442\u043E\u0438\u0442 \u043D\u0430\u0434\u0435\u0432\u0430\u0442\u044C
      \u0441\u0438\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 71
    m_Localized: "\u0422\u0435\u0431\u0435 \u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E \u044F \u0433\u043E\u0432\u043E\u0440\u044E \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0442\u0438\u0445\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 72
    m_Localized: "\u042F \u043D\u0435 \u043B\u044E\u0431\u043B\u044E \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0432 \u0433\u043B\u0430\u0437\u0430. \u041D\u0435 \u043C\u043E\u0433\u043B\u0430
      \u0431\u044B \u0442\u044B \u043D\u0435 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043D\u0430 \u043C\u0435\u043D\u044F, \u043A\u043E\u0433\u0434\u0430 \u044F
      \u0441\u043C\u043E\u0442\u0440\u044E \u043D\u0430 \u0442\u0435\u0431\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 73
    m_Localized: "\u042F \u043D\u0430\u0434\u0435\u044E\u0441\u044C, \u0447\u0442\u043E
      \u0432 \u043D\u043E\u0432\u043E\u0439 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438
      \u043D\u0435 \u043F\u043E\u043C\u0435\u0448\u0430\u043B \u0431\u044B \u0441\u0435\u043A\u0440\u0435\u0442\u0430\u0440\u044C...
      \u042F \u0443\u0436\u0435 \u0446\u0435\u043B\u0443\u044E \u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C
      \u043F\u043E\u0434\u0430\u044E \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 74
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0434\u0435\u0442\u043A\u0430!
      \u0423 \u043C\u0435\u043D\u044F \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C
      \u0448\u0443\u0442\u043A\u0438, \u0435\u0441\u043B\u0438 \u043E\u043D\u0438
      \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C, \u043F\u043E\u0434\u0435\u043B\u0438\u0441\u044C
      \u0438\u043C\u0438 \u0441\u043E \u043C\u043D\u043E\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 75
    m_Localized: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0411\u0438\u043B\u043B\u0438
      \u0438 \u041C\u0438\u043B\u043B\u0438 \u0445\u043E\u0440\u043E\u0448\u043E
      \u0443\u0447\u0430\u0442\u0441\u044F \u0432 \u0448\u043A\u043E\u043B\u0435\u2026
      \u043D\u0435\u0442, \u043E\u043D\u0438 \u0442\u0430\u043A\u0438\u0435 \u0436\u0435
      \u0437\u0432\u0435\u0437\u0434\u044B, \u043A\u0430\u043A \u043C\u044B \u0441
      \u0442\u043E\u0431\u043E\u0439, \u043C\u0430\u043B\u044B\u0448!"
    m_Metadata:
      m_Items: []
  - m_Id: 76
    m_Localized: "\u042D\u0439, \u0437\u043D\u0430\u0435\u0448\u044C, \u0433\u0434\u0435
      \u0437\u0434\u0435\u0441\u044C \u0441\u0430\u043C\u043E\u0435 \u043B\u0443\u0447\u0448\u0435\u0435
      \u0446\u0432\u0435\u0442\u043E\u0447\u043D\u043E\u0435 \u043F\u043E\u043B\u0435
      \u0432 \u043E\u043A\u0440\u0443\u0433\u0435? \u041D\u0435\u0442, \u044D\u0442\u043E
      \u043D\u0435 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u043A
      \u043A\u0443\u043B\u044C\u043C\u0438\u043D\u0430\u0446\u0438\u0438, \u044F
      \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 77
    m_Localized: "\u042F \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0430 \u0442\u0430\u043A\u043E\u043C
      \u043F\u043E\u0434\u044A\u0451\u043C\u0435! \u041C\u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u043A\u0443\u043F\u0438\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u0431\u0438\u043B\u0435\u0442\u044B \u043D\u0430 \u043A\u043E\u043D\u0446\u0435\u0440\u0442
      Basalt \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u044F \u0443\u0448\u0435\u043B
      \u0441 \u0440\u0430\u0431\u043E\u0442\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 78
    m_Localized: "\u041E-\u043E, \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0448\u044C
      \u043F\u0440\u044F\u043C\u043E \u0441 \u0438\u0433\u043E\u043B\u043E\u0447\u043A\u0438!
      \u041D\u0430 \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u0435? \u041D\u0443\u0436\u043D\u044B
      \u0441\u043E\u0432\u0435\u0442\u044B? \u041D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439,
      \u043E\u043D\u0438 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E!
      \u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \u044D\u0442\u0438\u0445
      \u0446\u0435\u043D \u043D\u0430 \u0431\u0438\u043B\u0435\u0442\u044B\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 79
    m_Localized: "\u042D\u0442\u043E\u0442 \u0431\u0443\u043A\u0435\u0442 \u043F\u043E\u043B\u0435\u0432\u044B\u0445
      \u0446\u0432\u0435\u0442\u043E\u0432? \u042F \u0433\u043E\u0442\u043E\u0432\u043B\u044E
      \u0435\u0433\u043E \u0434\u043B\u044F \u0441\u0432\u043E\u0435\u0439 \u0436\u0435\u043D\u044B
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437, \u043A\u043E\u0433\u0434\u0430
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0441\u044C \u0434\u043E\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 80
    m_Localized: "\u042D\u0439, \u0447\u0442\u043E \u0441\u043A\u0430\u0437\u0430\u043B\u0438
      \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0443 \u0434\u0432\u0430
      \u043E\u043A\u0435\u0430\u043D\u0430? \u041D\u0438\u0447\u0435\u0433\u043E,
      \u043E\u043D\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u043C\u0430\u0445\u0430\u043B\u0438!
      \u0445\u0430\u0445\u0430! ...\u043E, \u044F \u0434\u0443\u043C\u0430\u044E,
      \u0432\u044B \u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u044D\u0442\u043E
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0447\u0430\u0441\u0442\u043E,
      \u0445\u043C...\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 81
    m_Localized: "\u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0445\u043E\u0447\u0443,
      \u0447\u0442\u043E\u0431\u044B \u043C\u043E\u044F \u0441\u0435\u043C\u044C\u044F
      \u0431\u044B\u043B\u0430 \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
      \u0438 \u0436\u0438\u043B\u0430 \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 82
    m_Localized: "\u042F \u0434\u0443\u043C\u0430\u044E, \u0447\u0442\u043E \u043E\u0447\u0435\u043D\u044C
      \u0441\u043A\u043E\u0440\u043E \u0443\u0432\u043E\u043B\u044E\u0441\u044C.
      \u042F \u043F\u0440\u043E\u0441\u0442\u043E... \u044F \u043C\u043E\u0433\u0443
      \u043D\u0430\u0439\u0442\u0438 \u0431\u043E\u043B\u0435\u0435 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0443\u044E
      \u0440\u0430\u0431\u043E\u0442\u0443 \u0442\u0430\u043C, \u043F\u043E\u0431\u043B\u0438\u0436\u0435
      \u043A \u043C\u043E\u0435\u0439 \u0441\u0435\u043C\u044C\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 83
    m_Localized: "\u0414\u0435\u0434\u0443\u0448\u043A\u0430 \u0441\u043A\u0430\u0437\u0430\u043B
      \u043C\u043D\u0435, \u0447\u0442\u043E \u0442\u044B \u043A\u0440\u0430\u0441\u0430\u0432\u0447\u0438\u043A,
      \u0438 \u043E\u043D \u0431\u044B\u043B \u043F\u0440\u0430\u0432!"
    m_Metadata:
      m_Items: []
  - m_Id: 84
    m_Localized: "\u041D\u0430 \u043A\u0430\u043A\u0438\u0445 \u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445
      \u0442\u044B \u043F\u043E\u043B\u043E\u0436\u0438\u043B \u0433\u043B\u0430\u0437?"
    m_Metadata:
      m_Items: []
  - m_Id: 85
    m_Localized: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439
      \u0434\u0435\u043D\u044C, \u043D\u0435 \u0442\u0430\u043A \u043B\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 86
    m_Localized: "\u042F \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0431\u043E\u0436\u0430\u044E
      \u0435\u0437\u0434\u0438\u0442\u044C \u043D\u0430 \u043F\u043E\u0435\u0437\u0434\u0435
      \u0432 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0433\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 87
    m_Localized: "\u0412\u0447\u0435\u0440\u0430 \u0443 \u043D\u0430\u0441 \u0441
      \u0434\u0435\u0434\u0443\u043B\u0435\u0439 \u0431\u044B\u043B\u0430 \u0437\u043E\u043B\u043E\u0442\u0430\u044F
      \u0441\u0432\u0430\u0434\u044C\u0431\u0430 \u2014 50 \u043B\u0435\u0442 \u0432\u043C\u0435\u0441\u0442\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 88
    m_Localized: "\u041F\u043E\u0437\u0432\u043E\u043B\u044C\u0442\u0435 \u043C\u043D\u0435
      \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C \u0432\u0430\u0441
      \u0441\u043E \u0441\u0432\u043E\u0435\u0439 \u0432\u043D\u0443\u0447\u043A\u043E\u0439...
      \u041E\u043D\u0430 \u0432\u0430\u043C \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 89
    m_Localized: "\u042F \u043D\u0430\u0448\u043B\u0430 \u043C\u0443\u0436\u0430
      \u0434\u043B\u044F \u0442\u043E\u0439 \u0432\u043D\u0443\u0447\u043A\u0438,
      \u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u043B\u0430,
      \u0438 \u043E\u043D\u0438 \u0442\u0430\u043A \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 90
    m_Localized: "\u042F \u0441\u043B\u044B\u0448\u0430\u043B\u0430, \u0443 \u0432\u0430\u0441,
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0435\u0441\u0442\u044C
      \u0442\u0430\u0439\u043D\u044B\u0439 \u043F\u043E\u043A\u043B\u043E\u043D\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 91
    m_Localized: "\u042F \u0432\u0438\u0436\u0443, \u043A\u0430\u043A \u043D\u0430
      \u0432\u0430\u0441 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043F\u043E\u0447\u0442\u0430\u043B\u044C\u043E\u043D,
      \u043E\u043D \u0431\u0435\u0437 \u0443\u043C\u0430 \u043E\u0442 \u0432\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 92
    m_Localized: "\u0415\u0441\u043B\u0438 \u0443 \u0442\u0435\u0431\u044F \u0432
      \u0431\u0443\u0434\u0443\u0449\u0435\u043C \u0431\u0443\u0434\u0435\u0442 \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u0435
      \u0441 \u044D\u0442\u0438\u043C \u043F\u043E\u0447\u0442\u0430\u043B\u044C\u043E\u043D\u043E\u043C,
      \u044F \u0431\u044B \u043D\u0430\u0434\u0435\u043B\u0430 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0434\u0440\u0443\u0433\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 93
    m_Localized: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0437\u0434\u0435\u0441\u044C
      \u0442\u0435\u0431\u0435 \u0431\u0443\u0434\u0443\u0442 \u0434\u0430\u0432\u0430\u0442\u044C
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u043F\u0435\u0440\u0435\u0434\u044B\u0448\u0435\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 94
    m_Localized: "\u041E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0441\u044C \u0438 \u0432\u0434\u043E\u0445\u043D\u0438
      \u043C\u043E\u0440\u0441\u043A\u043E\u0439 \u0431\u0440\u0438\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 95
    m_Localized: "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437 \u0442\u044B
      \u0441\u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C
      \u043E\u0434\u043D\u043E\u043C\u0443 \u0438 \u0442\u043E\u043C\u0443 \u0436\u0435
      \u0432\u044B\u0432\u0435\u0441\u0442\u0438 \u0442\u0435\u0431\u044F \u0438\u0437
      \u0441\u0435\u0431\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 96
    m_Localized: "\u041D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u043B\u044E\u0434\u044F\u043C, \u0447\u0442\u043E \u0442\u044B \u0438\u0445
      \u043B\u044E\u0431\u0438\u0448\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 97
    m_Localized: "\u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439,
      \u0447\u0442\u043E \u0432\u0441\u0435\u0433\u0434\u0430 \u043C\u043E\u0436\u043D\u043E
      \u043D\u0430\u0447\u0430\u0442\u044C \u0441 \u0447\u0438\u0441\u0442\u043E\u0433\u043E
      \u043B\u0438\u0441\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 98
    m_Localized: "\u0418 \u0432 \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0435,
      \u0438 \u0432 \u0434\u043E\u0436\u0434\u043B\u0438\u0432\u044B\u0435 \u0434\u043D\u0438
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u0432\u0441\u0451"
    m_Metadata:
      m_Items: []
  - m_Id: 99
    m_Localized: "\u041D\u0435 \u0436\u0434\u0438 \u043D\u043E\u0432\u044B\u0445
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0435\u0439, \u0438\u0434\u0438
      \u0438 \u043D\u0430\u0439\u0434\u0438 \u0438\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 100
    m_Localized: "\u0412 \u043F\u043B\u043E\u0445\u0438\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0430
      \u0445\u043E\u0440\u043E\u0448\u0435\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
      \u0436\u0434\u0451\u0442 \u0442\u0435\u0431\u044F \u0437\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 101
    m_Localized: "\u0415\u0441\u043B\u0438 \u0442\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0448\u044C\u0441\u044F
      \u0447\u0435\u043C-\u0442\u043E \u0435\u0449\u0451, \u0443 \u0442\u0435\u0431\u044F
      \u0435\u0441\u0442\u044C \u043F\u0440\u0438\u0447\u0438\u043D\u0430 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C
      \u0438\u0434\u0442\u0438 \u0432\u043F\u0435\u0440\u0451\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 102
    m_Localized: "\u0422\u044B \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435,
      \u043C\u0430\u043B\u044B\u0448?"
    m_Metadata:
      m_Items: []
  - m_Id: 103
    m_Localized: "\u0427\u0442\u043E-\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 104
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 105
    m_Localized: "\u0417\u043D\u0430\u0435\u0448\u044C, \u043C\u043D\u043E\u0433\u0438\u0435
      \u043E\u0431\u044F\u0437\u0430\u043D\u044B \u0442\u0435\u0431\u0435 \u0436\u0438\u0437\u043D\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 106
    m_Localized: "\u0415\u0441\u043B\u0438 \u0431\u044B \u043D\u0435 \u0442\u044B,
      \u043C\u043D\u043E\u0433\u0438\u0435 \u0436\u0438\u0437\u043D\u0438 \u043C\u043E\u0433\u043B\u0438
      \u0431\u044B \u0431\u044B\u0442\u044C \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 107
    m_Localized: "\u041D\u043E \u044D\u0442\u043E \u0441\u043B\u0430\u0431\u043E\u0435
      \u0443\u0442\u0435\u0448\u0435\u043D\u0438\u0435, \u043D\u0435 \u0442\u0430\u043A
      \u043B\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 108
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 109
    m_Localized: "\u041C\u043D\u0435 \u0436\u0430\u043B\u044C \u0442\u0432\u043E\u0435\u0433\u043E
      \u043F\u0438\u0442\u043E\u043C\u0446\u0430, \u043C\u0430\u043B\u044B\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 110
    m_Localized: "\u042F \u0443\u0436\u0435 \u0434\u0430\u0432\u043D\u043E \u0437\u0430\u043C\u0435\u0442\u0438\u043B,
      \u0447\u0442\u043E \u0442\u044B \u0432\u0441\u0451 \u0440\u0435\u0436\u0435
      \u0438 \u0440\u0435\u0436\u0435 \u0432\u044B\u0432\u043E\u0434\u0438\u0448\u044C
      \u0435\u0433\u043E \u043D\u0430 \u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0443,
      \u0430 \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F
      \u044F \u0435\u0433\u043E \u0432\u043E\u043E\u0431\u0449\u0435 \u043D\u0435
      \u0432\u0438\u0434\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 111
    m_Localized: "\u0427\u0442\u043E-\u0442\u043E \u043C\u043D\u0435 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0441 \u043D\u0438\u043C \u0440\u0430\u0441\u0441\u0442\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 112
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 113
    m_Localized: "\u041C\u043E\u0436\u043D\u043E \u044F \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443
      \u0442\u0435\u0431\u0435 \u043E\u0434\u043D\u0443 \u0438\u0441\u0442\u043E\u0440\u0438\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 114
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u044F \u0431\u044B\u043B \u043C\u043E\u043B\u043E\u0434,
      \u044F \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B \u0434\u0435\u0432\u0443\u0448\u043A\u0443.
      \u042F \u043B\u044E\u0431\u0438\u043B \u0435\u0451 \u0432\u0441\u0435\u043C
      \u0441\u0435\u0440\u0434\u0446\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 115
    m_Localized: "\u041C\u044B \u043F\u043E\u0442\u043E\u0440\u043E\u043F\u0438\u043B\u0438\u0441\u044C
      \u0441\u043E \u0441\u0432\u0430\u0434\u044C\u0431\u043E\u0439, \u0438 \u0443
      \u043C\u0435\u043D\u044F \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C
      \u0441\u0435\u043C\u044C\u044F \u0440\u0430\u043D\u044C\u0448\u0435, \u0447\u0435\u043C
      \u044F \u0431\u044B\u043B \u043A \u044D\u0442\u043E\u043C\u0443 \u0433\u043E\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 116
    m_Localized: "\u041C\u044B \u0435\u0434\u0432\u0430 \u0441\u0432\u043E\u0434\u0438\u043B\u0438
      \u043A\u043E\u043D\u0446\u044B \u0441 \u043A\u043E\u043D\u0446\u0430\u043C\u0438,
      \u0445\u043E\u0442\u044F \u043E\u0431\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 117
    m_Localized: "\u041E\u0434\u043D\u043E\u043C\u0443 \u0438\u0437 \u043D\u0430\u0441
      \u043D\u0443\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435, \u0447\u0442\u043E\u0431\u044B
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0442\u044C \u0434\u0435\u0442\u044F\u043C
      \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u0443\u044E \u0436\u0438\u0437\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 118
    m_Localized: "\u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u044F \u043F\u043E\u0448\u0435\u043B
      \u0432\u043E \u0444\u043B\u043E\u0442. \u0422\u0430\u043C \u0445\u043E\u0440\u043E\u0448\u043E
      \u043F\u043B\u0430\u0442\u0438\u043B\u0438, \u0438 \u044F \u0441\u043C\u043E\u0433
      \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C \u043A\u043E\u043B\u043B\u0435\u0434\u0436."
    m_Metadata:
      m_Items: []
  - m_Id: 119
    m_Localized: "\u042F \u043F\u0440\u043E\u0432\u0435\u043B \u0442\u0430\u043C
      \u0434\u0432\u0430 \u0433\u043E\u0434\u0430, \u0432\u043E \u0432\u0440\u0435\u043C\u044F
      \u0410\u043C\u043C\u043E\u043D\u0438\u0442\u043E\u0432\u043E\u0439 \u0432\u043E\u0439\u043D\u044B,
      \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0441\u044F \u043F\u043E\u0433\u0440\u0443\u0437\u043A\u043E\u0439
      \u0441\u0443\u0434\u043E\u0432. \u0412\u043E\u043E\u0440\u0443\u0436\u0430\u043B
      \u0438\u0445 \u0442\u043E\u0440\u043F\u0435\u0434\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 120
    m_Localized: "\u042F \u043D\u0438 \u0440\u0430\u0437\u0443 \u043D\u0435 \u0441\u0442\u0443\u043F\u0430\u043B
      \u043D\u0430 \u0431\u043E\u0440\u0442 \u043A\u043E\u0440\u0430\u0431\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 121
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0432\u043E\u0439\u043D\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C,
      \u044F \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0434\u0438\u043F\u043B\u043E\u043C
      \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u0430 \u0438 \u043D\u0430\u0447\u0430\u043B
      \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0432 \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439
      \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 122
    m_Localized: "\u0412 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0434\u043E\u0447\u0435\u0440\u043D\u0435\u0439
      \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \xAB\u0420\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u043E\u0439
      \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 123
    m_Localized: "\u041E\u043D\u0438 \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0438\u0441\u044C
      \u0441\u043E\u043C\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438
      \u0434\u0435\u043B\u0430\u043C\u0438, \u043D\u043E \u044F \u043D\u0435 \u043F\u0440\u0438\u0434\u0430\u0432\u0430\u043B
      \u044D\u0442\u043E\u043C\u0443 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F.
      \u0412 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432,
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u044D\u0442\u043E\u0439
      \u0440\u0430\u0431\u043E\u0442\u0435 \u044F \u043C\u043E\u0433 \u043E\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0442\u044C
      \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u0441\u0432\u043E\u0438\u0445
      \u0434\u0435\u0442\u0435\u0439 \u0432 \u043A\u043E\u043B\u043B\u0435\u0434\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 124
    m_Localized: "\u042D\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u043B\u043E
      \u043C\u043D\u0435 \u043A\u0430\u0436\u0434\u044B\u0439 \u0433\u043E\u0434
      \u0441\u043E\u0432\u0435\u0440\u0448\u0430\u0442\u044C \u043A\u0440\u0443\u0433\u043E\u0441\u0432\u0435\u0442\u043D\u043E\u0435
      \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 125
    m_Localized: "\u041E\u0434\u043D\u0430\u0436\u0434\u044B \u044F \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F
      \u0432 \u0410\u043C\u043C\u043E\u043D\u0430\u0442\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 126
    m_Localized: "\u042F \u043D\u0430\u0442\u043A\u043D\u0443\u043B\u0441\u044F \u043D\u0430
      \u043E\u0434\u043D\u043E \u0438\u0437 \u0442\u0435\u0445 \u043C\u0435\u0441\u0442,
      \u0433\u0434\u0435 \u0431\u044B\u0432\u0430\u043B \u0444\u043B\u043E\u0442,
      \u0438 \u0443\u0432\u0438\u0434\u0435\u043B \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E
      \u043E\u043A\u0430\u043C\u0435\u043D\u0435\u043B\u043E\u0441\u0442\u0435\u0439,
      \u0440\u0430\u0437\u0431\u0440\u043E\u0441\u0430\u043D\u043D\u044B\u0445 \u043F\u043E
      \u0437\u0435\u043C\u043B\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 127
    m_Localized: "...\u0438 \u0432\u0441\u0435 \u043E\u043D\u0438 \u0431\u044B\u043B\u0438
      \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u044B \u0441\u0442\u0430\u0440\u044B\u043C\u0438
      \u0442\u043E\u0440\u043F\u0435\u0434\u043D\u044B\u043C\u0438 \u043A\u043E\u0440\u043F\u0443\u0441\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 128
    m_Localized: "\u0418 \u044F, \u043A\u0430\u043A \u0438 \u0442\u044B, \u043F\u043E\u043D\u044F\u043B,
      \u0447\u0442\u043E \u043D\u0435\u0441\u0443 \u0437\u0430 \u044D\u0442\u043E
      \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 129
    m_Localized: "\u042F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435
      \u0431\u044B\u043B \u043A\u0430\u043F\u0438\u0442\u0430\u043D\u043E\u043C \u043A\u043E\u0440\u0430\u0431\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 130
    m_Localized: "\u042F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435
      \u0441\u043F\u0443\u0441\u043A\u0430\u043B \u043D\u0430 \u0432\u043E\u0434\u0443
      \u0442\u043E\u0440\u043F\u0435\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 131
    m_Localized: "\u041D\u043E \u043B\u044E\u0431\u0443\u044E \u0438\u0437 \u044D\u0442\u0438\u0445
      \u0442\u043E\u0440\u043F\u0435\u0434 \u043C\u043E\u0433 \u0437\u0430\u0440\u044F\u0434\u0438\u0442\u044C
      \u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 132
    m_Localized: "\u0418, \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C,
      \u0435\u0441\u043B\u0438 \u0431\u044B \u043C\u0435\u043D\u044F \u0442\u0430\u043C
      \u043D\u0435 \u0431\u044B\u043B\u043E, \u0432\u044B\u0436\u0438\u043B\u043E
      \u0431\u044B \u0435\u0449\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0430\u043C\u043C\u043E\u043D\u0438\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 133
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 134
    m_Localized: "\u042F \u0443\u0432\u043E\u043B\u0438\u043B\u0441\u044F \u0441
      \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u0438 \u043C\u0430\u0448\u0438\u043D\u0438\u0441\u0442\u0430
      \u043F\u043E\u0435\u0437\u0434\u0430, \u043A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 135
    m_Localized: "\u042F \u0432\u043C\u0435\u0441\u0442\u043E \u044D\u0442\u043E\u0433\u043E
      \u0443\u0441\u0442\u0440\u043E\u0438\u043B\u0441\u044F \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u0432 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0441\u0435\u043C\u0435\u0439\u043D\u0443\u044E
      \u0430\u0432\u0442\u043E\u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 136
    m_Localized: "\u042F \u043D\u0435 \u0435\u0437\u0434\u0438\u043B \u0432 \u043E\u0442\u043F\u0443\u0441\u043A
      \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 137
    m_Localized: "\u041D\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u044F \u043C\u043E\u0433\u0443
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0441\u043F\u0430\u0442\u044C
      \u043F\u043E \u043D\u043E\u0447\u0430\u043C, \u0437\u043D\u0430\u044F, \u0447\u0442\u043E
      \u0443\u0448\u0435\u043B \u0438\u0437 \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439
      \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \u0434\u043E \u0442\u043E\u0433\u043E,
      \u043A\u0430\u043A\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 138
    m_Localized: "\u2026\u044D\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 139
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 140
    m_Localized: "\u0422\u0435\u0431\u044F \u0436\u0434\u0443\u0442 \u0442\u044F\u0436\u0435\u043B\u044B\u0435
      \u043D\u0435\u0434\u0435\u043B\u0438, \u043F\u0430\u0440\u0435\u043D\u044C.
      \u0418 \u0442\u044F\u0436\u0435\u043B\u044B\u0435 \u0433\u043E\u0434\u044B,
      \u043F\u043E\u043A\u0430 \u0442\u044B \u043D\u0435 \u0432\u0441\u0442\u0430\u043D\u0435\u0448\u044C
      \u043D\u0430 \u043D\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 141
    m_Localized: "\u041D\u043E \u044F \u043D\u0430\u0434\u0435\u044E\u0441\u044C,
      \u0442\u044B \u043D\u0438 \u0441\u0435\u043A\u0443\u043D\u0434\u044B \u043E\u0431
      \u044D\u0442\u043E\u043C \u043D\u0435 \u043F\u043E\u0436\u0430\u043B\u0435\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 142
    m_Localized: "\u0422\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u043A\u0443\u043F\u0438\u0442\u044C
      \u0441\u0435\u0431\u0435 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u043A\u0440\u0430\u0441\u0438\u0432\u043E\u0435\u2026 \u0442\u044B \u044D\u0442\u043E\u0433\u043E
      \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 143
    m_Localized: "\u0422\u044B \u043F\u0440\u043E\u0447\u043B\u0430 \u043C\u043E\u0451
      \u043F\u0438\u0441\u044C\u043C\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 144
    m_Localized: "\u041A\u0430\u043A \u0434\u0443\u043C\u0430\u0435\u0448\u044C,
      \u0442\u044B \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C
      \u043F\u043E\u043B\u044E\u0431\u0438\u0448\u044C \u043A\u043E\u0433\u043E-\u0442\u043E
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u0441\u0432\u043E\u0435\u0433\u043E
      \u0438\u0437\u043E\u043F\u043E\u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 145
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u0439 \u043D\u0435\u0434\u0435\u043B\u0435
      \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u0448\u043B\u043E \u0431\u043E\u043B\u044C\u0448\u0435
      \u043F\u0438\u0441\u0435\u043C, \u0447\u0435\u043C \u043E\u0431\u044B\u0447\u043D\u043E.
      \u041C\u043E\u0436\u0435\u0442, \u0443 \u0442\u0435\u0431\u044F \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
      \u043F\u043E\u043A\u043B\u043E\u043D\u043D\u0438\u043A, \u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u044F \u043D\u0435 \u0437\u043D\u0430\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 146
    m_Localized: "\u0422\u044B \u0432\u0435\u0434\u044C \u0442\u0440\u0430\u0442\u0438\u0448\u044C
      \u0434\u0435\u043D\u044C\u0433\u0438 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0430 \u0441\u0432\u043E\u0435\u0433\u043E \u0438\u0437\u043E\u043F\u043E\u0434\u0430,
      \u0432\u0435\u0440\u043D\u043E\u2026?"
    m_Metadata:
      m_Items: []
  - m_Id: 147
    m_Localized: "\u0414\u0430\u0432\u0430\u0439 \u043A\u0430\u043A-\u043D\u0438\u0431\u0443\u0434\u044C
      \u043F\u043E\u043E\u0431\u0435\u0434\u0430\u0435\u043C \u0432\u043C\u0435\u0441\u0442\u0435,
      \u043A\u043E\u0433\u0434\u0430 \u0443 \u043D\u0430\u0441 \u043E\u0431\u043E\u0438\u0445
      \u0431\u0443\u0434\u0435\u0442 \u043F\u0435\u0440\u0435\u0440\u044B\u0432.
      \u041E\u0431\u0435\u0449\u0430\u044E, \u044F \u043D\u0435 \u0431\u0443\u0434\u0443
      \u0442\u0435\u0431\u044F \u0433\u0440\u0443\u0437\u0438\u0442\u044C\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 148
    m_Localized: "\u0422\u044B \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0434\u0443\u043C\u0430\u0435\u0448\u044C \u043E \u0442\u043E\u043C, \u0447\u0442\u043E\u0431\u044B
      \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u043E\u0442\u0441\u044E\u0434\u0430?..
      \u042F \u2014 \u0434\u0430. \u041D\u043E \u0438\u0437-\u0437\u0430 \u0442\u0435\u0431\u044F
      \u043C\u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 149
    m_Localized: "\u0417\u043D\u0430\u0435\u0448\u044C, \u044F \u0443\u0436\u0435
      \u043D\u0430\u0447\u0438\u043D\u0430\u044E \u0434\u0443\u043C\u0430\u0442\u044C,
      \u0447\u0442\u043E \u0434\u0430\u0436\u0435 \u0442\u0432\u043E\u0439 \u0432\u0435\u0442\u0435\u0440\u0438\u043D\u0430\u0440
      \u0432\u0438\u0434\u0438\u0442 \u0442\u0435\u0431\u044F \u0447\u0430\u0449\u0435,
      \u0447\u0435\u043C \u044F\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 150
    m_Localized: "\u042F \u0432\u0438\u0434\u0435\u043B, \u043A\u0430\u043A \u0414\u0435\u0434\u0443\u043B\u044F
      \u0441 \u0442\u043E\u0431\u043E\u0439 \u0431\u043E\u043B\u0442\u0430\u043B\u2026
      \u043E\u043F\u044F\u0442\u044C \u0441\u043E\u0432\u0435\u0442\u043E\u0432\u0430\u043B
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u043F\u0435\u043D\u0441\u0438\u043E\u043D\u043D\u044B\u0439
      \u0441\u0447\u0451\u0442 Roth IRA?"
    m_Metadata:
      m_Items: []
  - m_Id: 151
    m_Localized: "\u041D\u0435 \u0437\u0440\u044F \u043C\u043D\u0435 \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
      \u0447\u0442\u043E \u0442\u044B \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0441\u0438\u043C\u043F\u0430\u0442\u0438\u0447\u043D\u0430\u044F \u043C\u043E\u0440\u0434\u0430\u0448\u043A\u0430
      \u2014 \u0443 \u0442\u0435\u0431\u044F \u0435\u0449\u0451 \u0438 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u044B
      \u0447\u0442\u043E \u043D\u0430\u0434\u043E. \u042F \u0442\u0430\u043A\u043E\u0435
      \u0443\u0432\u0430\u0436\u0430\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 152
    m_Localized: "\u0417\u043D\u0430\u0435\u0448\u044C, \u043C\u043D\u043E\u0433\u0438\u0435
      \u0445\u043E\u0442\u044F\u0442 \u0442\u0435\u0431\u044F \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 153
    m_Localized: "\u041F\u043E\u0445\u043E\u0436\u0435, \u043A\u0440\u043E\u043C\u0435
      \u0441\u0438\u043C\u043F\u0430\u0442\u0438\u0447\u043D\u043E\u0439 \u043C\u043E\u0440\u0434\u0430\u0448\u043A\u0438,
      \u0437\u0430 \u0442\u043E\u0431\u043E\u0439 \u0432\u0441\u0451-\u0442\u0430\u043A\u0438
      \u043D\u0438\u0447\u0435\u0433\u043E \u0438 \u043D\u0435\u0442\u2026 \u0410
      \u044F \u0432\u0435\u0434\u044C \u043F\u0440\u0430\u0432\u0434\u0430 \u0432
      \u0442\u0435\u0431\u044F \u0432\u0435\u0440\u0438\u043B\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 154
    m_Localized: "\u2026\u043D\u0443, \u043D\u0430\u0434\u0435\u044E\u0441\u044C,
      \u0445\u043E\u0442\u044C \u0434\u0435\u043D\u044C \u0443 \u0442\u0435\u0431\u044F
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0445\u043E\u0440\u043E\u0448\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 155
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442! \u041D\u0443 \u043A\u0430\u043A
      \u043C\u044B \u0441\u0435\u0433\u043E\u0434\u043D\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 156
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u043F\u0440\u043E\u0441\u0442\u043E
      \u043E\u0431\u044B\u0447\u043D\u044B\u0439 \u043E\u0441\u043C\u043E\u0442\u0440
      \u0434\u043B\u044F \u0442\u0432\u043E\u0435\u0433\u043E \u043C\u0430\u043B\u044B\u0448\u0430?
      \u041C-\u043C, \u044D\u0442\u043E \u043C\u044B \u0435\u0449\u0451 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 157
    m_Localized: "\u041E-\u043E-\u043E\u2026 \u0445\u043C\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 158
    m_Localized: "\u0422\u0430\u043A\u2026 \u0430 \u0432\u043E\u0442 \u0442\u0432\u043E\u0439
      \u0434\u0440\u0443\u0436\u043E\u043A \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0435
      \u0432 \u043B\u0443\u0447\u0448\u0435\u0439 \u0444\u043E\u0440\u043C\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 159
    m_Localized: "\u0422\u044B \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438!
      \u041E\u0434\u043D\u0430 \u043B\u0430\u043F\u043A\u0430 \u043A\u043E\u0440\u043E\u0447\u0435
      \u0434\u0440\u0443\u0433\u043E\u0439 \u2014 \u044F\u0432\u043D\u044B\u0439
      \u043F\u0440\u0438\u0437\u043D\u0430\u043A \u043D\u0435\u0434\u043E\u0435\u0434\u0430\u043D\u0438\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 160
    m_Localized: "\u041D\u0435\u0442-\u043D\u0435\u0442, \u044F \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u044E,
      \u0447\u0442\u043E \u0442\u044B \u043F\u043B\u043E\u0445\u043E \u0437\u0430
      \u043D\u0438\u043C \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 161
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E \u0442\u0432\u043E\u0435\u043C\u0443
      \u0438\u0437\u043E\u043F\u043E\u0434\u0443 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
      \u043F\u0438\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0432\u0435\u0449\u0435\u0441\u0442\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 162
    m_Localized: "\u0422\u044B \u0436\u0435 \u0437\u043D\u0430\u0435\u0448\u044C,
      \u043A\u0430\u043A\u0438\u0435 \u0441\u0435\u0439\u0447\u0430\u0441 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043D\u044B\u0435
      \u043A\u043E\u0440\u043C\u0430: \u0432\u0441\u0451 \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u043E\u0435,
      \u0441\u043F\u043B\u043E\u0448\u043D\u044B\u0435 \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 163
    m_Localized: "\u0412\u043E\u0442, \u044F \u043B\u0438\u0447\u043D\u043E \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u044E
      \u0438\u043C\u0435\u043D\u043D\u043E \u044D\u0442\u0443 \u043C\u0430\u0440\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 164
    m_Localized: "\u0414\u0430, \u043E\u043D\u0430 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0434\u043E\u0440\u043E\u0436\u0435, \u0437\u0430\u0442\u043E, \u043E\u0431\u0435\u0449\u0430\u044E,
      \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u043F\u0438\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u0435\u0435
      \u0438 \u043D\u0430\u0442\u0443\u0440\u0430\u043B\u044C\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 165
    m_Localized: "\u041E\u0447\u0435\u043D\u044C \u0441\u043E\u0432\u0435\u0442\u0443\u044E
      \u043F\u0435\u0440\u0435\u0439\u0442\u0438 \u043D\u0430 \u043D\u0435\u0451
      \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u0441\u043A\u043E\u0440\u0435\u0435,
      \u0438\u043D\u0430\u0447\u0435 \u0442\u0432\u043E\u0439 \u0438\u0437\u043E\u043F\u043E\u0434
      \u0440\u0438\u0441\u043A\u0443\u0435\u0442 \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E
      \u0437\u0430\u0431\u043E\u043B\u0435\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 166
    m_Localized: "\u0427\u0442\u043E \u044F \u0438\u043C\u0435\u044E \u0432 \u0432\u0438\u0434\u0443?
      \u0412\u0438\u0434\u0438\u0448\u044C \u043B\u0438\u2026 \u0434\u0435\u043B\u043E
      \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u043A\u043E\u0440\u043C\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 167
    m_Localized: "\u041F\u043E\u0445\u043E\u0436\u0435, \u0443 \u0442\u0432\u043E\u0435\u0433\u043E
      \u0438\u0437\u043E\u043F\u043E\u0434\u0430 \u0442\u044F\u0436\u0451\u043B\u043E\u0435
      \u0445\u0440\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u0437\u0430\u0431\u043E\u043B\u0435\u0432\u0430\u043D\u0438\u0435
      \u0434\u044B\u0445\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 168
    m_Localized: "\u0421\u0443\u0434\u044F \u043F\u043E \u0432\u0441\u0435\u043C\u0443,
      \u043E\u043D\u043E \u0433\u0435\u043D\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435:
      \u0436\u0430\u0431\u0440\u044B \u0442\u0432\u043E\u0435\u0433\u043E \u0438\u0437\u043E\u043F\u043E\u0434\u0430
      \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E
      \u043F\u043E\u0433\u043B\u043E\u0449\u0430\u0442\u044C \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 169
    m_Localized: "\u0421\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u043D\u0430\u0447\u043D\u0443\u0442\u0441\u044F
      \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u044B\u0435 \u043E\u0441\u043B\u043E\u0436\u043D\u0435\u043D\u0438\u044F,
      \u0438 \u044D\u0442\u043E \u043D\u0435\u0438\u0437\u0431\u0435\u0436\u043D\u043E
      \u043F\u0440\u0438\u0432\u0435\u0434\u0451\u0442 \u043A \u0440\u0430\u043D\u043D\u0435\u0439
      \u0441\u043C\u0435\u0440\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 170
    m_Localized: "\u041D\u0443\u0436\u043D\u043E \u0432\u0437\u044F\u0442\u044C \u043E\u0431\u0440\u0430\u0437\u0435\u0446
      \u0442\u043A\u0430\u043D\u0438 \u043D\u0430 \u0430\u043D\u0430\u043B\u0438\u0437,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043D\u044F\u0442\u044C, \u043A\u0430\u043A\u043E\u0435
      \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E \u043F\u043E\u0434\u043E\u0439\u0434\u0451\u0442
      \u043B\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 171
    m_Localized: "\u0412 \u0445\u0443\u0434\u0448\u0435\u043C \u0441\u043B\u0443\u0447\u0430\u0435
      \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0434\u0435\u043B\u0430\u0442\u044C
      \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044E \u0438 \u0437\u0430\u043C\u0435\u043D\u044F\u0442\u044C
      \u0436\u0430\u0431\u0440\u044B \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 172
    m_Localized: "\u041C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0436\u0430\u043B\u044C
      \u0441\u043E\u043E\u0431\u0449\u0430\u0442\u044C \u0442\u0430\u043A\u0438\u0435
      \u043F\u043B\u043E\u0445\u0438\u0435 \u043D\u043E\u0432\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 173
    m_Localized: "\u041D\u0430 \u044D\u0442\u0443 \u043D\u0435\u0434\u0435\u043B\u044E
      \u044F \u0432\u044B\u043F\u0438\u0448\u0443 \u043B\u0435\u0447\u0435\u0431\u043D\u044B\u0435
      \u0445\u043B\u043E\u043F\u044C\u044F, \u0430 \u043E\u0431\u0440\u0430\u0437\u0435\u0446
      \u0432\u043E\u0437\u044C\u043C\u0451\u043C \u0441\u0435\u0433\u043E\u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 174
    m_Localized: "\u041F\u043E\u0432\u0435\u0440\u044C, \u044F \u0441\u0434\u0435\u043B\u0430\u044E
      \u0432\u0441\u0451 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0435,
      \u0447\u0442\u043E\u0431\u044B \u0441\u043F\u0430\u0441\u0442\u0438 \u0442\u0432\u043E\u0435\u0433\u043E
      \u043B\u044E\u0431\u0438\u043C\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 175
    m_Localized: "\u0418\u0442\u043E\u0433\u043E \u0437\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u2014 \u043E\u043A\u043E\u043B\u043E 800 \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 176
    m_Localized: "\u2026\u0410 \u0447\u0435\u0433\u043E \u043B\u0438\u0446\u043E
      \u0442\u0430\u043A\u043E\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 177
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442! \u041D\u0430\u0434\u0435\u044E\u0441\u044C,
      \u0443 \u0432\u0430\u0441 \u043E\u0431\u043E\u0438\u0445 \u0432\u0441\u0451
      \u0445\u043E\u0440\u043E\u0448\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 178
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u044F \u043E\u0441\u043C\u043E\u0442\u0440\u044E
      \u0442\u0432\u043E\u0435\u0433\u043E \u043C\u0430\u043B\u044B\u0448\u0430,
      \u0430 \u043F\u043E\u0442\u043E\u043C \u043E\u0431\u0441\u0443\u0434\u0438\u043C
      \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B \u0430\u043D\u0430\u043B\u0438\u0437\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 179
    m_Localized: "\u0425\u043C\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 180
    m_Localized: "\u041D\u0430\u0447\u043D\u0451\u043C \u0441 \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E:
      \u0442\u0432\u043E\u0439 \u0438\u0437\u043E\u043F\u043E\u0434 \u0432 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u043C \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438,
      \u0435\u043C\u0443 \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u043B\u0443\u0447\u0448\u0435,
      \u0447\u0435\u043C \u043D\u0430 \u043F\u0440\u043E\u0448\u043B\u043E\u0439
      \u043D\u0435\u0434\u0435\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 181
    m_Localized: "\u0410 \u043F\u043B\u043E\u0445\u0430\u044F \u043D\u043E\u0432\u043E\u0441\u0442\u044C
      \u2014 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B \u0430\u043D\u0430\u043B\u0438\u0437\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 182
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0442\u0432\u043E\u0435\u043C\u0443
      \u0438\u0437\u043E\u043F\u043E\u0434\u0443 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u044F\u0442\u0441\u044F
      \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u044B\u0435 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0449\u0438\u0435
      \u0443\u043A\u043E\u043B\u044B \u0438 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 183
    m_Localized: "\u041D\u043E \u044D\u0442\u043E\u0433\u043E \u0431\u0443\u0434\u0435\u0442
      \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E. \u041B\u0443\u0447\u0448\u0435\u0435
      \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u2014 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
      \u0436\u0430\u0431\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 184
    m_Localized: "\u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
      \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u044B\u0435. \u0423\u043A\u043E\u043B\u044B
      \u0438 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430 \u2014 \u043B\u0438\u0448\u044C
      \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F \u043C\u0435\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 185
    m_Localized: "\u041E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439
      \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u2014 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044F
      \u043F\u043E \u0437\u0430\u043C\u0435\u043D\u0435 \u0436\u0430\u0431\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 186
    m_Localized: "\u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
      \u0442\u0432\u043E\u044F \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u043A\u0430
      \u043E\u0442 \u0440\u0430\u0431\u043E\u0442\u043E\u0434\u0430\u0442\u0435\u043B\u044F
      \u044D\u0442\u043E\u0433\u043E \u043D\u0435 \u043F\u043E\u043A\u0440\u044B\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 187
    m_Localized: "\u041F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0438\u0437 \u0441\u0432\u043E\u0435\u0433\u043E \u043A\u0430\u0440\u043C\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 188
    m_Localized: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0441\u0434\u0435\u043B\u0430\u0435\u043C
      \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0449\u0438\u0439
      \u0443\u043A\u043E\u043B, \u0438 \u044F \u0432\u044B\u043F\u0438\u0448\u0443
      \u043D\u043E\u0432\u044B\u0435 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 189
    m_Localized: "\u041A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443
      \u0432\u0438\u0437\u0438\u0442\u0443 \u0434\u0430\u0439 \u0437\u043D\u0430\u0442\u044C,
      \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u0435\u0448\u044C \u043B\u0438 \u0434\u0435\u043B\u0430\u0442\u044C
      \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 190
    m_Localized: "\u0426\u0435\u043D\u0430? \u041D\u0443\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 191
    m_Localized: "\u0421\u0440\u0430\u0437\u0443 \u0441\u043A\u0430\u0436\u0443:
      \u0434\u0451\u0448\u0435\u0432\u043E \u043D\u0435 \u0431\u0443\u0434\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 192
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0432\u0441\u0451-\u0442\u0430\u043A\u0438
      \u0434\u0435\u043B\u0430\u0435\u043C \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044E?
      \u041E\u0442\u043B\u0438\u0447\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 193
    m_Localized: "\u0417\u0430\u043F\u0438\u0448\u0435\u043C \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E
      \u043D\u0435\u0434\u0435\u043B\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 194
    m_Localized: "\u0410 \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0438\u0439
      \u0443\u043A\u043E\u043B? \u0414\u0430-\u0434\u0430, \u0441\u0435\u0439\u0447\u0430\u0441
      \u0441\u0434\u0435\u043B\u0430\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 195
    m_Localized: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0443\u0436\u043D\u043E
      \u0432\u043D\u0435\u0441\u0442\u0438 \u043D\u0435\u0432\u043E\u0437\u0432\u0440\u0430\u0442\u043D\u044B\u0439
      \u0434\u0435\u043F\u043E\u0437\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 196
    m_Localized: "\u0414\u0430, \u0441\u0435\u0433\u043E\u0434\u043D\u044F. \u0418
      \u0434\u0430, \u043D\u0435\u0432\u043E\u0437\u0432\u0440\u0430\u0442\u043D\u044B\u0439.
      \u0410 \u043A\u0430\u043A \u043C\u043D\u0435 \u0435\u0449\u0451 \u0432\u044B\u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0441\u0432\u043E\u0439\u2014"
    m_Metadata:
      m_Items: []
  - m_Id: 197
    m_Localized: "\u042D\u043C\u2026 \u041B\u0430\u0434\u043D\u043E, \u043D\u0435\u0432\u0430\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 198
    m_Localized: "\u042D\u0442\u043E \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u0430\u044F
      \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0430. \u041D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
      \u0447\u0435\u0433\u043E \u0442\u044B \u0442\u0430\u043A \u0437\u043B\u0438\u0448\u044C\u0441\u044F\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 199
    m_Localized: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
      \u0438 \u043D\u0430 \u0434\u0435\u043F\u043E\u0437\u0438\u0442, \u0438 \u043D\u0430
      \u043E\u0431\u044B\u0447\u043D\u043E\u0435 \u043B\u0435\u0447\u0435\u043D\u0438\u0435?
      \u041D\u0443 \u0442\u043E\u0433\u0434\u0430\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 200
    m_Localized: "\u0415\u0441\u043B\u0438 \u0441 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0435\u0439
      \u0432\u0441\u0451 \u0440\u0435\u0448\u0435\u043D\u043E, \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0438\u0439
      \u0443\u043A\u043E\u043B \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 201
    m_Localized: "\u0414\u0430, \u043E\u0434\u0438\u043D \u0440\u0430\u0437 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0449\u0438\u0439
      \u0443\u043A\u043E\u043B \u043C\u043E\u0436\u043D\u043E\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 202
    m_Localized: "\u041D\u043E \u0435\u0441\u043B\u0438 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0451\u043C
      \u0434\u0430\u0432\u0430\u0442\u044C \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430,
      \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044F \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u043D\u0435\u0434\u0435\u043B\u0435 \u0443\u0436\u0435 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 203
    m_Localized: "\u0422\u0430\u043A \u0447\u0442\u043E \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u043D\u0435\u0434\u0435\u043B\u0435 \u043B\u0443\u0447\u0448\u0435 \u043D\u0430\u0441\u043A\u0440\u0435\u0441\u0442\u0438
      \u043D\u0443\u0436\u043D\u0443\u044E \u0441\u0443\u043C\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 204
    m_Localized: "\u0414\u0435\u043D\u044C\u0433\u0438 \u0435\u0441\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 205
    m_Localized: "\u2026\u041E\u0433\u043E. \u0414\u0430\u0436\u0435 \u0441 \u0442\u0432\u043E\u0435\u0439
      \u0436\u0430\u043B\u043A\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u0451\u043D\u043A\u043E\u0439
      \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043D\u0430\u0441\u043A\u0440\u0435\u0441\u0442\u0438
      \u043D\u0443\u0436\u043D\u0443\u044E \u0441\u0443\u043C\u043C\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 206
    m_Localized: "\u042D-\u044D-\u044D\u2026 \u043D\u0435 \u0442\u043E \u0447\u0442\u043E\u0431\u044B
      \u044F \u0437\u043D\u0430\u044E, \u0433\u0434\u0435 \u0442\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0448\u044C.
      \u041F\u0440\u043E\u0441\u0442\u043E \u043F\u043E \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u0435
      \u0431\u044B\u043B\u043E \u043F\u043E\u043D\u044F\u0442\u043D\u043E, \u0447\u0442\u043E
      \u0440\u0430\u0431\u043E\u0442\u0430 \u0442\u0430\u043A \u0441\u0435\u0431\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 207
    m_Localized: "\u041D\u0443, \u0440\u0430\u0437 \u0432\u0441\u044F \u0441\u0443\u043C\u043C\u0430
      \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C, \u0431\u0443\u0434\u0435\u043C
      \u0432\u0432\u043E\u0434\u0438\u0442\u044C \u0442\u0432\u043E\u0435\u0433\u043E
      \u0438\u0437\u043E\u043F\u043E\u0434\u0430 \u0432 \u043D\u0430\u0440\u043A\u043E\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 208
    m_Localized: "\u041D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439,
      \u043C\u044B \u0441\u0434\u0435\u043B\u0430\u0435\u043C \u0432\u0441\u0451
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 209
    m_Localized: "\u041E\u043D \u0432\u044B\u043A\u0430\u0440\u0430\u0431\u043A\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 210
    m_Localized: "\u0414\u0435\u043D\u044C\u0433\u0438 \u0435\u0441\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 211
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 212
    m_Localized: "\u042D\u0442\u043E\u0433\u043E \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 213
    m_Localized: "\u0418\u0437\u0432\u0438\u043D\u0438, \u0442\u044B \u0447\u0442\u043E,
      \u0434\u0443\u043C\u0430\u0435\u0448\u044C, \u043C\u044B \u0431\u043B\u0430\u0433\u043E\u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F? \u041D\u0430\u043C
      \u0442\u043E\u0436\u0435 \u0435\u0441\u0442\u044C \u043A\u043E\u0433\u043E
      \u043A\u043E\u0440\u043C\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 214
    m_Localized: "\u041F\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C \u043C\u044B
      \u043D\u0435 \u043C\u043E\u0436\u0435\u043C \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C
      \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044E, \u043F\u043E\u043A\u0430
      \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043C \u0432\u0441\u044E
      \u0441\u0443\u043C\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 215
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 216
    m_Localized: "\u0423\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044C
      \u043C\u0435\u043D\u044F \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u043E.
      \u042F \u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C
      \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C \u0438\u0437-\u0437\u0430
      \u044D\u0442\u043E\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 217
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438?
      \u041C\u043D\u0435 \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u0442\u0443\u0442
      \u0432\u0441\u0451 \u0431\u044B\u043B\u043E \u044F\u0441\u043D\u043E\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 218
    m_Localized: "\u0422\u043E\u0442 \u043D\u0435\u0432\u043E\u0437\u0432\u0440\u0430\u0442\u043D\u044B\u0439
      \u0434\u0435\u043F\u043E\u0437\u0438\u0442 \u0441 \u043F\u0440\u043E\u0448\u043B\u043E\u0439
      \u043D\u0435\u0434\u0435\u043B\u0438\u2026 \u043E\u043D \u043D\u0435\u0432\u043E\u0437\u0432\u0440\u0430\u0442\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 219
    m_Localized: "\u0410 \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0438\u0439?
      \u041D\u0443\u2026 \u044D\u0442\u043E \u043F\u043B\u0430\u0442\u0430 \u0437\u0430
      \u043A\u043E\u043D\u0441\u0443\u043B\u044C\u0442\u0430\u0446\u0438\u044E. \u0418
      \u0443\u0433\u0430\u0434\u0430\u0439 \u0447\u0442\u043E? \u041A\u043E\u043D\u0441\u0443\u043B\u044C\u0442\u0430\u0446\u0438\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u0430\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 220
    m_Localized: "\u0422\u0430\u043A \u0447\u0442\u043E \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 221
    m_Localized: "\u041E, \u0437\u043D\u0430\u0435\u0448\u044C \u0447\u0442\u043E?
      \u0412\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 222
    m_Localized: "\u0411\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E\u0435 \u043D\u0430\u0434\u0433\u0440\u043E\u0431\u0438\u0435
      \u2014 \u0437\u0430 \u0441\u0447\u0451\u0442 \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u044F.
      \u0412\u0445\u043E\u0434\u0438\u0442 \u0432 \u043D\u0430\u0448 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0439
      \u043F\u0430\u043A\u0435\u0442 \u043F\u043E\u0441\u043C\u0435\u0440\u0442\u043D\u043E\u0433\u043E
      \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F \u0434\u043B\u044F
      \u0432\u0441\u0435\u0445 \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 223
    m_Localized: "\u041F\u043E\u043A\u0430-\u043F\u043E\u043A\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 224
    m_Localized: "\u043A\u0430\u043F\u2026 \u043A\u0430\u043F\u2026 \u043A\u0430\u043F"
    m_Metadata:
      m_Items: []
  - m_Id: 225
    m_Localized: "\u0433\u0440\u0440\u0440\u044D\u044D\u044D\u0433\u0445\u0445\u0445\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 226
    m_Localized: "\u043E\u0442\u043F\u0443\u0441\u0442\u0438\u2026 \u043C\u0435\u043D\u044F\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 227
    m_Localized: "\u0441\u043A\u0432\u0430\u0430\u043A-\u043A\u043B\u0430\u043A-\u043A\u043B\u0430\u043A-\u043A\u043B\u0430\u043A-\u043A\u043B\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 228
    m_Localized: "*\u0445\u043B\u044E\u043F* (\u0437\u0432\u0443\u043A\u043E\u0432\u043E\u0439
      \u044D\u0444\u0444\u0435\u043A\u0442)"
    m_Metadata:
      m_Items: []
  - m_Id: 229
    m_Localized: "\u0411\u043B\u0438\u043D, \u043A\u0430\u043A\u0438\u0435 \u043A\u043B\u0430\u0441\u0441\u043D\u044B\u0435
      \u043D\u043E\u0433\u0438! \u041F\u0440\u0430\u0432\u0434\u0430? \u041F\u0420\u0410\u0412\u0414\u0410???"
    m_Metadata:
      m_Items: []
  - m_Id: 230
    m_Localized: "\u0433\u0440\u0430\u0430\u0430\u0432\u0432\u0432\u0432\u0432\u0440\u0440\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 231
    m_Localized: "\u0440\u0440\u0440\u0440\u0440\u0433\u0433\u0433\u0445\u0445\u0445\u0445"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
