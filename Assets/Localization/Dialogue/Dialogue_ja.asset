    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: "\u307E\u3060\u7814\u7A76\u8077\u306E\u52DF\u96C6\u306F\u3042\u308A\u307E\u3059\u304B\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: "Crustacean corp \u304C\u79C1\u306B\u4ED5\u4E8B\u3092\u63D0\u4F9B\u3057\u3066\u304F\u308C\u305F\u304C\u3001\u3042\u3044\u3064\u3089\u306B\u306F\u4F55\u304B\u304A\u304B\u3057\u306A\u3068\u3053\u308D\u304C\u3042\u308B"
