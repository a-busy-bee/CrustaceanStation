      m_Items: []
  - m_Id: 34
    m_Localized: "\u65B0\u3057\u3044\u7814\u7A76\u30D7\u30ED\u30B8\u30A7\u30AF\u30C8\u3067\u30DC\u30E9\u30F3\u30C6\u30A3\u30A2\u3092\u3057\u3066\u3044\u307E\u3059\uFF01"
