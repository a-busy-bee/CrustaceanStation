      m_Items: []
  - m_Id: 48
    m_Localized: "\u4ECA\u65E5\u3001\u79C1\u306E\u30B7\u30A7\u30EB\u30C9\u30F3\u3068\u3044\u3046\u690D\u7269\u304C\u5C11\u3057\u3057\u304A\u308C\u3066\u898B\u3048\u307E\u3059"
