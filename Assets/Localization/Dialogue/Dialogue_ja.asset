  - m_Id: 29
    m_Localized: "Crustacean Corporation\u304C\u305D\u306E\u304B\u308F\u3044\u305D\u3046\u306A\u4EBA\u305F\u3061\u3092\u5B9F\u9A13\u3057\u3066\u3044\u308B\u3063\u3066\u805E\u3044\u305F\uFF01"
