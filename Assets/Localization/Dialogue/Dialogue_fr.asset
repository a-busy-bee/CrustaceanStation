%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 25e982df099754116b3863808eae6c55, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: Salut!
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "J'esp\xE8re que tu passes une bonne journ\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "Tu as l'air \xE9puis\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: Comment vont les enfants?
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: Quand allez-vous prendre votre retraite?
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: Beau temps que nous avons!
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "Y avait-il un poisson ici r\xE9cemment? \xC7a pue!"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "En esp\xE9rant de la pluie ce week-end."
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "Avez-vous entendu dire qu'ils augmentaient nos imp\xF4ts?"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "Je vais voir mon ami de longue distance! On ne s'est pas vus depuis
      des ann\xE9es."
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "Je pars en vacances pour la premi\xE8re fois depuis une d\xE9cennie!"
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "Je fuis mon pass\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "Saviez-vous que le train atteint des vitesses allant jusqu'\xE0
      57 lieues par heure?! C'est tellement rapide!"
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "D\xE9p\xEAchez-vous et poin\xE7onnez mon billet, v\xE9rifiez-vous
      s\xE9rieusement ma carte d'identit\xE9??!"
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "Avez - vous vu mon chapeau \xE0 h\xE9lice? J'ai d\xFB le laisser
      dans un train"
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "Avez-vous vu mon chapeau haut de forme? J'ai d\xFB le laisser dans
      un train"
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "Avez-vous vu mon chapeau vert? J'ai d\xFB le laisser dans un train"
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "Qu'est-ce que tu cherches sur ma carte d'identit\xE9? Tu aimes
      ma photo, mon beau?"
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "C'est moi sur la photo, laisse-moi d\xE9j\xE0 passer!"
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "C'est tellement difficile de garder une trace de ces billets, \xE0
      l'\xE9poque, nous venions d'embrasser le conducteur"
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: "C'est tellement difficile de garder une trace de ces billets, \xE0
      l'\xE9poque, nous venions de payer \xE0 la porte"
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: "C'est tellement difficile de garder une trace de ces billets, \xE0
      l'\xE9poque, nous avons juste demand\xE9 pardon, pas la permission"
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: J'ai attendu en ligne pour toujours
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: Appelez-vous cela un train ou un chariot?
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: Mon voisin m'a dit que ces navettes vous emmenaient pour de bon,
      est-ce vrai?
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: Il y a quelque chose qui cloche avec ces chercheurs.
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: Les gens qui reviennent de ce labo sentent bizarrement.
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: J'entends parfois des cris la nuit.
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: "J'ai entendu dire que Crustacean Corporation exp\xE9rimentait sur
      ces pauvres gens!"
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: "Vous devriez voter pour les droits des poissons m\xEAme si vous
      n'\xEAtes pas un poisson."
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: "Au moins, tous les pr\xE9dateurs le font volontairement. Et ils
      sont pay\xE9s pour \xE7a!"
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: Pensez-vous que des postes de recherche sont encore ouverts?
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: Crustacean corp m'a offert un travail, mais il y a quelque chose
      qui ne va pas chez ces gars
    m_Metadata:
      m_Items: []
  - m_Id: 34
    m_Localized: Je suis volontaire pour le nouveau projet de recherche!
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: "Ma sucette where o\xF9 est-elle all\xE9e;; ("
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: Mon meilleur ami s'appelle Samuel! Quel est le nom de ton meilleur
      ami?
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: "Samuel avait l'air dr\xF4le aujourd'hui\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: Maman a toujours l'air si cool dans sa veste blanche!
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: Maman fait la meilleure nourriture de toute la grande mer!
    m_Metadata:
      m_Items: []
  - m_Id: 40
    m_Localized: "L'\xE9cole est tellement ennuyeuse mister monsieur, voulez-vous
      jouer avec Samuel et moi? Aw Aww d'accord."
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: "Quels bonbons est-ce que j'aime? Mm, j'aime les casse-m\xE2choires
      et les bonbons rock, mais les sucettes sont mes pr\xE9f\xE9r\xE9es!"
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: "Monsieur! J'ai eu ma sucette fraise-banane pr\xE9f\xE9r\xE9e aujourd'hui!
      Tu en veux un aussi?"
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: "Ils n'avaient pas de fraise-banane au magasin aujourd'hui...C'est
      ma pr\xE9f\xE9r\xE9e\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: "J'aime ma m\xE8re, j'aime Samuel, j'aime les sucettes fraise-banane...et
      je t'aime aussi!"
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: J'adore la pluie, n'est-ce pas?
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: Je n'ai pas besoin d'acheter un billet pour une usine, n'est-ce
      pas?
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: Je peux apporter ma pancarte dans le train, non?
    m_Metadata:
      m_Items: []
  - m_Id: 48
    m_Localized: "Ma plante Shelldon a l'air un peu fan\xE9e aujourd'hui"
    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: J'ai mis tous mes pots dehors aujourd'hui pour attraper l'eau
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: Puis-je apporter du parmesan d'aubergine dans le train?
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: "Tu devrais venir \xE0 ma prochaine manifestation!"
    m_Metadata:
      m_Items: []
  - m_Id: 52
    m_Localized: "Avez-vous d\xE9j\xE0 pens\xE9 que les nuages sombres essayaient
      de nous dire quelque chose?"
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: "Les nouveaux laboratoires ne font que marginaliser davantage les
      poissons am\xE9ricains"
    m_Metadata:
      m_Items: []
  - m_Id: 54
    m_Localized: "Si je m'encha\xEEne \xE0 l'avant du labo, pensez-vous qu'ils cesseraient
      leurs op\xE9rations?"
    m_Metadata:
      m_Items: []
  - m_Id: 55
    m_Localized: "Ah, cette vieille coquille de la mienne grince tellement. Envoyer
      une vieille \xE2me sur son chemin, jeune gar\xE7on?"
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: "Il fut un temps o\xF9 tous les \xEAtres parcouraient les fonds
      marins. En effet, on manque ces jours r\xE9volus depuis longtemps."
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: Ceux avec qui on voyageait autrefois sont maintenant partis depuis
      longtemps, leurs traces ont disparu de ce monde.
    m_Metadata:
      m_Items: []
  - m_Id: 58
    m_Localized: "Hmph! Par rapport \xE0 hier, les chasseurs de cet \xE2ge sont des
      \xEAtres d\xE9charn\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 59
    m_Localized: "Pardonnez la torpeur de ce corps; on est attach\xE9 \xE0 ce fauteuil
      roulant depuis longtemps."
    m_Metadata:
      m_Items: []
  - m_Id: 60
    m_Localized: "Jeune gar\xE7on, ne fais pas les m\xEAmes erreurs que l'on a faites.
      Si vous pouvez sauver quelqu'un, ne restez pas l\xE0 et ne l'envoyez pas \xE0
      la mort."
    m_Metadata:
      m_Items: []
  - m_Id: 61
    m_Localized: "On entend encore leurs voix crier one on ne peut pas dire si elles
      proviennent de r\xEAves d'autrefois ou de souffrances du pr\xE9sent."
    m_Metadata:
      m_Items: []
  - m_Id: 62
    m_Localized: "La technologie et les transports sont si avanc\xE9s de nos jours
      one on ne peut s'emp\xEAcher de se sentir comme un \xE9tranger \xE0 cet \xE2ge."
    m_Metadata:
      m_Items: []
  - m_Id: 63
    m_Localized: "Jeune gar\xE7on, tu devrais sortir et profiter de cette vie avec
      tes proches. Ne consacrez pas votre vie \xE0 la survie et finissez par \xEAtre
      le dernier solitaire."
    m_Metadata:
      m_Items: []
  - m_Id: 64
    m_Localized: "..Mes amis? ...Ils \xE9taient connus dans les livres d'histoire
      comme de braves guerriers, mais on souhaite s'en souvenir en dehors de leurs
      descriptions assign\xE9es."
    m_Metadata:
      m_Items: []
  - m_Id: 65
    m_Localized: "...n'h\xE9sitez pas."
    m_Metadata:
      m_Items: []
  - m_Id: 66
    m_Localized: J'ai besoin de plus d'argent pour payer tous mes arcs
    m_Metadata:
      m_Items: []
  - m_Id: 67
    m_Localized: J'aimerais qu'il fasse un peu plus froid aujourd'hui
    m_Metadata:
      m_Items: []
  - m_Id: 68
    m_Localized: Vous auriez l'air plus mignon avec un arc aussi!
    m_Metadata:
      m_Items: []
  - m_Id: 69
    m_Localized: "J'ai h\xE2te de me pelotonner dans le train et de lire"
    m_Metadata:
      m_Items: []
  - m_Id: 70
    m_Localized: "Tu n'es pas cens\xE9 porter du bleu aujourd'hui, tu sais"
    m_Metadata:
      m_Items: []
  - m_Id: 71
    m_Localized: Tu penses que je parle trop doucement?
    m_Metadata:
      m_Items: []
  - m_Id: 72
    m_Localized: "Je n'aime pas \xE9tablir un contact visuel. Pourrais-tu ne pas
      me regarder quand je te regarde?"
    m_Metadata:
      m_Items: []
  - m_Id: 73
    m_Localized: "J'esp\xE8re que ce nouveau labo pourrait utiliser une secr\xE9taire...
      Je postule depuis toujours."
    m_Metadata:
      m_Items: []
  - m_Id: 74
    m_Localized: "H\xE9 gamin! Je viens de sortir des blagues, si vous en avez, laissez
      minnow!"
    m_Metadata:
      m_Items: []
  - m_Id: 75
    m_Localized: "J'esp\xE8re que Billie et Millie vont bien \xE0 l'\xE9cole n non,
      ce sont des stars comme toi et moi gamin!"
    m_Metadata:
      m_Items: []
  - m_Id: 76
    m_Localized: "Psst h\xE9, sais - tu o\xF9 se trouve le meilleur champ de fleurs
      par ici? Non, ce n'est pas une pr\xE9paration \xE0 une punchline, je suis s\xE9rieux!"
    m_Metadata:
      m_Items: []
  - m_Id: 77
    m_Localized: "Je suis tellement pomp\xE9 en ce moment! J'ai r\xE9ussi \xE0 r\xE9cup\xE9rer
      les derniers billets de concert en Basalte avant de quitter le travail!"
    m_Metadata:
      m_Items: []
  - m_Id: 78
    m_Localized: "Ooh, tu as l'air vraiment frais aujourd'hui! Tu as un rencard?
      Besoin de conseils? Ne vous inqui\xE9tez pas, ils sont gratuits! Contrairement
      \xE0 ces prix de billets\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 79
    m_Localized: "Ce bouquet de fleurs sauvages? J'en fais un pour ma femme chaque
      fois que je rentre \xE0 la maison."
    m_Metadata:
      m_Items: []
  - m_Id: 80
    m_Localized: "H\xE9, qu'est-ce que les deux oc\xE9ans se sont dit? Rien, ils
      ont juste agit\xE9 la main! HAHA! oh oh, je suppose que tu as trop entendu
      celui-l\xE0, hmm\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 81
    m_Localized: "Je veux juste que ma famille soit en s\xE9curit\xE9 et vive heureuse."
    m_Metadata:
      m_Items: []
  - m_Id: 82
    m_Localized: "Je pense que je vais arr\xEAter tr\xE8s bient\xF4t. Je peux juste
      find je peux trouver un travail plus s\xFBr l\xE0-bas, plus proche de ma famille."
    m_Metadata:
      m_Items: []
  - m_Id: 83
    m_Localized: "Gramps m'a dit que tu \xE9tais beau et il avait raison!"
    m_Metadata:
      m_Items: []
  - m_Id: 84
    m_Localized: "Des crustac\xE9s sur lesquels vous avez l'\u0153il?"
    m_Metadata:
      m_Items: []
  - m_Id: 85
    m_Localized: "Aujourd'hui est une belle journ\xE9e, n'est-ce pas?"
    m_Metadata:
      m_Items: []
  - m_Id: 86
    m_Localized: "J'adore prendre le train \xE0 cette p\xE9riode de l'ann\xE9e"
    m_Metadata:
      m_Items: []
  - m_Id: 87
    m_Localized: "C'\xE9tait le 50e anniversaire de Gramps et moi hier!"
    m_Metadata:
      m_Items: []
  - m_Id: 88
    m_Localized: Laisse-moi t'installer avec ma petite-fille... Tu l'aimerais!
    m_Metadata:
      m_Items: []
  - m_Id: 89
    m_Localized: "J'ai trouv\xE9 un mari pour cette petite-fille dont j'ai parl\xE9
      et ils sont si heureux"
    m_Metadata:
      m_Items: []
  - m_Id: 90
    m_Localized: "J'ai entendu dire que tu avais peut-\xEAtre un admirateur secret"
    m_Metadata:
      m_Items: []
  - m_Id: 91
    m_Localized: "Je vois la fa\xE7on dont le facteur te regarde, il est \xE9pris"
    m_Metadata:
      m_Items: []
  - m_Id: 92
    m_Localized: "S'il vous arrivait d'avoir un rendez-vous avec ce facteur \xE0
      l'avenir, je porterais autre chose."
    m_Metadata:
      m_Items: []
  - m_Id: 93
    m_Localized: "J'esp\xE8re qu'ils te donnent assez de pauses ici"
    m_Metadata:
      m_Items: []
  - m_Id: 94
    m_Localized: "Assurez-vous de vous arr\xEAter et de sentir la brise marine"
    m_Metadata:
      m_Items: []
  - m_Id: 95
    m_Localized: "Combien de fois pouvez-vous laisser la m\xEAme chose vous abattre?"
    m_Metadata:
      m_Items: []
  - m_Id: 96
    m_Localized: N'oubliez pas de dire aux autres que vous les aimez
    m_Metadata:
      m_Items: []
  - m_Id: 97
    m_Localized: N'oublie jamais que tu peux toujours recommencer
    m_Metadata:
      m_Items: []
  - m_Id: 98
    m_Localized: "Les jours ensoleill\xE9s et les jours de pluie sont les deux jours
      o\xF9 tout est possible"
    m_Metadata:
      m_Items: []
  - m_Id: 99
    m_Localized: "N'attendez pas de nouvelles opportunit\xE9s, allez les trouver"
    m_Metadata:
      m_Items: []
  - m_Id: 100
    m_Localized: "Dans les mauvais moments, de bonnes choses attendent toujours juste
      \xE0 l'horizon"
    m_Metadata:
      m_Items: []
  - m_Id: 101
    m_Localized: S'occuper d'autre chose vous donne des raisons de continuer
    m_Metadata:
      m_Items: []
  - m_Id: 102
    m_Localized: Tu vas bien, gamin?
    m_Metadata:
      m_Items: []
  - m_Id: 103
    m_Localized: "Quelque chose en t\xEAte?"
    m_Metadata:
      m_Items: []
  - m_Id: 104
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 105
    m_Localized: "Beaucoup de gens l\xE0-bas vous doivent leurs moyens de subsistance,
      vous savez."
    m_Metadata:
      m_Items: []
  - m_Id: 106
    m_Localized: "Beaucoup de vies auraient pu \xEAtre ruin\xE9es, sans toi."
    m_Metadata:
      m_Items: []
  - m_Id: 107
    m_Localized: Mais c'est un confort froid, n'est-ce pas?
    m_Metadata:
      m_Items: []
  - m_Id: 108
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 109
    m_Localized: "Je suis d\xE9sol\xE9 pour ton animal de compagnie, gamin."
    m_Metadata:
      m_Items: []
  - m_Id: 110
    m_Localized: "J'ai commenc\xE9 \xE0 remarquer il y a quelque temps que tu le
      sortais de moins en moins, et derni\xE8rement je ne l'ai pas du tout vu."
    m_Metadata:
      m_Items: []
  - m_Id: 111
    m_Localized: "Quelque chose me dit que tu as d\xFB y renoncer."
    m_Metadata:
      m_Items: []
  - m_Id: 112
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 113
    m_Localized: Je peux te raconter une histoire?
    m_Metadata:
      m_Items: []
  - m_Id: 114
    m_Localized: "Quand j'\xE9tais jeune, j'ai rencontr\xE9 une fille. Je l'aimais
      de tout mon c\u0153ur."
    m_Metadata:
      m_Items: []
  - m_Id: 115
    m_Localized: "Nous nous sommes pr\xE9cipit\xE9s \xE0 travers les choses, nous
      nous sommes mari\xE9s et je me suis retrouv\xE9 avec une famille avant de pouvoir
      vraiment m'en occuper."
    m_Metadata:
      m_Items: []
  - m_Id: 116
    m_Localized: "Nous avons eu du mal \xE0 joindre les deux bouts, m\xEAme avec
      nous deux emplois."
    m_Metadata:
      m_Items: []
  - m_Id: 117
    m_Localized: "L'un de nous devait faire des \xE9tudes si nous voulions donner
      \xE0 nos enfants la vie qu'ils m\xE9ritaient."
    m_Metadata:
      m_Items: []
  - m_Id: 118
    m_Localized: "Alors j'ai rejoint la marine. Cela a bien pay\xE9 et cela m'a permis
      de terminer l'universit\xE9 \xE0 la fin des choses."
    m_Metadata:
      m_Items: []
  - m_Id: 119
    m_Localized: "J'y ai pass\xE9 deux ans, pendant la guerre des Ammonites, \xE0
      charger des embarcations. Les armer de torpilles."
    m_Metadata:
      m_Items: []
  - m_Id: 120
    m_Localized: "Je n'ai m\xEAme jamais mis les pieds sur un bateau."
    m_Metadata:
      m_Items: []
  - m_Id: 121
    m_Localized: "Eh bien, la guerre s'est termin\xE9e, j'ai obtenu un dipl\xF4me
      d'ing\xE9nieur et j'ai commenc\xE9 \xE0 travailler pour une compagnie ferroviaire."
    m_Metadata:
      m_Items: []
  - m_Id: 122
    m_Localized: "Un petit, une filiale d'un endroit appel\xE9 \\\"Crustacean Corporation.\\\""
    m_Metadata:
      m_Items: []
  - m_Id: 123
    m_Localized: "Ils faisaient des choses sommaires, mais je n'y pensais pas beaucoup.
      Le travail payait pour que mes propres enfants aillent \xE0 l'universit\xE9,
      apr\xE8s tout."
    m_Metadata:
      m_Items: []
  - m_Id: 124
    m_Localized: "Cela m'a permis de m'offrir un voyage autour du monde chaque ann\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 125
    m_Localized: "Puis un an, j'ai fait un voyage \xE0 Ammonatia."
    m_Metadata:
      m_Items: []
  - m_Id: 126
    m_Localized: "Je suis tomb\xE9 sur l'un des endroits visit\xE9s par la marine
      et j'ai vu fossile apr\xE8s fossile apr\xE8s fossile jonchant le sol\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 127
    m_Localized: "surrounded le tout entour\xE9 de vieux obus torpilles."
    m_Metadata:
      m_Items: []
  - m_Id: 128
    m_Localized: "Et j'ai r\xE9alis\xE9, comme toi, que j'\xE9tais responsable."
    m_Metadata:
      m_Items: []
  - m_Id: 129
    m_Localized: "Je n'ai jamais \xE9t\xE9 capitaine des navires."
    m_Metadata:
      m_Items: []
  - m_Id: 130
    m_Localized: "Je n'ai jamais tir\xE9 les torpilles."
    m_Metadata:
      m_Items: []
  - m_Id: 131
    m_Localized: "Mais n'importe laquelle des torpilles l\xE0-bas aurait pu \xEAtre
      charg\xE9e par moi."
    m_Metadata:
      m_Items: []
  - m_Id: 132
    m_Localized: "Et peut-\xEAtre que si je n'avais pas \xE9t\xE9 l\xE0, quelques
      ammonites de plus auraient v\xE9cu."
    m_Metadata:
      m_Items: []
  - m_Id: 133
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 134
    m_Localized: "J'ai quitt\xE9 mon travail d'ing\xE9nieur ferroviaire d\xE8s mon
      retour."
    m_Metadata:
      m_Items: []
  - m_Id: 135
    m_Localized: "J'ai commenc\xE9 \xE0 travailler dans un atelier de m\xE9canique
      pour maman et papa \xE0 la place."
    m_Metadata:
      m_Items: []
  - m_Id: 136
    m_Localized: Je ne suis pas parti en vacances pendant trente ans.
    m_Metadata:
      m_Items: []
  - m_Id: 137
    m_Localized: "Mais je peux bien dormir chaque nuit, sachant que j'ai quitt\xE9
      cette compagnie de train avant\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 138
    m_Localized: "...c'est arriv\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 139
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 140
    m_Localized: "\xC7a va \xEAtre quelques semaines difficiles, gamin. Et quelques
      ann\xE9es difficiles apr\xE8s \xE7a, pendant que tu te remets sur pied."
    m_Metadata:
      m_Items: []
  - m_Id: 141
    m_Localized: "Mais j'esp\xE8re que tu ne le regretteras pas une seconde."
    m_Metadata:
      m_Items: []
  - m_Id: 142
    m_Localized: "Tu devrais t'acheter quelque chose de gentil you tu le m\xE9rites."
    m_Metadata:
      m_Items: []
  - m_Id: 143
    m_Localized: Avez-vous lu ma lettre?
    m_Metadata:
      m_Items: []
  - m_Id: 144
    m_Localized: Pensez-vous que vous aimerez jamais quelqu'un plus que votre isopode?
    m_Metadata:
      m_Items: []
  - m_Id: 145
    m_Localized: "Vous avez re\xE7u plus de courrier que d'habitude cette semaine,
      avez - vous un admirateur que je ne connais pas?"
    m_Metadata:
      m_Items: []
  - m_Id: 146
    m_Localized: "Vous d\xE9pensez de l'argent pour des choses autres que votre isopode,
      n'est-ce pas...?"
    m_Metadata:
      m_Items: []
  - m_Id: 147
    m_Localized: "On devrait d\xE9jeuner un jour quand on est tous les deux en pause,
      je te promets que je ne t'ennuierai pas\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 148
    m_Localized: "Tu penses jamais \xE0 sortir d'ici..? Je le fais, mais vous faites
      en sorte que rester en vaille la peine."
    m_Metadata:
      m_Items: []
  - m_Id: 149
    m_Localized: "Tu sais, j'ai commenc\xE9 \xE0 me demander si je te voyais moins
      que ton v\xE9t\xE9rinaire\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 150
    m_Localized: "J'ai vu Gramps discuter avec toi was te disait-il d'ouvrir \xE0
      nouveau un Roth IRA?"
    m_Metadata:
      m_Items: []
  - m_Id: 151
    m_Localized: "Je savais que tu \xE9tais plus qu'un joli visage, tu as aussi de
      bonnes m\u0153urs. J'aime \xE7a chez une personne."
    m_Metadata:
      m_Items: []
  - m_Id: 152
    m_Localized: Beaucoup de gens veulent te remercier, tu sais.
    m_Metadata:
      m_Items: []
  - m_Id: 153
    m_Localized: "Je suppose que tu \xE9tais juste un autre joli visage apr\xE8s
      tout, et je croyais vraiment en toi\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 154
    m_Localized: "...eh bien, j'esp\xE8re que tu passes au moins une bonne journ\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 155
    m_Localized: "H\xE9 l\xE0, comment va-t-on aujourd'hui?"
    m_Metadata:
      m_Items: []
  - m_Id: 156
    m_Localized: "Juste ici pour un examen r\xE9gulier de votre petit ici? Mm, nous
      verrons \xE0 ce sujet\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 157
    m_Localized: "Ohhhh hm hmm\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 158
    m_Localized: Eh bien, votre copain ici ne fait pas trop chaud en ce moment!
    m_Metadata:
      m_Items: []
  - m_Id: 159
    m_Localized: Regarde-le! L'une de ses jambes est plus courte que l'autre; c'est
      clairement un signe de malnutrition!
    m_Metadata:
      m_Items: []
  - m_Id: 160
    m_Localized: "Non non, je ne dis pas que tu ne fais pas du bon travail pour les
      \xE9lever."
    m_Metadata:
      m_Items: []
  - m_Id: 161
    m_Localized: "Votre isopode ne re\xE7oit tout simplement pas assez de nutriments."
    m_Metadata:
      m_Items: []
  - m_Id: 162
    m_Localized: "Vous savez comment sont les marques de magasins de nos jours, toujours
      transform\xE9es et pleines de charges."
    m_Metadata:
      m_Items: []
  - m_Id: 163
    m_Localized: Ici, je recommande personnellement cette marque ici.
    m_Metadata:
      m_Items: []
  - m_Id: 164
    m_Localized: C'est un peu plus cher, oui, mais je promets que c'est beaucoup
      plus riche en nutriments et naturel.
    m_Metadata:
      m_Items: []
  - m_Id: 165
    m_Localized: Je vous conseille vivement de changer rapidement, sinon votre isopode
      risque fortement de tomber malade.
    m_Metadata:
      m_Items: []
  - m_Id: 166
    m_Localized: "Qu\u2019est-ce que je veux dire ? Vous voyez\u2026 il n\u2019y
      a pas que la nourriture."
    m_Metadata:
      m_Items: []
  - m_Id: 167
    m_Localized: Il semblerait que votre isopode souffre d'une grave maladie respiratoire
      chronique.
    m_Metadata:
      m_Items: []
  - m_Id: 168
    m_Localized: "Il semblerait que ce soit d'origine g\xE9n\xE9tique\_; les branchies
      de votre isopode sont incapables d'absorber correctement l'oxyg\xE8ne."
    m_Metadata:
      m_Items: []
  - m_Id: 169
    m_Localized: "Avec le temps, cela engendrera de graves probl\xE8mes et conduira
      certainement \xE0 une mort pr\xE9matur\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 170
    m_Localized: "Il nous faudra pr\xE9lever un \xE9chantillon de tissu pour effectuer
      des tests et d\xE9terminer quel m\xE9dicament sera le plus efficace."
    m_Metadata:
      m_Items: []
  - m_Id: 171
    m_Localized: "Dans le pire des cas, il faudra peut-\xEAtre pratiquer une intervention
      chirurgicale pour remplacer les branchies de votre isopode par des branchies
      artificielles."
    m_Metadata:
      m_Items: []
  - m_Id: 172
    m_Localized: "Je suis vraiment d\xE9sol\xE9 de vous annoncer une si mauvaise
      nouvelle."
    m_Metadata:
      m_Items: []
  - m_Id: 173
    m_Localized: "Je vais prescrire des flocons m\xE9dicinaux pour cette semaine,
      et nous pr\xE9l\xE8verons l'\xE9chantillon aujourd'hui."
    m_Metadata:
      m_Items: []
  - m_Id: 174
    m_Localized: Ayez confiance, je ferai tout mon possible pour sauver votre cher
      isopode.
    m_Metadata:
      m_Items: []
  - m_Id: 175
    m_Localized: "Votre total aujourd'hui s'\xE9l\xE8ve \xE0 environ 800 dollars."
    m_Metadata:
      m_Items: []
  - m_Id: 176
    m_Localized: "\u2026Qu\u2019est-ce qui se passe avec cette t\xEAte\_?"
    m_Metadata:
      m_Items: []
  - m_Id: 177
    m_Localized: "Salut ! J'esp\xE8re que vous allez bien tous les deux !"
    m_Metadata:
      m_Items: []
  - m_Id: 178
    m_Localized: "Je vais d'abord faire un bilan de sant\xE9 \xE0 votre petit bout
      de chou, et ensuite nous discuterons des r\xE9sultats des tests."
    m_Metadata:
      m_Items: []
  - m_Id: 179
    m_Localized: "Hmm\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 180
    m_Localized: "Voici la bonne nouvelle\_: votre isopode est relativement stable
      et se porte beaucoup mieux que la semaine derni\xE8re."
    m_Metadata:
      m_Items: []
  - m_Id: 181
    m_Localized: "La mauvaise nouvelle, ce sont les r\xE9sultats des tests."
    m_Metadata:
      m_Items: []
  - m_Id: 182
    m_Localized: "D\xE9sormais, votre isopode aura besoin de rappels de vaccins et
      de m\xE9dicaments r\xE9guliers."
    m_Metadata:
      m_Items: []
  - m_Id: 183
    m_Localized: "Cependant, cela ne suffira pas. La meilleure solution consiste
      \xE0 utiliser des branchies artificielles."
    m_Metadata:
      m_Items: []
  - m_Id: 184
    m_Localized: "Malheureusement, les d\xE9g\xE2ts sont trop importants. Les injections
      et les m\xE9dicaments ne sont que des solutions temporaires."
    m_Metadata:
      m_Items: []
  - m_Id: 185
    m_Localized: "La meilleure solution consiste \xE0 op\xE9rer pour remplacer les
      branchies."
    m_Metadata:
      m_Items: []
  - m_Id: 186
    m_Localized: "Malheureusement, cela n'est pas couvert par votre r\xE9gime d'assurance
      d'entreprise."
    m_Metadata:
      m_Items: []
  - m_Id: 187
    m_Localized: Vous devrez payer de votre poche.
    m_Metadata:
      m_Items: []
  - m_Id: 188
    m_Localized: "On va faire une injection de rappel aujourd'hui, et je vais prescrire
      de nouveaux m\xE9dicaments."
    m_Metadata:
      m_Items: []
  - m_Id: 189
    m_Localized: "Faites-moi savoir lors de votre prochaine visite si vous comptez
      proc\xE9der \xE0 l'intervention chirurgicale."
    m_Metadata:
      m_Items: []
  - m_Id: 190
    m_Localized: "Le co\xFBt ? Eh bien\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 191
    m_Localized: "Sachez que ce ne sera pas bon march\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 192
    m_Localized: "Vous avez donc d\xE9cid\xE9 de proc\xE9der \xE0 l'op\xE9ration
      ? C'est bien."
    m_Metadata:
      m_Items: []
  - m_Id: 193
    m_Localized: Nous le programmerons pour la semaine prochaine.
    m_Metadata:
      m_Items: []
  - m_Id: 194
    m_Localized: Le tir du jour ? Oui oui, on y viendra.
    m_Metadata:
      m_Items: []
  - m_Id: 195
    m_Localized: Vous devrez verser un acompte non remboursable aujourd'hui.
    m_Metadata:
      m_Items: []
  - m_Id: 196
    m_Localized: "Oui, aujourd'hui. Et non remboursable. Comment vais-je faire pour
      rembourser mon pr\xEAt autrement ?"
    m_Metadata:
      m_Items: []
  - m_Id: 197
    m_Localized: Euh. Bref.
    m_Metadata:
      m_Items: []
  - m_Id: 198
    m_Localized: "C'est une pratique courante ; je ne comprends pas pourquoi vous
      \xEAtes si contrari\xE9(e)..."
    m_Metadata:
      m_Items: []
  - m_Id: 199
    m_Localized: "Vous n\u2019avez pas assez d\u2019argent pour l\u2019acompte et
      les frais de traitement habituels aujourd\u2019hui\_? Eh bien\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 200
    m_Localized: "Si vous \xEAtes d\xE9cid\xE9(e) pour l'op\xE9ration, on reportera
      l'injection aujourd'hui."
    m_Metadata:
      m_Items: []
  - m_Id: 201
    m_Localized: "Oui, sauter le rappel aujourd'hui ne posera pas de probl\xE8me\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 202
    m_Localized: "Mais si vous arr\xEAtez le traitement de votre isopode, nous devrons
      proc\xE9der \xE0 l'op\xE9ration la semaine prochaine."
    m_Metadata:
      m_Items: []
  - m_Id: 203
    m_Localized: "Alors, vous avez int\xE9r\xEAt \xE0 r\xE9unir suffisamment d'argent
      d'ici la semaine prochaine."
    m_Metadata:
      m_Items: []
  - m_Id: 204
    m_Localized: Avez-vous l'argent ?
    m_Metadata:
      m_Items: []
  - m_Id: 205
    m_Localized: "\u2026Waouh ! M\xEAme avec ton boulot ingrat, tu arrives \xE0 t'en
      sortir suffisamment ?"
    m_Metadata:
      m_Items: []
  - m_Id: 206
    m_Localized: "Euh\u2026 je ne sais pas vraiment quel est votre travail. Le salaire
      laissait juste pr\xE9sager qu'il n'\xE9tait pas bon march\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 207
    m_Localized: "Bon, puisque vous avez la somme totale aujourd'hui, nous allons
      mettre votre isopode sous\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 208
    m_Localized: "Soyez assur\xE9s que nous ferons tout notre possible."
    m_Metadata:
      m_Items: []
  - m_Id: 209
    m_Localized: Ils s'en sortiront.
    m_Metadata:
      m_Items: []
  - m_Id: 210
    m_Localized: Avez-vous l'argent ?
    m_Metadata:
      m_Items: []
  - m_Id: 211
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 212
    m_Localized: Ce n'est pas suffisant.
    m_Metadata:
      m_Items: []
  - m_Id: 213
    m_Localized: "Excusez-moi, vous pensez que nous sommes une association \xE0 but
      non lucratif\_? Nous avons aussi des bouches \xE0 nourrir."
    m_Metadata:
      m_Items: []
  - m_Id: 214
    m_Localized: "Conform\xE9ment \xE0 notre politique, nous ne pouvons proc\xE9der
      \xE0 aucune intervention tant que vous n'avez pas r\xE9gl\xE9 l'int\xE9gralit\xE9
      du montant."
    m_Metadata:
      m_Items: []
  - m_Id: 215
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 216
    m_Localized: "Me supplier ne servira \xE0 rien. Je ne vais pas risquer mon travail
      pour \xE7a."
    m_Metadata:
      m_Items: []
  - m_Id: 217
    m_Localized: "Pouvez-vous \xEAtre rembours\xE9\_? Je pensais que c'\xE9tait clair\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 218
    m_Localized: "L'acompte non remboursable vers\xE9 la semaine derni\xE8re ne sera
      pas remboursable."
    m_Metadata:
      m_Items: []
  - m_Id: 219
    m_Localized: "Le tarif d\u2019aujourd\u2019hui\_? Eh bien\u2026 c\u2019est le
      prix de la consultation. Devinez quoi\_? Vous venez d\u2019avoir une consultation."
    m_Metadata:
      m_Items: []
  - m_Id: 220
    m_Localized: Alors non.
    m_Metadata:
      m_Items: []
  - m_Id: 221
    m_Localized: Oh, vous savez quoi ? Tenez.
    m_Metadata:
      m_Items: []
  - m_Id: 222
    m_Localized: Une pierre tombale offerte par la maison, dans le cadre de notre
      forfait de suivi gratuit pour tous nos patients.
    m_Metadata:
      m_Items: []
  - m_Id: 223
    m_Localized: "\xC0 bient\xF4t !"
    m_Metadata:
      m_Items: []
  - m_Id: 224
    m_Localized: "goutte\u2026 goutte\u2026 goutte"
    m_Metadata:
      m_Items: []
  - m_Id: 225
    m_Localized: grrregghhhhh
    m_Metadata:
      m_Items: []
  - m_Id: 226
    m_Localized: "Laissez-moi partir\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 227
    m_Localized: squawacklackclackclackclack
    m_Metadata:
      m_Items: []
  - m_Id: 228
    m_Localized: "*\xE9crasement* (effet sonore)"
    m_Metadata:
      m_Items: []
  - m_Id: 229
    m_Localized: Mec, elles ont de belles jambes ! Pas vrai ? PAS VRAI ???
    m_Metadata:
      m_Items: []
  - m_Id: 230
    m_Localized: graaawwwwwrrrr
    m_Metadata:
      m_Items: []
  - m_Id: 231
    m_Localized: rrrrrgggghhhhh
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
