%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 25e982df099754116b3863808eae6c55, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: Salut !
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "J'esp\xE8re que tu passes une bonne journ\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "T'as l'air \xE0 bout."
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: Comment vont les enfants ?
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: Tu comptes prendre ta retraite quand ?
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: Quel temps magnifique aujourd'hui !
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "Beurk, y avait un poisson ici r\xE9cemment ? \xC7a empeste !"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "J'esp\xE8re qu'il va pleuvoir ce week-end."
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "T'as entendu ? Ils vont augmenter nos imp\xF4ts."
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "Je vais voir un ami qui vit loin ! On ne s'est pas vus depuis des
      ann\xE9es."
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "Je pars enfin en vacances, les premi\xE8res depuis dix ans !"
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "Je fuis mon pass\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "Tu savais que ce train peut atteindre 57 lieues \xE0 l'heure ?!
      C'est dingue !"
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "D\xE9p\xEAche-toi de poin\xE7onner mon billet ! Tu v\xE9rifies
      vraiment ma pi\xE8ce d'identit\xE9 ??!"
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "T'aurais pas vu mon chapeau \xE0 h\xE9lice ? J'ai d\xFB l'oublier
      dans un train."
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "T'aurais pas vu mon haut-de-forme ? J'ai d\xFB l'oublier dans un
      train."
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "T'aurais pas vu mon chapeau vert ? J'ai d\xFB l'oublier dans un
      train."
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "Qu'est-ce que tu cherches sur ma pi\xE8ce d'identit\xE9 ? Ma photo
      te pla\xEEt, beau gosse ?"
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: C'est bien moi sur la photo, laisse-moi passer !
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "C'est gal\xE8re de garder tous ces billets\u2026 de mon temps,
      on embrassait juste le contr\xF4leur."
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: "C'est gal\xE8re de garder tous ces billets\u2026 de mon temps,
      on payait juste \xE0 l'entr\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: "C'est gal\xE8re de garder tous ces billets\u2026 de mon temps,
      on demandait pardon plut\xF4t que la permission."
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: "\xC7a fait une \xE9ternit\xE9 que j'attends dans cette file."
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "Tu appelles \xE7a un train ou un tram ?"
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: "Mon voisin dit que ces navettes vous emm\xE8nent et qu'on ne revient
      jamais. C'est vrai ?"
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: Il y a quelque chose qui cloche avec ces chercheurs.
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: "Ceux qui reviennent de ce labo ont une dr\xF4le d'odeur."
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: Parfois, j'entends des cris la nuit.
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: "J'ai entendu dire que Crustacean Corporation fait des exp\xE9riences
      sur ces pauvres cr\xE9atures !"
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: "Tu devrais voter pour les droits des poissons, m\xEAme si t'es
      pas un poisson."
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: "H\xE9, au moins tous les pr\xE9dateurs participent de leur plein
      gr\xE9. Et ils sont pay\xE9s !"
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: Tu crois qu'ils recrutent encore des chercheurs ?
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: "Crustacean Corporation m'a propos\xE9 un boulot, mais quelque chose
      cloche chez eux."
    m_Metadata:
      m_Items: []
  - m_Id: 34
    m_Localized: Je me porte volontaire pour le nouveau projet de recherche !
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: "Ma sucette\u2026 elle est o\xF9\u2026 ;("
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: Mon meilleur copain s'appelle Samuel ! Et toi, c'est quoi le nom
      de ton meilleur copain ?
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: "Samuel avait l'air bizarre aujourd'hui\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: Maman est trop classe dans sa blouse blanche !
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: Maman fait la meilleure cuisine de toute la mer !
    m_Metadata:
      m_Items: []
  - m_Id: 40
    m_Localized: "L'\xE9cole c'est trop nul\u2026 M'sieur, tu veux jouer avec Samuel
      et moi ? \u2026Oooh, d'accord."
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: "Mes bonbons pr\xE9f\xE9r\xE9s ? Hmm, j'aime les casse-m\xE2choire
      et le sucre candi, mais les sucettes c'est ce que je pr\xE9f\xE8re !"
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: "M'sieur ! Aujourd'hui j'ai eu ma sucette fraise-banane pr\xE9f\xE9r\xE9e
      ! T'en veux une aussi ?"
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: "Y avait pas fraise-banane au magasin aujourd'hui\u2026 C'est ma
      pr\xE9f\xE9r\xE9e\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: "J'aime Maman, j'aime Samuel, j'aime les sucettes fraise-banane\u2026
      et je t'aime bien aussi !"
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: J'adore la pluie, pas toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: J'ai pas besoin d'acheter un billet pour une plante, hein ?
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: Je peux prendre ma pancarte dans le train, hein ?
    m_Metadata:
      m_Items: []
  - m_Id: 48
    m_Localized: "Ma plante Shelldon a l'air un peu fan\xE9e aujourd'hui."
    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: "J'ai sorti tous mes pots aujourd'hui pour r\xE9cup\xE9rer l'eau
      de pluie."
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: Je peux prendre des aubergines parmigiana dans le train ?
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: "Tu devrais venir \xE0 ma prochaine manif !"
    m_Metadata:
      m_Items: []
  - m_Id: 52
    m_Localized: "T'as d\xE9j\xE0 pens\xE9 que les nuages noirs essayaient peut-\xEAtre
      de nous dire quelque chose ?"
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: Ces nouveaux labos ne font qu'aggraver la marginalisation des poissons.
    m_Metadata:
      m_Items: []
  - m_Id: 54
    m_Localized: "Si je m'encha\xEEne devant le labo, tu crois qu'ils arr\xEAteront
      leurs activit\xE9s ?"
    m_Metadata:
      m_Items: []
  - m_Id: 55
    m_Localized: "Ah\u2026 ma vieille carapace grince de partout. Tu veux bien aider
      une vieille \xE2me \xE0 poursuivre son chemin, mon gar\xE7on ?"
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: "Il fut un temps o\xF9 tous les \xEAtres parcouraient les fonds
      marins. Ah, comme ces jours lointains me manquent."
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: "Ceux avec qui je voyageais autrefois ont disparu depuis longtemps.
      Leurs traces m\xEAmes se sont effac\xE9es de ce monde."
    m_Metadata:
      m_Items: []
  - m_Id: 58
    m_Localized: "Hmph ! Compar\xE9s aux chasseurs d'autrefois, ceux de cette \xE9poque
      ne sont que de fr\xEAles cr\xE9atures."
    m_Metadata:
      m_Items: []
  - m_Id: 59
    m_Localized: "Pardonne la lenteur de ce vieux corps ; voil\xE0 bien longtemps
      qu'il est condamn\xE9 \xE0 ce fauteuil roulant."
    m_Metadata:
      m_Items: []
  - m_Id: 60
    m_Localized: "Mon gar\xE7on, ne r\xE9p\xE8te pas mes erreurs. Si tu peux sauver
      quelqu'un, ne reste pas sans agir pour l'envoyer \xE0 la mort."
    m_Metadata:
      m_Items: []
  - m_Id: 61
    m_Localized: "J'entends encore leurs cris\u2026 Impossible de savoir s'ils viennent
      de vieux r\xEAves ou des souffrances du pr\xE9sent."
    m_Metadata:
      m_Items: []
  - m_Id: 62
    m_Localized: "La technologie et les transports ont tant progress\xE9\u2026 Je
      ne peux m'emp\xEAcher de me sentir \xE9tranger \xE0 cette \xE9poque."
    m_Metadata:
      m_Items: []
  - m_Id: 63
    m_Localized: "Mon gar\xE7on, va profiter de cette vie avec ceux que tu aimes.
      Ne consacre pas ton existence \xE0 survivre pour finir seul, le dernier de
      tous."
    m_Metadata:
      m_Items: []
  - m_Id: 64
    m_Localized: "\u2026Mes amis ? \u2026Les livres d'histoire les d\xE9crivent comme
      de valeureux guerriers. Moi, je pr\xE9f\xE8re me souvenir de ceux qu'ils \xE9taient
      au-del\xE0 de ces titres."
    m_Metadata:
      m_Items: []
  - m_Id: 65
    m_Localized: "\u2026n'h\xE9site pas."
    m_Metadata:
      m_Items: []
  - m_Id: 66
    m_Localized: "Il me faut plus d'argent pour acheter tous mes n\u0153uds."
    m_Metadata:
      m_Items: []
  - m_Id: 67
    m_Localized: J'aimerais qu'il fasse un peu plus froid aujourd'hui.
    m_Metadata:
      m_Items: []
  - m_Id: 68
    m_Localized: "Toi aussi, tu serais plus mignon avec un n\u0153ud !"
    m_Metadata:
      m_Items: []
  - m_Id: 69
    m_Localized: "J'ai tellement h\xE2te de me blottir dans le train avec un livre."
    m_Metadata:
      m_Items: []
  - m_Id: 70
    m_Localized: "Tu sais que t'es pas cens\xE9 porter du bleu aujourd'hui, hein
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 71
    m_Localized: Tu trouves que je parle trop doucement ?
    m_Metadata:
      m_Items: []
  - m_Id: 72
    m_Localized: "J'aime pas regarder dans les yeux. Tu pourrais\u2026 ne pas me
      regarder quand je te regarde ?"
    m_Metadata:
      m_Items: []
  - m_Id: 73
    m_Localized: "J'esp\xE8re que le nouveau labo cherche une secr\xE9taire\u2026
      \xC7a fait une \xE9ternit\xE9 que je postule."
    m_Metadata:
      m_Items: []
  - m_Id: 74
    m_Localized: "Salut, petit ! Je suis \xE0 court de blagues. Si t'en as une, je
      suis tout ou\xEFes !"
    m_Metadata:
      m_Items: []
  - m_Id: 75
    m_Localized: "J'esp\xE8re que Billie et Millie s'en sortent bien \xE0 l'\xE9cole\u2026
      Mais oui, ce sont des \xE9toiles, comme toi et moi, petit !"
    m_Metadata:
      m_Items: []
  - m_Id: 76
    m_Localized: "Psst, h\xE9 ! Tu sais o\xF9 est le meilleur champ de fleurs du
      coin ? Non, c'est pas le d\xE9but d'une blague, je suis s\xE9rieux !"
    m_Metadata:
      m_Items: []
  - m_Id: 77
    m_Localized: "Je suis \xE0 fond l\xE0 ! J'ai r\xE9ussi \xE0 choper les derniers
      billets pour le concert de Basalt juste avant de finir le boulot !"
    m_Metadata:
      m_Items: []
  - m_Id: 78
    m_Localized: "Ooh, t'es super \xE9l\xE9gant aujourd'hui ! Un rendez-vous ? Besoin
      de conseils ? T'inqui\xE8te, eux sont gratuits ! Contrairement \xE0 ces billets\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 79
    m_Localized: "Ce bouquet de fleurs sauvages ? J'en fais un pour ma femme chaque
      fois que je peux rentrer \xE0 la maison."
    m_Metadata:
      m_Items: []
  - m_Id: 80
    m_Localized: "H\xE9, tu sais ce que deux oc\xE9ans se disent quand ils se croisent
      ? Rien, ils se font juste coucou avec une vague ! HAHA ! \u2026Oh, tu l'as
      d\xE9j\xE0 trop entendue celle-l\xE0, hein\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 81
    m_Localized: "Je veux juste que ma famille soit en s\xE9curit\xE9 et heureuse."
    m_Metadata:
      m_Items: []
  - m_Id: 82
    m_Localized: "Je crois que je vais bient\xF4t d\xE9missionner. Je\u2026 je peux
      trouver un boulot plus s\xFBr ailleurs, plus pr\xE8s de ma famille."
    m_Metadata:
      m_Items: []
  - m_Id: 83
    m_Localized: "Papi m'a dit que tu \xE9tais beau, et il avait raison !"
    m_Metadata:
      m_Items: []
  - m_Id: 84
    m_Localized: "Un crustac\xE9 t'a tap\xE9 dans l'\u0153il ?"
    m_Metadata:
      m_Items: []
  - m_Id: 85
    m_Localized: "Quelle belle journ\xE9e, tu ne trouves pas ?"
    m_Metadata:
      m_Items: []
  - m_Id: 86
    m_Localized: "J'adore prendre le train \xE0 cette p\xE9riode de l'ann\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 87
    m_Localized: "Hier, Papi et moi avons f\xEAt\xE9 nos 50 ans de mariage !"
    m_Metadata:
      m_Items: []
  - m_Id: 88
    m_Localized: "Laisse-moi te pr\xE9senter ma petite-fille\u2026 Vous iriez tellement
      bien ensemble !"
    m_Metadata:
      m_Items: []
  - m_Id: 89
    m_Localized: "J'ai trouv\xE9 un mari \xE0 la petite-fille dont je te parlais,
      et ils sont tellement heureux !"
    m_Metadata:
      m_Items: []
  - m_Id: 90
    m_Localized: "J'ai entendu dire que tu avais peut-\xEAtre un admirateur secret."
    m_Metadata:
      m_Items: []
  - m_Id: 91
    m_Localized: "Je vois bien comment le facteur te regarde\u2026 il en pince pour
      toi !"
    m_Metadata:
      m_Items: []
  - m_Id: 92
    m_Localized: "Si un jour tu as un rendez-vous avec ce facteur, \xE0 ta place
      je mettrais autre chose."
    m_Metadata:
      m_Items: []
  - m_Id: 93
    m_Localized: "J'esp\xE8re qu'ils te laissent prendre assez de pauses ici."
    m_Metadata:
      m_Items: []
  - m_Id: 94
    m_Localized: "N'oublie pas de t'arr\xEAter de temps en temps pour respirer la
      brise marine."
    m_Metadata:
      m_Items: []
  - m_Id: 95
    m_Localized: "Combien de fois vas-tu laisser la m\xEAme chose te miner ?"
    m_Metadata:
      m_Items: []
  - m_Id: 96
    m_Localized: "Pense \xE0 dire \xE0 ceux qui comptent pour toi que tu les aimes."
    m_Metadata:
      m_Items: []
  - m_Id: 97
    m_Localized: "N'oublie jamais que tu peux toujours repartir de z\xE9ro."
    m_Metadata:
      m_Items: []
  - m_Id: 98
    m_Localized: Qu'il fasse soleil ou qu'il pleuve, tout reste possible.
    m_Metadata:
      m_Items: []
  - m_Id: 99
    m_Localized: "N'attends pas que les occasions viennent \xE0 toi. Va les chercher."
    m_Metadata:
      m_Items: []
  - m_Id: 100
    m_Localized: "M\xEAme dans les mauvais moments, il y a toujours quelque chose
      de bon qui attend juste derri\xE8re l'horizon."
    m_Metadata:
      m_Items: []
  - m_Id: 101
    m_Localized: "Avoir quelque chose dont s'occuper, \xE7a donne une raison d'avancer."
    m_Metadata:
      m_Items: []
  - m_Id: 102
    m_Localized: "\xC7a va, petit ?"
    m_Metadata:
      m_Items: []
  - m_Id: 103
    m_Localized: Quelque chose te tracasse ?
    m_Metadata:
      m_Items: []
  - m_Id: 104
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 105
    m_Localized: "Il y en a beaucoup l\xE0 dehors qui te doivent leur gagne-pain,
      tu sais."
    m_Metadata:
      m_Items: []
  - m_Id: 106
    m_Localized: "Sans toi, beaucoup de vies auraient pu \xEAtre d\xE9truites."
    m_Metadata:
      m_Items: []
  - m_Id: 107
    m_Localized: "Mais \xE7a console pas vraiment, hein ?"
    m_Metadata:
      m_Items: []
  - m_Id: 108
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 109
    m_Localized: "Je suis d\xE9sol\xE9 pour ton petit compagnon, petit."
    m_Metadata:
      m_Items: []
  - m_Id: 110
    m_Localized: "Il y a quelque temps, j'ai commenc\xE9 \xE0 remarquer que tu le
      sortais de moins en moins. Et derni\xE8rement, je ne l'ai plus vu du tout."
    m_Metadata:
      m_Items: []
  - m_Id: 111
    m_Localized: "Quelque chose me dit que tu as d\xFB t'en s\xE9parer."
    m_Metadata:
      m_Items: []
  - m_Id: 112
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 113
    m_Localized: Je peux te raconter une histoire ?
    m_Metadata:
      m_Items: []
  - m_Id: 114
    m_Localized: "Quand j'\xE9tais jeune, j'ai rencontr\xE9 une fille. Je l'aimais
      de tout mon c\u0153ur."
    m_Metadata:
      m_Items: []
  - m_Id: 115
    m_Localized: "On est all\xE9s trop vite, on s'est mari\xE9s, et je me suis retrouv\xE9
      avec une famille avant d'\xEAtre vraiment pr\xEAt."
    m_Metadata:
      m_Items: []
  - m_Id: 116
    m_Localized: "M\xEAme en travaillant tous les deux, on avait du mal \xE0 joindre
      les deux bouts."
    m_Metadata:
      m_Items: []
  - m_Id: 117
    m_Localized: "Il fallait que l'un de nous fasse des \xE9tudes si on voulait offrir
      \xE0 nos enfants la vie qu'ils m\xE9ritaient."
    m_Metadata:
      m_Items: []
  - m_Id: 118
    m_Localized: "Alors je me suis engag\xE9 dans la marine. \xC7a payait bien et
      \xE7a me garantissait de pouvoir faire des \xE9tudes ensuite."
    m_Metadata:
      m_Items: []
  - m_Id: 119
    m_Localized: "J'y ai pass\xE9 deux ans, pendant la guerre des Ammonites, \xE0
      charger des appareils. \xC0 les armer de torpilles."
    m_Metadata:
      m_Items: []
  - m_Id: 120
    m_Localized: "Je n'ai m\xEAme jamais mis les pieds sur un navire."
    m_Metadata:
      m_Items: []
  - m_Id: 121
    m_Localized: "Puis la guerre s'est termin\xE9e. J'ai obtenu mon dipl\xF4me d'ing\xE9nieur
      et j'ai commenc\xE9 \xE0 travailler pour une compagnie ferroviaire."
    m_Metadata:
      m_Items: []
  - m_Id: 122
    m_Localized: "Une petite bo\xEEte, filiale d'un groupe appel\xE9 \xAB Crustacean
      Corporation \xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 123
    m_Localized: "Ils faisaient des trucs louches, mais je n'y pr\xEAtais pas vraiment
      attention. Apr\xE8s tout, ce boulot payait les \xE9tudes de mes propres enfants."
    m_Metadata:
      m_Items: []
  - m_Id: 124
    m_Localized: "Il me permettait m\xEAme de faire un tour du monde chaque ann\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 125
    m_Localized: "Puis, une ann\xE9e, je suis parti \xE0 Ammonatia."
    m_Metadata:
      m_Items: []
  - m_Id: 126
    m_Localized: "Je suis tomb\xE9 sur un des endroits o\xF9 la marine \xE9tait pass\xE9e.
      Des fossiles partout\u2026 encore et encore\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 127
    m_Localized: "\u2026tous entour\xE9s de vieux restes de torpilles."
    m_Metadata:
      m_Items: []
  - m_Id: 128
    m_Localized: "Et j'ai compris, comme toi, que j'en \xE9tais responsable."
    m_Metadata:
      m_Items: []
  - m_Id: 129
    m_Localized: "Je n'ai jamais command\xE9 ces navires."
    m_Metadata:
      m_Items: []
  - m_Id: 130
    m_Localized: "Je n'ai jamais tir\xE9 ces torpilles."
    m_Metadata:
      m_Items: []
  - m_Id: 131
    m_Localized: "Mais n'importe laquelle de ces torpilles aurait pu \xEAtre une
      de celles que j'avais charg\xE9es."
    m_Metadata:
      m_Items: []
  - m_Id: 132
    m_Localized: "Et peut-\xEAtre que, sans moi, quelques ammonites de plus seraient
      encore en vie."
    m_Metadata:
      m_Items: []
  - m_Id: 133
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 134
    m_Localized: "D\xE8s mon retour, j'ai quitt\xE9 mon poste d'ing\xE9nieur ferroviaire."
    m_Metadata:
      m_Items: []
  - m_Id: 135
    m_Localized: "\xC0 la place, j'ai trouv\xE9 du travail dans un petit garage familial."
    m_Metadata:
      m_Items: []
  - m_Id: 136
    m_Localized: Je ne suis pas reparti en vacances pendant trente ans.
    m_Metadata:
      m_Items: []
  - m_Id: 137
    m_Localized: "Mais chaque soir, je dors tranquille en sachant que j'ai quitt\xE9
      cette compagnie ferroviaire avant que\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 138
    m_Localized: "\u2026tout \xE7a arrive."
    m_Metadata:
      m_Items: []
  - m_Id: 139
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 140
    m_Localized: "Les prochaines semaines vont \xEAtre dures, petit. Et les ann\xE9es
      qui suivront aussi, le temps de te reconstruire."
    m_Metadata:
      m_Items: []
  - m_Id: 141
    m_Localized: "Mais j'esp\xE8re que tu n'en regretteras pas une seule seconde."
    m_Metadata:
      m_Items: []
  - m_Id: 142
    m_Localized: "Tu devrais t'offrir un petit plaisir\u2026 tu le m\xE9rites."
    m_Metadata:
      m_Items: []
  - m_Id: 143
    m_Localized: T'as lu ma lettre ?
    m_Metadata:
      m_Items: []
  - m_Id: 144
    m_Localized: Tu crois que tu aimeras un jour quelqu'un plus que ton isopode ?
    m_Metadata:
      m_Items: []
  - m_Id: 145
    m_Localized: "T'as re\xE7u plus de courrier que d'habitude cette semaine\u2026
      t'aurais un admirateur dont je serais pas au courant ?"
    m_Metadata:
      m_Items: []
  - m_Id: 146
    m_Localized: "Tu d\xE9penses quand m\xEAme de l'argent pour autre chose que ton
      isopode, hein\u2026 ?"
    m_Metadata:
      m_Items: []
  - m_Id: 147
    m_Localized: "On devrait d\xE9jeuner ensemble un de ces jours, quand on sera
      tous les deux en pause. Promis, je t'ennuierai pas\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 148
    m_Localized: "Tu penses parfois \xE0 foutre le camp d'ici\u2026 ? Moi oui. Mais
      toi, tu me donnes envie de rester."
    m_Metadata:
      m_Items: []
  - m_Id: 149
    m_Localized: "Tu sais, je commence \xE0 me demander si ton v\xE9t\xE9rinaire
      te voit pas plus souvent que moi\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 150
    m_Localized: "J'ai vu Papi discuter avec toi\u2026 il te parlait encore d'ouvrir
      un plan d'\xE9pargne retraite ?"
    m_Metadata:
      m_Items: []
  - m_Id: 151
    m_Localized: "Je savais que t'\xE9tais pas juste un joli visage. T'as aussi de
      vraies valeurs. J'aime \xE7a chez quelqu'un."
    m_Metadata:
      m_Items: []
  - m_Id: 152
    m_Localized: Il y en a beaucoup qui veulent te remercier, tu sais.
    m_Metadata:
      m_Items: []
  - m_Id: 153
    m_Localized: "Je suppose que t'\xE9tais juste un joli visage finalement\u2026
      et dire que j'avais vraiment cru en toi."
    m_Metadata:
      m_Items: []
  - m_Id: 154
    m_Localized: "\u2026bon, j'esp\xE8re au moins que tu passes une bonne journ\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 155
    m_Localized: "Bonjour ! Comment \xE7a va aujourd'hui ?"
    m_Metadata:
      m_Items: []
  - m_Id: 156
    m_Localized: "Simple visite de routine pour votre petit compagnon ? Hmm, on va
      voir \xE7a\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 157
    m_Localized: "Ohhhh\u2026 hmm\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 158
    m_Localized: Eh bien, votre petit compagnon n'est pas en grande forme !
    m_Metadata:
      m_Items: []
  - m_Id: 159
    m_Localized: Regardez ! Une de ses pattes est plus courte que l'autre ; c'est
      clairement un signe de malnutrition !
    m_Metadata:
      m_Items: []
  - m_Id: 160
    m_Localized: Non, non, je ne dis pas que vous vous en occupez mal.
    m_Metadata:
      m_Items: []
  - m_Id: 161
    m_Localized: "Votre isopode ne re\xE7oit tout simplement pas assez de nutriments."
    m_Metadata:
      m_Items: []
  - m_Id: 162
    m_Localized: "Vous savez comment sont les marques distributeur de nos jours :
      ultra-transform\xE9es et bourr\xE9es d'agents de remplissage."
    m_Metadata:
      m_Items: []
  - m_Id: 163
    m_Localized: Tenez, moi, je recommande personnellement cette marque-ci.
    m_Metadata:
      m_Items: []
  - m_Id: 164
    m_Localized: "Elle est un peu plus ch\xE8re, certes, mais je vous assure qu'elle
      est bien plus riche en nutriments et plus naturelle."
    m_Metadata:
      m_Items: []
  - m_Id: 165
    m_Localized: Je vous recommande vivement de changer rapidement, sinon votre isopode
      court un risque important de tomber malade.
    m_Metadata:
      m_Items: []
  - m_Id: 166
    m_Localized: "Ce que je veux dire ? Vous voyez\u2026 il n'y a pas que la nourriture."
    m_Metadata:
      m_Items: []
  - m_Id: 167
    m_Localized: Il semble que votre isopode souffre d'une grave maladie respiratoire
      chronique.
    m_Metadata:
      m_Items: []
  - m_Id: 168
    m_Localized: "Cela semble \xEAtre d'origine g\xE9n\xE9tique ; ses branchies n'absorbent
      pas correctement l'oxyg\xE8ne."
    m_Metadata:
      m_Items: []
  - m_Id: 169
    m_Localized: "Avec le temps, cela provoquera de graves complications et entra\xEEnera
      certainement une mort pr\xE9matur\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 170
    m_Localized: "Nous allons devoir pr\xE9lever un \xE9chantillon de tissu afin
      de d\xE9terminer quel m\xE9dicament sera le plus efficace."
    m_Metadata:
      m_Items: []
  - m_Id: 171
    m_Localized: "Dans le pire des cas, une op\xE9ration pourrait \xEAtre n\xE9cessaire
      pour remplacer ses branchies par des branchies artificielles."
    m_Metadata:
      m_Items: []
  - m_Id: 172
    m_Localized: "Je suis vraiment d\xE9sol\xE9 de devoir vous annoncer une si mauvaise
      nouvelle."
    m_Metadata:
      m_Items: []
  - m_Id: 173
    m_Localized: "Je vais vous prescrire des flocons m\xE9dicamenteux pour cette
      semaine, et nous pr\xE9l\xE8verons l'\xE9chantillon aujourd'hui."
    m_Metadata:
      m_Items: []
  - m_Id: 174
    m_Localized: "Soyez assur\xE9 que je ferai absolument tout mon possible pour
      sauver votre cher isopode."
    m_Metadata:
      m_Items: []
  - m_Id: 175
    m_Localized: Cela vous fait environ 800 dollars pour aujourd'hui.
    m_Metadata:
      m_Items: []
  - m_Id: 176
    m_Localized: "\u2026Pourquoi cette t\xEAte ?"
    m_Metadata:
      m_Items: []
  - m_Id: 177
    m_Localized: "Bonjour ! J'esp\xE8re que vous allez bien tous les deux !"
    m_Metadata:
      m_Items: []
  - m_Id: 178
    m_Localized: "Je vais d'abord faire un petit bilan de sant\xE9 \xE0 votre compagnon,
      puis nous parlerons des r\xE9sultats des analyses."
    m_Metadata:
      m_Items: []
  - m_Id: 179
    m_Localized: "Hmm\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 180
    m_Localized: "Bon, voici la bonne nouvelle : votre isopode est relativement stable
      et va beaucoup mieux que la semaine derni\xE8re."
    m_Metadata:
      m_Items: []
  - m_Id: 181
    m_Localized: "La mauvaise nouvelle, ce sont les r\xE9sultats des analyses."
    m_Metadata:
      m_Items: []
  - m_Id: 182
    m_Localized: "D\xE9sormais, votre isopode aura besoin d'injections de rappel
      r\xE9guli\xE8res et de m\xE9dicaments."
    m_Metadata:
      m_Items: []
  - m_Id: 183
    m_Localized: Malheureusement, cela ne suffira pas. La meilleure solution reste
      les branchies artificielles.
    m_Metadata:
      m_Items: []
  - m_Id: 184
    m_Localized: "Les d\xE9g\xE2ts sont malheureusement trop importants. Les injections
      et les m\xE9dicaments ne sont que des mesures temporaires."
    m_Metadata:
      m_Items: []
  - m_Id: 185
    m_Localized: "La meilleure solution est une op\xE9ration pour remplacer les branchies."
    m_Metadata:
      m_Items: []
  - m_Id: 186
    m_Localized: Malheureusement, cette intervention n'est pas couverte par l'assurance
      de votre entreprise.
    m_Metadata:
      m_Items: []
  - m_Id: 187
    m_Localized: Vous devrez la payer de votre poche.
    m_Metadata:
      m_Items: []
  - m_Id: 188
    m_Localized: Nous allons faire un rappel aujourd'hui, et je vais vous prescrire
      un nouveau traitement.
    m_Metadata:
      m_Items: []
  - m_Id: 189
    m_Localized: "Lors de votre prochaine visite, dites-moi si vous souhaitez proc\xE9der
      \xE0 l'op\xE9ration."
    m_Metadata:
      m_Items: []
  - m_Id: 190
    m_Localized: "Le prix ? Eh bien\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 191
    m_Localized: "Sachez simplement que ce ne sera pas donn\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 192
    m_Localized: "Alors, vous avez d\xE9cid\xE9 de proc\xE9der \xE0 l'op\xE9ration
      ? Tr\xE8s bien."
    m_Metadata:
      m_Items: []
  - m_Id: 193
    m_Localized: Nous la programmerons pour la semaine prochaine.
    m_Metadata:
      m_Items: []
  - m_Id: 194
    m_Localized: L'injection d'aujourd'hui ? Oui, oui, on va y venir.
    m_Metadata:
      m_Items: []
  - m_Id: 195
    m_Localized: Vous devrez verser aujourd'hui un acompte non remboursable.
    m_Metadata:
      m_Items: []
  - m_Id: 196
    m_Localized: "Oui, aujourd'hui. Et non remboursable. Sinon, comment voulez-vous
      que je rembourse mon\u2014"
    m_Metadata:
      m_Items: []
  - m_Id: 197
    m_Localized: Euh. Bref.
    m_Metadata:
      m_Items: []
  - m_Id: 198
    m_Localized: "C'est une pratique standard ; je ne comprends pas pourquoi vous
      le prenez comme \xE7a\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 199
    m_Localized: "Vous n'avez pas assez pour l'acompte et les frais de traitement
      habituels aujourd'hui ? Eh bien\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 200
    m_Localized: "Si vous \xEAtes d\xE9cid\xE9 \xE0 faire l'op\xE9ration, on sautera
      l'injection aujourd'hui."
    m_Metadata:
      m_Items: []
  - m_Id: 201
    m_Localized: "Oui, manquer le rappel aujourd'hui ne posera pas de probl\xE8me\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 202
    m_Localized: "Mais si on arr\xEAte les m\xE9dicaments, il faudra absolument op\xE9rer
      la semaine prochaine."
    m_Metadata:
      m_Items: []
  - m_Id: 203
    m_Localized: "Alors d\xE9brouillez-vous pour r\xE9unir la somme d'ici la semaine
      prochaine."
    m_Metadata:
      m_Items: []
  - m_Id: 204
    m_Localized: Vous avez l'argent ?
    m_Metadata:
      m_Items: []
  - m_Id: 205
    m_Localized: "\u2026Waouh. M\xEAme avec votre petit boulot minable, vous avez
      r\xE9ussi \xE0 r\xE9unir la somme ?"
    m_Metadata:
      m_Items: []
  - m_Id: 206
    m_Localized: "Euh\u2026 pas que je sache ce que vous faites comme m\xE9tier.
      C'est juste que votre salaire donnait une assez bonne id\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 207
    m_Localized: "Bon, puisque vous avez la totalit\xE9 aujourd'hui, nous allons
      anesth\xE9sier votre isopode."
    m_Metadata:
      m_Items: []
  - m_Id: 208
    m_Localized: "Soyez assur\xE9 que nous ferons absolument tout notre possible."
    m_Metadata:
      m_Items: []
  - m_Id: 209
    m_Localized: Il va s'en sortir.
    m_Metadata:
      m_Items: []
  - m_Id: 210
    m_Localized: Vous avez l'argent ?
    m_Metadata:
      m_Items: []
  - m_Id: 211
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 212
    m_Localized: Ce n'est pas assez.
    m_Metadata:
      m_Items: []
  - m_Id: 213
    m_Localized: "D\xE9sol\xE9, vous nous prenez pour une association caritative
      ? Nous aussi, on a des bouches \xE0 nourrir."
    m_Metadata:
      m_Items: []
  - m_Id: 214
    m_Localized: "Conform\xE9ment \xE0 notre r\xE8glement, nous ne pouvons pratiquer
      aucune intervention tant que la totalit\xE9 de la somme n'a pas \xE9t\xE9 r\xE9gl\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 215
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 216
    m_Localized: "Me supplier ne changera rien. Je ne vais pas risquer mon poste
      pour \xE7a."
    m_Metadata:
      m_Items: []
  - m_Id: 217
    m_Localized: "Vous voulez r\xE9cup\xE9rer votre argent ? Je croyais que c'\xE9tait
      clair\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 218
    m_Localized: "L'acompte non remboursable de la semaine derni\xE8re \xE9tait\u2026
      non remboursable."
    m_Metadata:
      m_Items: []
  - m_Id: 219
    m_Localized: "L'argent d'aujourd'hui ? Eh bien\u2026 ce sont les frais de consultation.
      Et devinez quoi ? Vous venez d'avoir une consultation."
    m_Metadata:
      m_Items: []
  - m_Id: 220
    m_Localized: Donc non.
    m_Metadata:
      m_Items: []
  - m_Id: 221
    m_Localized: Oh, vous savez quoi ? Tenez.
    m_Metadata:
      m_Items: []
  - m_Id: 222
    m_Localized: Une pierre tombale offerte par la maison, dans le cadre de notre
      forfait gratuit de soins post-traitement pour tous nos patients.
    m_Metadata:
      m_Items: []
  - m_Id: 223
    m_Localized: Tchao !
    m_Metadata:
      m_Items: []
  - m_Id: 224
    m_Localized: "goutte\u2026 goutte\u2026 goutte\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 225
    m_Localized: grrregghhhhh
    m_Metadata:
      m_Items: []
  - m_Id: 226
    m_Localized: "laissez\u2026 moi\u2026 partir\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 227
    m_Localized: squawacklackclackclackclack
    m_Metadata:
      m_Items: []
  - m_Id: 228
    m_Localized: '*sploutch* (effet sonore)'
    m_Metadata:
      m_Items: []
  - m_Id: 229
    m_Localized: "Wouah, ces pattes sont g\xE9niales ! Hein ? HEIN ???"
    m_Metadata:
      m_Items: []
  - m_Id: 230
    m_Localized: graaawwwwwrrrr
    m_Metadata:
      m_Items: []
  - m_Id: 231
    m_Localized: rrrrrgggghhhhh
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
