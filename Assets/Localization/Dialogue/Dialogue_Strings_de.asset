%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_Strings_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 35bb4ba5f1f0c4df8b2ab72c443b2046, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: Hallo!
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "Ich hoffe, Sie haben einen sch\xF6nen Tag."
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "Du siehst ersch\xF6pft aus."
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: Wie geht es den Kindern?
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: Wann gehen Sie in Rente?
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: Wir haben herrliches Wetter!
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: Igitt, lag hier vor Kurzem ein Fisch? Der stinkt ja!
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: Hoffentlich regnet es dieses Wochenende.
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "Hast du geh\xF6rt, dass unsere Steuern erh\xF6ht werden?"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: Ich besuche meine Freundin, mit der ich weit weg wohne! Wir haben
      uns seit Jahren nicht gesehen.
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: Ich fahre zum ersten Mal seit zehn Jahren in den Urlaub!
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: Ich laufe vor meiner Vergangenheit davon.
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: Wussten Sie, dass dieser Zug Geschwindigkeiten von bis zu 57 Meilen
      pro Stunde erreicht?! Er ist so schnell!
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: Schnell, entwerten Sie mein Ticket! Kontrollieren Sie etwa ernsthaft
      meinen Ausweis?!
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: Hast du meinen Propellerhut gesehen? Ich muss ihn wohl im Zug vergessen
      haben.
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: Hast du meinen Zylinder gesehen? Ich muss ihn wohl im Zug vergessen
      haben.
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "Hast du meinen gr\xFCnen Hut gesehen? Ich muss ihn wohl im Zug
      vergessen haben."
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "Was suchen Sie auf meinem Ausweis? Gef\xE4llt Ihnen mein Foto,
      H\xFCbscher?"
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: Das bin ich auf dem Bild, lasst mich endlich durch!
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "Es ist so schwierig, den \xDCberblick \xFCber diese Fahrkarten
      zu behalten. Fr\xFCher haben wir den Schaffner einfach gek\xFCsst."
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: "Es ist so schwierig, den \xDCberblick \xFCber diese Tickets zu
      behalten. Fr\xFCher haben wir einfach an der Kasse bezahlt."
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: "Es ist so schwierig, den \xDCberblick \xFCber diese Strafzettel
      zu behalten. Fr\xFCher haben wir einfach um Verzeihung gebeten, nicht um Erlaubnis."
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: Ich warte schon ewig in der Schlange
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "Nennt man es Zug oder Stra\xDFenbahn?"
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: "Mein Nachbar hat mir erz\xE4hlt, dass man mit diesen Shuttles f\xFCr
      immer verschwindet. Stimmt das?"
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: Mit diesen Forschern stimmt etwas nicht.
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: "Die Leute, die aus diesem Labor zur\xFCckkommen, riechen komisch."
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "Manchmal h\xF6re ich nachts Schreie."
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: "Ich habe geh\xF6rt, dass die Crustacean Corporation an diesen armen
      Menschen experimentiert!"
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: "Auch wenn du kein Fisch bist, solltest du f\xFCr die Rechte der
      Fische stimmen."
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: "Immerhin machen das alle T\xE4ter freiwillig. Und sie werden daf\xFCr
      auch noch bezahlt!"
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: Glauben Sie, dass noch Forschungsstellen vakant sind?
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: Die Firma Crustacean Corp hat mir einen Job angeboten, aber irgendwas
      stimmt nicht mit denen.
    m_Metadata:
      m_Items: []
  - m_Id: 34
    m_Localized: "Ich melde mich freiwillig f\xFCr das neue Forschungsprojekt!"
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: "Mein Lolli\u2026wo ist er nur hin\u2026 ;("
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: "Mein bester Freund hei\xDFt Samuel! Wie hei\xDFt dein bester Freund?"
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: "Samuel sah heute komisch aus\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: "Mama sieht in ihrer wei\xDFen Jacke immer so cool aus!"
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: Mama kocht das beste Essen im ganzen weiten Meer!
    m_Metadata:
      m_Items: []
  - m_Id: 40
    m_Localized: "Schule ist so langweilig\u2026 Herr, w\xFCrden Sie mit mir und
      Samuel spielen? \u2026Ach so, okay."
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: "Welche S\xFC\xDFigkeiten mag ich? Hm, ich mag Jawbreaker und Kandiszucker,
      aber Lutscher sind meine absoluten Favoriten!"
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: "Hey! Ich habe heute meinen Lieblings-Erdbeer-Bananen-Lutscher bekommen!
      M\xF6chtest du auch einen?"
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: "Heute gab es im Laden keine Erdbeer-Banane\u2026 Das ist meine
      Lieblingssorte\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: "Ich mag meine Mama, ich mag Samuel, ich mag Erdbeer-Bananen-Lollis\u2026und
      dich mag ich auch!"
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: Ich liebe den Regen einfach, du nicht auch?
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: "Ich brauche doch keine Eintrittskarte f\xFCr eine Pflanze, oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: Ich kann mein Schild im Zug mitnehmen, richtig?
    m_Metadata:
      m_Items: []
  - m_Id: 48
    m_Localized: Meine Pflanze Shelldon sieht heute etwas welk aus.
    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: "Ich habe heute alle meine T\xF6pfe nach drau\xDFen gestellt, um
      das Wasser aufzufangen."
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: Kann ich Auberginen-Parmigiana im Zug mitnehmen?
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: "Du solltest zu meiner n\xE4chsten Demonstration kommen!"
    m_Metadata:
      m_Items: []
  - m_Id: 52
    m_Localized: Haben Sie jemals gedacht, dass die dunklen Wolken uns etwas mitteilen
      wollen?
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: Die neuen Labore grenzen uns Fische nur noch weiter aus.
    m_Metadata:
      m_Items: []
  - m_Id: 54
    m_Localized: "Wenn ich mich vor dem Labor anketten w\xFCrde, glauben Sie, dass
      sie den Betrieb einstellen w\xFCrden?"
    m_Metadata:
      m_Items: []
  - m_Id: 55
    m_Localized: "Ach, meine alte H\xFClle knarrt so. Schick eine alte Seele auf
      ihren Weg, junger Bursche?"
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: "Es gab eine Zeit, da durchstreiften alle Lebewesen den Meeresgrund.
      Man vermisst diese l\xE4ngst vergangenen Tage."
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: "Diejenigen, mit denen man einst reiste, sind l\xE4ngst fort, ihre
      Spuren sind aus dieser Welt verschwunden."
    m_Metadata:
      m_Items: []
  - m_Id: 58
    m_Localized: "Pff! Verglichen mit denen von fr\xFCher sind die J\xE4ger von heute
      schm\xE4chtige Gestalten."
    m_Metadata:
      m_Items: []
  - m_Id: 59
    m_Localized: "Verzeiht mir meine Tr\xE4gheit; ich bin schon lange an diesen Rollstuhl
      gefesselt."
    m_Metadata:
      m_Items: []
  - m_Id: 60
    m_Localized: Junger Mann, mach nicht dieselben Fehler wie der andere. Wenn du
      jemanden retten kannst, dann sieh nicht tatenlos zu und schick ihn in den Tod.
    m_Metadata:
      m_Items: []
  - m_Id: 61
    m_Localized: "Man h\xF6rt noch immer ihre Schreie\u2026man kann nicht sagen,
      ob sie aus alten Tr\xE4umen oder aus dem Leiden der Gegenwart stammen."
    m_Metadata:
      m_Items: []
  - m_Id: 62
    m_Localized: "Technologie und Transport sind heutzutage so fortschrittlich\u2026
      man kann sich in diesem Zeitalter nur allzu gut wie ein Fremder f\xFChlen."
    m_Metadata:
      m_Items: []
  - m_Id: 63
    m_Localized: "Junger Mann, geh raus und genie\xDFe das Leben mit deinen Lieben.
      Widme dein Leben nicht dem \xDCberleben und endest nicht als der einsame Letzte."
    m_Metadata:
      m_Items: []
  - m_Id: 64
    m_Localized: "...Meine Freunde? \u2026In den Geschichtsb\xFCchern waren sie als
      tapfere Krieger bekannt, aber man m\xF6chte sie lieber jenseits der ihnen zugewiesenen
      Beschreibungen in Erinnerung behalten."
    m_Metadata:
      m_Items: []
  - m_Id: 65
    m_Localized: "...z\xF6gern Sie nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 66
    m_Localized: "Ich brauche mehr Geld, um mir alle meine B\xF6gen leisten zu k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 67
    m_Localized: "Ich w\xFCnschte, es w\xE4re heute etwas k\xE4lter."
    m_Metadata:
      m_Items: []
  - m_Id: 68
    m_Localized: "Mit einer Schleife s\xE4hest du auch s\xFC\xDFer aus!"
    m_Metadata:
      m_Items: []
  - m_Id: 69
    m_Localized: Ich kann es kaum erwarten, mich im Zug einzukuscheln und zu lesen.
    m_Metadata:
      m_Items: []
  - m_Id: 70
    m_Localized: "Du sollst heute kein Blau tragen, wei\xDFt du?"
    m_Metadata:
      m_Items: []
  - m_Id: 71
    m_Localized: Findest du, ich spreche zu leise?
    m_Metadata:
      m_Items: []
  - m_Id: 72
    m_Localized: "Ich mag keinen Augenkontakt. K\xF6nntest du mich bitte nicht ansehen,
      wenn ich dich ansehe?"
    m_Metadata:
      m_Items: []
  - m_Id: 73
    m_Localized: "Ich hoffe, dass das neue Labor eine Sekret\xE4rin gebrauchen kann...
      Ich bewerbe mich schon ewig."
    m_Metadata:
      m_Items: []
  - m_Id: 74
    m_Localized: Hey Kleiner! Mir sind die Witze ausgegangen, wenn du welche hast,
      immer her damit!
    m_Metadata:
      m_Items: []
  - m_Id: 75
    m_Localized: "Ich hoffe, Billie und Millie machen sich gut in der Schule\u2026
      ach, die sind Stars wie du und ich, mein Kind!"
    m_Metadata:
      m_Items: []
  - m_Id: 76
    m_Localized: "Psst, wei\xDFt du, wo hier in der Gegend das sch\xF6nste Blumenfeld
      ist? Nein, das ist keine Pointe, ich meine es ernst!"
    m_Metadata:
      m_Items: []
  - m_Id: 77
    m_Localized: Ich bin total aufgeregt! Ich habe es geschafft, mir kurz vor Feierabend
      die letzten Basalt-Konzertkarten zu sichern!
    m_Metadata:
      m_Items: []
  - m_Id: 78
    m_Localized: "Oh, du siehst heute echt super aus! Hast du ein Date? Brauchst
      du ein paar Tipps? Keine Sorge, die sind kostenlos! Im Gegensatz zu diesen
      Ticketpreisen\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 79
    m_Localized: "Dieser Wildblumenstrau\xDF? Den mache ich jedes Mal f\xFCr meine
      Frau, wenn ich nach Hause komme."
    m_Metadata:
      m_Items: []
  - m_Id: 80
    m_Localized: "Hey, was haben die beiden Ozeane zueinander gesagt? Nichts, sie
      haben nur gewunken! HAHA! \u2026Oh, ich glaube, den Witz hast du schon zu oft
      geh\xF6rt, hm\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 81
    m_Localized: "Ich w\xFCnsche mir einfach nur, dass meine Familie in Sicherheit
      ist und gl\xFCcklich lebt."
    m_Metadata:
      m_Items: []
  - m_Id: 82
    m_Localized: "Ich glaube, ich werde bald k\xFCndigen. Ich finde einfach einen
      sichereren Job, n\xE4her an meiner Familie."
    m_Metadata:
      m_Items: []
  - m_Id: 83
    m_Localized: Opa sagte mir, du seist gutaussehend, und er hatte Recht!
    m_Metadata:
      m_Items: []
  - m_Id: 84
    m_Localized: Gibt es Krustentiere, die Sie besonders im Auge haben?
    m_Metadata:
      m_Items: []
  - m_Id: 85
    m_Localized: "Heute ist ein wundersch\xF6ner Tag, nicht wahr?"
    m_Metadata:
      m_Items: []
  - m_Id: 86
    m_Localized: Ich liebe es einfach, zu dieser Jahreszeit mit dem Zug zu fahren.
    m_Metadata:
      m_Items: []
  - m_Id: 87
    m_Localized: Gestern war mein und Opas 50. Hochzeitstag!
    m_Metadata:
      m_Items: []
  - m_Id: 88
    m_Localized: "Ich m\xF6chte dich mit meiner Enkelin bekannt machen... Du w\xFCrdest
      sie lieben!"
    m_Metadata:
      m_Items: []
  - m_Id: 89
    m_Localized: "Ich habe einen Ehemann f\xFCr meine Enkelin gefunden, von der ich
      erz\xE4hlt habe, und sie sind \xFCbergl\xFCcklich."
    m_Metadata:
      m_Items: []
  - m_Id: 90
    m_Localized: "Ich habe geh\xF6rt, du h\xE4ttest vielleicht einen heimlichen Verehrer."
    m_Metadata:
      m_Items: []
  - m_Id: 91
    m_Localized: Ich sehe, wie der Postbote dich ansieht, er ist hin und weg.
    m_Metadata:
      m_Items: []
  - m_Id: 92
    m_Localized: "Falls Sie in Zukunft einmal ein Date mit diesem Postboten haben
      sollten, w\xFCrde ich etwas anderes tragen."
    m_Metadata:
      m_Items: []
  - m_Id: 93
    m_Localized: Ich hoffe, sie geben dir hier genug Pausen.
    m_Metadata:
      m_Items: []
  - m_Id: 94
    m_Localized: "Halten Sie unbedingt an und genie\xDFen Sie die Meeresbrise."
    m_Metadata:
      m_Items: []
  - m_Id: 95
    m_Localized: Wie oft kannst du dich von ein und demselben Problem noch entmutigen
      lassen?
    m_Metadata:
      m_Items: []
  - m_Id: 96
    m_Localized: Vergiss nicht, anderen zu sagen, dass du sie liebst.
    m_Metadata:
      m_Items: []
  - m_Id: 97
    m_Localized: Vergiss nie, dass du immer von vorne anfangen kannst.
    m_Metadata:
      m_Items: []
  - m_Id: 98
    m_Localized: "An sonnigen wie an regnerischen Tagen ist alles m\xF6glich."
    m_Metadata:
      m_Items: []
  - m_Id: 99
    m_Localized: Warte nicht auf neue Gelegenheiten, sondern suche sie dir!
    m_Metadata:
      m_Items: []
  - m_Id: 100
    m_Localized: In schlechten Zeiten warten gute Zeiten immer schon am Horizont.
    m_Metadata:
      m_Items: []
  - m_Id: 101
    m_Localized: "Sich um etwas anderes zu k\xFCmmern, gibt einem einen Grund, weiterzumachen"
    m_Metadata:
      m_Items: []
  - m_Id: 102
    m_Localized: Alles in Ordnung bei dir, Kleiner?
    m_Metadata:
      m_Items: []
  - m_Id: 103
    m_Localized: Hast du etwas auf dem Herzen?
    m_Metadata:
      m_Items: []
  - m_Id: 104
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 105
    m_Localized: Viele Menschen verdanken Ihnen ihren Lebensunterhalt, wissen Sie.
    m_Metadata:
      m_Items: []
  - m_Id: 106
    m_Localized: "Viele Leben w\xE4ren vielleicht zerst\xF6rt worden, wenn du nicht
      gewesen w\xE4rst."
    m_Metadata:
      m_Items: []
  - m_Id: 107
    m_Localized: Aber das ist doch nur ein schwacher Trost, nicht wahr?
    m_Metadata:
      m_Items: []
  - m_Id: 108
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 109
    m_Localized: Es tut mir leid um dein Haustier, Kleiner.
    m_Metadata:
      m_Items: []
  - m_Id: 110
    m_Localized: Mir ist schon vor einiger Zeit aufgefallen, dass du es immer seltener
      herausgenommen hast, und in letzter Zeit habe ich es gar nicht mehr gesehen.
    m_Metadata:
      m_Items: []
  - m_Id: 111
    m_Localized: "Irgendwie habe ich das Gef\xFChl, du musstest es aufgeben."
    m_Metadata:
      m_Items: []
  - m_Id: 112
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 113
    m_Localized: "Darf ich Ihnen eine Geschichte erz\xE4hlen?"
    m_Metadata:
      m_Items: []
  - m_Id: 114
    m_Localized: "Als ich jung war, lernte ich ein M\xE4dchen kennen. Ich liebte
      sie von ganzem Herzen."
    m_Metadata:
      m_Items: []
  - m_Id: 115
    m_Localized: "Wir haben alles \xFCberst\xFCrzt, geheiratet, und ich hatte pl\xF6tzlich
      eine Familie, bevor ich das wirklich verkraften konnte."
    m_Metadata:
      m_Items: []
  - m_Id: 116
    m_Localized: "Wir hatten M\xFChe, \xFCber die Runden zu kommen, obwohl wir beide
      berufst\xE4tig waren."
    m_Metadata:
      m_Items: []
  - m_Id: 117
    m_Localized: "Einer von uns musste eine Ausbildung machen, wenn wir unseren Kindern
      das Leben erm\xF6glichen wollten, das sie verdienten."
    m_Metadata:
      m_Items: []
  - m_Id: 118
    m_Localized: "Also ging ich zur Marine. Sie zahlte sich gut aus und stellte sicher,
      dass ich am Ende mein Studium abschlie\xDFen konnte."
    m_Metadata:
      m_Items: []
  - m_Id: 119
    m_Localized: "Ich habe dort zwei Jahre verbracht, w\xE4hrend des Ammonitenkrieges,
      und war nichts anderes als das Beladen von Schiffen. Ich habe sie mit Torpedos
      bewaffnet."
    m_Metadata:
      m_Items: []
  - m_Id: 120
    m_Localized: "Ich habe noch nie einen Fu\xDF auf ein Schiff gesetzt."
    m_Metadata:
      m_Items: []
  - m_Id: 121
    m_Localized: Nun ja, der Krieg war vorbei, ich habe einen Ingenieurabschluss
      gemacht und bei einer Eisenbahngesellschaft angefangen zu arbeiten.
    m_Metadata:
      m_Items: []
  - m_Id: 122
    m_Localized: "Ein kleines Unternehmen, eine Tochtergesellschaft einer Firma namens
      \u201ECrustacean Corporation\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 123
    m_Localized: "Sie trieben zwar einiges an fragw\xFCrdigen Machenschaften, aber
      ich schenkte dem keine gro\xDFe Beachtung. Schlie\xDFlich finanzierte der Job
      ja das Studium meiner eigenen Kinder."
    m_Metadata:
      m_Items: []
  - m_Id: 124
    m_Localized: Dadurch konnte ich mir jedes Jahr eine Weltreise leisten.
    m_Metadata:
      m_Items: []
  - m_Id: 125
    m_Localized: Dann, eines Jahres, unternahm ich eine Reise nach Ammonatia.
    m_Metadata:
      m_Items: []
  - m_Id: 126
    m_Localized: "Ich stie\xDF zuf\xE4llig auf einen der Orte, die die Marine besucht
      hatte, und sah Fossil um Fossil um Fossil den Boden \xFCbers\xE4t\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 127
    m_Localized: "\u2026alles umgeben von alten Torpedoh\xFClsen."
    m_Metadata:
      m_Items: []
  - m_Id: 128
    m_Localized: Und mir wurde, genau wie dir, klar, dass ich die Verantwortung trug.
    m_Metadata:
      m_Items: []
  - m_Id: 129
    m_Localized: "Ich war nie Kapit\xE4n eines Schiffes."
    m_Metadata:
      m_Items: []
  - m_Id: 130
    m_Localized: Ich habe die Torpedos nie abgefeuert.
    m_Metadata:
      m_Items: []
  - m_Id: 131
    m_Localized: "Aber jeder einzelne der dort befindlichen Torpedos h\xE4tte von
      mir geladen sein k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 132
    m_Localized: "Und vielleicht h\xE4tten, wenn ich nicht dort gewesen w\xE4re,
      noch ein paar Ammoniten \xFCberlebt."
    m_Metadata:
      m_Items: []
  - m_Id: 133
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 134
    m_Localized: "Ich habe meinen Job als Lokf\xFChrer sofort nach meiner R\xFCckkehr
      gek\xFCndigt."
    m_Metadata:
      m_Items: []
  - m_Id: 135
    m_Localized: "Stattdessen fing ich in einer kleinen, familiengef\xFChrten Autowerkstatt
      an zu arbeiten."
    m_Metadata:
      m_Items: []
  - m_Id: 136
    m_Localized: "Drei\xDFig Jahre lang bin ich nicht mehr in Urlaub gefahren."
    m_Metadata:
      m_Items: []
  - m_Id: 137
    m_Localized: "Aber ich kann jede Nacht gut schlafen, weil ich wei\xDF, dass ich
      diese Bahngesellschaft verlassen habe, bevor\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 138
    m_Localized: "\u2026das ist passiert."
    m_Metadata:
      m_Items: []
  - m_Id: 139
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 140
    m_Localized: Das werden ein paar harte Wochen, mein Junge. Und auch danach noch
      ein paar harte Jahre, bis du wieder auf die Beine kommst.
    m_Metadata:
      m_Items: []
  - m_Id: 141
    m_Localized: Aber ich hoffe, du bereust keine Sekunde davon.
    m_Metadata:
      m_Items: []
  - m_Id: 142
    m_Localized: "Du solltest dir etwas Sch\xF6nes g\xF6nnen\u2026 du hast es verdient."
    m_Metadata:
      m_Items: []
  - m_Id: 143
    m_Localized: Hast du meinen Brief gelesen?
    m_Metadata:
      m_Items: []
  - m_Id: 144
    m_Localized: Glaubst du, du wirst jemals jemanden mehr lieben als deine Assel?
    m_Metadata:
      m_Items: []
  - m_Id: 145
    m_Localized: "Sie haben diese Woche mehr Post als sonst bekommen, haben Sie etwa
      einen Verehrer, von dem ich nichts wei\xDF?"
    m_Metadata:
      m_Items: []
  - m_Id: 146
    m_Localized: "Du gibst dein Geld doch auch f\xFCr andere Dinge als deine Assel
      aus, oder\u2026?"
    m_Metadata:
      m_Items: []
  - m_Id: 147
    m_Localized: "Wir sollten mal zusammen Mittagessen gehen, wenn wir beide Pause
      haben. Ich verspreche, ich werde dich nicht langweilen\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 148
    m_Localized: Denkst du manchmal daran, hier wegzukommen? Ich schon, aber du machst
      es lohnenswert, hier zu bleiben.
    m_Metadata:
      m_Items: []
  - m_Id: 149
    m_Localized: "Wei\xDFt du, ich frage mich langsam, ob ich dich seltener sehe
      als dein Tierarzt\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 150
    m_Localized: "Ich habe gesehen, wie Opa mit dir geplaudert hat\u2026 hat er dir
      etwa wieder geraten, ein Roth-IRA-Konto zu er\xF6ffnen?"
    m_Metadata:
      m_Items: []
  - m_Id: 151
    m_Localized: "Ich wusste, dass du mehr bist als nur ein h\xFCbsches Gesicht,
      du hast auch starke moralische Werte. Das mag ich an einem Menschen."
    m_Metadata:
      m_Items: []
  - m_Id: 152
    m_Localized: "Viele Leute m\xF6chten sich bei Ihnen bedanken, wissen Sie."
    m_Metadata:
      m_Items: []
  - m_Id: 153
    m_Localized: "Ich sch\xE4tze, du warst letztendlich doch nur ein h\xFCbsches
      Gesicht, und ich habe wirklich an dich geglaubt\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 154
    m_Localized: "...nun ja, ich hoffe, Sie haben wenigstens einen sch\xF6nen Tag."
    m_Metadata:
      m_Items: []
  - m_Id: 155
    m_Localized: Hallo zusammen, wie geht es euch heute?
    m_Metadata:
      m_Items: []
  - m_Id: 156
    m_Localized: "Nur zur Routineuntersuchung f\xFCr Ihr Kind hier? Hm, mal sehen\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 157
    m_Localized: "Ohhhh\u2026hmm\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 158
    m_Localized: Nun, deinem Kumpel hier geht es im Moment nicht besonders gut!
    m_Metadata:
      m_Items: []
  - m_Id: 159
    m_Localized: "Seht ihn euch an! Ein Bein ist k\xFCrzer als das andere; das ist
      eindeutig ein Zeichen von Unterern\xE4hrung!"
    m_Metadata:
      m_Items: []
  - m_Id: 160
    m_Localized: Nein, nein, ich sage nicht, dass du sie nicht gut erziehst.
    m_Metadata:
      m_Items: []
  - m_Id: 161
    m_Localized: "Ihre Assel erh\xE4lt einfach nicht gen\xFCgend N\xE4hrstoffe."
    m_Metadata:
      m_Items: []
  - m_Id: 162
    m_Localized: "Sie wissen ja, wie die Eigenmarken heutzutage sind, immer verarbeitet
      und voller F\xFCllstoffe."
    m_Metadata:
      m_Items: []
  - m_Id: 163
    m_Localized: "Hier kann ich Ihnen pers\xF6nlich diese Marke w\xE4rmstens empfehlen."
    m_Metadata:
      m_Items: []
  - m_Id: 164
    m_Localized: "Es ist zwar etwas teurer, aber ich verspreche Ihnen, es ist viel
      n\xE4hrstoffreicher und nat\xFCrlicher."
    m_Metadata:
      m_Items: []
  - m_Id: 165
    m_Localized: "Ich rate Ihnen dringend, bald zu wechseln, sonst besteht f\xFCr
      Ihre Assel ein erhebliches Krankheitsrisiko."
    m_Metadata:
      m_Items: []
  - m_Id: 166
    m_Localized: "Was ich damit meine? Sehen Sie\u2026es geht nicht nur ums Essen."
    m_Metadata:
      m_Items: []
  - m_Id: 167
    m_Localized: Es scheint, als leide Ihre Assel an einer schweren chronischen Atemwegserkrankung.
    m_Metadata:
      m_Items: []
  - m_Id: 168
    m_Localized: Dies scheint genetisch bedingt zu sein; die Kiemen Ihrer Assel sind
      nicht in der Lage, Sauerstoff richtig aufzunehmen.
    m_Metadata:
      m_Items: []
  - m_Id: 169
    m_Localized: "Dies wird mit der Zeit zu schwerwiegenden Problemen f\xFChren und
      mit Sicherheit einen fr\xFChen Tod zur Folge haben."
    m_Metadata:
      m_Items: []
  - m_Id: 170
    m_Localized: "Wir m\xFCssen eine Gewebeprobe entnehmen, um zu testen, welches
      Medikament am besten geeignet ist."
    m_Metadata:
      m_Items: []
  - m_Id: 171
    m_Localized: "Im schlimmsten Fall m\xFCssen wir m\xF6glicherweise eine Operation
      durchf\xFChren, um die Kiemen Ihrer Assel durch k\xFCnstliche zu ersetzen."
    m_Metadata:
      m_Items: []
  - m_Id: 172
    m_Localized: "Es tut mir sehr leid, Ihnen diese schlechte Nachricht \xFCberbringen
      zu m\xFCssen."
    m_Metadata:
      m_Items: []
  - m_Id: 173
    m_Localized: "Ich werde Ihnen f\xFCr diese Woche medizinische Flocken verschreiben,
      und wir werden heute die Probe entnehmen."
    m_Metadata:
      m_Items: []
  - m_Id: 174
    m_Localized: "Bitte vertrauen Sie mir, dass ich mein M\xF6glichstes tun werde,
      um Ihre geliebte Assel zu retten."
    m_Metadata:
      m_Items: []
  - m_Id: 175
    m_Localized: "Ihr heutiger Gesamtbetrag bel\xE4uft sich auf etwa 800 Dollar."
    m_Metadata:
      m_Items: []
  - m_Id: 176
    m_Localized: "\u2026Was soll denn dieses Gesicht?"
    m_Metadata:
      m_Items: []
  - m_Id: 177
    m_Localized: Hallo zusammen, ich hoffe, euch beiden geht es gut!
    m_Metadata:
      m_Items: []
  - m_Id: 178
    m_Localized: "Ich werde zuerst einen Gesundheitscheck bei Ihrem Kleinen durchf\xFChren,
      und anschlie\xDFend werden wir die Testergebnisse besprechen."
    m_Metadata:
      m_Items: []
  - m_Id: 179
    m_Localized: "Hmm\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 180
    m_Localized: 'Nun, hier die gute Nachricht: Ihrer Assel geht es relativ gut und
      deutlich besser als letzte Woche.'
    m_Metadata:
      m_Items: []
  - m_Id: 181
    m_Localized: Die schlechte Nachricht sind die Testergebnisse.
    m_Metadata:
      m_Items: []
  - m_Id: 182
    m_Localized: "Von nun an ben\xF6tigt Ihre Assel regelm\xE4\xDFige Auffrischungsimpfungen
      und Medikamente."
    m_Metadata:
      m_Items: []
  - m_Id: 183
    m_Localized: "Das wird jedoch nicht ausreichen. Die beste L\xF6sung sind k\xFCnstliche
      Kiemen."
    m_Metadata:
      m_Items: []
  - m_Id: 184
    m_Localized: "Leider ist das Ausma\xDF der Sch\xE4digung zu gro\xDF. Spritzen
      und Medikamente sind nur vor\xFCbergehende Ma\xDFnahmen."
    m_Metadata:
      m_Items: []
  - m_Id: 185
    m_Localized: "Die beste L\xF6sung ist eine Operation, bei der die Kiemen ersetzt
      werden."
    m_Metadata:
      m_Items: []
  - m_Id: 186
    m_Localized: Leider ist dies nicht durch Ihre Firmenversicherung abgedeckt.
    m_Metadata:
      m_Items: []
  - m_Id: 187
    m_Localized: "Sie m\xFCssen die Kosten selbst tragen."
    m_Metadata:
      m_Items: []
  - m_Id: 188
    m_Localized: Wir machen heute eine Auffrischungsimpfung, und ich werde Ihnen
      neue Medikamente verschreiben.
    m_Metadata:
      m_Items: []
  - m_Id: 189
    m_Localized: "Bitte teilen Sie mir bis zu Ihrem n\xE4chsten Termin mit, ob Sie
      die Operation durchf\xFChren lassen m\xF6chten."
    m_Metadata:
      m_Items: []
  - m_Id: 190
    m_Localized: "Die Kosten? Nun ja\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 191
    m_Localized: Du solltest wissen, dass es nicht billig wird.
    m_Metadata:
      m_Items: []
  - m_Id: 192
    m_Localized: "Sie haben sich also entschieden, die Operation durchf\xFChren zu
      lassen? Das ist gut."
    m_Metadata:
      m_Items: []
  - m_Id: 193
    m_Localized: "Wir werden es f\xFCr n\xE4chste Woche einplanen."
    m_Metadata:
      m_Items: []
  - m_Id: 194
    m_Localized: "Der Schuss f\xFCr heute? Ja ja, dazu kommen wir noch."
    m_Metadata:
      m_Items: []
  - m_Id: 195
    m_Localized: "Sie m\xFCssen heute eine nicht r\xFCckerstattbare Anzahlung leisten."
    m_Metadata:
      m_Items: []
  - m_Id: 196
    m_Localized: "Ja, heute. Und nicht erstattungsf\xE4hig. Wie soll ich sonst meine..."
    m_Metadata:
      m_Items: []
  - m_Id: 197
    m_Localized: "\xC4hm. Na ja."
    m_Metadata:
      m_Items: []
  - m_Id: 198
    m_Localized: "Das ist g\xE4ngige Praxis; ich verstehe nicht, warum Sie so aufgebracht
      sind..."
    m_Metadata:
      m_Items: []
  - m_Id: 199
    m_Localized: "Sie haben heute nicht genug f\xFCr die Anzahlung und die \xFCblichen
      Behandlungskosten? Nun gut\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 200
    m_Localized: "Wenn Sie sich f\xFCr die Operation entschieden haben, verzichten
      wir heute auf die Spritze."
    m_Metadata:
      m_Items: []
  - m_Id: 201
    m_Localized: "Ja, die Auffrischungsimpfung heute auszulassen, ist in Ordnung\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 202
    m_Localized: "Aber wenn Sie Ihre Assel von den Medikamenten absetzen, m\xFCssen
      wir die Operation n\xE4chste Woche durchf\xFChren."
    m_Metadata:
      m_Items: []
  - m_Id: 203
    m_Localized: "Du solltest also besser bis n\xE4chste Woche genug Geld zusammenkratzen."
    m_Metadata:
      m_Items: []
  - m_Id: 204
    m_Localized: Hast du das Geld?
    m_Metadata:
      m_Items: []
  - m_Id: 205
    m_Localized: "Wow. Selbst mit deinem mickrigen Job hast du tats\xE4chlich genug
      verdient?"
    m_Metadata:
      m_Items: []
  - m_Id: 206
    m_Localized: "\xC4hm\u2026 nicht, dass ich w\xFCsste, was du beruflich machst.
      Die Bezahlung lie\xDF nur irgendwie darauf schlie\xDFen, dass sie schlecht
      war."
    m_Metadata:
      m_Items: []
  - m_Id: 207
    m_Localized: Da Sie heute den vollen Betrag haben, legen wir Ihre Assel unter.
    m_Metadata:
      m_Items: []
  - m_Id: 208
    m_Localized: Seien Sie versichert, dass wir unser Bestes geben werden.
    m_Metadata:
      m_Items: []
  - m_Id: 209
    m_Localized: Sie werden es schaffen.
    m_Metadata:
      m_Items: []
  - m_Id: 210
    m_Localized: Hast du das Geld?
    m_Metadata:
      m_Items: []
  - m_Id: 211
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 212
    m_Localized: Das reicht nicht aus.
    m_Metadata:
      m_Items: []
  - m_Id: 213
    m_Localized: "Entschuldigung, glauben Sie etwa, wir seien eine gemeinn\xFCtzige
      Organisation? Wir haben schlie\xDFlich auch Familien zu ern\xE4hren."
    m_Metadata:
      m_Items: []
  - m_Id: 214
    m_Localized: "Gem\xE4\xDF unseren Richtlinien k\xF6nnen wir den Eingriff erst
      durchf\xFChren, wenn Sie den Betrag vollst\xE4ndig bezahlt haben."
    m_Metadata:
      m_Items: []
  - m_Id: 215
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 216
    m_Localized: Betteln bringt nichts. Ich riskiere deswegen nicht meinen Job.
    m_Metadata:
      m_Items: []
  - m_Id: 217
    m_Localized: "Kann ich mein Geld zur\xFCckbekommen? Ich dachte, das w\xE4re eindeutig\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 218
    m_Localized: "Die letzte Woche geleistete, nicht erstattungsf\xE4hige Anzahlung
      war nicht erstattungsf\xE4hig."
    m_Metadata:
      m_Items: []
  - m_Id: 219
    m_Localized: "Das heutige? Nun ja\u2026 das ist die Beratungsgeb\xFChr. Und wissen
      Sie was? Sie hatten gerade eine Beratung."
    m_Metadata:
      m_Items: []
  - m_Id: 220
    m_Localized: Also nein.
    m_Metadata:
      m_Items: []
  - m_Id: 221
    m_Localized: "Ach, wei\xDFt du was? Hier."
    m_Metadata:
      m_Items: []
  - m_Id: 222
    m_Localized: "Ein kostenloser Grabstein, gratis dazu, als Teil unseres kostenlosen
      Nachsorgepakets f\xFCr alle unsere Patienten."
    m_Metadata:
      m_Items: []
  - m_Id: 223
    m_Localized: "Tsch\xFCss!"
    m_Metadata:
      m_Items: []
  - m_Id: 224
    m_Localized: "Tropf\u2026Tropf\u2026Tropf"
    m_Metadata:
      m_Items: []
  - m_Id: 225
    m_Localized: grrregghhhhh
    m_Metadata:
      m_Items: []
  - m_Id: 226
    m_Localized: "Lass mich gehen\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 227
    m_Localized: squawacklackclackclackclack
    m_Metadata:
      m_Items: []
  - m_Id: 228
    m_Localized: "*quetsch* (Ger\xE4uscheffekt)"
    m_Metadata:
      m_Items: []
  - m_Id: 229
    m_Localized: Mann, sind die Beine toll! Oder? ODER???
    m_Metadata:
      m_Items: []
  - m_Id: 230
    m_Localized: grrrrr
    m_Metadata:
      m_Items: []
  - m_Id: 231
    m_Localized: rrrrrgggghhhhh
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
