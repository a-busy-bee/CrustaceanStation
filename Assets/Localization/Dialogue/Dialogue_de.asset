%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 25e982df099754116b3863808eae6c55, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: "Hall\xF6chen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "Hoffe, du hast einen sch\xF6nen Tag."
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "Du siehst v\xF6llig fertig aus."
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "Wie geht\u2019s den Kindern?"
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: Wann gehst du eigentlich in Rente?
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: Herrliches Wetter heute!
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "Igitt, war hier vor Kurzem ein Fisch? Hier stinkt\u2019s!"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "Hoffentlich regnet\u2019s dieses Wochenende ein bisschen."
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "Hast du geh\xF6rt? Sie erh\xF6hen schon wieder unsere Steuern."
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: Ich besuche endlich jemanden, der weit weg wohnt! Wir haben uns
      seit Jahren nicht gesehen.
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: Mein erster Urlaub seit zehn Jahren!
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: Ich laufe vor meiner Vergangenheit davon.
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: Wusstest du, dass der Zug bis zu 57 Leugen pro Stunde schafft?!
      Der ist SO schnell!
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "Los, entwerte mein Ticket! Pr\xFCfst du jetzt ernsthaft auch noch
      meinen Ausweis?!"
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "Hast du meine Propellerm\xFCtze gesehen? Die muss ich im Zug liegen
      gelassen haben."
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: Hast du meinen Zylinder gesehen? Den muss ich im Zug liegen gelassen
      haben.
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "Hast du meinen gr\xFCnen Hut gesehen? Den muss ich im Zug liegen
      gelassen haben."
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "Was suchst du denn auf meinem Ausweis? Gef\xE4llt dir mein Foto,
      H\xFCbscher?"
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: Das bin doch ich auf dem Foto. Lass mich endlich durch!
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "Bei all diesen Tickets verliert man ja den \xDCberblick. Zu meiner
      Zeit haben wir einfach den Schaffner gek\xFCsst."
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: "Bei all diesen Tickets verliert man ja den \xDCberblick. Zu meiner
      Zeit haben wir einfach beim Einsteigen bezahlt."
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: "Bei all diesen Tickets verliert man ja den \xDCberblick. Zu meiner
      Zeit haben wir um Verzeihung gebeten, nicht um Erlaubnis."
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: Ich stehe hier schon ewig an.
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "Sagst du dazu Zug oder Stra\xDFenbahn?"
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: Mein Nachbar sagt, diese Shuttles bringen einen weg und man kommt
      nie wieder. Stimmt das?
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: Mit diesen Forschern stimmt doch was nicht.
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: "Wer aus diesem Labor zur\xFCckkommt, riecht irgendwie komisch."
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "Manchmal h\xF6re ich nachts Schreie."
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: "Ich hab geh\xF6rt, die Crustacean Corporation experimentiert an
      den armen Dingern!"
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: "Du solltest f\xFCr Fischrechte stimmen, auch wenn du selbst kein
      Fisch bist."
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: "Hey, immerhin machen alle Raubtiere freiwillig mit. Und sie werden
      sogar daf\xFCr bezahlt!"
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: Meinst du, die haben noch Stellen in der Forschung frei?
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: Die Crustacean Corporation hat mir einen Job angeboten, aber mit
      denen stimmt irgendwas nicht.
    m_Metadata:
      m_Items: []
  - m_Id: 34
    m_Localized: "Ich melde mich freiwillig f\xFCr das neue Forschungsprojekt!"
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: "Mein Lolli \u2026 wo ist er hin \u2026 ;("
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: "Mein bester Freund hei\xDFt Samuel! Wie hei\xDFt dein bester Freund?"
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: "Samuel sah heute irgendwie komisch aus \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: "Mama sieht in ihrer wei\xDFen Jacke immer so cool aus!"
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: Mama macht das beste Essen im ganzen weiten Meer!
    m_Metadata:
      m_Items: []
  - m_Id: 40
    m_Localized: "Schule ist sooo langweilig \u2026 Mister, spielst du mit mir und
      Samuel? \u2026 Och, okay."
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: "Welche S\xFC\xDFigkeiten mag ich? Hmm \u2026 Kaubonbons und Kandis
      sind gut, aber Lollis mag ich am allerliebsten!"
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: Mister! Heute hab ich meinen Lieblingslolli mit Erdbeer-Banane bekommen!
      Willst du auch einen?
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: "Heute gab\u2019s im Laden kein Erdbeer-Banane \u2026 Das ist doch
      mein Lieblingsgeschmack \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: "Ich mag Mama, ich mag Samuel, ich mag Erdbeer-Bananen-Lollis \u2026
      und dich mag ich auch!"
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: Ich liebe Regen einfach. Du nicht?
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: "F\xFCr eine Pflanze brauche ich doch kein eigenes Ticket, oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: Mein Protest-Schild darf mit in den Zug, oder?
    m_Metadata:
      m_Items: []
  - m_Id: 48
    m_Localized: Meine Pflanze Shelldon sieht heute ein bisschen schlapp aus.
    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: "Ich hab heute alle meine T\xF6pfe rausgestellt, damit sie das Regenwasser
      auffangen."
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: Darf ich Auberginen-Parmigiana mit in den Zug nehmen?
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: "Du solltest zu meinem n\xE4chsten Protest kommen!"
    m_Metadata:
      m_Items: []
  - m_Id: 52
    m_Localized: Glaubst du manchmal auch, dass uns die dunklen Wolken etwas sagen
      wollen?
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: Die neuen Labore grenzen uns Fische nur noch weiter aus.
    m_Metadata:
      m_Items: []
  - m_Id: 54
    m_Localized: Wenn ich mich vor dem Labor ankette, meinst du, sie stellen den
      Betrieb ein?
    m_Metadata:
      m_Items: []
  - m_Id: 55
    m_Localized: "Ach, mein altes Geh\xE4use knarrt so sehr. L\xE4sst du eine alte
      Seele weiterziehen, junger Freund?"
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: "Es gab eine Zeit, da zogen alle Wesen frei \xFCber den Meeresgrund.
      Ach \u2026 diese l\xE4ngst vergangenen Tage fehlen mir."
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: "Die Gef\xE4hrten von einst sind l\xE4ngst fort. Selbst ihre Spuren
      sind aus dieser Welt verschwunden."
    m_Metadata:
      m_Items: []
  - m_Id: 58
    m_Localized: "Hmpf! Gegen die J\xE4ger von fr\xFCher sind die heutigen doch nur
      d\xFCrre Gestalten."
    m_Metadata:
      m_Items: []
  - m_Id: 59
    m_Localized: "Verzeih diesem tr\xE4gen K\xF6rper. Ich bin schon lange an diesen
      Rollstuhl gebunden."
    m_Metadata:
      m_Items: []
  - m_Id: 60
    m_Localized: Junger Freund, begehe nicht dieselben Fehler wie ich. Wenn du jemanden
      retten kannst, sieh nicht tatenlos zu und schick ihn nicht in den Tod.
    m_Metadata:
      m_Items: []
  - m_Id: 61
    m_Localized: "Noch immer h\xF6re ich ihre Schreie \u2026 Ich wei\xDF nicht, ob
      sie aus alten Tr\xE4umen stammen oder aus dem Leid der Gegenwart."
    m_Metadata:
      m_Items: []
  - m_Id: 62
    m_Localized: "Technik und Verkehr sind heutzutage so weit fortgeschritten \u2026
      In dieser Zeit f\xFChlt man sich unweigerlich wie ein Fremder."
    m_Metadata:
      m_Items: []
  - m_Id: 63
    m_Localized: "Junger Freund, geh hinaus und genie\xDFe dieses Leben mit denen,
      die dir lieb sind. Lebe nicht nur f\xFCrs \xDCberleben, sonst bist du am Ende
      der Letzte, der allein zur\xFCckbleibt."
    m_Metadata:
      m_Items: []
  - m_Id: 64
    m_Localized: "\u2026 Meine Freunde? In den Geschichtsb\xFCchern nennt man sie
      tapfere Krieger. Ich m\xF6chte mich lieber an sie erinnern, wie sie wirklich
      waren."
    m_Metadata:
      m_Items: []
  - m_Id: 65
    m_Localized: "\u2026 z\xF6gere nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 66
    m_Localized: "Ich brauche mehr Geld f\xFCr all meine Schleifen."
    m_Metadata:
      m_Items: []
  - m_Id: 67
    m_Localized: "Ich w\xFCnschte, es w\xE4re heute ein bisschen k\xE4lter."
    m_Metadata:
      m_Items: []
  - m_Id: 68
    m_Localized: "Mit einer Schleife w\xFCrdest du auch noch s\xFC\xDFer aussehen!"
    m_Metadata:
      m_Items: []
  - m_Id: 69
    m_Localized: Ich kann es kaum erwarten, mich im Zug zusammenzurollen und zu lesen.
    m_Metadata:
      m_Items: []
  - m_Id: 70
    m_Localized: "Du wei\xDFt schon, dass man heute kein Blau tr\xE4gt, oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 71
    m_Localized: Findest du, ich rede zu leise?
    m_Metadata:
      m_Items: []
  - m_Id: 72
    m_Localized: "Ich mag keinen Blickkontakt. K\xF6nntest du bitte wegschauen, wenn
      ich dich ansehe?"
    m_Metadata:
      m_Items: []
  - m_Id: 73
    m_Localized: "Hoffentlich braucht das neue Labor noch eine Sekret\xE4rskraft
      \u2026 Ich bewerbe mich gef\xFChlt schon ewig."
    m_Metadata:
      m_Items: []
  - m_Id: 74
    m_Localized: "Hey, Kleiner! Mir sind die Witze ausgegangen. Wenn du einen hast,
      immer her damit \u2014 ich bin ganz Kiemen!"
    m_Metadata:
      m_Items: []
  - m_Id: 75
    m_Localized: "Hoffentlich l\xE4uft\u2019s bei Billie und Millie gut in der Schule
      \u2026 Ach was, die sind Stars, genau wie du und ich, Kleiner!"
    m_Metadata:
      m_Items: []
  - m_Id: 76
    m_Localized: "Psst, hey \u2026 wei\xDFt du, wo hier das sch\xF6nste Blumenfeld
      ist? Nein, das ist keine Einleitung zu einem Witz. Ich mein\u2019s ernst!"
    m_Metadata:
      m_Items: []
  - m_Id: 77
    m_Localized: "Ich bin gerade total aufgedreht! Hab nach der Arbeit noch die letzten
      paar Tickets f\xFCrs Basalt-Konzert erwischt!"
    m_Metadata:
      m_Items: []
  - m_Id: 78
    m_Localized: "Oho, heute siehst du aber richtig schick aus! Ein Date? Brauchst
      du Tipps? Keine Sorge, die kosten nichts. Anders als diese Ticketpreise \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 79
    m_Localized: "Der Wildblumenstrau\xDF? Den mache ich meiner Frau jedes Mal, wenn
      ich endlich wieder nach Hause kann."
    m_Metadata:
      m_Items: []
  - m_Id: 80
    m_Localized: "Hey, was haben zwei Meere zueinander gesagt? Nichts \u2014 sie
      haben sich nur zugewinkt! HAHA! \u2026 Oh. Den kennst du wohl schon, hm?"
    m_Metadata:
      m_Items: []
  - m_Id: 81
    m_Localized: "Ich will einfach nur, dass meine Familie sicher ist und gl\xFCcklich
      leben kann."
    m_Metadata:
      m_Items: []
  - m_Id: 82
    m_Localized: "Ich glaube, ich k\xFCndige bald. Ich \u2026 ich finde bestimmt
      einen sichereren Job, n\xE4her bei meiner Familie."
    m_Metadata:
      m_Items: []
  - m_Id: 83
    m_Localized: "Opa hat gesagt, du siehst gut aus \u2014 und er hatte recht!"
    m_Metadata:
      m_Items: []
  - m_Id: 84
    m_Localized: "Gibt\u2019s ein Krebstier, auf das du ein Auge geworfen hast?"
    m_Metadata:
      m_Items: []
  - m_Id: 85
    m_Localized: "Was f\xFCr ein sch\xF6ner Tag heute, oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 86
    m_Localized: Ich fahre um diese Jahreszeit einfach so gern Zug.
    m_Metadata:
      m_Items: []
  - m_Id: 87
    m_Localized: Opa und ich hatten gestern unseren 50. Hochzeitstag!
    m_Metadata:
      m_Items: []
  - m_Id: 88
    m_Localized: "Ich sollte dich mit meiner Enkelin verkuppeln \u2026 Ihr w\xFCrdet
      euch bestimmt m\xF6gen!"
    m_Metadata:
      m_Items: []
  - m_Id: 89
    m_Localized: "F\xFCr die Enkelin, von der ich dir erz\xE4hlt habe, habe ich einen
      Ehemann gefunden. Die beiden sind so gl\xFCcklich!"
    m_Metadata:
      m_Items: []
  - m_Id: 90
    m_Localized: "Ich hab geh\xF6rt, du hast vielleicht einen heimlichen Verehrer."
    m_Metadata:
      m_Items: []
  - m_Id: 91
    m_Localized: "Ich sehe doch, wie der Postbote dich anschaut. Der ist v\xF6llig
      hin und weg."
    m_Metadata:
      m_Items: []
  - m_Id: 92
    m_Localized: "Falls du irgendwann mal ein Date mit diesem Postboten hast \u2026
      ich w\xFCrde etwas anderes anziehen."
    m_Metadata:
      m_Items: []
  - m_Id: 93
    m_Localized: "Hoffentlich g\xF6nnen sie dir hier genug Pausen."
    m_Metadata:
      m_Items: []
  - m_Id: 94
    m_Localized: "Vergiss nicht, ab und zu innezuhalten und die Meeresbrise zu genie\xDFen."
    m_Metadata:
      m_Items: []
  - m_Id: 95
    m_Localized: Wie oft willst du dich noch von derselben Sache runterziehen lassen?
    m_Metadata:
      m_Items: []
  - m_Id: 96
    m_Localized: Vergiss nicht, den anderen zu sagen, dass du sie liebst.
    m_Metadata:
      m_Items: []
  - m_Id: 97
    m_Localized: 'Vergiss nie: Du kannst immer neu anfangen.'
    m_Metadata:
      m_Items: []
  - m_Id: 98
    m_Localized: "Ob Sonne oder Regen \u2014 jeder Tag kann alles ver\xE4ndern."
    m_Metadata:
      m_Items: []
  - m_Id: 99
    m_Localized: Warte nicht auf neue Chancen. Geh raus und such sie dir.
    m_Metadata:
      m_Items: []
  - m_Id: 100
    m_Localized: Auch in schlechten Zeiten wartet hinter dem Horizont immer etwas
      Gutes.
    m_Metadata:
      m_Items: []
  - m_Id: 101
    m_Localized: "Sich um etwas anderes zu k\xFCmmern, gibt einem einen Grund weiterzumachen."
    m_Metadata:
      m_Items: []
  - m_Id: 102
    m_Localized: Alles in Ordnung bei dir, Kleiner?
    m_Metadata:
      m_Items: []
  - m_Id: 103
    m_Localized: Geht dir was im Kopf herum?
    m_Metadata:
      m_Items: []
  - m_Id: 104
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 105
    m_Localized: "Da drau\xDFen verdanken dir viele ihre Existenz, wei\xDFt du."
    m_Metadata:
      m_Items: []
  - m_Id: 106
    m_Localized: "Ohne dich w\xE4ren vielleicht viele Leben ruiniert worden."
    m_Metadata:
      m_Items: []
  - m_Id: 107
    m_Localized: "Aber ein gro\xDFer Trost ist das nicht, was?"
    m_Metadata:
      m_Items: []
  - m_Id: 108
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 109
    m_Localized: Das mit deinem Haustier tut mir leid, Kleiner.
    m_Metadata:
      m_Items: []
  - m_Id: 110
    m_Localized: Mir ist schon vor einer Weile aufgefallen, dass du es immer seltener
      mitgenommen hast. Und in letzter Zeit hab ich es gar nicht mehr gesehen.
    m_Metadata:
      m_Items: []
  - m_Id: 111
    m_Localized: Irgendwas sagt mir, dass du es abgeben musstest.
    m_Metadata:
      m_Items: []
  - m_Id: 112
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 113
    m_Localized: "Darf ich dir eine Geschichte erz\xE4hlen?"
    m_Metadata:
      m_Items: []
  - m_Id: 114
    m_Localized: "Als ich jung war, lernte ich ein M\xE4dchen kennen. Ich liebte
      sie von ganzem Herzen."
    m_Metadata:
      m_Items: []
  - m_Id: 115
    m_Localized: "Wir haben alles \xFCberst\xFCrzt, geheiratet, und pl\xF6tzlich
      hatte ich eine Familie, bevor ich wirklich daf\xFCr bereit war."
    m_Metadata:
      m_Items: []
  - m_Id: 116
    m_Localized: "Wir kamen kaum \xFCber die Runden, obwohl wir beide gearbeitet
      haben."
    m_Metadata:
      m_Items: []
  - m_Id: 117
    m_Localized: Einer von uns musste eine Ausbildung machen, wenn unsere Kinder
      einmal das Leben haben sollten, das sie verdienten.
    m_Metadata:
      m_Items: []
  - m_Id: 118
    m_Localized: Also ging ich zur Marine. Die Bezahlung war gut, und am Ende konnte
      ich damit mein Studium finanzieren.
    m_Metadata:
      m_Items: []
  - m_Id: 119
    m_Localized: "Ich war zwei Jahre dort, w\xE4hrend des Ammonitenkriegs. Ich habe
      nur Fahrzeuge beladen und mit Torpedos best\xFCckt."
    m_Metadata:
      m_Items: []
  - m_Id: 120
    m_Localized: "Ich habe nicht ein einziges Mal einen Fu\xDF auf ein Schiff gesetzt."
    m_Metadata:
      m_Items: []
  - m_Id: 121
    m_Localized: Dann war der Krieg vorbei. Ich machte meinen Abschluss als Ingenieur
      und fing bei einer Bahngesellschaft an.
    m_Metadata:
      m_Items: []
  - m_Id: 122
    m_Localized: "Eine kleine Firma, Tochterunternehmen von etwas namens \u201ECrustacean
      Corporation\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 123
    m_Localized: "Die haben ein paar dubiose Sachen gemacht, aber ich hab mir nicht
      viel dabei gedacht. Der Job bezahlte schlie\xDFlich das Studium meiner Kinder."
    m_Metadata:
      m_Items: []
  - m_Id: 124
    m_Localized: Und jedes Jahr konnte ich mir eine Reise um die Welt leisten.
    m_Metadata:
      m_Items: []
  - m_Id: 125
    m_Localized: Dann reiste ich eines Jahres nach Ammonatia.
    m_Metadata:
      m_Items: []
  - m_Id: 126
    m_Localized: "Ich stie\xDF auf einen der Orte, an denen die Marine gewesen war.
      \xDCberall lagen Fossilien. Eins nach dem anderen nach dem anderen \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 127
    m_Localized: "\u2026 und ringsherum alte Torpedoh\xFClsen."
    m_Metadata:
      m_Items: []
  - m_Id: 128
    m_Localized: Da wurde mir klar, genau wie dir, dass ich mitverantwortlich war.
    m_Metadata:
      m_Items: []
  - m_Id: 129
    m_Localized: Ich habe nie ein Schiff kommandiert.
    m_Metadata:
      m_Items: []
  - m_Id: 130
    m_Localized: Ich habe nie einen Torpedo abgefeuert.
    m_Metadata:
      m_Items: []
  - m_Id: 131
    m_Localized: "Aber jeden einzelnen Torpedo dort h\xE4tte ich selbst verladen
      haben k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 132
    m_Localized: "Und vielleicht h\xE4tten ein paar Ammoniten mehr \xFCberlebt, wenn
      ich nicht dort gewesen w\xE4re."
    m_Metadata:
      m_Items: []
  - m_Id: 133
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 134
    m_Localized: "Sobald ich zur\xFCckkam, k\xFCndigte ich meinen Job als Lokf\xFChrer."
    m_Metadata:
      m_Items: []
  - m_Id: 135
    m_Localized: "Stattdessen fing ich in einer kleinen familiengef\xFChrten Werkstatt
      an."
    m_Metadata:
      m_Items: []
  - m_Id: 136
    m_Localized: "Drei\xDFig Jahre lang machte ich keinen einzigen Urlaub mehr."
    m_Metadata:
      m_Items: []
  - m_Id: 137
    m_Localized: "Aber ich kann jede Nacht ruhig schlafen, weil ich diese Bahngesellschaft
      verlassen habe, bevor \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 138
    m_Localized: "\u2026 das hier passiert ist."
    m_Metadata:
      m_Items: []
  - m_Id: 139
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 140
    m_Localized: "Die n\xE4chsten Wochen werden hart, Kleiner. Und die n\xE4chsten
      Jahre auch, bis du wieder auf die Beine kommst."
    m_Metadata:
      m_Items: []
  - m_Id: 141
    m_Localized: Aber ich hoffe, du bereust keine einzige Sekunde davon.
    m_Metadata:
      m_Items: []
  - m_Id: 142
    m_Localized: "G\xF6nn dir mal was Sch\xF6nes \u2026 du hast es verdient."
    m_Metadata:
      m_Items: []
  - m_Id: 143
    m_Localized: Hast du meinen Brief gelesen?
    m_Metadata:
      m_Items: []
  - m_Id: 144
    m_Localized: Meinst du, du wirst je jemanden mehr lieben als deine Assel?
    m_Metadata:
      m_Items: []
  - m_Id: 145
    m_Localized: "Du hast diese Woche mehr Post als sonst. Hast du einen Verehrer,
      von dem ich nichts wei\xDF?"
    m_Metadata:
      m_Items: []
  - m_Id: 146
    m_Localized: "Du gibst dein Geld auch f\xFCr andere Dinge als deine Assel aus,
      oder \u2026?"
    m_Metadata:
      m_Items: []
  - m_Id: 147
    m_Localized: "Wir sollten mal zusammen Mittag essen, wenn wir beide Pause haben.
      Ich verspreche, ich langweile dich nicht \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 148
    m_Localized: "Denkst du manchmal daran, hier abzuhauen \u2026? Ich schon. Aber
      wegen dir lohnt es sich zu bleiben."
    m_Metadata:
      m_Items: []
  - m_Id: 149
    m_Localized: "Ich hab Opa mit dir reden sehen \u2026 wollte er dir schon wieder
      ein Roth-IRA-Konto andrehen?"
    m_Metadata:
      m_Items: []
  - m_Id: 150
    m_Localized: "Ich hab Opa mit dir reden sehen \u2026 wollte er dir schon wieder
      einen Roth-IRA andrehen?"
    m_Metadata:
      m_Items: []
  - m_Id: 151
    m_Localized: "Ich wusste, dass du mehr bist als nur ein h\xFCbsches Gesicht.
      Du hast auch Prinzipien. Das mag ich an jemandem."
    m_Metadata:
      m_Items: []
  - m_Id: 152
    m_Localized: "Ganz sch\xF6n viele wollen dir danken, wei\xDFt du."
    m_Metadata:
      m_Items: []
  - m_Id: 153
    m_Localized: "Tja \u2026 am Ende warst du wohl doch nur ein h\xFCbsches Gesicht.
      Und ich hab wirklich an dich geglaubt \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 154
    m_Localized: "\u2026 na ja. Ich hoffe wenigstens, du hast einen sch\xF6nen Tag."
    m_Metadata:
      m_Items: []
  - m_Id: 155
    m_Localized: "Na, wie geht\u2019s uns denn heute?"
    m_Metadata:
      m_Items: []
  - m_Id: 156
    m_Localized: "Nur zur Routineuntersuchung mit deinem Kleinen hier? Hm \u2026
      das werden wir ja sehen \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 157
    m_Localized: "Ooooh \u2026 hm \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 158
    m_Localized: "Also, deinem kleinen Freund hier geht\u2019s gerade gar nicht gut!"
    m_Metadata:
      m_Items: []
  - m_Id: 159
    m_Localized: "Sieh dir das an! Ein Bein ist k\xFCrzer als die anderen. Ganz klar
      ein Zeichen von Mangelern\xE4hrung!"
    m_Metadata:
      m_Items: []
  - m_Id: 160
    m_Localized: "Nein, nein, ich sage ja nicht, dass du dich schlecht um deine Assel
      k\xFCmmerst."
    m_Metadata:
      m_Items: []
  - m_Id: 161
    m_Localized: "Sie bekommt einfach nicht genug N\xE4hrstoffe."
    m_Metadata:
      m_Items: []
  - m_Id: 162
    m_Localized: "Du wei\xDFt ja, wie diese Billigmarken heutzutage sind: alles verarbeitet
      und voller F\xFCllstoffe."
    m_Metadata:
      m_Items: []
  - m_Id: 163
    m_Localized: "Hier, ich pers\xF6nlich empfehle genau diese Marke."
    m_Metadata:
      m_Items: []
  - m_Id: 164
    m_Localized: "Ja, sie ist etwas teurer, aber ich verspreche dir: viel n\xE4hrstoffreicher
      und ganz nat\xFCrlich."
    m_Metadata:
      m_Items: []
  - m_Id: 165
    m_Localized: "Ich w\xFCrde wirklich sehr bald wechseln. Sonst besteht ein erhebliches
      Risiko, dass deine Assel krank wird."
    m_Metadata:
      m_Items: []
  - m_Id: 166
    m_Localized: "Was ich damit meine? Nun \u2026 es liegt nicht nur am Futter."
    m_Metadata:
      m_Items: []
  - m_Id: 167
    m_Localized: Deine Assel scheint an einer schweren chronischen Atemwegserkrankung
      zu leiden.
    m_Metadata:
      m_Items: []
  - m_Id: 168
    m_Localized: "Offenbar ist das genetisch bedingt. Die Kiemen deiner Assel k\xF6nnen
      Sauerstoff nicht richtig aufnehmen."
    m_Metadata:
      m_Items: []
  - m_Id: 169
    m_Localized: "Mit der Zeit f\xFChrt das zu schweren Problemen und ganz sicher
      zu einem fr\xFChen Tod."
    m_Metadata:
      m_Items: []
  - m_Id: 170
    m_Localized: "Wir m\xFCssen eine Gewebeprobe nehmen, um herauszufinden, welches
      Medikament am besten wirkt."
    m_Metadata:
      m_Items: []
  - m_Id: 171
    m_Localized: "Im schlimmsten Fall m\xFCssen wir operieren und die Kiemen deiner
      Assel durch k\xFCnstliche ersetzen."
    m_Metadata:
      m_Items: []
  - m_Id: 172
    m_Localized: "Es tut mir wirklich leid, dir so schlechte Nachrichten \xFCberbringen
      zu m\xFCssen."
    m_Metadata:
      m_Items: []
  - m_Id: 173
    m_Localized: "F\xFCr diese Woche verschreibe ich medizinische Flocken. Die Probe
      nehmen wir noch heute."
    m_Metadata:
      m_Items: []
  - m_Id: 174
    m_Localized: 'Vertrau mir bitte: Ich werde alles tun, um deine geliebte Assel
      zu retten.'
    m_Metadata:
      m_Items: []
  - m_Id: 175
    m_Localized: "Damit w\xE4ren wir heute bei ungef\xE4hr 800 Dollar."
    m_Metadata:
      m_Items: []
  - m_Id: 176
    m_Localized: "\u2026 Was ist denn mit deinem Gesicht los?"
    m_Metadata:
      m_Items: []
  - m_Id: 177
    m_Localized: "Hey! Ich hoffe, euch beiden geht\u2019s gut!"
    m_Metadata:
      m_Items: []
  - m_Id: 178
    m_Localized: "Ich untersuche zuerst deinen Kleinen, dann sprechen wir \xFCber
      die Testergebnisse."
    m_Metadata:
      m_Items: []
  - m_Id: 179
    m_Localized: "Hm \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 180
    m_Localized: "Also, zuerst die gute Nachricht: Deine Assel ist relativ stabil
      und ihr geht\u2019s deutlich besser als letzte Woche."
    m_Metadata:
      m_Items: []
  - m_Id: 181
    m_Localized: Die schlechte Nachricht sind die Testergebnisse.
    m_Metadata:
      m_Items: []
  - m_Id: 182
    m_Localized: "Von jetzt an braucht deine Assel regelm\xE4\xDFig Auffrischungsspritzen
      und Medikamente."
    m_Metadata:
      m_Items: []
  - m_Id: 183
    m_Localized: "Aber das wird nicht reichen. Die beste L\xF6sung sind k\xFCnstliche
      Kiemen."
    m_Metadata:
      m_Items: []
  - m_Id: 184
    m_Localized: "Leider ist der Schaden zu gro\xDF. Spritzen und Medikamente sind
      nur vor\xFCbergehende Ma\xDFnahmen."
    m_Metadata:
      m_Items: []
  - m_Id: 185
    m_Localized: "Die beste L\xF6sung ist eine Operation, bei der wir die Kiemen
      ersetzen."
    m_Metadata:
      m_Items: []
  - m_Id: 186
    m_Localized: "Leider \xFCbernimmt eure Firmenversicherung diese Behandlung nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 187
    m_Localized: Du musst die Kosten selbst tragen.
    m_Metadata:
      m_Items: []
  - m_Id: 188
    m_Localized: "Heute gibt\u2019s eine Auffrischungsspritze, und ich verschreibe
      neue Medikamente."
    m_Metadata:
      m_Items: []
  - m_Id: 189
    m_Localized: "Sag mir bis zum n\xE4chsten Termin Bescheid, ob du die Operation
      machen lassen willst."
    m_Metadata:
      m_Items: []
  - m_Id: 190
    m_Localized: "Die Kosten? Nun ja \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 191
    m_Localized: 'Du solltest wissen: Billig wird das nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 192
    m_Localized: "Du hast dich also f\xFCr die Operation entschieden? Sehr gut."
    m_Metadata:
      m_Items: []
  - m_Id: 193
    m_Localized: "Wir setzen sie f\xFCr n\xE4chste Woche an."
    m_Metadata:
      m_Items: []
  - m_Id: 194
    m_Localized: "Die Spritze f\xFCr heute? Ja, ja, dazu kommen wir noch."
    m_Metadata:
      m_Items: []
  - m_Id: 195
    m_Localized: "Heute musst du eine nicht erstattungsf\xE4hige Anzahlung leisten."
    m_Metadata:
      m_Items: []
  - m_Id: 196
    m_Localized: "Ja, heute. Und nicht erstattungsf\xE4hig. Wie soll ich sonst meine\u2014"
    m_Metadata:
      m_Items: []
  - m_Id: 197
    m_Localized: "\xC4hm. Wie auch immer."
    m_Metadata:
      m_Items: []
  - m_Id: 198
    m_Localized: "Das ist ganz normale Praxis. Ich verstehe nicht, warum du dich
      so aufregst \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 199
    m_Localized: "Du hast heute nicht genug f\xFCr die Anzahlung und die \xFCblichen
      Behandlungskosten? Na dann \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 200
    m_Localized: "Wenn du dich wirklich f\xFCr die Operation entschieden hast, lassen
      wir die Spritze heute aus."
    m_Metadata:
      m_Items: []
  - m_Id: 201
    m_Localized: "Ja, die Auffrischungsspritze heute auszulassen ist schon in Ordnung
      \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 202
    m_Localized: "Aber wenn wir die Medikamente absetzen, m\xFCssen wir die Operation
      n\xE4chste Woche auch wirklich durchf\xFChren."
    m_Metadata:
      m_Items: []
  - m_Id: 203
    m_Localized: "Also sieh zu, dass du bis n\xE4chste Woche genug Geld zusammenkratzt."
    m_Metadata:
      m_Items: []
  - m_Id: 204
    m_Localized: Hast du das Geld?
    m_Metadata:
      m_Items: []
  - m_Id: 205
    m_Localized: "\u2026 Wow. Trotz deines mickrigen Jobs hast du tats\xE4chlich
      genug zusammenbekommen?"
    m_Metadata:
      m_Items: []
  - m_Id: 206
    m_Localized: "\xC4h \u2026 nicht, dass ich w\xFCsste, was du beruflich machst.
      Bei der Bezahlung klang\u2019s einfach nach einem schlechten Job."
    m_Metadata:
      m_Items: []
  - m_Id: 207
    m_Localized: Gut, da du heute den vollen Betrag hast, versetzen wir deine Assel
      in Narkose.
    m_Metadata:
      m_Items: []
  - m_Id: 208
    m_Localized: Sei versichert, wir werden unser absolut Bestes geben.
    m_Metadata:
      m_Items: []
  - m_Id: 209
    m_Localized: Sie wird es schaffen.
    m_Metadata:
      m_Items: []
  - m_Id: 210
    m_Localized: Hast du das Geld?
    m_Metadata:
      m_Items: []
  - m_Id: 211
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 212
    m_Localized: Das reicht nicht.
    m_Metadata:
      m_Items: []
  - m_Id: 213
    m_Localized: "Entschuldige mal, h\xE4ltst du uns f\xFCr einen Wohlt\xE4tigkeitsverein?
      Wir m\xFCssen schlie\xDFlich auch von etwas leben."
    m_Metadata:
      m_Items: []
  - m_Id: 214
    m_Localized: "Laut unseren Richtlinien d\xFCrfen wir den Eingriff erst durchf\xFChren,
      wenn der volle Betrag bezahlt ist."
    m_Metadata:
      m_Items: []
  - m_Id: 215
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 216
    m_Localized: "Betteln bringt nichts. Daf\xFCr riskiere ich nicht meinen Job."
    m_Metadata:
      m_Items: []
  - m_Id: 217
    m_Localized: "Du willst dein Geld zur\xFCck? Ich dachte, das w\xE4re klar gewesen
      \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 218
    m_Localized: "Die nicht erstattungsf\xE4hige Anzahlung von letzter Woche war
      nicht erstattungsf\xE4hig."
    m_Metadata:
      m_Items: []
  - m_Id: 219
    m_Localized: "Das Geld von heute? Nun \u2026 das ist die Beratungsgeb\xFChr.
      \xDCberraschung: Du hattest gerade eine Beratung."
    m_Metadata:
      m_Items: []
  - m_Id: 220
    m_Localized: 'Also: nein.'
    m_Metadata:
      m_Items: []
  - m_Id: 221
    m_Localized: "Ach, wei\xDFt du was? Hier."
    m_Metadata:
      m_Items: []
  - m_Id: 222
    m_Localized: "Ein kostenloser Grabstein, geht aufs Haus. Teil unseres gratis
      Nachsorgepakets f\xFCr alle Patienten."
    m_Metadata:
      m_Items: []
  - m_Id: 223
    m_Localized: "Tsch\xFCssikowski!"
    m_Metadata:
      m_Items: []
  - m_Id: 224
    m_Localized: "tropf \u2026 tropf \u2026 tropf"
    m_Metadata:
      m_Items: []
  - m_Id: 225
    m_Localized: grrregghhhhh
    m_Metadata:
      m_Items: []
  - m_Id: 226
    m_Localized: "lass \u2026 mich \u2026 los \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 227
    m_Localized: squawacklackclackclackclack
    m_Metadata:
      m_Items: []
  - m_Id: 228
    m_Localized: '*matsch* (Soundeffekt)'
    m_Metadata:
      m_Items: []
  - m_Id: 229
    m_Localized: Mann, diese Beine sind echt klasse! Oder? ODER???
    m_Metadata:
      m_Items: []
  - m_Id: 230
    m_Localized: graaawwwwwrrrr
    m_Metadata:
      m_Items: []
  - m_Id: 231
    m_Localized: rrrrrgggghhhhh
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
