%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 25e982df099754116b3863808eae6c55, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: Hallo!
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "Ich hoffe, Sie haben einen sch\xF6nen Tag."
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "Du siehst ersch\xF6pft aus."
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: Wie geht es den Kindern?
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: Wann gehst du in Rente?
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "Sch\xF6nes Wetter haben wir!"
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "War hier k\xFCrzlich ein Fisch? Es stinkt!"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: Ich hoffe auf etwas Regen an diesem Wochenende.
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "Hast du geh\xF6rt, dass sie unsere Steuern erh\xF6hen?"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: Ich werde meinen Fernfreund sehen! Wir haben uns seit Jahren nicht
      gesehen.
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: Ich mache meinen ersten Urlaub seit einem Jahrzehnt!
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: Ich renne vor meiner Vergangenheit davon.
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: Wussten Sie, dass der Zug Geschwindigkeiten von bis zu 57 Meilen
      pro Stunde erreicht?! Es ist so schnell!
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "Beeil dich und loche mein Ticket, \xFCberpr\xFCfst du ernsthaft
      meinen Ausweis??!"
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: Hast du meinen Propellerhut gesehen? Ich muss es in einem Zug gelassen
      haben
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: Hast du meinen Zylinder gesehen? Ich muss es in einem Zug gelassen
      haben
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "Hast du meinen gr\xFCnen Hut gesehen? Ich muss es in einem Zug
      gelassen haben"
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "Wonach suchen Sie in meinem Ausweis? Gef\xE4llt dir mein Foto,
      H\xFCbscher?"
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: Das bin ich auf dem Bild, lass mich schon durch!
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "Es ist so schwer, den \xDCberblick \xFCber diese Tickets zu behalten,
      zu meiner Zeit haben wir gerade den Schaffner gek\xFCsst"
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: "Es ist so schwer, diese Tickets im Auge zu behalten, zu meiner
      Zeit haben wir einfach an der T\xFCr bezahlt"
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: "Es ist so schwer, den \xDCberblick \xFCber diese Tickets zu behalten,
      damals haben wir nur um Vergebung gebeten, nicht um Erlaubnis"
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: Ich habe ewig in der Schlange gewartet
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: Nennst du es einen Zug oder einen Trolley?
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: "Mein Nachbar sagte mir, diese Shuttles bringen dich f\xFCr immer
      weg, stimmt das?"
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: Mit diesen Forschern stimmt etwas nicht.
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: "Die Leute, die aus dem Labor zur\xFCckkommen, riechen komisch."
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "Manchmal h\xF6re ich nachts Schreie."
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: "Ich habe geh\xF6rt, dass die Crustacean Corporation an diesen armen
      Leuten experimentiert!"
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: "Sie sollten f\xFCr Fischrechte stimmen, auch wenn Sie kein Fisch
      sind."
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: "Hey, zumindest machen das alle Raubtiere freiwillig. Und sie werden
      daf\xFCr bezahlt!"
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: Glauben Sie, dass noch Forschungsstellen offen sind?
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: Crustacean Corp hat mir einen Job angeboten, aber mit diesen Jungs
      stimmt etwas nicht
    m_Metadata:
      m_Items: []
  - m_Id: 34
    m_Localized: "Ich melde mich freiwillig f\xFCr das neue Forschungsprojekt!"
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: Mein Lutscher ... wo ist er hin ... ;(
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: "Der Name meines besten Freundes ist Samuel! Wie hei\xDFt dein bester
      Freund?"
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: "Samuel sah heute lustig aus\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: "Mama sieht in ihrer wei\xDFen Jacke immer so cool aus!"
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: Mama macht das beste Essen im ganzen weiten Meer!
    m_Metadata:
      m_Items: []
  - m_Id: 40
    m_Localized: Die Schule ist so langweilig ... mister, spielst du mit mir und
      Samuel? ... Oh, ok.
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: "Welche S\xFC\xDFigkeiten mag ich? Mm, ich mag Jawbreaker und Kandiszucker,
      aber Lutscher sind mein Favorit!"
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: Mister! Ich habe heute meinen Lieblings-Erdbeer-Bananen-Lutscher
      bekommen! Willst du auch eins?
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: "Sie hatten heute keine Erdbeer-Banane im Laden ... Das ist mein
      Favorit\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: Ich mag meine Mutter, ich mag Samuel, ich mag Erdbeer-Bananen-Lutscher
      ... und ich mag dich auch!
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: Ich liebe den Regen, nicht wahr?
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: "Ich muss kein Ticket f\xFCr eine Anlage kaufen, oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: Ich kann mein Schild mit in den Zug nehmen, richtig?
    m_Metadata:
      m_Items: []
  - m_Id: 48
    m_Localized: Meine Pflanze Shelldon sieht heute etwas verwelkt aus
    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: "Ich habe heute alle meine T\xF6pfe nach drau\xDFen gestellt, um
      das Wasser aufzufangen"
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: Kann ich Auberginenparmesan mit in den Zug nehmen?
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: "Du solltest zu meinem n\xE4chsten Protest kommen!"
    m_Metadata:
      m_Items: []
  - m_Id: 52
    m_Localized: Haben Sie jemals gedacht, dass die dunklen Wolken versuchen, uns
      etwas zu sagen?
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: Die neuen Labore marginalisieren US-Fische nur noch weiter
    m_Metadata:
      m_Items: []
  - m_Id: 54
    m_Localized: "Wenn ich mich an die Vorderseite des Labors ketten w\xFCrde, glaubst
      du, sie w\xFCrden den Betrieb einstellen?"
    m_Metadata:
      m_Items: []
  - m_Id: 55
    m_Localized: "Ah, diese alte H\xFClle von mir knarrt so. Eine alte Seele auf
      den Weg schicken, junger Bursche?"
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: "Es gab eine Zeit, in der alle Wesen den Meeresboden durchstreiften.
      In der Tat vermisst man diese l\xE4ngst vergangenen Tage."
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: "Diejenigen, mit denen man einmal gereist ist, sind l\xE4ngst verschwunden,
      ihre Spuren sind von dieser Welt verschwunden."
    m_Metadata:
      m_Items: []
  - m_Id: 58
    m_Localized: "Hmph! Im Vergleich zu fr\xFCher sind die J\xE4ger dieses Zeitalters
      d\xFCrre Wesen."
    m_Metadata:
      m_Items: []
  - m_Id: 59
    m_Localized: "Verzeihen Sie die Erstarrung dieses K\xF6rpers, man ist schon lange
      an diesen Rollstuhl gebunden."
    m_Metadata:
      m_Items: []
  - m_Id: 60
    m_Localized: "Junger Bursche, mach nicht die gleichen Fehler, die man gemacht
      hat. Wenn Sie jemanden retten k\xF6nnen, stehen Sie nicht daneben und schicken
      Sie ihn in den Tod."
    m_Metadata:
      m_Items: []
  - m_Id: 61
    m_Localized: "Man h\xF6rt immer noch ihre Stimmen schreien ... man kann nicht
      sagen, ob sie aus alten Tr\xE4umen oder Leiden der Gegenwart stammen."
    m_Metadata:
      m_Items: []
  - m_Id: 62
    m_Localized: "Technologie und Transport sind heutzutage so weit fortgeschritten
      ... man kann nicht anders, als sich in diesem Zeitalter wie ein Ausl\xE4nder
      zu f\xFChlen."
    m_Metadata:
      m_Items: []
  - m_Id: 63
    m_Localized: "Junger Bursche, du solltest rausgehen und dieses Leben mit deinen
      Lieben genie\xDFen. Widme dein Leben nicht dem \xDCberleben und werde am Ende
      der letzte einsame."
    m_Metadata:
      m_Items: []
  - m_Id: 64
    m_Localized: "...Meine Freunde? ... Sie waren in den Geschichtsb\xFCchern als
      tapfere Krieger bekannt, aber man m\xF6chte sich au\xDFerhalb ihrer zugewiesenen
      Beschreibungen an sie erinnern."
    m_Metadata:
      m_Items: []
  - m_Id: 65
    m_Localized: "...z\xF6gern Sie nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 66
    m_Localized: "Ich brauche mehr Geld, um mir alle meine B\xF6gen leisten zu k\xF6nnen"
    m_Metadata:
      m_Items: []
  - m_Id: 67
    m_Localized: "Ich w\xFCnschte, es w\xE4re heute etwas k\xE4lter"
    m_Metadata:
      m_Items: []
  - m_Id: 68
    m_Localized: "Mit einer Schleife w\xFCrdest du auch niedlicher aussehen!"
    m_Metadata:
      m_Items: []
  - m_Id: 69
    m_Localized: Ich kann es kaum erwarten, mich im Zug zusammenzurollen und zu lesen
    m_Metadata:
      m_Items: []
  - m_Id: 70
    m_Localized: "Du sollst heute kein Blau tragen, wei\xDFt du"
    m_Metadata:
      m_Items: []
  - m_Id: 71
    m_Localized: Denkst du, ich rede zu leise?
    m_Metadata:
      m_Items: []
  - m_Id: 72
    m_Localized: "Ich mag es nicht, Augenkontakt herzustellen. K\xF6nntest du mich
      nicht ansehen, wenn ich dich ansehe?"
    m_Metadata:
      m_Items: []
  - m_Id: 73
    m_Localized: "Ich hoffe, dass das neue Labor eine Sekret\xE4rin gebrauchen k\xF6nnte...
      Ich bewerbe mich seit ewigkeiten."
    m_Metadata:
      m_Items: []
  - m_Id: 74
    m_Localized: Hey Kleiner! Ich habe keine Witze mehr, wenn du welche hast, lass
      Minnow!
    m_Metadata:
      m_Items: []
  - m_Id: 75
    m_Localized: Ich hoffe, Billie und Millie geht es gut in der Schule ... nee,
      sie sind Stars wie du und ich, Kleiner!
    m_Metadata:
      m_Items: []
  - m_Id: 76
    m_Localized: "Psst hey, wei\xDFt du, wo hier das beste Blumenfeld ist? Nein,
      das ist keine Pointe, ich meine es ernst!"
    m_Metadata:
      m_Items: []
  - m_Id: 77
    m_Localized: Ich bin gerade so aufgepumpt! Ich habe es geschafft, die letzten
      Basalt-Konzertkarten zu ergattern, bevor ich von der Arbeit kam!
    m_Metadata:
      m_Items: []
  - m_Id: 78
    m_Localized: "Oh, du siehst heute echt frisch aus! Hast du ein Date? Brauchen
      Sie ein paar Tipps? Keine Sorge, sie sind kostenlos! Im Gegensatz zu diesen
      Ticketpreisen\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 79
    m_Localized: "Dieser Wildblumenstrau\xDF? Ich mache jedes Mal einen f\xFCr meine
      Frau, wenn ich nach Hause komme."
    m_Metadata:
      m_Items: []
  - m_Id: 80
    m_Localized: "Hey, was haben sich die beiden Ozeane gesagt? Nichts, sie winkten
      nur! HAHA! ... oh, ich denke, das hast du zu oft geh\xF6rt, hmm\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 81
    m_Localized: "Ich m\xF6chte nur, dass meine Familie in Sicherheit ist und gl\xFCcklich
      lebt."
    m_Metadata:
      m_Items: []
  - m_Id: 82
    m_Localized: "Ich glaube, ich werde sehr bald aufh\xF6ren. Ich kann nur ... ich
      kann da drau\xDFen einen sichereren Job finden, n\xE4her bei meiner Familie."
    m_Metadata:
      m_Items: []
  - m_Id: 83
    m_Localized: "Opa sagte mir, du w\xE4rst h\xFCbsch und er hatte Recht!"
    m_Metadata:
      m_Items: []
  - m_Id: 84
    m_Localized: Irgendwelche Krebstiere, die du im Auge hast?
    m_Metadata:
      m_Items: []
  - m_Id: 85
    m_Localized: "Heute ist ein sch\xF6ner Tag, nicht wahr?"
    m_Metadata:
      m_Items: []
  - m_Id: 86
    m_Localized: Ich liebe es einfach, zu dieser Jahreszeit mit dem Zug zu fahren
    m_Metadata:
      m_Items: []
  - m_Id: 87
    m_Localized: Gestern war mein 50. Geburtstag mit Opa!
    m_Metadata:
      m_Items: []
  - m_Id: 88
    m_Localized: "Lass mich dich mit meiner Enkelin verkuppeln... Du w\xFCrdest sie
      lieben!"
    m_Metadata:
      m_Items: []
  - m_Id: 89
    m_Localized: "Ich habe einen Ehemann f\xFCr die erw\xE4hnte Enkelin gefunden
      und sie sind so gl\xFCcklich"
    m_Metadata:
      m_Items: []
  - m_Id: 90
    m_Localized: "Ich habe geh\xF6rt, du k\xF6nntest einen heimlichen Bewunderer
      haben"
    m_Metadata:
      m_Items: []
  - m_Id: 91
    m_Localized: Ich sehe, wie der Postbote dich ansieht, er ist begeistert
    m_Metadata:
      m_Items: []
  - m_Id: 92
    m_Localized: "Wenn du in Zukunft ein Date mit diesem Postboten hast, w\xFCrde
      ich etwas anderes tragen."
    m_Metadata:
      m_Items: []
  - m_Id: 93
    m_Localized: Ich hoffe, sie geben dir hier genug Pausen
    m_Metadata:
      m_Items: []
  - m_Id: 94
    m_Localized: Stellen Sie sicher, dass Sie anhalten und die Meeresbrise riechen
    m_Metadata:
      m_Items: []
  - m_Id: 95
    m_Localized: Wie oft kannst du dich von der gleichen Sache unterkriegen lassen?
    m_Metadata:
      m_Items: []
  - m_Id: 96
    m_Localized: Denken Sie daran, anderen zu sagen, dass Sie sie lieben
    m_Metadata:
      m_Items: []
  - m_Id: 97
    m_Localized: Vergiss nie, dass du immer neu anfangen kannst
    m_Metadata:
      m_Items: []
  - m_Id: 98
    m_Localized: "Sonnige Tage und Regentage sind beide Tage, an denen alles m\xF6glich
      ist"
    m_Metadata:
      m_Items: []
  - m_Id: 99
    m_Localized: "Warten Sie nicht auf neue M\xF6glichkeiten, sondern finden Sie
      sie"
    m_Metadata:
      m_Items: []
  - m_Id: 100
    m_Localized: In schlechten Zeiten warten gute Dinge immer nur hinter dem Horizont
    m_Metadata:
      m_Items: []
  - m_Id: 101
    m_Localized: "Sich um etwas anderes zu k\xFCmmern, gibt dir Grund weiterzumachen"
    m_Metadata:
      m_Items: []
  - m_Id: 102
    m_Localized: Geht es dir gut, Junge?
    m_Metadata:
      m_Items: []
  - m_Id: 103
    m_Localized: Hast du etwas auf dem Herzen?
    m_Metadata:
      m_Items: []
  - m_Id: 104
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 105
    m_Localized: "Viele Leute da drau\xDFen schulden dir ihren Lebensunterhalt, wei\xDFt
      du."
    m_Metadata:
      m_Items: []
  - m_Id: 106
    m_Localized: "Ohne dich w\xE4ren viele Leben ruiniert worden."
    m_Metadata:
      m_Items: []
  - m_Id: 107
    m_Localized: Aber das ist kalter Trost, nicht wahr?
    m_Metadata:
      m_Items: []
  - m_Id: 108
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 109
    m_Localized: Das mit deinem Haustier tut mir leid, Junge.
    m_Metadata:
      m_Items: []
  - m_Id: 110
    m_Localized: "Ich habe vor einiger Zeit bemerkt, dass du es immer weniger herausgenommen
      hast, und in letzter Zeit habe ich es \xFCberhaupt nicht gesehen."
    m_Metadata:
      m_Items: []
  - m_Id: 111
    m_Localized: Irgendetwas sagt mir, dass du es aufgeben musstest.
    m_Metadata:
      m_Items: []
  - m_Id: 112
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 113
    m_Localized: "Darf ich dir eine Geschichte erz\xE4hlen?"
    m_Metadata:
      m_Items: []
  - m_Id: 114
    m_Localized: "Damals, als ich jung war, traf ich ein M\xE4dchen. Liebte sie von
      ganzem Herzen."
    m_Metadata:
      m_Items: []
  - m_Id: 115
    m_Localized: Wir eilten durch die Dinge, heirateten und ich hatte eine Familie,
      bevor ich wirklich damit umgehen konnte.
    m_Metadata:
      m_Items: []
  - m_Id: 116
    m_Localized: "Wir hatten Schwierigkeiten, \xFCber die Runden zu kommen, auch
      wenn wir beide berufst\xE4tig waren."
    m_Metadata:
      m_Items: []
  - m_Id: 117
    m_Localized: Einer von uns brauchte eine Ausbildung, wenn wir unseren Kindern
      das Leben geben wollten, das sie verdienten.
    m_Metadata:
      m_Items: []
  - m_Id: 118
    m_Localized: "Also bin ich der Marine beigetreten. Es hat sich gut bezahlt gemacht
      und es hat daf\xFCr gesorgt, dass ich am Ende der Dinge durch das College kommen
      konnte."
    m_Metadata:
      m_Items: []
  - m_Id: 119
    m_Localized: "Ich verbrachte zwei Jahre dort, w\xE4hrend des Ammoniten-Krieges,
      nur das Laden von Schiffen. Bewaffnung mit Torpedos."
    m_Metadata:
      m_Items: []
  - m_Id: 120
    m_Localized: "Ich habe noch nie einen Fu\xDF auf ein Schiff gesetzt."
    m_Metadata:
      m_Items: []
  - m_Id: 121
    m_Localized: "Nun, der Krieg endete, ich machte einen Abschluss in Ingenieurwissenschaften
      und begann f\xFCr eine Eisenbahngesellschaft zu arbeiten."
    m_Metadata:
      m_Items: []
  - m_Id: 122
    m_Localized: Eine kleine, eine Tochtergesellschaft eines Ortes namens \"Crustacean
      Corporation.\"
    m_Metadata:
      m_Items: []
  - m_Id: 123
    m_Localized: "Sie machten einige skizzenhafte Dinge, aber ich dachte nicht viel
      dar\xFCber nach. Der Job bezahlte schlie\xDFlich daf\xFCr, dass meine eigenen
      Kinder aufs College gingen."
    m_Metadata:
      m_Items: []
  - m_Id: 124
    m_Localized: Damit konnte ich mir jedes Jahr eine Weltreise leisten.
    m_Metadata:
      m_Items: []
  - m_Id: 125
    m_Localized: Dann machte ich ein Jahr lang eine Reise nach Ammonatien.
    m_Metadata:
      m_Items: []
  - m_Id: 126
    m_Localized: "Ich stolperte \xFCber einen der Orte, die die Marine besuchte,
      und sah Fossil nach Fossil nach Fossil auf dem Boden liegen\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 127
    m_Localized: ... alles umgeben von alten Torpedogranaten.
    m_Metadata:
      m_Items: []
  - m_Id: 128
    m_Localized: Und mir wurde klar, wie du, dass ich verantwortlich war.
    m_Metadata:
      m_Items: []
  - m_Id: 129
    m_Localized: "Ich war nie Kapit\xE4n der Schiffe."
    m_Metadata:
      m_Items: []
  - m_Id: 130
    m_Localized: Ich habe die Torpedos nie abgefeuert.
    m_Metadata:
      m_Items: []
  - m_Id: 131
    m_Localized: "Aber jeder der Torpedos dort h\xE4tte von mir geladen werden k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 132
    m_Localized: "Und wenn ich nicht dort gewesen w\xE4re, h\xE4tten vielleicht noch
      ein paar Ammoniten gelebt."
    m_Metadata:
      m_Items: []
  - m_Id: 133
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 134
    m_Localized: "Ich k\xFCndigte meinen Job als Lokf\xFChrer, sobald ich zur\xFCckkam."
    m_Metadata:
      m_Items: []
  - m_Id: 135
    m_Localized: Ich fing stattdessen an, in einem Tante-Emma-Mechaniker-Laden zu
      arbeiten.
    m_Metadata:
      m_Items: []
  - m_Id: 136
    m_Localized: "Ich habe drei\xDFig Jahre lang keinen Urlaub mehr gemacht."
    m_Metadata:
      m_Items: []
  - m_Id: 137
    m_Localized: "Aber ich kann jede Nacht gut schlafen, da ich wei\xDF, dass ich
      diese Bahngesellschaft schon einmal verlassen habe\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 138
    m_Localized: ... das ist passiert.
    m_Metadata:
      m_Items: []
  - m_Id: 139
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 140
    m_Localized: "Es werden ein paar harte Wochen, Junge. Und ein paar harte Jahre
      danach, w\xE4hrend du wieder auf die Beine kommst."
    m_Metadata:
      m_Items: []
  - m_Id: 141
    m_Localized: Aber ich hoffe, du bereust keine Sekunde davon.
    m_Metadata:
      m_Items: []
  - m_Id: 142
    m_Localized: "Du solltest dir etwas Sch\xF6nes besorgen ... du verdienst es."
    m_Metadata:
      m_Items: []
  - m_Id: 143
    m_Localized: Hast du meinen Brief gelesen?
    m_Metadata:
      m_Items: []
  - m_Id: 144
    m_Localized: Glaubst du, du wirst jemals jemanden mehr lieben als deine Assel?
    m_Metadata:
      m_Items: []
  - m_Id: 145
    m_Localized: "Du hast diese Woche mehr Post bekommen als sonst, hast du einen
      Bewunderer, von dem ich nichts wei\xDF?"
    m_Metadata:
      m_Items: []
  - m_Id: 146
    m_Localized: "Du gibst Geld f\xFCr Dinge au\xDFer deiner Assel aus, richtig ...?"
    m_Metadata:
      m_Items: []
  - m_Id: 147
    m_Localized: "Wir sollten irgendwann zu Mittag essen, wenn wir beide in der Pause
      sind, ich verspreche, ich werde dich nicht langweilen\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 148
    m_Localized: Denkst du jemals daran, von hier wegzukommen..? Tue ich, aber du
      machst es lohnenswert zu bleiben.
    m_Metadata:
      m_Items: []
  - m_Id: 149
    m_Localized: "Wei\xDFt du, ich habe angefangen mich zu fragen, ob ich dich weniger
      sehe als dein Tierarzt\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 150
    m_Localized: "Ich habe gesehen, wie Opa mit dir gechattet hat ... hat er dir
      gesagt, du sollst wieder eine Roth IRA er\xF6ffnen?"
    m_Metadata:
      m_Items: []
  - m_Id: 151
    m_Localized: "Ich wusste, dass du mehr als nur ein h\xFCbsches Gesicht bist,
      du hast auch eine starke Moral. Ich mag das an einer Person."
    m_Metadata:
      m_Items: []
  - m_Id: 152
    m_Localized: "Viele Leute wollen dir danken, wei\xDFt du."
    m_Metadata:
      m_Items: []
  - m_Id: 153
    m_Localized: "Ich sch\xE4tze, du warst doch nur ein weiteres h\xFCbsches Gesicht,
      und ich habe wirklich an dich geglaubt\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 154
    m_Localized: ...ich hoffe, du hast wenigstens einen guten Tag.
    m_Metadata:
      m_Items: []
  - m_Id: 155
    m_Localized: Hey, wie geht es uns heute?
    m_Metadata:
      m_Items: []
  - m_Id: 156
    m_Localized: "Nur hier f\xFCr eine regelm\xE4\xDFige Untersuchung f\xFCr deine
      kleine hier? Mm, das werden wir sehen\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 157
    m_Localized: "Ohhhh... hmm\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 158
    m_Localized: "Naja, deinem Kumpel hier geht es gerade nicht zu hei\xDF!"
    m_Metadata:
      m_Items: []
  - m_Id: 159
    m_Localized: "Sieh ihn dir an! Eines seiner Beine ist k\xFCrzer als das andere;
      Dies ist eindeutig ein Zeichen von Unterern\xE4hrung!"
    m_Metadata:
      m_Items: []
  - m_Id: 160
    m_Localized: Nein, nein, ich sage nicht, dass du sie nicht gut erziehst.
    m_Metadata:
      m_Items: []
  - m_Id: 161
    m_Localized: "Ihre Assel bekommt einfach nicht genug N\xE4hrstoffe."
    m_Metadata:
      m_Items: []
  - m_Id: 162
    m_Localized: "Sie wissen, wie die Handelsmarken heutzutage sind, immer verarbeitet
      und voller F\xFCllstoffe."
    m_Metadata:
      m_Items: []
  - m_Id: 163
    m_Localized: "Hier empfehle ich pers\xF6nlich diese Marke genau hier."
    m_Metadata:
      m_Items: []
  - m_Id: 164
    m_Localized: "Es ist ein bisschen teurer, ja, aber ich verspreche, es ist viel
      n\xE4hrstoffreicher und nat\xFCrlicher."
    m_Metadata:
      m_Items: []
  - m_Id: 165
    m_Localized: "Ich rate Ihnen dringend, bald zu wechseln, sonst besteht f\xFCr
      Ihre Assel ein erhebliches Krankheitsrisiko."
    m_Metadata:
      m_Items: []
  - m_Id: 166
    m_Localized: "Was ich damit meine? Sehen Sie\u2026es geht nicht nur ums Essen."
    m_Metadata:
      m_Items: []
  - m_Id: 167
    m_Localized: Es scheint, als leide Ihre Assel an einer schweren chronischen Atemwegserkrankung.
    m_Metadata:
      m_Items: []
  - m_Id: 168
    m_Localized: Es scheint sich um eine genetische Ursache zu handeln; die Kiemen
      Ihrer Assel sind nicht in der Lage, Sauerstoff richtig aufzunehmen.
    m_Metadata:
      m_Items: []
  - m_Id: 169
    m_Localized: "Dies wird mit der Zeit zu schwerwiegenden Problemen f\xFChren und
      mit Sicherheit einen fr\xFChen Tod zur Folge haben."
    m_Metadata:
      m_Items: []
  - m_Id: 170
    m_Localized: "Wir m\xFCssen eine Gewebeprobe entnehmen, um zu testen, welches
      Medikament am besten geeignet ist."
    m_Metadata:
      m_Items: []
  - m_Id: 171
    m_Localized: "Im schlimmsten Fall m\xFCssen wir m\xF6glicherweise eine Operation
      durchf\xFChren, um die Kiemen Ihrer Assel durch k\xFCnstliche zu ersetzen."
    m_Metadata:
      m_Items: []
  - m_Id: 172
    m_Localized: "Es tut mir sehr leid, Ihnen diese schlechte Nachricht \xFCberbringen
      zu m\xFCssen."
    m_Metadata:
      m_Items: []
  - m_Id: 173
    m_Localized: "Ich werde Ihnen f\xFCr diese Woche medizinische Flocken verschreiben,
      und wir werden heute die Probe entnehmen."
    m_Metadata:
      m_Items: []
  - m_Id: 174
    m_Localized: "Bitte vertrauen Sie mir, dass ich mein M\xF6glichstes tun werde,
      um Ihre geliebte Assel zu retten."
    m_Metadata:
      m_Items: []
  - m_Id: 175
    m_Localized: "Ihr heutiger Gesamtbetrag bel\xE4uft sich auf etwa 800 Dollar."
    m_Metadata:
      m_Items: []
  - m_Id: 176
    m_Localized: "\u2026Was soll denn dieses Gesicht?"
    m_Metadata:
      m_Items: []
  - m_Id: 177
    m_Localized: Hallo zusammen, ich hoffe, euch beiden geht es gut!
    m_Metadata:
      m_Items: []
  - m_Id: 178
    m_Localized: "Ich werde zuerst einen Gesundheitscheck bei Ihrem Kleinen durchf\xFChren,
      und anschlie\xDFend werden wir die Testergebnisse besprechen."
    m_Metadata:
      m_Items: []
  - m_Id: 179
    m_Localized: "Hmm\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 180
    m_Localized: 'Nun, hier die gute Nachricht: Ihrer Assel geht es relativ gut und
      deutlich besser als letzte Woche.'
    m_Metadata:
      m_Items: []
  - m_Id: 181
    m_Localized: Die schlechte Nachricht sind die Testergebnisse.
    m_Metadata:
      m_Items: []
  - m_Id: 182
    m_Localized: "Von nun an ben\xF6tigt Ihre Assel regelm\xE4\xDFige Auffrischungsimpfungen
      und Medikamente."
    m_Metadata:
      m_Items: []
  - m_Id: 183
    m_Localized: "Das wird jedoch nicht ausreichen. Die beste L\xF6sung sind k\xFCnstliche
      Kiemen."
    m_Metadata:
      m_Items: []
  - m_Id: 184
    m_Localized: "Leider ist das Ausma\xDF der Sch\xE4digung zu gro\xDF. Spritzen
      und Medikamente sind nur vor\xFCbergehende Ma\xDFnahmen."
    m_Metadata:
      m_Items: []
  - m_Id: 185
    m_Localized: "Die beste L\xF6sung ist eine Operation, bei der die Kiemen ersetzt
      werden."
    m_Metadata:
      m_Items: []
  - m_Id: 186
    m_Localized: Leider ist dies nicht durch Ihre Firmenversicherung abgedeckt.
    m_Metadata:
      m_Items: []
  - m_Id: 187
    m_Localized: "Sie m\xFCssen die Kosten selbst tragen."
    m_Metadata:
      m_Items: []
  - m_Id: 188
    m_Localized: Wir machen heute eine Auffrischungsimpfung, und ich werde Ihnen
      neue Medikamente verschreiben.
    m_Metadata:
      m_Items: []
  - m_Id: 189
    m_Localized: "Bitte teilen Sie mir bis zu Ihrem n\xE4chsten Termin mit, ob Sie
      die Operation durchf\xFChren lassen m\xF6chten."
    m_Metadata:
      m_Items: []
  - m_Id: 190
    m_Localized: "Die Kosten? Nun ja\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 191
    m_Localized: Du solltest wissen, dass es nicht billig wird.
    m_Metadata:
      m_Items: []
  - m_Id: 192
    m_Localized: "Sie haben sich also entschieden, die Operation durchf\xFChren zu
      lassen? Das ist gut."
    m_Metadata:
      m_Items: []
  - m_Id: 193
    m_Localized: "Wir werden es f\xFCr n\xE4chste Woche einplanen."
    m_Metadata:
      m_Items: []
  - m_Id: 194
    m_Localized: "Der Schuss f\xFCr heute? Ja ja, dazu kommen wir noch."
    m_Metadata:
      m_Items: []
  - m_Id: 195
    m_Localized: "Sie m\xFCssen heute eine nicht r\xFCckerstattbare Anzahlung leisten."
    m_Metadata:
      m_Items: []
  - m_Id: 196
    m_Localized: "Ja, heute. Und nicht erstattungsf\xE4hig. Wie soll ich sonst meine..."
    m_Metadata:
      m_Items: []
  - m_Id: 197
    m_Localized: "\xC4hm. Na ja."
    m_Metadata:
      m_Items: []
  - m_Id: 198
    m_Localized: "Das ist g\xE4ngige Praxis; ich verstehe nicht, warum Sie so aufgebracht
      sind..."
    m_Metadata:
      m_Items: []
  - m_Id: 199
    m_Localized: "Sie haben heute nicht genug f\xFCr die Anzahlung und die \xFCblichen
      Behandlungskosten? Nun gut\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 200
    m_Localized: "Wenn Sie sich f\xFCr die Operation entschieden haben, verzichten
      wir heute auf die Spritze."
    m_Metadata:
      m_Items: []
  - m_Id: 201
    m_Localized: "Ja, die Auffrischungsimpfung heute auszulassen, ist in Ordnung\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 202
    m_Localized: "Aber wenn Sie Ihre Assel von den Medikamenten absetzen, m\xFCssen
      wir die Operation n\xE4chste Woche durchf\xFChren."
    m_Metadata:
      m_Items: []
  - m_Id: 203
    m_Localized: "Du solltest also besser bis n\xE4chste Woche genug Geld zusammenkratzen."
    m_Metadata:
      m_Items: []
  - m_Id: 204
    m_Localized: Hast du das Geld?
    m_Metadata:
      m_Items: []
  - m_Id: 205
    m_Localized: "Wow. Selbst mit deinem mickrigen Job hast du tats\xE4chlich genug
      verdient?"
    m_Metadata:
      m_Items: []
  - m_Id: 206
    m_Localized: "\xC4hm\u2026 nicht, dass ich w\xFCsste, was du beruflich machst.
      Die Bezahlung lie\xDF nur vermuten, dass sie schlecht war."
    m_Metadata:
      m_Items: []
  - m_Id: 207
    m_Localized: Da Sie heute den vollen Betrag haben, legen wir Ihre Assel unter.
    m_Metadata:
      m_Items: []
  - m_Id: 208
    m_Localized: Seien Sie versichert, dass wir unser Bestes geben werden.
    m_Metadata:
      m_Items: []
  - m_Id: 209
    m_Localized: Sie werden es schaffen.
    m_Metadata:
      m_Items: []
  - m_Id: 210
    m_Localized: Hast du das Geld?
    m_Metadata:
      m_Items: []
  - m_Id: 211
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 212
    m_Localized: Das reicht nicht aus.
    m_Metadata:
      m_Items: []
  - m_Id: 213
    m_Localized: "Entschuldigung, glauben Sie etwa, wir seien eine gemeinn\xFCtzige
      Organisation? Wir m\xFCssen schlie\xDFlich auch unsere Familien ern\xE4hren."
    m_Metadata:
      m_Items: []
  - m_Id: 214
    m_Localized: "Gem\xE4\xDF unseren Richtlinien k\xF6nnen wir den Eingriff erst
      durchf\xFChren, wenn Sie den Betrag vollst\xE4ndig bezahlt haben."
    m_Metadata:
      m_Items: []
  - m_Id: 215
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 216
    m_Localized: Betteln bringt nichts. Ich riskiere deswegen nicht meinen Job.
    m_Metadata:
      m_Items: []
  - m_Id: 217
    m_Localized: "Kann ich mein Geld zur\xFCckbekommen? Ich dachte, das w\xE4re eindeutig\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 218
    m_Localized: "Die letzte Woche geleistete, nicht erstattungsf\xE4hige Anzahlung
      war nicht erstattungsf\xE4hig."
    m_Metadata:
      m_Items: []
  - m_Id: 219
    m_Localized: "Das heutige? Nun ja\u2026 das ist die Beratungsgeb\xFChr. Und wissen
      Sie was? Sie hatten gerade eine Beratung."
    m_Metadata:
      m_Items: []
  - m_Id: 220
    m_Localized: Also nein.
    m_Metadata:
      m_Items: []
  - m_Id: 221
    m_Localized: "Ach, wei\xDFt du was? Hier."
    m_Metadata:
      m_Items: []
  - m_Id: 222
    m_Localized: "Ein kostenloser Grabstein, gratis dazu, als Teil unseres kostenlosen
      Nachsorgepakets f\xFCr alle unsere Patienten."
    m_Metadata:
      m_Items: []
  - m_Id: 223
    m_Localized: "Tsch\xFCss!"
    m_Metadata:
      m_Items: []
  - m_Id: 224
    m_Localized: "Tropf\u2026Tropf\u2026Tropf"
    m_Metadata:
      m_Items: []
  - m_Id: 225
    m_Localized: grrregghhhhh
    m_Metadata:
      m_Items: []
  - m_Id: 226
    m_Localized: "Lass mich gehen\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 227
    m_Localized: squawacklackklackklackklack
    m_Metadata:
      m_Items: []
  - m_Id: 228
    m_Localized: "*quetsch* (Ger\xE4uscheffekt)"
    m_Metadata:
      m_Items: []
  - m_Id: 229
    m_Localized: Mann, sind die Beine toll! Oder? ODER???
    m_Metadata:
      m_Items: []
  - m_Id: 230
    m_Localized: grrrrr
    m_Metadata:
      m_Items: []
  - m_Id: 231
    m_Localized: rrrrrgggghhhhh
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
