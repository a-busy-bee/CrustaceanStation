  - m_Id: 17
    m_Localized: "\u6700\u8FD1\uFF0C\u8BB8\u591A\u4EBA\u53EF\u80FD\u90FD\u542C\u8BF4\u4E86\u4E00\u4E9B\u5173\u4E8E\u957F\u7740\u5F02\u5E38\u80A2\u4F53\u7684\u751F\u7269\u6307\u63A7\u516C\u53F8\u8FDB\u884C\u975E\u6CD5\u5B9E\u9A8C\u7684\u65B0\u95FB\u3002\u8FD9\u4E9B\u8BF4\u6CD5\u5E76\u4E0D\u5C5E\u5B9E\uFF1B\u8FD9\u662F\u5FC3\u6000\u4E0D\u6EE1\u7684\u5458\u5DE5\u634F\u9020\u7684\u865A\u5047\u6307\u63A7\uFF0C\u4ED6\u4EEC\u56E0\u672A\u80FD\u8FBE\u5230\u516C\u53F8\u8FD1\u671F\u9879\u76EE\u7684\u9884\u671F\u800C\u88AB\u89E3\u96C7\u3002\u6211\u4EEC\u5C06\u5BF9\u8FD9\u4E9B\u865A\u5047\u6307\u63A7\u4EE5\u53CA\u8BD5\u56FE\u62B9\u6740\u6211\u4EEC\u6570\u5341\u5E74\u5FC3\u8840\u7684\u4EBA\u91C7\u53D6\u6CD5\u5F8B\u884C\u52A8\u3002\n\n"
