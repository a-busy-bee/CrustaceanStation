  - m_Id: 2
    m_Localized: "\u6B22\u8FCE\u60A8\u52A0\u5165 Crustacean Station\uFF0C\u6210\u4E3A\u4E00\u540D\u521D\u7EA7\u81EA\u52A9\u670D\u52A1\u4EAD\u64CD\u4F5C\u5458\uFF01\u60A8\u7684\u5C97\u4F4D\u5BF9\u672C\u7AD9\u7684\u8FD0\u8425\u4EE5\u53CA\u6BCF\u4F4D\u987E\u5BA2\u7684\u6EE1\u610F\u5EA6\u90FD\u81F3\u5173\u91CD\u8981\u3002\u6211\u4EEC\u671F\u5F85\u60A8\u7684\u52A0\u5165\u3002\\nCrustacean
      Corporation \u518D\u6B21\u63D0\u9192\u60A8\uFF0C\u5B89\u5168\u548C\u987E\u5BA2\u6EE1\u610F\u5EA6\u81F3\u5173\u91CD\u8981\u3002\u56E0\u6B64\uFF0C\u8BF7\u52A1\u5FC5\u9075\u5B88\u76F8\u5173\u89C4\u7AE0\u5236\u5EA6\u548C\u6307\u4EE4\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "\u795D\u60A8\u597D\u8FD0\uFF0C\\n\u7532\u58F3\u7C7B\u52A8\u7269\u516C\u53F8"
