  - m_Id: 58
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442,"
    m_Metadata:
      m_Items: []
  - m_Id: 59
    m_Localized: "\u0412\u044B \u0442\u043E\u0436\u0435 \u044D\u0442\u043E \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438,
      \u043F\u0440\u0430\u0432\u0434\u0430? \u0412\u0441\u0435 \u044D\u0442\u0438
      \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u044B\u2026\\n\\n\u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u0434\u0435\u043B\u044C
      \u044F \u0432\u0438\u0434\u0435\u043B \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432 \u0432 \u0431\u0438\u043D\u0442\u0430\u0445.
      \u042F \u0434\u0443\u043C\u0430\u043B, \u043E\u043D\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u0435\u0440\u0435\u0431\u0438\u043D\u0442\u043E\u0432\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0438\u0437-\u0437\u0430 \u043F\u0430\u0441\u043C\u0443\u0440\u043D\u043E\u0439
      \u043F\u043E\u0433\u043E\u0434\u044B, \u043D\u043E \u0442\u0435\u043F\u0435\u0440\u044C\u2026
      \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0443\u0436\u0430\u0441\u043D\u043E.
      \u041A\u0430\u043A \u044D\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E?
      \u041F\u0440\u0430\u0432\u043E\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u043E\u0440\u0433\u0430\u043D\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u044D\u0442\u043E
      \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C, \u0432\u0435\u0440\u043D\u043E?"
    m_Metadata:
      m_Items: []
