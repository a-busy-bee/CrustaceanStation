  - m_Id: 55
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442, \u043A\u0440\u0430\u0441\u043E\u0442\u043A\u0430
      ;)"
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: "\u0412 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u043C \u0440\u0430\u0439\u043E\u043D\u0435
      \u0420\u0438\u0444\u0442\u0442\u0430\u0443\u043D \u043E\u0442\u043A\u0440\u044B\u043B\u0430\u0441\u044C
      \u043D\u043E\u0432\u0430\u044F \u0441\u043E\u043B\u044F\u043D\u0430\u044F \u0444\u0430\u0431\u0440\u0438\u043A\u0430.
      \u0425\u043E\u0447\u0435\u0448\u044C \u0437\u0430\u0433\u043B\u044F\u043D\u0443\u0442\u044C?
      \u0421\u043B\u044B\u0448\u0430\u043B, \u0438\u0445 \u043D\u043E\u0432\u044B\u0435
      \u043C\u043E\u0440\u0441\u043A\u0438\u0435 \u043E\u0433\u0443\u0440\u0446\u044B
      \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u043E\u0441\u0445\u0438\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u044B.
      \u0418 \u0447\u0435\u0441\u0442\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u044F,
      \u0435\u0441\u043B\u0438 \u0431\u044B \u043C\u043D\u0435 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0443\u043C\u0435\u0440\u0435\u0442\u044C, \u044F \u0431\u044B \u0445\u043E\u0442\u0435\u043B
      \u0443\u043C\u0435\u0440\u0435\u0442\u044C \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u0442\u043E\u0431\u043E\u0439\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: "\u0421 \u043B\u044E\u0431\u043E\u0432\u044C\u044E, \u0412\u0430\u0448
      \u043F\u043E\u0447\u0442\u0430\u043B\u044C\u043E\u043D"
