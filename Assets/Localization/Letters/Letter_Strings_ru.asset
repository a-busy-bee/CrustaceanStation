  m_SharedData: {fileID: 11400000, guid: dc9bf26741112408bafe847b9a4c6919, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: "\u0414\u043B\u044F \u043F\u0440\u0435\u0434\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u044F
      \u043F\u043E \u043C\u0435\u0441\u0442\u0443 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F,"
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
      \u043D\u0430 \u0432\u0430\u0448\u0443 \u043D\u043E\u0432\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443
      \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0430
      \u043A\u0438\u043E\u0441\u043A\u0430 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0443\u0440\u043E\u0432\u043D\u044F \u043D\u0430 \u0441\u0442\u0430\u043D\u0446\u0438\u0438
      \xAB\u0420\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0435\xBB!
      \u0412\u0430\u0448\u0430 \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C
      \u0438\u043C\u0435\u0435\u0442 \u0440\u0435\u0448\u0430\u044E\u0449\u0435\u0435
      \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B
      \u044D\u0442\u043E\u0439 \u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u0438
      \u0443\u0434\u043E\u0432\u043B\u0435\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u0438
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u043E\u0433\u043E.
      \u041C\u044B \u0441 \u043D\u0435\u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435\u043C
      \u0436\u0434\u0435\u043C \u0432\u0430\u0448\u0435\u0433\u043E \u0441\u043A\u043E\u0440\u043E\u0433\u043E
      \u043D\u0430\u0447\u0430\u043B\u0430 \u0440\u0430\u0431\u043E\u0442\u044B.\\n\u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F
      \xAB\u0420\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0435\xBB
      \u0435\u0449\u0435 \u0440\u0430\u0437 \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
      \u0432\u0430\u043C, \u0447\u0442\u043E \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u0438 \u0443\u0434\u043E\u0432\u043B\u0435\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432 \u0438\u043C\u0435\u044E\u0442
      \u043F\u0435\u0440\u0432\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E\u0435
      \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435. \u041F\u043E\u044D\u0442\u043E\u043C\u0443,
      \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0441\u043E\u0431\u043B\u044E\u0434\u0430\u0439\u0442\u0435
      \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435
      \u043F\u0440\u0430\u0432\u0438\u043B\u0430 \u0438 \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "\u0416\u0435\u043B\u0430\u0435\u043C \u0432\u0430\u043C \u0443\u0434\u0430\u0447\u0438,
      \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F \xAB\u0420\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0435\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "\u041E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0443,"
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "\u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F Crustacean Corporation
      \u0440\u0430\u0434\u0430 \u043E\u0431\u044A\u044F\u0432\u0438\u0442\u044C \u043E
      \u0437\u0430\u043F\u0443\u0441\u043A\u0435 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
      \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0430 \u0434\u043B\u044F
      \u0433\u043E\u0441\u0442\u0435\u0439 \u0438 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432
      Crustacean Corporation! \u041F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u044B
      \u0448\u0430\u0442\u0442\u043B\u0430 \u0434\u043E\u043B\u0436\u043D\u044B \u043F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u0442\u044C
      \u0441\u0432\u043E\u0438 \u044D\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432\u043D\u044B\u0435
      \u0431\u0438\u043B\u0435\u0442\u044B \u0432 \u043A\u0438\u043E\u0441\u043A\u0435.
      \u041D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C\u0442\u0435 \u0443\u043A\u0430\u0437\u0430\u0442\u044C
      \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u0430\u043C \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0435
      \u043C\u0435\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "\u0421 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C,
      \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F \u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "\u0412\u0441\u0435\u043C \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C,"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "\u041C\u043D\u043E\u0433\u0438\u0435 \u0438\u0437 \u0432\u0430\u0441,
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043D\u0435\u0434\u0430\u0432\u043D\u043E
      \u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u043E \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u043C
      \u0438\u043D\u0446\u0438\u0434\u0435\u043D\u0442\u0435, \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u0435\u0434\u0448\u0435\u043C
      \u0441 \u0440\u0435\u0431\u0435\u043D\u043A\u043E\u043C \u043E\u0434\u043D\u043E\u0433\u043E
      \u0438\u0437 \u043D\u0430\u0448\u0438\u0445 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432.
      \u0412 \u0441\u0432\u0435\u0442\u0435 \u0443\u0447\u0430\u0441\u0442\u0438\u0432\u0448\u0438\u0445\u0441\u044F
      \u0441\u043B\u0443\u0447\u0430\u0435\u0432 \u043F\u043E\u0434\u043E\u0431\u043D\u043E\u0433\u043E
      \u0442\u0440\u0435\u0432\u043E\u0436\u043D\u043E\u0433\u043E \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F
      \u0441\u043E\u0432\u0435\u0442 \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440\u043E\u0432
      \u043F\u0440\u0438\u043D\u044F\u043B \u0440\u0435\u0448\u0435\u043D\u0438\u0435
      \u043F\u0435\u0440\u0435\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430\u0448\u0443
      \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u0443 \u0438 \u0446\u0435\u043B\u0438
      \u0434\u043B\u044F \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u044F \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438. \u0412\u0441\u0435\u043C
      \u043D\u0443\u0436\u043D\u043E \u0435\u0441\u0442\u044C, \u043D\u043E \u044D\u0442\u043E
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043F\u043E\u0435\u0434\u0430\u043D\u0438\u0435 \u0442\u0435\u0445,
      \u043A\u0442\u043E \u0435\u0449\u0435 \u043D\u0435 \u0440\u043E\u0434\u0438\u043B\u0441\u044F.
      \u0422\u0435\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C, \u0431\u0443\u0434\u044C\u0442\u0435
      \u0431\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u044B \u043F\u043E \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044E
      \u043A \u043E\u043F\u0430\u0441\u043D\u044B\u043C \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430\u043C
      \u0438 \u0437\u0430\u0449\u0438\u0449\u0430\u0439\u0442\u0435 \u0441\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "\u0421 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C,
      \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F \u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "\u041E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0443,"
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F, \u0435\u0441\u043B\u0438
      \u0432\u044B \u0443\u0432\u0438\u0434\u0438\u0442\u0435 \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u043E\u0432,
      \u0432\u0435\u0434\u0443\u0449\u0438\u0445 \u0441\u0435\u0431\u044F \u043A\u0430\u043A
      \u0445\u0438\u0449\u043D\u0438\u043A\u0438, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
      \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u0438\u0445
      \u043D\u0430 \u0448\u0430\u0442\u0442\u043B\u0435 \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u043E\u0431\u044B\u0447\u043D\u044B\u043C\u0438 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C\u0438,
      \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E \u043E\u0442 \u0442\u0438\u043F\u0430
      \u0438\u0445 \u0431\u0438\u043B\u0435\u0442\u0430. \u041F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u044B
      \u043F\u043E\u043B\u0443\u0447\u0430\u0442 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0443\u044E
      \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u044E \u0437\u0430
      \u043F\u0440\u0438\u0447\u0438\u043D\u0435\u043D\u043D\u044B\u0435 \u043D\u0435\u0443\u0434\u043E\u0431\u0441\u0442\u0432\u0430,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0435 \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u0442\u0435\u0441\u044C
      \u043E \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u044B\u0445 \u043E\u0442\u0437\u044B\u0432\u0430\u0445.
      \u041C\u044B \u043E\u0431 \u044D\u0442\u043E\u043C \u043F\u043E\u0437\u0430\u0431\u043E\u0442\u0438\u043C\u0441\u044F.\\n\u041D\u0435
      \u0440\u0430\u0437\u043E\u0447\u0430\u0440\u0443\u0439\u0442\u0435 \u043D\u0430\u0441,
      \u041E\u043F\u0435\u0440\u0430\u0442\u043E\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043C \u0432\u0430\u0441
      \u0437\u0430 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E,
      \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F \xAB\u0420\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0435\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "\u0414\u0430\u043D\u043D\u043E\u0435 \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u0435
      \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E \u0434\u043B\u044F
      \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430:"
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "\u041E\u0431\u0440\u0430\u0442\u0438\u0442\u0435 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u043D\u0430 \u043D\u043E\u0432\u043E\u0435 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435
      \u0432 \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0445: \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u044B,
      \u043D\u0435 \u044F\u0432\u043B\u044F\u044E\u0449\u0438\u0435\u0441\u044F \u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u043C\u0438,
      \u0442\u0430\u043A\u0436\u0435 \u0434\u043E\u043B\u0436\u043D\u044B \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u0438\u0442\u044C\u0441\u044F
      \u0432 \u0430\u0432\u0442\u043E\u0431\u0443\u0441\u0435 \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C\u0438,
      \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E \u043E\u0442 \u0442\u0438\u043F\u0430
      \u0438\u0445 \u0431\u0438\u043B\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043C \u0432\u0430\u0441
      \u0437\u0430 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E,
      \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F \xAB\u0420\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0435\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "\u0412\u0441\u0435\u043C \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C,"
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "\u041C\u043D\u043E\u0433\u0438\u0435 \u0438\u0437 \u0432\u0430\u0441,
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043D\u0435\u0434\u0430\u0432\u043D\u043E
      \u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u043D\u043E\u0432\u043E\u0441\u0442\u0438
      \u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430\u0445 \u0441 \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u043C\u0438
      \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u044F\u043C\u0438, \u043E\u0431\u0432\u0438\u043D\u044F\u044E\u0449\u0438\u0445
      \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044E \u0432 \u043D\u0435\u0437\u0430\u043A\u043E\u043D\u043D\u044B\u0445
      \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u0445.
      \u042D\u0442\u0438 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u044F
      \u043D\u0435 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0442
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438;
      \u044D\u0442\u043E \u043B\u043E\u0436\u043D\u044B\u0435 \u043E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u044F,
      \u0432\u044B\u0434\u0432\u0438\u043D\u0443\u0442\u044B\u0435 \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u043C\u0438
      \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043D\u0435 \u043E\u043F\u0440\u0430\u0432\u0434\u0430\u043B\u0438 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0439
      \u0432 \u043D\u0430\u0448\u0438\u0445 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445
      \u043F\u0440\u043E\u0435\u043A\u0442\u0430\u0445 \u0438 \u200B\u200B\u0432\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438
      \u0431\u044B\u043B\u0438 \u0443\u0432\u043E\u043B\u0435\u043D\u044B. \u041C\u044B
      \u0431\u0443\u0434\u0435\u043C \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u044C
      \u043C\u0435\u0440\u044B \u043F\u0440\u043E\u0442\u0438\u0432 \u044D\u0442\u0438\u0445
      \u043B\u043E\u0436\u043D\u044B\u0445 \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u0439
      \u0438 \u0442\u0435\u0445, \u043A\u0442\u043E \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
      \u043E\u043F\u043E\u0440\u043E\u0447\u0438\u0442\u044C \u043D\u0430\u0448\u0443
      \u043C\u043D\u043E\u0433\u043E\u043B\u0435\u0442\u043D\u044E\u044E \u0440\u0430\u0431\u043E\u0442\u0443.\n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "\u0421 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C,
      \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F \u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "\u041E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0443,"
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u0435\u043C!
      \u0417\u0430 \u043E\u0442\u043B\u0438\u0447\u043D\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443
      \u0432\u044B \u0438\u043C\u0435\u0435\u0442\u0435 \u043F\u0440\u0430\u0432\u043E
      \u043D\u0430 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435 \u043F\u0440\u0435\u043C\u0438\u0438
      \u0437\u0430 \u044D\u0442\u043E\u0442 \u043C\u0435\u0441\u044F\u0446. \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F
      \xAB\u041A\u0440\u0435\u0441\u0442\u043E\u043D\u043E\u0441\u0446\u044B\xBB
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442 \u0432\u0430\u0441
      \u0437\u0430 \u043F\u0440\u0435\u0434\u0430\u043D\u043D\u043E\u0441\u0442\u044C
      \u0438 \u043B\u043E\u044F\u043B\u044C\u043D\u043E\u0441\u0442\u044C. \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439\u0442\u0435 \u0432 \u0442\u043E\u043C
      \u0436\u0435 \u0434\u0443\u0445\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: "\u0421 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C,
      \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F \u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: "\u0412\u0441\u0435\u043C \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C,"
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u0433\u043E
      \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F \u043A\u043B\u0438\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0445
      \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0439 \u043C\u044B \u0441
      \u0433\u043E\u0440\u0434\u043E\u0441\u0442\u044C\u044E \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u043C
      \u043D\u0430\u0448 \u043D\u043E\u0432\u044B\u0439 \u0440\u0435\u0430\u0431\u0438\u043B\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0439
      \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442. \u042D\u0442\u043E \u0431\u044B\u043B
      \u043D\u0430\u0448 \u0441\u0430\u043C\u044B\u0439 \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u043D\u044B\u0439
      \u043F\u0440\u043E\u0435\u043A\u0442 \u0441 \u043C\u043E\u043C\u0435\u043D\u0442\u0430
      \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438,
      \u0438 \u0435\u0433\u043E \u0440\u0435\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F
      \u0431\u044B\u043B\u0430 \u0431\u044B \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u0430
      \u0431\u0435\u0437 \u0436\u0435\u0440\u0442\u0432 \u0438 \u0443\u043F\u043E\u0440\u043D\u043E\u0433\u043E
      \u0442\u0440\u0443\u0434\u0430 \u0432\u0441\u0435\u0445 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u0432.
      \u042D\u0442\u043E\u0442 \u043D\u043E\u0432\u044B\u0439 \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442
      \u043E\u0431\u0435\u0449\u0430\u0435\u0442 \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C
      \u0432\u0441\u0435 \u0430\u0441\u043F\u0435\u043A\u0442\u044B \u0431\u043B\u0430\u0433\u043E\u043F\u043E\u043B\u0443\u0447\u0438\u044F
      \u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445 \u0438
      \u043F\u043E\u0434\u0430\u0432\u0438\u0442\u044C \u043B\u044E\u0431\u044B\u0435
      \u043D\u0435\u0436\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \xAB\u043D\u0438\u0437\u043C\u0435\u043D\u043D\u044B\u0435\xBB \u0438\u043D\u0441\u0442\u0438\u043D\u043A\u0442\u044B.
      \u0412 \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u0441\u043E\u043E\u0431\u0449\u0430\u0435\u043C,
      \u0447\u0442\u043E \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0438
      \u0431\u0443\u0434\u0443\u0442 \u043E\u0431\u044F\u0437\u0430\u043D\u044B \u043F\u0440\u043E\u0439\u0442\u0438
      \u043B\u0435\u0447\u0435\u043D\u0438\u0435 \u0434\u043E \u043A\u043E\u043D\u0446\u0430
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u043C\u0435\u0441\u044F\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "\u041F\u0443\u0441\u0442\u044C \u044D\u043F\u043E\u0445\u0430 \u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445
      \u0431\u0443\u0434\u0435\u0442 \u0441\u043B\u0430\u0432\u043D\u043E\u0439!
      \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F \xAB\u0420\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0435\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: "\u041E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0443,"
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: "\u041C\u044B \u0432\u044B\u0441\u043E\u043A\u043E \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u043C
      \u0432\u0430\u0448\u0438 \u0443\u0441\u043F\u0435\u0445\u0438 \u0432 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0438
      \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043C\u0435\u0441\u044F\u0446\u0430
      \u0440\u0430\u0431\u043E\u0442\u044B. \u041E\u0434\u043D\u0430\u043A\u043E
      \u043C\u044B \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0440\u0430\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F \u043C\u0435\u0436\u0434\u0443
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E\u043C \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0445
      \u0432\u0430\u043C\u0438 \u0433\u043E\u0441\u0442\u0435\u0439 \u0438 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E\u043C
      \u0444\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043F\u0440\u0438\u043D\u044F\u0442\u044B\u0445
      \u043D\u0430\u043C\u0438 \u0433\u043E\u0441\u0442\u0435\u0439 \u0432 \u0440\u0430\u0437\u043D\u044B\u0435
      \u0434\u043D\u0438. \u0412 \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u043C
      \u043C\u044B \u0432\u043A\u043B\u044E\u0447\u0438\u043C \u0432\u0430\u0441
      \u0432 \u043F\u043B\u0430\u043D \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u044F
      \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438
      \u0440\u0430\u0431\u043E\u0442\u044B, \u0447\u0442\u043E\u0431\u044B \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0442\u044C
      \u043D\u0435\u0443\u043A\u043E\u0441\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
      \u0441\u043E\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435 \u0432\u0430\u043C\u0438
      \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0445
      \u043F\u0440\u0430\u0432\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: "\u0421 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C,
      \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F \u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "\u041E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0443,"
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: "\u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F Crustacean Station
      \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0441\u044F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0442\u044C
      \u0432\u044B\u0441\u043E\u043A\u043E\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E
      \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F \u0441\u0432\u043E\u0438\u0445
      \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u043E\u0432. \u041E\u0434\u043D\u0430\u043A\u043E
      \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F
      \u043C\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E
      \u0436\u0430\u043B\u043E\u0431 \u043D\u0430 \u0432\u0430\u0448\u0435 \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435
      \u0438 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F.
      \u0427\u0442\u043E\u0431\u044B \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0430\u043C, \u043E\u0436\u0438\u0434\u0430\u0435\u043C\u044B\u043C
      \u043E\u0442 \u0432\u0430\u0441 \u043D\u0430 \u044D\u0442\u043E\u0439 \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u0438,
      \u043C\u044B \u043F\u0440\u043E\u0441\u0438\u043C \u0432\u0430\u0441 \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C
      \u0441\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u0443, \u0443\u0434\u0435\u043B\u044F\u044F
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F
      \u043F\u043E\u0442\u0440\u0435\u0431\u043D\u043E\u0441\u0442\u044F\u043C \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u043E\u0432.
      \u041D\u0435\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
      \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C \u0441\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u0443
      \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438
      \u043A \u0432\u0430\u0448\u0435\u043C\u0443 \u0443\u0432\u043E\u043B\u044C\u043D\u0435\u043D\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043C \u0432\u0430\u0441
      \u0437\u0430 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E,
      \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F \xAB\u0420\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0435\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: "\u041E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0443,"
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: "\u041A\u0430\u043A \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A
      \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 Crustacean Corporation, \u0432\u044B
      \u043E\u0431\u044F\u0437\u0430\u043D\u044B \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u044F\u043C \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438.
      \u041D\u0435\u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u043F\u0440\u0438\u043A\u0430\u0437\u043E\u0432
      \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438
      \u043A \u0443\u0432\u043E\u043B\u044C\u043D\u0435\u043D\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043C \u0432\u0430\u0441
      \u0437\u0430 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E,
      \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F \xAB\u0420\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0435\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 34
    m_Localized: "\u041E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0443,"
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: "\u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F Crustacean
      \u0445\u043E\u0442\u0435\u043B\u0430 \u0431\u044B \u0432\u044B\u0440\u0430\u0437\u0438\u0442\u044C
      \u0432\u0430\u043C \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u0437\u0430 \u0432\u0430\u0448\u0438 \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0435
      \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B \u0440\u0430\u0431\u043E\u0442\u044B
      \u0438 \u043F\u0440\u0438\u0437\u0432\u0430\u0442\u044C \u0432\u0430\u0441
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C \u0432 \u0442\u043E\u043C
      \u0436\u0435 \u0434\u0443\u0445\u0435. \u041D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u043C,
      \u0447\u0442\u043E \u0432 \u043A\u043E\u043D\u0446\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u043C\u0435\u0441\u044F\u0446\u0430 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0438
      \u0441 \u043E\u0431\u0440\u0430\u0437\u0446\u043E\u0432\u043E\u0439 \u043E\u0446\u0435\u043D\u043A\u043E\u0439
      \u0440\u0430\u0431\u043E\u0442\u044B \u0438\u043C\u0435\u044E\u0442 \u043F\u0440\u0430\u0432\u043E
      \u043D\u0430 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435 \u043F\u0440\u0435\u043C\u0438\u0438
      \u043A \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u043D\u043E\u0439 \u043F\u043B\u0430\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: "\u0421 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C,
      \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F \u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: "\u041E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0443,"
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: "\u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F Crustacean Station
      \u0445\u043E\u0442\u0435\u043B\u0430 \u0431\u044B \u043D\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C
      \u0432\u0430\u043C \u043E \u0432\u0430\u0436\u043D\u043E\u0441\u0442\u0438
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
      \u0432\u0441\u0435\u0445 \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u043E\u0432.
      \u041C\u044B \u044F\u0432\u043B\u044F\u0435\u043C\u0441\u044F \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u043D\u043E\u0439
      \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439, \u0430 \u043D\u0435
      \u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D\u043E\u043C. \u041C\u044B
      \u0432\u044B\u0440\u0430\u0436\u0430\u0435\u043C \u0441\u043E\u0431\u043E\u043B\u0435\u0437\u043D\u043E\u0432\u0430\u043D\u0438\u044F
      \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u0432\u0448\u0435\u0439 \u0441\u0435\u043C\u044C\u0435.
      \u0425\u043E\u0442\u044F \u043F\u043E\u0434\u043E\u0431\u043D\u043E\u0435 \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435
      \u043F\u0440\u0430\u0432\u043E\u043D\u0430\u0440\u0443\u0448\u0438\u0442\u0435\u043B\u044F
      \u0432 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0432\u0440\u0435\u043C\u044F
      \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \xAB\u0437\u0430\u043A\u043E\u043D\u043D\u044B\u043C\xBB,
      \u043C\u044B \u043F\u0440\u043E\u0441\u0438\u043C \u0432\u0430\u0441 \u0441\u0432\u0435\u0441\u0442\u0438
      \u043A \u043C\u0438\u043D\u0438\u043C\u0443\u043C\u0443 \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0435
      \u0438\u043D\u0446\u0438\u0434\u0435\u043D\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: "\u0421 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C,
      \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F \u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 40
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0447\u0443\u0432\u0430\u043A!"
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: "\u0414\u0430\u0439 \u043C\u043D\u0435 \u0431\u0438\u043B\u0435\u0442
      \u043D\u0430 \u043F\u043E\u0435\u0437\u0434, \u043B\u0430\u0434\u043D\u043E?
      \u042F \u0442\u0430\u043A \u0445\u043E\u0447\u0443 \u043D\u0430 \u043E\u0434\u0438\u043D
      \u0438\u0437 \u043A\u043E\u043D\u0446\u0435\u0440\u0442\u043E\u0432 (\u0433\u0440\u0443\u043F\u043F\u044B),
      \u043D\u043E \u0443 \u043C\u0435\u043D\u044F \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u0434\u0435\u043D\u044C\u0433\u0438.\\n\u041F\u043E\u043C\u043E\u0433\u0438
      \u043C\u043D\u0435, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430
      ;)"
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: "\u0422\u0432\u043E\u0439 \u043B\u0443\u0447\u0448\u0438\u0439 \u0434\u0440\u0443\u0433,
      \u0414\u044D\u0439\u0432\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u043E\u0439 \u0431\u0440\u0430\u0442,"
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: "\u041C\u044B \u0443\u0441\u0442\u0440\u043E\u0438\u043B\u0438 \u043C\u0430\u043C\u0443
      \u0432 \u043D\u043E\u0432\u043E\u043C \u0434\u043E\u043C\u0435 \u043F\u0440\u0435\u0441\u0442\u0430\u0440\u0435\u043B\u044B\u0445.
      \u0421\u0435\u0439\u0447\u0430\u0441 \u0435\u0435 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0441\u0442\u0430\u0431\u0438\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043B\u043E\u0441\u044C,
      \u0442\u0430\u043A \u0447\u0442\u043E \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u043E
      \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C
      \u043F\u043B\u0430\u0442\u0438\u0442\u044C, \u0438 \u043C\u044B \u0441\u043C\u043E\u0436\u0435\u043C
      \u043E \u043D\u0435\u0439 \u043F\u043E\u0437\u0430\u0431\u043E\u0442\u0438\u0442\u044C\u0441\u044F.\\n\\n\u042F
      \u0437\u043D\u0430\u044E, \u0432\u044B \u043D\u0435 \u043E\u0447\u0435\u043D\u044C
      \u0445\u043E\u0442\u0438\u0442\u0435 \u0432\u043C\u0435\u0448\u0438\u0432\u0430\u0442\u044C\u0441\u044F,
      \u043D\u043E \u044D\u0442\u043E \u0441\u0430\u043C\u043E\u0435 \u043C\u0435\u043D\u044C\u0448\u0435\u0435,
      \u0447\u0442\u043E \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u0434\u043B\u044F \u0441\u0432\u043E\u0435\u0439 \u0441\u0435\u043C\u044C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: "\u0422\u0432\u043E\u044F (\u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F)
      \u0441\u0435\u0441\u0442\u0440\u0430, \u041A\u0435\u043B\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435,
      \u0433\u043E\u0441\u043F\u043E\u0434\u0438\u043D \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A
      \u0441\u0442\u0430\u043D\u0446\u0438\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E
      \u043F\u043E\u0437\u0430\u0431\u043E\u0442\u0438\u043B\u0438\u0441\u044C \u043E
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u043C\u043E\u0435\u0433\u043E
      \u0441\u044B\u043D\u0430. \u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E
      \u043E\u043D \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0432\u0430\u043C
      \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0441\u0442\u0438, \u0438
      \u0438\u0441\u043A\u0440\u0435\u043D\u043D\u0435 \u0438\u0437\u0432\u0438\u043D\u044F\u044E\u0441\u044C.
      \u0418\u0437-\u0437\u0430 \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043D\u043D\u043E\u0441\u0442\u0438
      \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438 \u0438 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044F
      \u0435\u0433\u043E \u043E\u0442\u0446\u0430 \u044F \u043D\u0435 \u043C\u043E\u0433\u0443
      \u0441\u0430\u043C\u0430 \u043E\u0442\u0432\u0435\u0437\u0442\u0438 \u0435\u0433\u043E
      \u0432 \u0448\u043A\u043E\u043B\u0443. \u042F \u0441\u043A\u0430\u0437\u0430\u043B\u0430
      \u0435\u043C\u0443, \u0447\u0442\u043E\u0431\u044B \u043E\u043D \u043E\u0431\u0440\u0430\u0449\u0430\u043B\u0441\u044F
      \u043A \u0432\u0430\u043C, \u0435\u0441\u043B\u0438 \u0443 \u043D\u0435\u0433\u043E
      \u0432\u043E\u0437\u043D\u0438\u043A\u043D\u0443\u0442 \u0432\u043E\u043F\u0440\u043E\u0441\u044B,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u044F \u0443\u043C\u043E\u043B\u044F\u044E
      \u0432\u0430\u0441, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
      \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0437\u0430
      \u043D\u0438\u043C \u0432 \u043C\u043E\u0435 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 48
    m_Localized: "\u041B\u044E\u0431\u044F\u0449\u0430\u044F (\u043D\u043E \u0443\u0441\u0442\u0430\u0432\u0448\u0430\u044F)
      \u043C\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442, \u043A\u0440\u0430\u0441\u043E\u0442\u043A\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: "\u041C\u044B \u0443\u0436\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0440\u0430\u0437 \u0432\u0438\u0434\u0435\u043B\u0438\u0441\u044C, \u043D\u043E
      \u0443 \u043C\u0435\u043D\u044F \u0435\u0449\u0451 \u043D\u0435 \u0431\u044B\u043B\u043E
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C\u0441\u044F.
      \u042F \u0440\u0430\u0431\u043E\u0442\u0430\u044E \u043F\u043E\u0447\u0442\u0430\u043B\u044C\u043E\u043D\u043E\u043C
      \u0438 \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E \u0432\u0430\u0448\u0438
      \u043E\u0442\u0437\u044B\u0432\u044B \u0438 \u043F\u0438\u0441\u044C\u043C\u0430!
      \u042D\u0442\u043E \u0442\u044F\u0436\u0451\u043B\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430,
      \u043D\u043E \u0432\u0438\u0434\u0435\u0442\u044C \u0432\u0430\u0448\u0443
      \u0443\u043B\u044B\u0431\u043A\u0443 \u0442\u043E\u0433\u043E \u0441\u0442\u043E\u0438\u0442
      :)\\n\\n\u0416\u0438\u0437\u043D\u044C \u0431\u044B\u0432\u0430\u0435\u0442
      \u0441\u043B\u043E\u0436\u043D\u043E\u0439, \u043F\u0440\u0430\u0432\u0434\u0430?
      \u0422\u0430\u043A \u0447\u0442\u043E, \u0447\u0442\u043E \u0431\u044B \u043D\u0438
      \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C, \u0437\u043D\u0430\u0439\u0442\u0435,
      \u0447\u0442\u043E \u044F \u0432\u0430\u0448 \u0441\u043E\u044E\u0437\u043D\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: "\u0421 \u043B\u044E\u0431\u043E\u0432\u044C\u044E, \u041F\u043E\u0447\u0442\u0430\u043B\u044C\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 52
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442, \u043A\u0440\u0430\u0441\u043E\u0442\u043A\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: "\u041C\u043D\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u043E\u0432\u0435\u0437\u043B\u043E
      \u0441 \u043E\u0442\u043B\u0438\u0432\u043E\u043C, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u044F \u0441\u043C\u043E\u0433\u043B\u0430 \u043D\u0430\u0432\u0435\u0441\u0442\u0438\u0442\u044C
      \u0441\u0432\u043E\u044E \u0441\u0435\u043C\u044C\u044E!\\n\\n\u041E\u043D\u0438
      \u043F\u043E\u0434\u0430\u0440\u0438\u043B\u0438 \u043C\u043D\u0435 \u043C\u043D\u043E\u0433\u043E
      \u0440\u0430\u043A\u0443\u0448\u0435\u043A. \u0423 \u043C\u0435\u043D\u044F
      \u0438\u0445 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E,
      \u0438 \u043C\u044B \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E\u0433\u043E
      \u0440\u0430\u0437\u043C\u0435\u0440\u0430, \u0442\u0430\u043A \u0447\u0442\u043E
      \u044F \u043F\u043E\u0434\u0443\u043C\u0430\u043B\u0430, \u043C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C, \u043E\u043D\u0438 \u0432\u0430\u043C \u043F\u043E\u043D\u0440\u0430\u0432\u044F\u0442\u0441\u044F?
      \u041E, \u043A\u0441\u0442\u0430\u0442\u0438, \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C
      \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u044F \u0443\u0436\u0435
      \u043E\u0442\u043D\u0435\u0441\u043B\u0430 \u0438\u0445 \u0432\u0430\u043C
      \u0434\u043E\u043C\u043E\u0439!"
    m_Metadata:
      m_Items: []
