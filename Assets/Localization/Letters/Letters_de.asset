%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Letters_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 490755d025cf9474bbd6d42c4b4b1516, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: Wen es angeht:,
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "Willkommen zu Ihrem neuen Job als Kioskbetreiber auf Einstiegsniveau
      bei Crustacean Station! Ihre Position ist entscheidend f\xFCr den Betrieb dieser
      Station und die Zufriedenheit jedes Krebstiers. Wir freuen uns, Sie bald an
      Bord zu haben.\\ nCrustacean Corporation erinnert Sie noch einmal daran, dass
      Sicherheit und Zufriedenheit an erster Stelle stehen. Bitte stellen Sie daher
      sicher, dass Sie die einschl\xE4gigen Vorschriften und Anordnungen befolgen."
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "Wir w\xFCnschen Ihnen viel Gl\xFCck,\\ nCrustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: An den Betreiber,
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "Die Crustacean Corporation freut sich, eine zus\xE4tzliche Pendler-Shuttle-Route
      f\xFCr die G\xE4ste und Mitarbeiter der Crustacean Corporation bekannt zu geben!
      Shuttle-Passagiere legen ihre exklusiven Shuttle-Tickets am Kiosk vor. Stellen
      Sie sicher, dass Sie diesen Passagieren die richtigen Sitzpl\xE4tze zuweisen."
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "Mit freundlichen Gr\xFC\xDFen,Crustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: An alle Mitarbeiter,
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "Viele von Ihnen haben vielleicht k\xFCrzlich von dem tragischen
      Vorfall geh\xF6rt, der dem Kind eines unserer Mitarbeiter widerfahren ist.
      Angesichts der zunehmenden F\xE4lle solchen st\xF6renden Verhaltens hat der
      Vorstand beschlossen, unsere Richtlinien und Ziele zu \xFCberarbeiten, um die
      \xF6ffentliche Sicherheit zu st\xE4rken. Jeder muss essen, aber das kann nicht
      so weit gehen, dass diejenigen verschlungen werden, die noch nicht einmal gelebt
      haben.\\ nIn der Zwischenzeit, wachsam bleiben gegen gef\xE4hrliche Kreaturen
      und sch\xFCtzen Sie sich."
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "Mit freundlichen Gr\xFC\xDFen,Crustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: An den Betreiber,
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "Wenn Sie heute Passagiere vom Typ Raubtier sehen, schicken Sie
      sie bitte zusammen mit den \xFCblichen Mitarbeitern in den Shuttle, unabh\xE4ngig
      von ihrem Ticket. Passagiere werden entsprechend f\xFCr ihre Probleme entsch\xE4digt,
      machen Sie sich also keine Sorgen \xFCber negative Bewertungen. Darum k\xFCmmern
      wir uns.\\nentt\xE4uschen Sie uns nicht, Operator."
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "Vielen Dank f\xFCr Ihre Mitarbeit,\\ nCrustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "Diese Bekanntmachung ist f\xFCr die \xD6ffentlichkeit nicht zug\xE4nglich:"
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "Bitte beachten Sie die neue Richtlinienrevision: Passagiere, die
      keine Krebstiere sind, m\xFCssen unabh\xE4ngig von ihrem Ticket auch zusammen
      mit Mitarbeitern mit dem Shuttle bef\xF6rdert werden."
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "Vielen Dank f\xFCr Ihre Mitarbeit,\\ nCrustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: An alle Mitarbeiter,
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "Viele von Ihnen haben vielleicht k\xFCrzlich Nachrichten \xFCber
      Kreaturen mit abnormalen Gliedma\xDFen geh\xF6rt, die das Unternehmen illegaler
      Experimente beschuldigen. Diese Behauptungen sind nicht wahr; Es sind falsche
      Anschuldigungen von ver\xE4rgerten Mitarbeitern, die die Erwartungen an unsere
      j\xFCngsten Projekte nicht erf\xFCllt haben und anschlie\xDFend freigelassen
      wurden. Wir werden gegen diese falschen Behauptungen und gegen diejenigen vorgehen,
      die versuchen, unsere jahrzehntelange Arbeit zu Fall zu bringen.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "Mit freundlichen Gr\xFC\xDFen,Crustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: An den Betreiber,
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "Herzlichen Gl\xFCckwunsch! F\xFCr Ihre hervorragende Leistung haben
      Sie Anspruch auf den Gehaltsbonus f\xFCr diesen Monat. Die Crustacean Corporation
      dankt Ihnen f\xFCr Ihr Engagement und Ihre Loyalit\xE4t. Bitte machen Sie weiter
      so."
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: "Mit freundlichen Gr\xFC\xDFen,Crustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: An alle Mitarbeiter,
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: "Nach bestandener klinischer Pr\xFCfung sind wir stolz darauf, endlich
      unsere neue Rehabilitationsmedizin vorzustellen. Dies war unser gr\xF6\xDFtes
      Unterfangen seit unserer Gr\xFCndung, und es h\xE4tte ohne die Opfer und die
      harte Arbeit aller Beteiligten nicht erreicht werden k\xF6nnen. Diese neue
      Medizin verspricht, alle Aspekte des Wohlbefindens von Krebstieren zu verbessern
      und unerw\xFCnschte \"Grundbed\xFCrfnisse\" zu unterdr\xFCcken.Nach einer abschlie\xDFenden
      Ank\xFCndigung werden die Mitarbeiter beauftragt, sich bis Ende n\xE4chsten
      Monats der Behandlung zu unterziehen."
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "M\xF6ge die Krustentier-\xC4ra herrlich sein, \\ nCrustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: An den Betreiber,
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: "Wir empfehlen Ihnen, Ihren ersten Monat im Job zu beenden. Wir
      haben jedoch an zahlreichen Tagen viele Unstimmigkeiten bei der Anzahl der
      von Ihnen gesendeten G\xE4ste und der Anzahl der tats\xE4chlich empfangenen
      G\xE4ste festgestellt. In Zukunft werden wir Sie in einen Leistungsverbesserungsplan
      aufnehmen, um sicherzustellen, dass Sie bei Ihrer Arbeit die Unternehmensrichtlinien
      konsequent befolgen."
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: Beste,\nCrustacean Corporation
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: An den Betreiber,
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: "Crustacean Station ist bestrebt, unseren Passagieren ein qualitativ
      hochwertiges Erlebnis zu bieten. In letzter Zeit haben wir jedoch zahlreiche
      Beschwerden \xFCber Ihr Verhalten und Ihren Service erhalten. Um die von Ihnen
      f\xFCr diese Position erwarteten Standards zu erf\xFCllen, bitten wir Sie,
      sich zu verbessern, indem Sie den Bed\xFCrfnissen der Passagiere mehr Aufmerksamkeit
      schenken. Wenn Sie die Leistung nicht verbessern, kann dies zu Ihrer K\xFCndigung
      f\xFChren."
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: "Vielen Dank f\xFCr Ihre Mitarbeit,\\ nCrustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: An den Betreiber,
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: "Als Mitarbeiter der Crustacean Corporation sind Sie verpflichtet,
      die Anweisungen des Unternehmens zu befolgen. Die Nichtbeachtung von Anordnungen
      kann zur Beendigung Ihres Arbeitsverh\xE4ltnisses f\xFChren."
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: "Vielen Dank f\xFCr Ihre Mitarbeit,\\ nCrustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 34
    m_Localized: An den Betreiber,
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: "Die Crustacean Corporation m\xF6chte Sie f\xFCr Ihre bisherige
      hervorragende Leistung loben und Sie ermutigen, die gute Arbeit fortzusetzen.Zur
      Erinnerung: Am Ende eines jeden Monats haben Mitarbeiter mit vorbildlichen
      Leistungsbewertungen Anspruch auf einen Gehaltsbonus."
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: "Mit freundlichen Gr\xFC\xDFen,Crustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: An den Betreiber,
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: "Crustacean Station m\xF6chte Sie daran erinnern, wie wichtig es
      ist, die Sicherheit aller Passagiere zu gew\xE4hrleisten. Wir sind ein Transportservice,
      kein Restaurant.\\ nWir haben der betroffenen Familie unser Beileid ausgesprochen.
      Obwohl ein solches Verhalten des T\xE4ters in der heutigen Zeit als \"legal\"
      angesehen wird, bitten wir Sie, Vorf\xE4lle so weit wie m\xF6glich zu minimieren."
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: "Mit freundlichen Gr\xFC\xDFen,Crustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 40
    m_Localized: Hey Mann!
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: Besorg mir ein Zugticket, ja? Ich wollte unbedingt zu einem der
      Konzerte von Basalt gehen, aber mir geht das Geld aus.\ nhelfe einem Bruder
      raus;)
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: Deine beste Knospe, nDavey
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: Liebster Bruder,
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: "Wir haben Mama im neuen Pflegeheim untergebracht. Sie ist jetzt
      etwas stabiler, also m\xFCssen Sie nur noch die Zahlungen leisten, und wir
      k\xF6nnen uns um sie k\xFCmmern.\\ n \\ Ich wei\xDF, dass du dich nicht wirklich
      zu sehr einmischen willst, aber das ist das Mindeste, was du f\xFCr deine Familie
      tun kannst."
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: Deine (einzige) Schwester Kellie
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: Hallo Herr Stationsleiter,
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: "Danke, dass du meinen Sohn besch\xFCtzt hast. Ich wei\xDF, dass
      er dir \xC4rger bereitet hat, und ich entschuldige mich aufrichtig. Da das
      Labor so besch\xE4ftigt ist und sein Vater nicht im Bild ist, kann ich ihn
      nicht selbst zur Schule bringen. Ich habe ihm gesagt, er soll mit dir reden,
      wenn er Fragen hat, also bitte ich dich, ihn in meiner Abwesenheit im Auge
      zu behalten."
    m_Metadata:
      m_Items: []
  - m_Id: 48
    m_Localized: "Eine liebevolle (aber m\xFCde) Mutter"
    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: "Hey S\xFC\xDFe,"
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: "Wir haben uns jetzt ein paar Mal gesehen, aber ich hatte noch keine
      Gelegenheit, mich vorzustellen. Ich bin der Posthalter, und ich bin derjenige,
      der Ihre Station Feedback und Briefe liefert! Es ist harte Arbeit, aber dein
      L\xE4cheln zu sehen, macht es alles wert :) \\ n \\ ndas Leben kann hart sein,
      ja? Also egal was passiert, wisse einfach, dass du einen Verb\xFCndeten in
      mir hast."
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: Mit Liebe,\ nMailkeeper
    m_Metadata:
      m_Items: []
  - m_Id: 52
    m_Localized: "Hey S\xFC\xDFe,"
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: "Ich hatte heute Gl\xFCck mit einer Ebbe, also durfte ich meine
      Familie besuchen!\\ n \\ nSie haben mir viele Muscheln geschenkt. Ich habe
      zu viele, und wir sind ungef\xE4hr gleich gro\xDF, also dachte ich, vielleicht
      w\xFCrden Sie sie m\xF6gen? Oh, du kannst \xFCbrigens nicht ablehnen, ich habe
      sie schon bei dir zu Hause abgesetzt!"
    m_Metadata:
      m_Items: []
  - m_Id: 54
    m_Localized: Mit Liebe,\ nMailkeeper
    m_Metadata:
      m_Items: []
  - m_Id: 55
    m_Localized: "Hey hei\xDFes Zeug ;)"
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: "In der nahe gelegenen Reeftown wurde eine neue Salzlake er\xF6ffnet.
      Willst du es dir ansehen? Ich habe geh\xF6rt, dass ihre neuen Seegurken ein
      Traum sind. Und ehrlich gesagt, wenn ich sterben m\xFCsste, w\xFCrde ich wollen,
      dass es bei dir ist\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: Mit Liebe,\ nd dein Postbote
    m_Metadata:
      m_Items: []
  - m_Id: 58
    m_Localized: Hey,
    m_Metadata:
      m_Items: []
  - m_Id: 59
    m_Localized: "Du hast es auch bemerkt, oder? All diese Passagiere...\\n\\nin
      den letzten Wochen habe ich viele Kreaturen gesehen, die Verb\xE4nde trugen.
      Ich dachte, sie w\xFCrden nur wegen des tr\xFCben Wetters einpacken, aber now...it
      ist einfach nur schrecklich. Wie ist das passiert? Das Vollstreckungskorps
      muss das untersuchen, richtig?"
    m_Metadata:
      m_Items: []
  - m_Id: 60
    m_Localized: Bitte bleiben Sie in Sicherheit, Ihr Mailkeeper
    m_Metadata:
      m_Items: []
  - m_Id: 166707401318400
    m_Localized: Wen es angeht,
    m_Metadata:
      m_Items: []
  - m_Id: 166707405512704
    m_Localized: "Herzlich willkommen zu Ihrem neuen Job als Kioskbediener/in bei
      Crustacean Station! Ihre Position ist entscheidend f\xFCr den reibungslosen
      Betrieb der Station und das Wohlbefinden unserer Kunden. Wir freuen uns darauf,
      Sie bald bei uns begr\xFC\xDFen zu d\xFCrfen.\\nCrustacean Corporation m\xF6chte
      Sie nochmals daran erinnern, dass Sicherheit und Kundenzufriedenheit f\xFCr
      uns oberste Priorit\xE4t haben. Bitte beachten Sie daher unbedingt alle geltenden
      Vorschriften und Anweisungen."
    m_Metadata:
      m_Items: []
  - m_Id: 166707405512705
    m_Localized: "Wir w\xFCnschen Ihnen viel Erfolg, Crustacean Corporation"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
