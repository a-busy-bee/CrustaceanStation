  m_TableData:
  - m_Id: 1
    m_Localized: "\u30D0\u30A4\u30AA\u30C6\u30AF\u30CE\u30ED\u30B8\u30FC\u4F01\u696D\u306B\u3068\u3063\u3066\u3001\u305D\u3082\u305D\u3082\u99C5\u306F\u4E00\u4F53\u4F55\u306B\u5FC5\u8981\u306A\u306E\u304B\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "\u901F\u5831\uFF1A\u30D5\u30A3\u30C3\u30B7\u30E5\u30DE\u30F3\u4E0A\u9662\u8B70\u54E1\u304C\u30A4\u30F3\u30B5\u30A4\u30C0\u30FC\u53D6\u5F15\u306E\u7591\u3044\u3067\u544A\u767A\u3055\u308C\u308B\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "\u82E5\u3055\u3068\u5065\u5EB7\u3092\u4FDD\u3064\u79D8\u8A23\u3068\u306F\uFF1F\u30AF\u30E9\u30B9\u30C6\u30A3\u30FB\u30AB\u30EC\u30D6\u304C\u3059\u3079\u3066\u3092\u660E\u304B\u3059\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "\u7532\u6BBB\u985E\u4F01\u696D\u306E\u7814\u7A76\u6240\u306E\u5916\u3067\u5B50\u4F9B\u306E\u907A\u4F53\u304C\u767A\u898B\u3055\u308C\u308B\u3002\u6355\u98DF\u52D5\u7269\u306B\u98DF\u3079\u3089\u308C\u305F\u3068\u307F\u3089\u308C\u308B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "\u610F\u898B\uFF1A\u7532\u6BBB\u985E\u4F01\u696D\u306F\u963B\u6B62\u3055\u308C\u308B\u3079\u304D\u3060"
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "\u8AD6\u8AAC\uFF1A\u7532\u6BBB\u985E\u4F01\u696D\u3053\u305D\u3001\u6B8B\u3055\u308C\u305F\u6700\u5F8C\u306E\u502B\u7406\u7684\u306A\u4F01\u696D\u304B\u3082\u3057\u308C\u306A\u3044"
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "\u4ECA\u6708\u3001\u884C\u65B9\u4E0D\u660E\u306B\u306A\u3063\u305F\u52D5\u7269\u306E\u4EF6\u6570\u304C\u904E\u53BB\u6700\u591A\u3092\u8A18\u9332\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "\u7532\u6BBB\u985E\u306F\u3059\u3079\u3066\u306E\u6D77\u6D0B\u751F\u7269\u306E\u6700\u7D42\u5F62\u614B\u3067\u3042\u308B"
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "\u4F53\u306B\u722A\u3092\u30C6\u30FC\u30D7\u3067\u8CBC\u308A\u4ED8\u3051\u308B\u306E\u304C\u3001\u4ECA\u4E00\u756A\u30DB\u30C3\u30C8\u306A\u30C8\u30EC\u30F3\u30C9\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "\u5185\u90E8\u544A\u767A\u8005\u304C\u7532\u6BBB\u985E\u4F01\u696D\u306E\u65B0\u305F\u306A\u9769\u65B0\u7684\u306A\u7814\u7A76\u306B\u3064\u3044\u3066\u5831\u544A"
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "\u722A\u304C\u751F\u3048\u308B\u306E\u306F\u3054\u304F\u81EA\u7136\u306A\u73FE\u8C61\u3067\u3059"
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "\u30AA\u30EC\u30F3\u30B8\u8272\u306F\u53F2\u4E0A\u6700\u9AD8\u306E\u8272\u5909\u7570\u3068\u3057\u3066\u8A55\u4FA1\u3055\u308C\u3066\u3044\u308B"
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "\u307F\u3093\u306A\u8D70\u308C\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "\u53E4\u3044\u5916\u9AA8\u683C\u3092\u8131\u304E\u6368\u3066\u3001\u764C\u5316\u3092\u53D7\u3051\u5165\u308C\u3088\u3046\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "\u7532\u6BBB\u985E\u304A\u3088\u3073\u7532\u6BBB\u985E\u69D8\u7532\u6BBB\u985E\u306E\u65B0\u4E16\u754C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "\u30AB\u30CB\u306E\u7F8E\u5473\u3057\u3055\u306F\u6BCE\u65E5\u7D76\u8CDB\u3055\u308C\u308B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "\u9032\u5316\u306B\u306F\u7406\u7531\u304C\u3042\u308B\u3093\u3060\u3088\u3001\u307F\u3093\u306A\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "\u5185\u90E8\u544A\u767A\u8005\u304C\u5B9F\u969B\u306B\u7532\u6BBB\u985E\u4F01\u696D\u306E\u885D\u6483\u7684\u306A\u5B9F\u9A13\u3092\u5831\u544A\u3057\u305F"
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "\u7532\u6BBB\u985E\u4F01\u696D\u306E\u6B6A\u3093\u3060\u7406\u5FF5\u3092\u5FB9\u5E95\u691C\u8A3C\u3059\u308B"
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "\u53CD\u30AF\u30E9\u30B9\u30C8\u904B\u52D5\u3092\u652F\u63F4\u3059\u308B\u305F\u3081\u306B\u3067\u304D\u308B10\u306E\u3053\u3068"
    m_Metadata:
      m_Items: []
