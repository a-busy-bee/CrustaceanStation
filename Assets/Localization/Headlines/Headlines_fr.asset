MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Headlines_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: cb6b811ec48994e63ac1d53100b2badf, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: Pourquoi une entreprise de biotechnologie aurait-elle besoin d'une
      gare ?
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "Derni\xE8re minute : le s\xE9nateur Fishman accus\xE9 de d\xE9lit
      d'initi\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "Quel est le secret pour rester si jeune et en bonne sant\xE9 ?
      Krusty Kaleb r\xE9v\xE8le tout\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "Un enfant retrouv\xE9 mort devant un laboratoire de Crustacean
      Corporation, apparemment d\xE9vor\xE9 par un pr\xE9dateur"
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "Opinion : il faut arr\xEAter Crustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "Opinion : Crustacean Corporation serait-elle la derni\xE8re entreprise
      \xE9thique ?"
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "Un nombre record de disparitions de cr\xE9atures ce mois-ci\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "Les crustac\xE9s seraient la forme ultime de toute vie marine"
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: 'Nouvelle tendance : se scotcher des pinces sur le corps ?'
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "Un lanceur d'alerte r\xE9v\xE8le les nouvelles recherches r\xE9volutionnaires
      de Crustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: Faire pousser des pinces est parfaitement normal
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "L'orange \xE9lu meilleure mutation de couleur de tous les temps"
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: Courez tous.
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: Abandonnez vos anciens exosquelettes et embrassez la carcinisation.
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "Le nouveau monde des crustac\xE9s et des crustac\xE9s qui ressemblent
      \xE0 des crustac\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: Le bonheur des raves de crabes, tous les jours.
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "L'\xE9volution n'est pas arriv\xE9e pour rien !"
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "Le lanceur d'alerte avait bien d\xE9nonc\xE9 les exp\xE9riences
      choquantes de Crustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "Plong\xE9e au c\u0153ur des id\xE9aux corrompus de Crustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "Dix fa\xE7ons de soutenir le mouvement anti-Crusty"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
