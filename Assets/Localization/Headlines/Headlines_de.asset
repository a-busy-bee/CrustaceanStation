  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Headlines_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: cb6b811ec48994e63ac1d53100b2badf, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: "Wozu braucht ein Biotechnologieunternehmen \xFCberhaupt einen Bahnhof?"
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: 'Eilmeldung: Senator Fishman des Insiderhandels beschuldigt!'
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "Was ist das Geheimnis ewiger Jugend und Gesundheit? Krusty Kaleb
      packt aus \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "Kind tot vor Labor der Crustacean Corporation gefunden \u2013 offenbar
      von einem Raubtier gefressen"
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: 'Kommentar: Die Crustacean Corporation muss gestoppt werden'
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: 'Kommentar: Die Crustacean Corporation ist vielleicht das letzte
      Unternehmen mit Moral'
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "Rekordzahl vermisster Wesen in diesem Monat \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "Krebstiere sind die endg\xFCltige Form allen Meereslebens"
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "Der neueste Trend: Scheren an den K\xF6rper kleben?"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "Whistleblower berichtet \xFCber revolution\xE4re neue Forschung
      der Crustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "Dass einem Scheren wachsen, ist v\xF6llig normal"
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "Orange zur besten Farbmutation aller Zeiten gek\xFCrt"
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: Alle weg hier.
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "Werft eure alten Exoskelette ab und hei\xDFt die Karzinisierung
      willkommen."
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "Die neue Welt der Krebstiere und krebstier\xE4hnlichen Krebstiere."
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "Die Freude t\xE4glicher Krabben-Raves."
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: Evolution hat einen Grund, Leute!
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "Whistleblower enth\xFCllte tats\xE4chlich die schockierenden Experimente
      der Crustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: Ein tiefer Blick in die verdorbenen Ideale der Crustacean Corporation
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "Die zehn besten Dinge, mit denen ihr die Anti-Crusty-Bewegung unterst\xFCtzen
      k\xF6nnt"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
