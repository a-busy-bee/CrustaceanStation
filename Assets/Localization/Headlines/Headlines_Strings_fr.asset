MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Headlines_Strings_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: feb04c4b14d9d4b9cbd860b3b50e0ee8, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: De quoi une entreprise de biotechnologie a-t-elle besoin avec une
      gare ?
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "Derni\xE8res nouvelles : Le s\xE9nateur Fishman accus\xE9 de d\xE9lit
      d'initi\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "Quel est le secret pour rester si jeune et en si bonne sant\xE9
      ? Krusty Kaleb vous d\xE9voile tout\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "Un enfant retrouv\xE9 mort devant le laboratoire d'une soci\xE9t\xE9
      sp\xE9cialis\xE9e dans les crustac\xE9s ; il semblerait qu'il ait \xE9t\xE9
      d\xE9vor\xE9 par un pr\xE9dateur."
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "Opinion : Il faut mettre un terme aux activit\xE9s de Crustacean
      Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "Opinion : Crustacean Corporation est peut-\xEAtre la derni\xE8re
      entreprise \xE9thique."
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "Ce mois-ci, le nombre de disparitions d'animaux sauvages a atteint
      un niveau record\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "Les crustac\xE9s sont la forme finale de toute la vie marine"
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "Est-ce la nouvelle tendance du moment\_: se coller des griffes
      sur le corps\_?"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "Un lanceur d'alerte r\xE9v\xE8le les nouvelles recherches r\xE9volutionnaires
      de Crustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "La pousse des griffes est un ph\xE9nom\xE8ne tout \xE0 fait normal."
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "L'orange est consid\xE9r\xE9e comme la meilleure mutation de couleur
      de tous les temps."
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: Tout le monde court !
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "D\xE9barrassez-vous de vos vieux exosquelettes et embrassez la
      carcinisation."
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "Le nouveau monde des crustac\xE9s et des crustac\xE9s apparent\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: Le plaisir du crabe fait sensation chaque jour.
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "L'\xE9volution n'a pas eu lieu par hasard !"
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "Un lanceur d'alerte a bel et bien r\xE9v\xE9l\xE9 les exp\xE9riences
      choquantes de la Crustacean Corporation."
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "Une analyse approfondie des id\xE9aux corrompus de Crustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "Dix choses que vous pouvez faire pour soutenir le mouvement anti-cro\xFBte"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
