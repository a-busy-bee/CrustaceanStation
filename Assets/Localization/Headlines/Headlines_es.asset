  m_TableData:
  - m_Id: 1
    m_Localized: "\xBFQu\xE9 Necesita una Empresa de Biotecnolog\xEDa Con una Estaci\xF3n
      de Tren?"
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "Noticias de \xDAltima Hora: \xA1Senador Fishman acusado de Abuso
      de Informaci\xF3n Privilegiada!"
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "\xBFCu\xE1l es el Secreto Detr\xE1s de Mantenerse Tan Joven y Saludable?
      Krusty Kaleb Revela Todo\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "Ni\xF1o Encontrado Muerto Fuera del Laboratorio de Crustacean Corporation,
      Parece Haber Sido Devorado por un Depredador"
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "Opini\xF3n: La Corporaci\xF3n de Crust\xE1ceos Necesita ser Detenida"
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "Opini\xF3n: Crustacean Corporation Podr\xEDa Ser la \xDAltima Compa\xF1\xEDa
      \xC9tica Que Queda"
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "El N\xFAmero R\xE9cord de Casos de Criaturas Desaparecidas de este
      Mes\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "Los Crust\xE1ceos Son la Forma Final de Toda la Vida Marina"
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "\xBFLa Nueva Tendencia de Moda Est\xE1 Grabando Garras en Tu Cuerpo?"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "Denunciante Informa sobre la Nueva Investigaci\xF3n Revolucionaria
      de Crustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: El Crecimiento de Garras es una Ocurrencia Absolutamente Normal.
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "El Naranja est\xE1 Calificado como la Mutaci\xF3n de Color Superior
      de Todos los Tiempos"
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: Todos Corran.
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "Deshazte De Tus Viejos Exoesqueletos y Abraza la Carcinizaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "El Nuevo Mundo de los Crust\xE1ceos y Crust\xE1ceos Similares a
      los Crust\xE1ceos."
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "La Alegr\xEDa del Cangrejo Delira Todos los D\xEDas."
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "\xA1La Evoluci\xF3n Sucedi\xF3 por una Raz\xF3n, Gente!"
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "Denunciante En Realidad Inform\xF3 sobre los impactantes Experimentos
      de Crustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "Una Inmersi\xF3n Profunda en los ideales Corruptos de Crustacean
      Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: Diez Cosas Principales Que Puede Hacer para Apoyar el Movimiento
      Anticostoso
    m_Metadata:
      m_Items: []
  references:
