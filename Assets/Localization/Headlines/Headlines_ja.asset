  m_TableData:
  - m_Id: 1
    m_Localized: "\u30D0\u30A4\u30AA\u30C6\u30AF\u30CE\u30ED\u30B8\u30FC\u4F01\u696D\u304C\u99C5\u3067\u4F55\u3092\u5FC5\u8981\u3068\u3059\u308B\u3068\u3044\u3046\u306E\u3067\u3057\u3087\u3046\u304B\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "\u901F\u5831: \u30D5\u30A3\u30C3\u30B7\u30E5\u30DE\u30F3\u4E0A\u9662\u8B70\u54E1\u3001\u30A4\u30F3\u30B5\u30A4\u30C0\u30FC\u53D6\u5F15\u306E\u7591\u3044\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "\u306A\u305C\u82E5\u3005\u3057\u304F\u5065\u5EB7\u3067\u3044\u3089\u308C\u308B\u306E\u304B\u3001\u305D\u306E\u79D8\u5BC6\u306F\u4F55\u3067\u3057\u3087\u3046\u304B\uFF1F
      \u30AB\u30CB\u306E\u30AB\u30EC\u30D6\u304C\u3059\u3079\u3066\u3092\u660E\u304B\u3059\xB7\xB7\xB7"
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "\u7532\u6BBB\u985E\u30B3\u30FC\u30DD\u30EC\u30FC\u30B7\u30E7\u30F3\u306E\u7814\u7A76\u6240\u306E\u5916\u3067\u5B50\u3069\u3082\u304C\u6B7B\u4EA1\u3057\u3066\u767A\u898B\u3055\u308C\u3001\u6355\u98DF\u8005\u306B\u98DF\u3079\u3089\u308C\u305F\u3068\u307F\u3089\u308C\u308B"
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "\u610F\u898B\uFF1A\u7532\u6BBB\u985E\u4F01\u696D\u306F\u505C\u6B62\u3055\u308C\u308B\u3079\u304D\u3060"
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "\u610F\u898B\uFF1A\u7532\u6BBB\u985E\u4F01\u696D\u306F\u6700\u5F8C\u306B\u6B8B\u308B\u502B\u7406\u7684\u306A\u4F01\u696D\u304B\u3082\u3057\u308C\u306A\u3044"
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "\u4ECA\u6708\u306E\u8A18\u9332\u7684\u306A\u884C\u65B9\u4E0D\u660E\u751F\u7269\u306E\u4EF6\u6570\xB7\xB7\xB7"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "\u7532\u6BBB\u985E\u306F\u3059\u3079\u3066\u306E\u6D77\u6D0B\u751F\u7269\u306E\u6700\u7D42\u5F62\u614B\u3067\u3059"
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "\u3042\u306A\u305F\u306E\u4F53\u306B\u722A\u3092\u30C6\u30FC\u30D7\u3067\u8CBC\u308B\u3068\u3044\u3046\u65B0\u3057\u3044\u30DB\u30C3\u30C8\u30C8\u30EC\u30F3\u30C9\u306F\u3042\u308A\u307E\u3059\u304B\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "\u30AF\u30E9\u30B9\u30C6\u30A4\u30B7\u30E3\u30F3\u793E\u306E\u65B0\u305F\u306A\u9769\u547D\u7684\u7814\u7A76\u306B\u95A2\u3059\u308B\u5185\u90E8\u544A\u767A\u8005\u306E\u5831\u544A"
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "\u722A\u304C\u4F38\u3073\u308B\u306E\u306F\u307E\u3063\u305F\u304F\u666E\u901A\u306E\u3053\u3068\u3067\u3059"
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "\u30AA\u30EC\u30F3\u30B8\u306F\u53F2\u4E0A\u6700\u9AD8\u306E\u8272\u5909\u7570\u3068\u3057\u3066\u8A55\u4FA1\u3055\u308C\u3066\u3044\u308B"
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "\u307F\u3093\u306A\u8D70\u308C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "\u53E4\u3044\u5916\u9AA8\u683C\u3092\u8131\u304E\u6368\u3066\u3001\u30AB\u30FC\u30CB\u30B7\u30BC\u30FC\u30B7\u30E7\u30F3\u3092\u53D7\u3051\u5165\u308C\u3088\u3046\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "\u7532\u6BBB\u985E\u304A\u3088\u3073\u7532\u6BBB\u985E\u69D8\u7532\u6BBB\u985E\u306E\u65B0\u4E16\u754C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "\u6BCE\u65E5\u306E\u30AF\u30E9\u30D6\u30FB\u30EC\u30A4\u30D6\u306E\u697D\u3057\u3055\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "\u9032\u5316\u306B\u306F\u3061\u3083\u3093\u3068\u7406\u7531\u304C\u3042\u308B\u3093\u3060\u3088\u3001\u307F\u3093\u306A\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "\u5185\u90E8\u544A\u767A\u8005\u304C\u5B9F\u969B\u306B\u5831\u544A\u3057\u305F\u7532\u6BBB\u985E\u4F01\u696D\u306E\u885D\u6483\u7684\u306A\u5B9F\u9A13"
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "\u30AF\u30E9\u30B9\u30C6\u30A4\u30B7\u30E3\u30F3\u30FB\u30B3\u30FC\u30DD\u30EC\u30FC\u30B7\u30E7\u30F3\u306E\u6B6A\u3093\u3060\u7406\u60F3\u4E3B\u7FA9\u3092\u6DF1\u304F\u6398\u308A\u4E0B\u3052\u308B"
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "\u30A2\u30F3\u30C1\u30AF\u30E9\u30B9\u30C8\u904B\u52D5\u3092\u652F\u63F4\u3059\u308B\u305F\u3081\u306B\u3067\u304D\u308B\u30C8\u30C3\u30D710\u306E\u3053\u3068"
    m_Metadata:
      m_Items: []
