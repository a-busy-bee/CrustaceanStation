  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Headlines_Strings_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: feb04c4b14d9d4b9cbd860b3b50e0ee8, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: "\xBFQu\xE9 necesita una empresa de biotecnolog\xEDa de una estaci\xF3n
      de tren?"
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "\xDAltima hora: \xA1El senador Fishman es acusado de uso de informaci\xF3n
      privilegiada!"
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "\xBFCu\xE1l es el secreto para mantenerse tan joven y saludable?
      Krusty Kaleb lo revela todo\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "Un ni\xF1o fue hallado muerto en las afueras del laboratorio de
      Crustacean Corporation; al parecer, fue devorado por un depredador."
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "Opini\xF3n: Hay que detener a Crustacean Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "Opini\xF3n: Crustacean Corporation podr\xEDa ser la \xFAltima empresa
      \xE9tica que queda."
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "Este mes se ha registrado un n\xFAmero r\xE9cord de casos de animales
      desaparecidos\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "Los crust\xE1ceos son la forma final de toda la vida marina."
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "\xBFLa nueva tendencia consiste en pegarse garras al cuerpo con
      cinta adhesiva?"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "Un informante denuncia la nueva investigaci\xF3n revolucionaria
      de Crustacean Corporation."
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "El crecimiento de las garras es un fen\xF3meno completamente normal."
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "El naranja est\xE1 considerado como la mejor mutaci\xF3n de color
      de todos los tiempos."
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "\xA1Corran todos!"
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "Deshazte de tus viejos exoesqueletos y abraza la carcinizaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "El nuevo mundo de los crust\xE1ceos y los crust\xE1ceos similares
      a los crust\xE1ceos."
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "La alegr\xEDa de los cangrejos se desata todos los d\xEDas."
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "\xA1La evoluci\xF3n ocurri\xF3 por una raz\xF3n, gente!"
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "Un informante revel\xF3 los impactantes experimentos de Crustacean
      Corporation."
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "Un an\xE1lisis profundo de los ideales corruptos de Crustacean
      Corporation"
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: Diez cosas que puedes hacer para apoyar el movimiento contra la
      comida crujiente.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
