  m_Name: Headlines_Strings_ru
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ru
  m_SharedData: {fileID: 11400000, guid: feb04c4b14d9d4b9cbd860b3b50e0ee8, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: "\u0417\u0430\u0447\u0435\u043C \u0431\u0438\u043E\u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \u0432\u043E\u043E\u0431\u0449\u0435
      \u043D\u0443\u0436\u0435\u043D \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0439
      \u0432\u043E\u043A\u0437\u0430\u043B?"
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "\u0421\u0440\u043E\u0447\u043D\u0430\u044F \u043D\u043E\u0432\u043E\u0441\u0442\u044C:
      \u0421\u0435\u043D\u0430\u0442\u043E\u0440\u0430 \u0424\u0438\u0448\u043C\u0430\u043D\u0430
      \u043E\u0431\u0432\u0438\u043D\u044F\u044E\u0442 \u0432 \u0438\u043D\u0441\u0430\u0439\u0434\u0435\u0440\u0441\u043A\u043E\u0439
      \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "\u0412 \u0447\u0451\u043C \u0441\u0435\u043A\u0440\u0435\u0442
      \u0442\u0430\u043A\u043E\u0439 \u043C\u043E\u043B\u043E\u0434\u043E\u0441\u0442\u0438
      \u0438 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F? \u041A\u0440\u0430\u0441\u0442\u0438
      \u041A\u0430\u043B\u0435\u0431 \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0432\u0441\u0435 \u0441\u0435\u043A\u0440\u0435\u0442\u044B\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "\u0420\u0435\u0431\u0435\u043D\u043E\u043A \u043D\u0430\u0439\u0434\u0435\u043D
      \u043C\u0435\u0440\u0442\u0432\u044B\u043C \u0432\u043E\u0437\u043B\u0435 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438
      \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438 \xABCrustacean
      Corporation\xBB, \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
      \u0435\u0433\u043E \u0441\u044A\u0435\u043B \u0445\u0438\u0449\u043D\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "\u041C\u043D\u0435\u043D\u0438\u0435: \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044E
      \u043F\u043E \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0443
      \u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "\u041C\u043D\u0435\u043D\u0438\u0435: \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F
      Crustacean Corporation, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439 \u043E\u0441\u0442\u0430\u0432\u0448\u0435\u0439\u0441\u044F
      \u044D\u0442\u0438\u0447\u043D\u043E\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "\u0412 \u044D\u0442\u043E\u043C \u043C\u0435\u0441\u044F\u0446\u0435
      \u0437\u0430\u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043E
      \u0440\u0435\u043A\u043E\u0440\u0434\u043D\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      \u0434\u0435\u043B \u043E \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0438\u0445
      \u0431\u0435\u0437 \u0432\u0435\u0441\u0442\u0438 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "\u0420\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0435
      \u2014 \u044D\u0442\u043E \u043A\u043E\u043D\u0435\u0447\u043D\u0430\u044F
      \u0444\u043E\u0440\u043C\u0430 \u0432\u0441\u0435\u0439 \u043C\u043E\u0440\u0441\u043A\u043E\u0439
      \u0436\u0438\u0437\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "\u041D\u043E\u0432\u044B\u0439 \u043C\u043E\u0434\u043D\u044B\u0439
      \u0442\u0440\u0435\u043D\u0434 \u2013 \u044D\u0442\u043E \u043D\u0430\u043D\u0435\u0441\u0435\u043D\u0438\u0435
      \u043A\u043B\u0435\u0439\u043A\u043E\u0439 \u043B\u0435\u043D\u0442\u044B \u0432
      \u0432\u0438\u0434\u0435 \u043A\u043E\u0433\u0442\u0435\u0439 \u043D\u0430
      \u0442\u0435\u043B\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "\u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440 \u0441\u043E\u043E\u0431\u0449\u0430\u0435\u0442
      \u043E \u043D\u043E\u0432\u044B\u0445 \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u043E\u043D\u043D\u044B\u0445
      \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F\u0445
      \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438 \u043F\u043E \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0443
      \u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "\u041E\u0442\u0440\u0430\u0449\u0438\u0432\u0430\u043D\u0438\u0435
      \u043A\u043E\u0433\u0442\u0435\u0439 \u2014 \u044D\u0442\u043E \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E
      \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0435 \u044F\u0432\u043B\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "\u041E\u0440\u0430\u043D\u0436\u0435\u0432\u044B\u0439 \u0446\u0432\u0435\u0442
      \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u043B\u0443\u0447\u0448\u0435\u0439
      \u0446\u0432\u0435\u0442\u043E\u0432\u043E\u0439 \u043C\u0443\u0442\u0430\u0446\u0438\u0435\u0439
      \u0432\u0441\u0435\u0445 \u0432\u0440\u0435\u043C\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "\u0411\u0435\u0433\u0438\u0442\u0435 \u0432\u0441\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "\u0421\u0431\u0440\u043E\u0441\u044C\u0442\u0435 \u0441\u0432\u043E\u0439
      \u0441\u0442\u0430\u0440\u044B\u0439 \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442
      \u0438 \u043F\u0440\u0438\u043C\u0438\u0442\u0435 \u043A\u0430\u0440\u0446\u0438\u043D\u0438\u0437\u0430\u0446\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "\u041D\u043E\u0432\u044B\u0439 \u043C\u0438\u0440 \u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445
      \u0438 \u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445,
      \u043F\u043E\u0445\u043E\u0436\u0438\u0445 \u043D\u0430 \u0440\u0430\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "\u0420\u0430\u0434\u043E\u0441\u0442\u044C \u043E\u0442 \u043A\u0440\u0430\u0431\u043E\u0432\u044B\u0445
      \u0432\u0435\u0447\u0435\u0440\u0438\u043D\u043E\u043A \u0440\u0430\u0434\u0443\u0435\u0442\u0441\u044F
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "\u042D\u0432\u043E\u043B\u044E\u0446\u0438\u044F \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u0430
      \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A, \u043B\u044E\u0434\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "\u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0441\u043E\u043E\u0431\u0449\u0438\u043B \u043E \u0448\u043E\u043A\u0438\u0440\u0443\u044E\u0449\u0438\u0445
      \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u0445
      \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438 Crustacean."
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "\u041F\u043E\u0434\u0440\u043E\u0431\u043D\u043E\u0435 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435
      \u043F\u043E\u0440\u043E\u0447\u043D\u044B\u0445 \u0438\u0434\u0435\u0430\u043B\u043E\u0432
      \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438 \xAB\u041A\u0440\u0435\u0441\u0442\u043E\u043D\u043E\u0441\u0446\u044B\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u044C \u0433\u043B\u0430\u0432\u043D\u044B\u0445
      \u0432\u0435\u0449\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u0434\u0435\u043B\u0430\u0442\u044C,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0442\u0438\u0432
      \u0432\u043E\u0440\u0447\u043B\u0438\u0432\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
