  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Headlines_it
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: it
  m_SharedData: {fileID: 11400000, guid: cb6b811ec48994e63ac1d53100b2badf, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: Di cosa ha bisogno un'azienda biotecnologica con una stazione ferroviaria?
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: 'Ultime notizie: Il senatore Fishman accusato di insider Trading!'
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "Qual \xE8 il segreto per rimanere cos\xEC giovani e sani? Krusty
      Kaleb rivela tutto\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: Bambino trovato morto fuori dal laboratorio della Crustacean Corporation,
      sembra essere stato mangiato da un predatore
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: 'Opinione: Crustacean Corporation deve essere fermato'
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: Crustacean Corporation potrebbe essere l'ultima azienda etica rimasta
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "Il numero record di casi di creature scomparse di questo mese\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: I crostacei sono la forma finale di tutta la vita marina
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "\xC8 la nuova tendenza calda Taping artigli sul tuo corpo?"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: Whistleblower riferisce sulla nuova ricerca rivoluzionaria di Crustacean
      Corporation
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: Gli artigli in crescita sono un evento assolutamente normale
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "Arancione \xE8 valutato come la mutazione di colore superiore di
      tutti i tempi"
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: Correte tutti.
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: Getta i tuoi vecchi esoscheletri e abbraccia la cancerizzazione.
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: Il nuovo mondo dei crostacei e dei crostacei simili ai crostacei.
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: La gioia del granchio Rave ogni giorno.
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "L'evoluzione \xE8 avvenuta per una ragione, gente!"
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: Whistleblower ha effettivamente riportato gli esperimenti scioccanti
      della Crustacean Corporation
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: Un tuffo profondo negli ideali corrotti della Crustacean Corporation
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: Le prime dieci cose che puoi fare per sostenere il movimento anti-Crusty
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
